#!/bin/sh
# Managed by puppet

# Session attribution uses Linux process metadata from procps and existing who login records, without sudo or audit tooling, rules, or logs.
# Run with visibility of all host processes; this is a snapshot of registered terminals and their descendants, including console logins.
# A root login record remains critical even when its original account cannot be independently verified; process associations do not prove a historical user-switch chain.
# Verified critical conditions take precedence over a failed process inspection (UNKNOWN), followed by warnings and healthy results.

# Fail helper
die() {
    printf 'SSH check cannot run: %s\n' "$*"
    exit 3
}

<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
<% end -%>

# Parse command output independently of the host locale.
LC_ALL=C
export LC_ALL

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
PS=$(command -v ps 2>/dev/null) || die "ps not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
<% if @systemd_enable != false -%>
if use_systemd; then
    JOURNALCTL=$(command -v journalctl 2>/dev/null || true)
fi
<% end -%>
WHO=$(command -v who 2>/dev/null) || die "who not available"

# Session thresholds are intentionally simple because this check is a local SSH exposure signal.
ALLOWED_USERS=<%= @check_users_str_shell %>

# The service name is resolved from the platform's fixed SSH service selection.
SERVICE='<%= @service %>'
CRIT_THRESH=${CRIT_THRESH:-2} # critical session count (active)
WARN_THRESH=${WARN_THRESH:-1} # warning session count (active)
LONG_OUTPUT=""
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
LONG_OUTPUT_SEP="__CHECK_SSH_NL__"
MAX_IDLE=${MAX_IDLE:-5} # minutes: session idle-time <= MAX_IDLE => active
MAX_AGE=${MAX_AGE:-30} # minutes: session age > MAX_AGE => CRITICAL
STATE_CODE=0
USAGE_TEXT="Usage: $0 [-c <crit>] [-w <warn>] [-t <max-age>] [-a <max-age>] [-i <max-idle>] [-l chars]
Environment: CRIT_THRESH (-c); WARN_THRESH (-w); MAX_AGE (-t); MAX_IDLE (-i); MAX_AGE (-a); DETAIL_LIMIT (-l).
Command-line options override non-empty environment values; unset or empty environment values use defaults."

# CLI overrides are runtime thresholds only; `-a` is kept as a compatibility alias for `-t`.
OPTERR=0
while getopts ':c:w:t:i:a:l:h' opt; do
    case "$opt" in
        c) CRIT_THRESH="$OPTARG" ;;
        w) WARN_THRESH="$OPTARG" ;;
        t) MAX_AGE="$OPTARG" ;;
        i) MAX_IDLE="$OPTARG" ;;
        a) MAX_AGE="$OPTARG" ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
for numeric_value in "$CRIT_THRESH" "$WARN_THRESH" "$MAX_IDLE" "$MAX_AGE"; do
    case "$numeric_value" in
        ''|*[!0-9]*) die "session thresholds must be numeric" ;;
    esac
done
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$CRIT_THRESH" -ge "$WARN_THRESH" ] || die "critical session threshold must be greater than or equal to warning threshold"
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

# Emit a direct CRITICAL result and stop immediately.
crit() {
    printf 'SSH %s\n' "$*"
    exit 2
}

# Keep user names and journal fragments safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append one line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
}

# Emit one monitoring line followed by sanitized session and journal detail.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Append one semicolon-separated cause to the short output.
append_summary_reason() {
    if [ -n "$1" ]; then
        printf '%s; %s' "$1" "$2"
    else
        printf '%s' "$2"
    fi
}

# Render a comma-separated list for long output; final diagnostics are capped once before Interpretation.
cap_csv_list() {
    printf '%s\n' "$1" | $AWK -F',' '
        {
            for (i = 1; i <= NF; i++) {
                item = $i
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", item)
                if (item == "") {
                    continue
                }
                shown++
                items[shown] = item
            }
        }
        END {
            for (i = 1; i <= shown; i++) {
                printf "%s%s", (i > 1 ? ", " : ""), items[i]
            }
        }
    '
}

# Count terminal processes and root descendants from one snapshot, following parents across pseudo-terminal changes.
inspect_session_processes() {
    printf '%s\n' "$PROCESS_OUTPUT" | $AWK -v tty="$1" -v check_pid="$$" '
        $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
            parent[$1] = $2
            uid[$1] = $3
            terminal[$1] = $4
            process_count++
        }
        END {
            for (pid in parent) {
                related = 0
                own_process = 0
                steps = 0
                for (ancestor = pid; ancestor in parent && steps++ < process_count; ancestor = parent[ancestor]) {
                    if (ancestor == check_pid) {
                        own_process = 1
                        break
                    }
                    if (terminal[ancestor] == tty) {
                        related = 1
                    }
                }
                if (own_process) {
                    continue
                }
                if (terminal[pid] == tty) {
                    tty_count++
                }
                # Count only processes on or below the login terminal, not privileged ancestors such as the SSH listener.
                if (related && uid[pid] == 0) {
                    root_count++
                }
            }
            printf "%d %d\n", tty_count, root_count
        }
    '
}

# Check the service first so daemon failures are reported before session parsing.
<% if @systemd_enable != false -%>
check_systemd_service "$SERVICE"
if ! use_systemd; then
<% end -%>
    PROCESS_NAMES=$($PS -e -o comm= 2>/dev/null) || die "process inspection unavailable"
    printf '%s\n' "$PROCESS_NAMES" | $AWK '$1 == "sshd" { found=1 } END { exit !found }' || crit "service is not active"
<% if @systemd_enable != false -%>
fi
<% end -%>

# Preserve the terminal-based session count while inspecting numeric UIDs and process ancestry independently of login tooling.
ACTIVE_SESSIONS=0
AGE_CRIT=false
MAX_SESSION_AGE_MIN=0
NOW_EPOCH=$($DATE +%s)
ROOT_ACTIVITY=false
SEP=""
USERS_LIST=""
WHO_OUTPUT=$($WHO -u) || die "cannot read login records"
PROCESS_INSPECTION_FAILED=false
PROCESS_OUTPUT=$($PS -e -o pid=,ppid=,euid=,tty=,stat=,comm=) || PROCESS_INSPECTION_FAILED=true
[ -n "$PROCESS_OUTPUT" ] || PROCESS_INSPECTION_FAILED=true

# Zombie sshd processes are diagnostic noise worth warning about when no harder issue exists.
ZOMBIE_COUNT=$(printf '%s\n' "$PROCESS_OUTPUT" | $AWK '$6 == "sshd" && $5 ~ /Z/ {c++} END {print c+0}')

# Parse who(1) output and keep only entries backed by an existing TTY.
while read -r USER TTY LOGIN_DATE LOGIN_TIME IDLE _; do
    # Skip malformed lines / missing TTY
    if [ -z "$USER" ] || [ ! -e "/dev/$TTY" ]; then
        continue
    fi

    # Aggregate unique users for message
    case ",$USERS_LIST," in
        *,"$USER",*) ;;
        *) USERS_LIST="${USERS_LIST}${SEP}${USER}"; SEP="," ;;
    esac

    # Normalize who(1) idle notation into minutes for active-session decisions.
    case "$IDLE" in
        '.')    IDLE_MIN=0 ;;
        'old')  IDLE_MIN=$((MAX_IDLE + 1)) ;;
        *:* )   H=${IDLE%%:*}; M=${IDLE##*:}; H=${H#0}; M=${M#0}; [ -z "$H" ] && H=0; [ -z "$M" ] && M=0; IDLE_MIN=$((H*60 + M)) ;;
        *d)     D=${IDLE%%[^0-9]*}; IDLE_MIN=$((D*1440)) ;;
        *)      IDLE_MIN=$((MAX_IDLE + 1)) ;;
    esac

    # A live root descendant may have another TTY or no TTY; neither sudo nor an audit login UID is required.
    SESSION_PROCESSES=$(inspect_session_processes "$TTY") || die "cannot classify session processes"
    read -r PROC_COUNT ROOT_COUNT <<EOF
$SESSION_PROCESSES
EOF
    if [ "$USER" = root ] || [ "$ROOT_COUNT" -gt 0 ]; then
        if [ "$ROOT_ACTIVITY" = false ]; then
            append_long "Root activity:"
        fi
        ROOT_ACTIVITY=true
        if [ "$USER" = root ]; then
            # Login records can also be written by privilege tools, so a root record alone does not prove a direct SSH login.
            append_long "  root - login registered as root on ${TTY}; originating account not independently verified"
        else
            append_long "  ${USER} -> root - ${ROOT_COUNT} root process(es) associated with login on ${TTY}"
        fi
    fi

    # A session is active when either process activity or low idle time indicates live use.
    if [ "$PROC_COUNT" -ge 1 ] || [ "$IDLE_MIN" -le "$MAX_IDLE" ]; then
        ACTIVE_SESSIONS=$((ACTIVE_SESSIONS + 1))
    fi

    # Long-lived sessions are security-sensitive even if they are idle.
    LOGIN_EPOCH=$($DATE -d "$LOGIN_DATE $LOGIN_TIME" +%s 2>/dev/null) || LOGIN_EPOCH=0
    if [ "$LOGIN_EPOCH" -ne 0 ]; then
        AGE_MIN=$(((NOW_EPOCH - LOGIN_EPOCH)/60))
        [ "$AGE_MIN" -gt "$MAX_SESSION_AGE_MIN" ] && MAX_SESSION_AGE_MIN=$AGE_MIN
        [ "$AGE_MIN" -gt "$MAX_AGE" ] && AGE_CRIT=true
    fi
done <<EOF
$WHO_OUTPUT
EOF

# Auth failure detection is PID-aware so retries followed by a successful login are not over-counted.
AUTH_HISTORY_AVAILABLE=false
AUTH_LOG=""
<% if @systemd_enable != false -%>
if use_systemd && [ -n "$JOURNALCTL" ]; then
    if AUTH_LOG=$($JOURNALCTL -q -o short-unix -u ssh -u sshd --since today 2>/dev/null); then
        AUTH_HISTORY_AVAILABLE=true
    fi
fi
<% end -%>
if [ "$AUTH_HISTORY_AVAILABLE" = true ]; then
OUT=$(printf '%s\n' "$AUTH_LOG" | $AWK -v allow_users="$ALLOWED_USERS" '
BEGIN {
    # Parse allowlist into a map for O(1) lookups.
    split(allow_users, a, ","); has_allow=0
    for (i in a) if (a[i]!="") { allow_map[a[i]]=1; has_allow=1 }

    # Initialize failure counters by PID visibility and allowlist class.
    fail_no_pid_total=0
    wl_fail_no_pid_total=0
    nl_fail_no_pid_total=0
    wl_abort_total=0
    nl_abort_total=0
}
{
    # Extract message part and PID without gawk-only match arrays.
    idx=index($0, ": "); msg=(idx>0?substr($0, idx+2):$0)
    pid=""
    if (match($0, /sshd\[[0-9]+\]/)) {
        pid=substr($0, RSTART + 5, RLENGTH - 6)
    }

    # Mark successful authentications per PID so earlier retries from the same connection do not count.
    if (msg ~ /Accepted (password|publickey) for [[:alnum:]_.-]+/) {
        if (pid != "") {
            accepted_pid[pid]=1
        }
        next
    }

    # User-initiated aborts before authentication completes are tracked separately and do not count as failures.
    if (msg ~ /Connection (closed|reset) by authenticating user [[:alnum:]_.-]+/ || msg ~ /Disconnected from authenticating user [[:alnum:]_.-]+/) {
        user=msg
        sub(/^.*authenticating user[[:space:]]+/, "", user)
        sub(/[[:space:]].*$/, "", user)
        if (user in allow_map) wl_abort_total++; else nl_abort_total++
        next
    }

    # Classify failures and extract the username when the journal line carries one.
    is_fail=0; user=""
    if (msg ~ /Invalid user[[:space:]]+[[:alnum:]_.-]+/) {
        is_fail=1
        user=msg
        sub(/^.*Invalid user[[:space:]]+/, "", user)
        sub(/[[:space:]].*$/, "", user)
    } else if (msg ~ /Failed (password|publickey) for (invalid user )?[[:alnum:]_.-]+/) {
        is_fail=1
        user=msg
        sub(/^.*Failed (password|publickey) for /, "", user)
        sub(/^invalid user[[:space:]]+/, "", user)
        sub(/[[:space:]].*$/, "", user)
    }
    else if (msg ~ /authentication failure|kex_exchange_identification/) { is_fail=1 }

    # Accumulate global and allowlist-specific counters while preserving PID matching.
    if (is_fail) {
        if (pid!="") fail_by_pid[pid]++; else fail_no_pid_total++

        if (user!="") {
            if (user in allow_map) {
                if (pid!="") wl_fail_by_pid[pid]++; else wl_fail_no_pid_total++
                wl_pid_user_flag[pid ":" user]=1
            } else {
                if (pid!="") nl_fail_by_pid[pid]++; else nl_fail_no_pid_total++
            }
        }
    }
}
END {
    # RAW is all failures with and without a PID.
    raw_fail_total=fail_no_pid_total
    for (pp in fail_by_pid) raw_fail_total+=fail_by_pid[pp]

    # Allowlist unmatched failures exclude connections that later authenticated successfully.
    wl_fail_unmatched_total=0; bad_users=""
    if (has_allow) {
        wl_fail_unmatched_total=wl_fail_no_pid_total
        for (pp in wl_fail_by_pid) if (!(pp in accepted_pid)) wl_fail_unmatched_total+=wl_fail_by_pid[pp]

        # Build a unique list of allowlist users with unmatched failures for the short output.
        sep=""
        for (k in wl_pid_user_flag) {
            n=split(k,parts,":"); pidk=parts[1]; userk=parts[2]
            if (!(pidk in accepted_pid) && !(userk in seen)) {
                bad_users=bad_users sep userk; sep=","; seen[userk]=1
            }
        }
    }

    # Non-allowlist totals mirror allowlist semantics, but they are context-only.
    nl_fail_raw_total=nl_fail_no_pid_total
    for (pp in nl_fail_by_pid) nl_fail_raw_total+=nl_fail_by_pid[pp]

    nl_fail_unmatched_total=nl_fail_no_pid_total
    for (pp in nl_fail_by_pid) if (!(pp in accepted_pid)) nl_fail_unmatched_total+=nl_fail_by_pid[pp]

    # The shell parser expects this stable field order.
    print raw_fail_total ":" wl_fail_unmatched_total ":" bad_users ":" \
          nl_fail_raw_total ":" nl_fail_unmatched_total ":" wl_abort_total ":" nl_abort_total
}
')
# Parse new names
FAIL_TOTAL=${OUT%%:*}; REM=${OUT#*:}
FAIL_WL_UNMATCHED=${REM%%:*}; REM=${REM#*:}
BAD_WL_USERS=${REM%%:*}; REM=${REM#*:}
FAIL_OTH_TOTAL=${REM%%:*}; REM=${REM#*:}
FAIL_OTH_UNMATCHED=${REM%%:*}; REM=${REM#*:}
ABORT_WL=${REM%%:*}; ABORT_OTH=${REM#*:}
else
FAIL_TOTAL=U
FAIL_WL_UNMATCHED=U
BAD_WL_USERS=""
FAIL_OTH_TOTAL=U
FAIL_OTH_UNMATCHED=U
ABORT_WL=U
ABORT_OTH=U
fi

# Active/root/old sessions determine the primary state before softer journal signals.
if [ "$ROOT_ACTIVITY" = true ] || [ "$AGE_CRIT" = true ]; then
    STATE_CODE=2
elif [ "$ACTIVE_SESSIONS" -ge "$CRIT_THRESH" ]; then
    STATE_CODE=2
elif [ "$PROCESS_INSPECTION_FAILED" = true ]; then
    STATE_CODE=3
elif [ "$ACTIVE_SESSIONS" -ge "$WARN_THRESH" ]; then
    STATE_CODE=1
fi

# Allowlist authentication failures and zombies are WARNING-only unless a session rule already fired.
if [ "$STATE_CODE" -lt 1 ]; then
    if [ "$ZOMBIE_COUNT" -gt 0 ] || [ -n "$BAD_WL_USERS" ] || { [ "$FAIL_WL_UNMATCHED" != U ] && [ "$FAIL_WL_UNMATCHED" -gt 0 ]; } ; then
        STATE_CODE=1
    fi
fi

# Build the visible cause list without Nagios state labels and keep user lists in long output.
SUMMARY_CAUSES=""
BAD_WL_USERS_TEXT=$(cap_csv_list "$BAD_WL_USERS")
USERS_LIST_TEXT=$(cap_csv_list "$USERS_LIST")
[ "$ROOT_ACTIVITY" = true ] && SUMMARY_CAUSES=$(append_summary_reason "$SUMMARY_CAUSES" "root activity detected")
[ "$PROCESS_INSPECTION_FAILED" = true ] && SUMMARY_CAUSES=$(append_summary_reason "$SUMMARY_CAUSES" "process inspection unavailable")
[ "$AGE_CRIT" = true ] && SUMMARY_CAUSES=$(append_summary_reason "$SUMMARY_CAUSES" "session age ${MAX_SESSION_AGE_MIN}m")
if { [ "$FAIL_WL_UNMATCHED" != U ] && [ "$FAIL_WL_UNMATCHED" -gt 0 ]; }; then
    ALLOWLIST_FAILURE_SUMMARY="${FAIL_WL_UNMATCHED} unmatched allowlist failure(s)"
    SUMMARY_CAUSES=$(append_summary_reason "$SUMMARY_CAUSES" "$ALLOWLIST_FAILURE_SUMMARY")
fi
[ "$ZOMBIE_COUNT" -gt 0 ] && SUMMARY_CAUSES=$(append_summary_reason "$SUMMARY_CAUSES" "${ZOMBIE_COUNT} zombie sshd process(es)")

# Long output shows bounded user and journal-classification context.
if [ "$PROCESS_INSPECTION_FAILED" = true ]; then
    append_long "Process inspection unavailable: verify procps and access to the host process table; root attribution is incomplete."
fi
append_long "Session totals: ${ACTIVE_SESSIONS} active, maximum age ${MAX_SESSION_AGE_MIN}m, root activity ${ROOT_ACTIVITY}"
[ -n "$USERS_LIST_TEXT" ] && append_long "Active users: ${USERS_LIST_TEXT}"
[ -n "$BAD_WL_USERS_TEXT" ] && append_long "Allowlist users with unmatched failures: ${BAD_WL_USERS_TEXT}"
[ "$AUTH_HISTORY_AVAILABLE" = true ] || append_long "Authentication history unavailable or not applicable; current sessions are still inspected. U counters do not mean zero failures."
append_long "Authentication counters: ${FAIL_TOTAL} total failures, ${FAIL_WL_UNMATCHED} allowlist unmatched, ${FAIL_OTH_TOTAL} other raw, ${FAIL_OTH_UNMATCHED} other unmatched, ${ABORT_WL} allowlist aborts, ${ABORT_OTH} other aborts"
[ "$ZOMBIE_COUNT" -gt 0 ] && append_long "Zombie sshd processes: ${ZOMBIE_COUNT}"
limit_long_output_details
append_long ""
append_long "Interpretation:"
append_long "Active session count, root activity, long-lived sessions, unmatched failures for allowed users, and zombie sshd processes can affect the exit code."
append_long "Root login records remain critical. User -> root associates current processes with a registered login terminal, not a proven switch history or root shell. Inspect the reported terminals."
append_long "Session totals count login terminals, including consoles and additional pseudo-terminals. Detached processes without a remaining terminal or ancestry link and activity between checks are outside this snapshot."
append_long "Non-allowlist authentication failures and user-initiated aborts are context only. Inspect active sessions and allowlisted-user failures first when the summary reports SSH exposure."

# Perfdata carries both active-session counters and journal classification totals.
AGE_CRIT_METRIC=0
[ "$AGE_CRIT" = true ] && AGE_CRIT_METRIC=1
PERF_DATA="sessions=${ACTIVE_SESSIONS};${WARN_THRESH};${CRIT_THRESH};0"
PERF_DATA="$PERF_DATA zombies=${ZOMBIE_COUNT}"
PERF_DATA="$PERF_DATA fail_total=${FAIL_TOTAL}"
PERF_DATA="$PERF_DATA fail_wl_unmatched=${FAIL_WL_UNMATCHED}"
PERF_DATA="$PERF_DATA fail_oth_total=${FAIL_OTH_TOTAL}"
PERF_DATA="$PERF_DATA fail_oth_unmatched=${FAIL_OTH_UNMATCHED}"
PERF_DATA="$PERF_DATA abort_wl=${ABORT_WL}"
PERF_DATA="$PERF_DATA abort_oth=${ABORT_OTH}"
PERF_DATA="$PERF_DATA age_crit=${AGE_CRIT_METRIC}"

# Output for monitoring; dynamic user names are sanitized before the perfdata delimiter.
SUMMARY="SSH sessions active: ${ACTIVE_SESSIONS}"
[ -n "$SUMMARY_CAUSES" ] && SUMMARY="${SUMMARY}; ${SUMMARY_CAUSES}"
emit_check "$SUMMARY" "$PERF_DATA"
exit "$STATE_CODE"
