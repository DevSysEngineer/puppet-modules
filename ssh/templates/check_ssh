#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'SSH check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
PS=$(command -v ps 2>/dev/null) || die "ps not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
<% if @systemd_enable -%>
SYSTEMDCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null) || die "journalctl not available"
<% end -%>
WHO=$(command -v who 2>/dev/null) || die "who not available"

# Session thresholds are intentionally simple because this check is a local SSH exposure signal.
ALLOWED_USERS="<%= @check_users_str %>"
CRIT_THRESH=2      # critical session count (active)
WARN_THRESH=1      # warning session count (active)
DETAIL_LIMIT=${DETAIL_LIMIT:-10}
MAX_IDLE=5         # minutes: session idle-time <= MAX_IDLE => active
MAX_AGE=30         # minutes: session age > MAX_AGE => CRITICAL
STATE_CODE=0
USAGE_TEXT="Usage: $0 [-c <crit>] [-w <warn>] [-t <max-age>] [-a <max-age>] [-i <max-idle>]"

# CLI overrides are runtime thresholds only; `-a` is kept as a compatibility alias for `-t`.
OPTERR=0
while getopts 'c:w:t:i:a:' opt; do
    case "$opt" in
        c) CRIT_THRESH="$OPTARG" ;;
        w) WARN_THRESH="$OPTARG" ;;
        t) MAX_AGE="$OPTARG" ;;
        i) MAX_IDLE="$OPTARG" ;;
        a) MAX_AGE="$OPTARG" ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
for numeric_value in "$CRIT_THRESH" "$WARN_THRESH" "$MAX_IDLE" "$MAX_AGE"; do
    case "$numeric_value" in
        ''|*[!0-9]*) die "session thresholds must be numeric" ;;
    esac
done
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "detail limit must be numeric" ;;
esac
[ "$CRIT_THRESH" -ge "$WARN_THRESH" ] || die "critical session threshold must be greater than or equal to warning threshold"
[ "$DETAIL_LIMIT" -ge 1 ] || die "detail limit must be at least 1"

# Emit a CRITICAL result and stop immediately.
crit() {
    printf 'SSH check failed: %s\n' "$*"
    exit 2
}

# Keep user names and journal fragments safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Render a bounded comma-separated list for short output.
cap_csv_list() {
    printf '%s\n' "$1" | $AWK -F',' -v max="$DETAIL_LIMIT" '
        {
            for (i = 1; i <= NF; i++) {
                item = $i
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", item)
                if (item == "") {
                    continue
                }
                total++
                if (shown < max) {
                    shown++
                    items[shown] = item
                }
            }
        }
        END {
            for (i = 1; i <= shown; i++) {
                printf "%s%s", (i > 1 ? ", " : ""), items[i]
            }
            if (total > shown) {
                printf "%s+%d more", (shown > 0 ? ", " : ""), total - shown
            }
        }
    '
}

# Check the service first so daemon failures are reported before session parsing.
<% if @systemd_enable -%>
$SYSTEMDCTL is-active --quiet "<%= @service %>" || crit "SSH service is not active"
<% else -%>
$PS -C sshd >/dev/null 2>&1 || crit "SSH service is not active"
<% end -%>

# Current sessions are classified from who(1) plus TTY process state.
ACTIVE_SESSIONS=0
AGE_CRIT=false
MAX_SESSION_AGE_MIN=0
NOW_EPOCH=$($DATE +%s)
ROOT_LOGIN=false
SEP=""
USERS_LIST=""
WHO_OUTPUT=$($WHO -u)

# Zombie sshd processes are diagnostic noise worth warning about when no harder issue exists.
ZOMBIE_COUNT=$($PS -C sshd -o stat= | $AWK '$0 ~ /Z/ {c++} END {print c+0}')

# Parse who(1) output and keep only entries backed by an existing TTY.
while read -r USER TTY LOGIN_DATE LOGIN_TIME IDLE _; do
    # Skip malformed lines / missing TTY
    if [ -z "$USER" ] || [ ! -e "/dev/$TTY" ]; then
        continue
    fi

    # Root session seen via who
    [ "$USER" = "root" ] && ROOT_LOGIN=true

    # Aggregate unique users for message
    case ",$USERS_LIST," in
        *,"$USER",*) ;;
        *) USERS_LIST="${USERS_LIST}${SEP}${USER}"; SEP="," ;;
    esac

    # Normalize who(1) idle notation into minutes for active-session decisions.
    case "$IDLE" in
        '.')    IDLE_MIN=0 ;;
        'old')  IDLE_MIN=$((MAX_IDLE + 1)) ;;
        *:* )   H=${IDLE%%:*}; M=${IDLE##*:}; H=${H#0}; M=${M#0}; [ -z "$H" ] && H=0; [ -z "$M" ] && M=0; IDLE_MIN=$((H*60 + M)) ;;
        *d)     D=${IDLE%%[^0-9]*}; IDLE_MIN=$((D*1440)) ;;
        *)      IDLE_MIN=$((MAX_IDLE + 1)) ;;
    esac

    # TTY process ownership catches root escalation after a non-root login.
    TTY_PROCS=$($PS -t "$TTY" -o user=)
    PROC_COUNT=$(printf '%s\n' "$TTY_PROCS" | $AWK 'NF { count++ } END { print count + 0 }')
    case "$TTY_PROCS" in
        *root*) ROOT_LOGIN=true ;;
    esac

    # A session is active when either process activity or low idle time indicates live use.
    if [ "$PROC_COUNT" -ge 1 ] || [ "$IDLE_MIN" -le "$MAX_IDLE" ]; then
        ACTIVE_SESSIONS=$((ACTIVE_SESSIONS + 1))
    fi

    # Long-lived sessions are security-sensitive even if they are idle.
    LOGIN_EPOCH=$($DATE -d "$LOGIN_DATE $LOGIN_TIME" +%s 2>/dev/null) || LOGIN_EPOCH=0
    if [ "$LOGIN_EPOCH" -ne 0 ]; then
        AGE_MIN=$(((NOW_EPOCH - LOGIN_EPOCH)/60))
        [ "$AGE_MIN" -gt "$MAX_SESSION_AGE_MIN" ] && MAX_SESSION_AGE_MIN=$AGE_MIN
        [ "$AGE_MIN" -gt "$MAX_AGE" ] && AGE_CRIT=true
    fi
done <<EOF
$WHO_OUTPUT
EOF

# Auth failure detection is PID-aware so retries followed by a successful login are not over-counted.
<% if @systemd_enable -%>
OUT=$($JOURNALCTL -q -o short-unix -u ssh -u sshd --since today | $AWK -v allow_users="$ALLOWED_USERS" '
BEGIN {
    # Parse allowlist into a map for O(1) lookups.
    split(allow_users, a, ","); has_allow=0
    for (i in a) if (a[i]!="") { allow_map[a[i]]=1; has_allow=1 }

    # Initialize failure counters by PID visibility and allowlist class.
    fail_no_pid_total=0
    wl_fail_no_pid_total=0
    nl_fail_no_pid_total=0
    wl_abort_total=0
    nl_abort_total=0
}
{
    # Extract message part and PID without gawk-only match arrays.
    idx=index($0, ": "); msg=(idx>0?substr($0, idx+2):$0)
    pid=""
    if (match($0, /sshd\[[0-9]+\]/)) {
        pid=substr($0, RSTART + 5, RLENGTH - 6)
    }

    # Mark successful authentications per PID so earlier retries from the same connection do not count.
    if (msg ~ /Accepted (password|publickey) for [[:alnum:]_.-]+/) {
        if (pid != "") {
            accepted_pid[pid]=1
        }
        next
    }

    # User-initiated aborts before authentication completes are tracked separately and do not count as failures.
    if (msg ~ /Connection (closed|reset) by authenticating user [[:alnum:]_.-]+/ || msg ~ /Disconnected from authenticating user [[:alnum:]_.-]+/) {
        user=msg
        sub(/^.*authenticating user[[:space:]]+/, "", user)
        sub(/[[:space:]].*$/, "", user)
        if (user in allow_map) wl_abort_total++; else nl_abort_total++
        next
    }

    # Classify failures and extract the username when the journal line carries one.
    is_fail=0; user=""
    if (msg ~ /Invalid user[[:space:]]+[[:alnum:]_.-]+/) {
        is_fail=1
        user=msg
        sub(/^.*Invalid user[[:space:]]+/, "", user)
        sub(/[[:space:]].*$/, "", user)
    } else if (msg ~ /Failed (password|publickey) for (invalid user )?[[:alnum:]_.-]+/) {
        is_fail=1
        user=msg
        sub(/^.*Failed (password|publickey) for /, "", user)
        sub(/^invalid user[[:space:]]+/, "", user)
        sub(/[[:space:]].*$/, "", user)
    }
    else if (msg ~ /authentication failure|kex_exchange_identification/) { is_fail=1 }

    # Accumulate global and allowlist-specific counters while preserving PID matching.
    if (is_fail) {
        if (pid!="") fail_by_pid[pid]++; else fail_no_pid_total++

        if (user!="") {
            if (user in allow_map) {
                if (pid!="") wl_fail_by_pid[pid]++; else wl_fail_no_pid_total++
                wl_pid_user_flag[pid ":" user]=1
            } else {
                if (pid!="") nl_fail_by_pid[pid]++; else nl_fail_no_pid_total++
            }
        }
    }
}
END {
    # RAW is all failures with and without a PID.
    raw_fail_total=fail_no_pid_total
    for (pp in fail_by_pid) raw_fail_total+=fail_by_pid[pp]

    # Allowlist unmatched failures exclude connections that later authenticated successfully.
    wl_fail_unmatched_total=0; bad_users=""
    if (has_allow) {
        wl_fail_unmatched_total=wl_fail_no_pid_total
        for (pp in wl_fail_by_pid) if (!(pp in accepted_pid)) wl_fail_unmatched_total+=wl_fail_by_pid[pp]

        # Build a unique list of allowlist users with unmatched failures for the short output.
        sep=""
        for (k in wl_pid_user_flag) {
            n=split(k,parts,":"); pidk=parts[1]; userk=parts[2]
            if (!(pidk in accepted_pid) && !(userk in seen)) {
                bad_users=bad_users sep userk; sep=","; seen[userk]=1
            }
        }
    }

    # Non-allowlist totals mirror allowlist semantics, but they are context-only.
    nl_fail_raw_total=nl_fail_no_pid_total
    for (pp in nl_fail_by_pid) nl_fail_raw_total+=nl_fail_by_pid[pp]

    nl_fail_unmatched_total=nl_fail_no_pid_total
    for (pp in nl_fail_by_pid) if (!(pp in accepted_pid)) nl_fail_unmatched_total+=nl_fail_by_pid[pp]

    # The shell parser expects this stable field order.
    print raw_fail_total ":" wl_fail_unmatched_total ":" bad_users ":" \
          nl_fail_raw_total ":" nl_fail_unmatched_total ":" wl_abort_total ":" nl_abort_total
}
')
# Parse new names
FAIL_TOTAL=${OUT%%:*}; REM=${OUT#*:}
FAIL_WL_UNMATCHED=${REM%%:*}; REM=${REM#*:}
BAD_WL_USERS=${REM%%:*}; REM=${REM#*:}
FAIL_OTH_TOTAL=${REM%%:*}; REM=${REM#*:}
FAIL_OTH_UNMATCHED=${REM%%:*}; REM=${REM#*:}
ABORT_WL=${REM%%:*}; ABORT_OTH=${REM#*:}
<% else -%>
FAIL_TOTAL=0
FAIL_WL_UNMATCHED=0
BAD_WL_USERS=""
FAIL_OTH_TOTAL=0
FAIL_OTH_UNMATCHED=0
ABORT_WL=0
ABORT_OTH=0
<% end -%>

# Active/root/old sessions determine the primary state before softer journal signals.
if [ "$ROOT_LOGIN" = true ] || [ "$AGE_CRIT" = true ]; then
    STATE_CODE=2
elif [ "$ACTIVE_SESSIONS" -ge "$CRIT_THRESH" ]; then
    STATE_CODE=2
elif [ "$ACTIVE_SESSIONS" -ge "$WARN_THRESH" ]; then
    STATE_CODE=1
fi

# Allowlist authentication failures and zombies are WARNING-only unless a session rule already fired.
if [ "$STATE_CODE" -lt 1 ]; then
    if [ "$ZOMBIE_COUNT" -gt 0 ] || [ -n "$BAD_WL_USERS" ] || [ "$FAIL_WL_UNMATCHED" -gt 0 ] ; then
        STATE_CODE=1
    fi
fi

# Build the visible cause list without Nagios state labels.
EXTRA=""
BAD_WL_USERS_TEXT=$(cap_csv_list "$BAD_WL_USERS")
USERS_LIST_TEXT=$(cap_csv_list "$USERS_LIST")
[ "$ROOT_LOGIN" = true ] && EXTRA="${EXTRA}root login, "
[ "$AGE_CRIT" = true ] && EXTRA="${EXTRA}session age ${MAX_SESSION_AGE_MIN}m, "
[ -n "$BAD_WL_USERS_TEXT" ] && EXTRA="${EXTRA}failed logins for '$BAD_WL_USERS_TEXT', "
[ "$FAIL_WL_UNMATCHED" -gt 0 ] && EXTRA="${EXTRA}${FAIL_WL_UNMATCHED} unmatched allowlist failures, "
[ "$ZOMBIE_COUNT" -gt 0 ] && EXTRA="${EXTRA}${ZOMBIE_COUNT} zombies, "
[ -n "$USERS_LIST_TEXT" ] && EXTRA="${EXTRA}users: $USERS_LIST_TEXT, "
EXTRA=$(printf '%s' "$EXTRA" | $SED 's/, $//')
[ -n "$EXTRA" ] && EXTRA="; $EXTRA"

# Perfdata carries both active-session counters and journal classification totals.
AGE_CRIT_METRIC=0
[ "$AGE_CRIT" = true ] && AGE_CRIT_METRIC=1
PERF_DATA="sessions=${ACTIVE_SESSIONS};${WARN_THRESH};${CRIT_THRESH};0;"
PERF_DATA="$PERF_DATA zombies=${ZOMBIE_COUNT};;;;"
PERF_DATA="$PERF_DATA fail_total=${FAIL_TOTAL};;;;"
PERF_DATA="$PERF_DATA fail_wl_unmatched=${FAIL_WL_UNMATCHED};;;;"
PERF_DATA="$PERF_DATA fail_oth_total=${FAIL_OTH_TOTAL};;;;"
PERF_DATA="$PERF_DATA fail_oth_unmatched=${FAIL_OTH_UNMATCHED};;;;"
PERF_DATA="$PERF_DATA abort_wl=${ABORT_WL};;;;"
PERF_DATA="$PERF_DATA abort_oth=${ABORT_OTH};;;;"
PERF_DATA="$PERF_DATA age_crit=${AGE_CRIT_METRIC};;;;"

# Output for monitoring; dynamic user names are sanitized before the perfdata delimiter.
SUMMARY="SSH sessions active: ${ACTIVE_SESSIONS}${EXTRA}"
printf '%s | %s\n' "$(monitor_text_value "$SUMMARY")" "$PERF_DATA"
exit "$STATE_CODE"
