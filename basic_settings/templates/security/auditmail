#!/bin/sh
# Managed by puppet

# Check command dependencies before building the report.
AUREPORTTOOL=$(command -v aureport 2>/dev/null) || exit 1
DATE=$(command -v date 2>/dev/null) || exit 1
GREP=$(command -v grep 2>/dev/null) || exit 1
JOURNALCTL=$(command -v journalctl 2>/dev/null) || exit 1

# Check if notification helper or mail fallback is available
MONITORING_NOTIFY=/usr/local/lib/puppet/monitoring-notify
MAIL=/usr/bin/mail
if [ ! -x "$MONITORING_NOTIFY" ] && [ ! -x "$MAIL" ]; then
    printf '%s\n' "monitoring-notify and mail not available" >&2
    exit 1
fi

send_notification() {
    subject=$1

    if [ -x "$MONITORING_NOTIFY" ]; then
        $MONITORING_NOTIFY -t <%= @mail_to_shell %> -r <%= @audit_mail_from_shell %> "$subject"
    else
        $MAIL -s "$subject" -r <%= @audit_mail_from_shell %> <%= @mail_to_shell %>
    fi
}

# Try to get aureport
AUDIT_OUTPUT=$($AUREPORTTOOL -k -ts yesterday 00:00:00 -te yesterday 23:59:59 2>&1)

# Try to check if we have boot records since yesterday.
YESTERDAY=$($DATE --date="yesterday" +"%Y-%m-%d")
TODAY=$($DATE +"%Y-%m-%d")
BOOT_OUTPUT=$($JOURNALCTL --quiet --list-boots | $GREP "$YESTERDAY" | $GREP "$TODAY")

# Check if we have valid report
if ! printf '%s\n' "$AUDIT_OUTPUT" | $GREP -q 'no events of interest were found'; then
    # Check what for logs we have
    if printf '%s\n' "$AUDIT_OUTPUT" | $GREP -qi 'error'; then
        if [ -n "$BOOT_OUTPUT" ]; then
            SUBJECT='Server has boot logs and audit report with ERROR'
            AUDIT_OUTPUT="Boot logs:\n$BOOT_OUTPUT\n$AUDIT_OUTPUT"
        else
            SUBJECT='Audit report with ERROR'
        fi
    elif printf '%s\n' "$AUDIT_OUTPUT" | $GREP -qi 'susp_activity'; then
        if [ -n "$BOOT_OUTPUT" ]; then
            SUBJECT='Server has boot logs and audit report with suspicious activity'
            AUDIT_OUTPUT="Boot logs:\n$BOOT_OUTPUT\n$AUDIT_OUTPUT"
        else
            SUBJECT='Audit report with suspicious activity'
        fi
    elif [ -n "$BOOT_OUTPUT" ]; then
        SUBJECT='Server has boot logs and audit report'
        AUDIT_OUTPUT="Boot logs:\n$BOOT_OUTPUT\n$AUDIT_OUTPUT"
    else
        SUBJECT='Audit report'
    fi
    printf 'Server: %s\n\n%b\n' <%= @server_fdqn_shell %> "$AUDIT_OUTPUT" | send_notification "$SUBJECT"
elif [ -n "$BOOT_OUTPUT" ]; then
    printf 'Server: %s\n\nBoot logs:\n%b\n' <%= @server_fdqn_shell %> "$BOOT_OUTPUT" | send_notification "Server has boot logs"
fi
