#!/bin/sh
# Managed by puppet

<%= scope.function_template(['basic_settings/monitoring/_output']) %>

# Fail helper
die() {
    monitor_error 'systemd timer check cannot run: ' "$*" ' | last_run_age=U exit_code=U'
    exit 3
}

# These checks inspect systemd concepts; other init systems are not applicable (Nagios UNKNOWN).
[ -d /run/systemd/system ] || die "not applicable: systemd is not running"

# Parse command output independently of the host locale.
LC_ALL=C
export LC_ALL

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null || true)
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
TAIL=$(command -v tail 2>/dev/null) || die "tail not available"

# Window and log caps keep timer diagnosis bounded for monitoring output.
WINDOW=${WINDOW:-600} # seconds to scan logs after the timer trigger (default 10m)
LOG_WINDOW=${LOG_WINDOW:-} # optional trailing journal interval in seconds
LOG_WINDOW_SET=${LOG_WINDOW:+true} # distinguish an omitted interval from an explicitly empty CLI value
LOG_LINES=${LOG_LINES:-20} # max journal lines to print below the summary
MAXLOG=${MAXLOG:-1000} # max characters per journal line in long output
DETAIL_LIMIT=${DETAIL_LIMIT:-6000} # max characters before Interpretation

# The timer target is read from the running manager after argument validation.
USAGE_TEXT="Usage: $0 [-l chars] [-n lines] [-t seconds] [-w seconds] [-m chars_per_line] <timer>
Environment: DETAIL_LIMIT (-l, default 6000); LOG_LINES (-n, default 20); WINDOW (-t, default 600); MAXLOG (-m, default 1000); LOG_WINDOW (-w, optional).
WINDOW selects the forward journal interval from the last timer trigger.
LOG_WINDOW selects a positive integer interval from now minus that many seconds through now, without clipping to the last trigger. It overrides journal selection only; WINDOW retains its meaning when LOG_WINDOW is omitted.
Journal entries are diagnostic context; current target service properties determine status. Output limits and the agent timeout do not expand with the lookback.
Journal display omits the header hostname and one leading ISO date/time from the message; the journal timestamp remains at second precision.
Recognized message prefixes use YYYY-MM-DD, optionally followed by T or a space and HH[:MM[:SS[.fraction]]], or time-only HH:MM[:SS[.fraction]].
Fractions also accept a comma; times accept Z or +/-HH:MM or +/-HHMM; matching square brackets are allowed. Invalid prefixes and timestamp-only messages remain intact.
A completed successful execution with exit status zero is OK. Concrete service failures are CRITICAL, including timeout or signal failures with exit status zero.
An observed running main process (including an activating oneshot) is WARNING: service execution in progress; result pending. Long tasks can keep warning; no allowed-runtime policy is implied.
Missing or invalid results and inconsistent observations are UNKNOWN. exit_code is U without a valid final result; last_run_age measures the timer trigger, not service completion.
Status sampling uses at most three timer/service pairs, without sleeps. OpenITCOCKPIT controls the maximum execution time and terminates the check.
Matching samples reduce races but do not make timer and service reads atomic.
Standalone use requires a running systemd manager, POSIX shell, awk, GNU date, sed and tail; journalctl is optional diagnostic context.
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':l:n:t:w:m:h' opt; do
    case "$opt" in
        l) DETAIL_LIMIT=$OPTARG ;;
        n) LOG_LINES=$OPTARG ;;
        t) WINDOW=$OPTARG ;;
        w)
            LOG_WINDOW=$OPTARG
            LOG_WINDOW_SET=true
            ;;
        m) MAXLOG=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 1 ] || die "$USAGE_TEXT"
TIMER_UNIT=$1

# Read named properties once per unit, preserving empty values and rejecting incomplete/duplicate fields.
# PROPERTIES is canonical name=value output; READ_ERROR describes an unreadable snapshot.
read_properties() {
    property_unit=$1
    property_names=$2
    READ_ERROR=''
    set --
    for property_name in $property_names; do
        set -- "$@" -p "$property_name"
    done
    PROPERTIES=$($SYSTEMCTL show "$property_unit" --all --no-pager "$@" 2>/dev/null) || {
        READ_ERROR="$property_unit status query failed"
        return 1
    }
    PROPERTIES=$(printf '%s\n' "$PROPERTIES" | $AWK -v names="$property_names" '
        BEGIN { count=split(names, fields, " "); for (i=1; i<=count; i++) wanted[fields[i]]=1 }
        {
            separator=index($0, "=")
            name=substr($0, 1, separator-1)
            if (!separator || !wanted[name] || seen[name]++) { bad=1; next }
            values[name]=substr($0, separator+1)
        }
        END {
            for (i=1; i<=count; i++)
                if (!seen[fields[i]] && fields[i] != "StatusText" && values["LoadState"] != "not-found") bad=1
            if (bad) exit 1
            for (i=1; i<=count; i++) print fields[i] "=" values[fields[i]]
        }
    ') || {
        READ_ERROR="$property_unit status properties missing, duplicated or malformed"
        return 1
    }
}

# Validate non-negative manager integers before shell comparisons; reject overflow as unreadable data.
valid_number() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 0 ] 2>/dev/null
}

# Validate diagnostic output limits before journal text is rendered.
case "$LOG_LINES" in
    ''|*[!0-9]*) die "LOG_LINES must be numeric" ;;
esac
case "$MAXLOG" in
    ''|*[!0-9]*) die "MAXLOG must be numeric" ;;
esac
case "$WINDOW" in
    ''|*[!0-9]*) die "WINDOW must be numeric" ;;
esac
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "DETAIL_LIMIT must be numeric" ;;
esac
[ "$LOG_LINES" -ge 1 ] || die "LOG_LINES must be at least 1"
[ "$MAXLOG" -ge 1 ] || die "MAXLOG must be at least 1"
[ "$WINDOW" -ge 1 ] || die "WINDOW must be at least 1"
[ "$DETAIL_LIMIT" -ge 1 ] || die "DETAIL_LIMIT must be at least 1"
if [ "$LOG_WINDOW_SET" = true ]; then
    case "$LOG_WINDOW" in
        ''|*[!0-9]*) die "LOG_WINDOW must be a positive integer" ;;
    esac
    # Treat digit-only input as decimal rather than shell arithmetic's octal notation.
    LOG_WINDOW=$(printf '%s\n' "$LOG_WINDOW" | $SED 's/^0*//')
    [ "$LOG_WINDOW" -ge 1 ] 2>/dev/null || die "LOG_WINDOW must be a positive integer"
fi

# Require two matching timer/service observations; retry changes at most twice without waiting.
# Invocation, process timestamps and the timer trigger distinguish executions, even in the same second.
PREVIOUS_SNAPSHOT=''
CHECK_STATUS=3
CHECK_MESSAGE='timer/service observations remain inconsistent after three samples'
EXIT_CODE=U
for SAMPLE in 1 2 3; do
    read_properties "$TIMER_UNIT" 'LoadState ActiveState Unit LastTriggerUSec LastTriggerUSecMonotonic' || die "$READ_ERROR"
    TIMER_SNAPSHOT=$PROPERTIES
    while IFS='=' read -r PROPERTY VALUE; do
        case "$PROPERTY" in
            LoadState) TIMER_LOAD=$VALUE ;;
            ActiveState) TIMER_ACTIVE=$VALUE ;;
            Unit) SERVICE_UNIT=$VALUE ;;
            LastTriggerUSec) LAST_RUN_TEXT=$VALUE ;;
            LastTriggerUSecMonotonic) LAST_TRIGGER_MONOTONIC=$VALUE ;;
        esac
    done <<EOF
$PROPERTIES
EOF
    # Preserve the existing missing/inactive timer policy before inspecting its target.
    if [ "$TIMER_LOAD" = not-found ]; then
        monitor_result "${TIMER_UNIT} does not exist" "last_run_age=U exit_code=U"
        exit 2
    fi
    case "$TIMER_LOAD" in
        loaded|stub|masked|error|bad-setting|merged) : ;;
        *) die "timer LoadState unavailable or invalid" ;;
    esac
    case "$TIMER_ACTIVE" in
        active) : ;;
        inactive|failed|activating|deactivating)
            monitor_result "${TIMER_UNIT} is not active (${TIMER_ACTIVE})" "last_run_age=U exit_code=U"
            exit 2
            ;;
        *) die "timer ActiveState unavailable or invalid" ;;
    esac
    [ -n "$SERVICE_UNIT" ] || die "timer target unavailable"
    # systemctl formats this timer property as a duration; compare it verbatim, not as an integer.
    [ -n "$LAST_TRIGGER_MONOTONIC" ] || die "timer LastTriggerUSecMonotonic unavailable"
    # An active timer without a trigger still has the existing first-run warning.
    if [ -z "$LAST_RUN_TEXT" ] || [ "$LAST_RUN_TEXT" = 0 ]; then
        monitor_result "${TIMER_UNIT} has never been triggered" "last_run_age=U exit_code=U"
        exit 1
    fi

    read_properties "$SERVICE_UNIT" 'LoadState ActiveState SubState Type Result ExecMainCode ExecMainStatus MainPID InvocationID ExecMainStartTimestampMonotonic ExecMainExitTimestampMonotonic StatusText' || die "$READ_ERROR"
    while IFS='=' read -r PROPERTY VALUE; do
        case "$PROPERTY" in
            LoadState) SERVICE_LOAD=$VALUE ;;
            ActiveState) SERVICE_ACTIVE=$VALUE ;;
            SubState) SERVICE_SUB=$VALUE ;;
            Type) SERVICE_TYPE=$VALUE ;;
            Result) RESULT=$VALUE ;;
            ExecMainCode) MAIN_CODE=$VALUE ;;
            ExecMainStatus) MAIN_STATUS=$VALUE ;;
            MainPID) MAIN_PID=$VALUE ;;
            InvocationID) INVOCATION_ID=$VALUE ;;
            ExecMainStartTimestampMonotonic) MAIN_START=$VALUE ;;
            ExecMainExitTimestampMonotonic) MAIN_EXIT=$VALUE ;;
            StatusText) STATUS_TEXT=$VALUE ;;
        esac
    done <<EOF
$PROPERTIES
EOF
    # A missing required target is a concrete fault, even without service-specific properties.
    if [ "$SERVICE_LOAD" = not-found ]; then
        CHECK_STATUS=2
        CHECK_MESSAGE='timer target does not exist'
        break
    fi
    [ "$SERVICE_LOAD" = loaded ] || die "$SERVICE_UNIT LoadState unavailable or not loaded"
    case "$SERVICE_ACTIVE" in
        active|inactive|failed|activating|deactivating|reloading|refreshing|maintenance) : ;;
        *) die "$SERVICE_UNIT ActiveState invalid" ;;
    esac
    case "$SERVICE_SUB" in
        ''|*[!a-z-]*) die "$SERVICE_UNIT SubState invalid" ;;
    esac
    case "$SERVICE_TYPE" in
        simple|exec|forking|oneshot|dbus|notify|notify-reload|idle) : ;;
        *) die "$SERVICE_UNIT Type invalid" ;;
    esac
    case "$RESULT" in
        ''|success|unknown|n/a|resources|protocol|timeout|exit-code|signal|core-dump|watchdog|start-limit-hit|oom-kill|exec-condition) : ;;
        *) die "$SERVICE_UNIT Result invalid" ;;
    esac
    case "$MAIN_CODE" in
        0|1|2|3) : ;;
        *) die "$SERVICE_UNIT ExecMainCode invalid" ;;
    esac
    valid_number "$MAIN_STATUS" && [ "$MAIN_STATUS" -le 255 ] || die "$SERVICE_UNIT ExecMainStatus invalid"
    valid_number "$MAIN_PID" || die "$SERVICE_UNIT MainPID invalid"
    valid_number "$MAIN_START" || die "$SERVICE_UNIT ExecMainStartTimestampMonotonic invalid"
    valid_number "$MAIN_EXIT" || die "$SERVICE_UNIT ExecMainExitTimestampMonotonic invalid"
    case "$INVOCATION_ID" in
        '') : ;; # Inactive units can have no invocation ID; timestamps still identify their last process.
        *[!0-9a-f]*) die "$SERVICE_UNIT InvocationID invalid" ;;
        *) [ "${#INVOCATION_ID}" -eq 32 ] || die "$SERVICE_UNIT InvocationID invalid" ;;
    esac

    # Only a stopped main process in a final service state supplies exit-code perfdata.
    FINAL_RESULT=false
    EXIT_CODE=U
    case "$SERVICE_ACTIVE/$SERVICE_SUB" in
        inactive/dead|failed/failed|active/exited)
            # A final state alone does not establish that a main process has completed.
            if [ "$MAIN_PID" -eq 0 ] && [ "$MAIN_CODE" -ne 0 ] &&
                [ "$MAIN_START" -gt 0 ] && [ "$MAIN_EXIT" -ge "$MAIN_START" ]; then
                FINAL_RESULT=true
                case "$RESULT" in
                    ''|unknown|n/a) : ;;
                    *) EXIT_CODE=$MAIN_STATUS ;;
                esac
            fi
            ;;
    esac

    # Concrete failures take precedence over an in-progress or changing service state.
    SERVICE_FAILED=false
    case "$RESULT" in
        ''|success|unknown|n/a) : ;;
        *) SERVICE_FAILED=true ;;
    esac
    if [ "$SERVICE_FAILED" = true ] || [ "$SERVICE_ACTIVE" = failed ] ||
        [ "$MAIN_CODE" -eq 2 ] || [ "$MAIN_CODE" -eq 3 ] || [ "$MAIN_STATUS" -ne 0 ]; then
        CHECK_STATUS=2
        CHECK_MESSAGE="${RESULT:-result unavailable} with exit $MAIN_STATUS, code $MAIN_CODE, state $SERVICE_ACTIVE/$SERVICE_SUB, status ${STATUS_TEXT:-unknown}"
        break
    fi

    # Require matching execution observations; StatusText can change independently and is excluded.
    SNAPSHOT=$(printf '%s\n' "$TIMER_SNAPSHOT" "$SERVICE_LOAD" "$SERVICE_ACTIVE" "$SERVICE_SUB" "$SERVICE_TYPE" "$RESULT" "$MAIN_CODE" "$MAIN_STATUS" "$MAIN_PID" "$INVOCATION_ID" "$MAIN_START" "$MAIN_EXIT")
    if [ "$SNAPSHOT" = "$PREVIOUS_SNAPSHOT" ]; then
        # Success requires normal process termination and a successful service result together.
        if [ "$FINAL_RESULT" = true ] && [ "$RESULT" = success ] && [ "$MAIN_CODE" -eq 1 ]; then
            CHECK_STATUS=0
            CHECK_MESSAGE="successful (${STATUS_TEXT:-unknown})"
        else
            # A live PID with an unfinished main-process timestamp also covers activating oneshots.
            CHECK_MESSAGE="no completed execution result and no running main process established (state $SERVICE_ACTIVE/$SERVICE_SUB)"
            if [ "$MAIN_PID" -gt 0 ] && [ "$MAIN_START" -gt 0 ] && [ "$MAIN_EXIT" -lt "$MAIN_START" ]; then
                case "$SERVICE_ACTIVE/$SERVICE_SUB" in
                    active/running|reloading/*|refreshing/*|activating/start|activating/start-post|deactivating/*)
                        CHECK_STATUS=1
                        CHECK_MESSAGE='service execution in progress; result pending'
                        ;;
                esac
            elif [ "$FINAL_RESULT" = true ]; then
                CHECK_MESSAGE='completed main process but service Result unavailable'
            fi
        fi
        break
    fi
    PREVIOUS_SNAPSHOT=$SNAPSHOT
    # An unstable final-looking snapshot must not publish an exit code as a settled result.
    EXIT_CODE=U
done

# Convert systemd's timestamp into epoch seconds for age and journal range calculations.
LAST_RUN_TS=$($DATE -d "$LAST_RUN_TEXT" +%s 2>/dev/null || true)
NOW_TS=$($DATE +%s)
[ -n "${LAST_RUN_TS:-}" ] || {
    monitor_result "${TIMER_UNIT} last run could not be parsed" "last_run_age=U exit_code=U"
    exit 3
}

LAST_RUN_AGE=$((NOW_TS - LAST_RUN_TS))
if [ "$LOG_WINDOW_SET" = true ]; then
    SINCE_TS=$((NOW_TS - LOG_WINDOW))
    UNTIL_TS=$NOW_TS
    JOURNAL_SOURCE="$SERVICE_UNIT; trailing window $LOG_WINDOW s; @${SINCE_TS} through @${UNTIL_TS}"
    JOURNAL_CONTEXT='the trailing interval'
else
    SINCE_TS=$LAST_RUN_TS
    UNTIL_TS=$((LAST_RUN_TS + WINDOW))
    JOURNAL_SOURCE="$SERVICE_UNIT; trigger $LAST_RUN_TEXT; window $WINDOW s"
    JOURNAL_CONTEXT='the last trigger window'
fi

# Read the target service journal within the selected diagnostic interval.
JOURNAL_RAW=""
if [ -n "$JOURNALCTL" ]; then
    JOURNAL_RAW=$($JOURNALCTL -u "$SERVICE_UNIT" --since "@${SINCE_TS}" --until "@${UNTIL_TS}" -o short-iso --no-pager 2>/dev/null || true)
fi

# Render journal for long output with a predictable line cap.
JOURNAL_LINE_COUNT=$(printf '%s\n' "$JOURNAL_RAW" | $SED '/^$/d' | $SED -n '$=')
case "$JOURNAL_LINE_COUNT" in
    ''|*[!0-9]*) JOURNAL_LINE_COUNT=0 ;;
esac

monitor_section "Service journal"
if [ "$JOURNAL_LINE_COUNT" -gt 0 ]; then
    monitor_item "Source: $JOURNAL_SOURCE"
    if [ "$JOURNAL_LINE_COUNT" -gt "$LOG_LINES" ]; then
        monitor_item "Selection: latest $LOG_LINES lines; $((JOURNAL_LINE_COUNT - LOG_LINES)) older lines omitted."
    fi
    monitor_log_items "$(printf '%s\n' "$JOURNAL_RAW" | $TAIL -n "$LOG_LINES" | monitor_compact_journal)" "$MAXLOG"
fi
if [ -n "${LONG_OUTPUT:-}" ] || [ "$CHECK_STATUS" -ne 0 ]; then
    monitor_limit "$DETAIL_LIMIT"
    monitor_section "Interpretation"
    monitor_item "Current properties of the timer target decide the exit code; journal lines are bounded context from $JOURNAL_CONTEXT."
    monitor_item "An in-progress execution has no final result and warns until completion; active state alone does not prove a running process. Inspect the named service when a failure or missing result persists."
fi

# Perfdata exposes trigger age and only a validated, settled main-process exit status.
PERFDATA="last_run_age=${LAST_RUN_AGE}s exit_code=${EXIT_CODE}"
if [ "$CHECK_STATUS" -ne 0 ]; then
    monitor_prepend 'Timer findings' "$SERVICE_UNIT: $CHECK_MESSAGE; last trigger $LAST_RUN_TEXT" 'Inspect the target service state and journal around the timer trigger.'
fi
monitor_result "$SERVICE_UNIT $CHECK_MESSAGE; last run: $LAST_RUN_TEXT" "$PERFDATA"
exit "$CHECK_STATUS"
