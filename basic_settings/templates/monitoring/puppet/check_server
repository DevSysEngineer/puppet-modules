#!/bin/sh
# Managed by puppet

<%= scope.function_template(['basic_settings/monitoring/_output']) %>

# Observe local CA files and store-report metadata; never invoke an agent run, CA API or private key.
# Requires Debian/Ubuntu coreutils, findutils, util-linux, procps, mawk, sed, openssl and the installed Puppet CLI.
# Report mtimes approximate receipt, not catalog requests; copied reports can change this approximation.
# Snapshot records contain only certname and the greatest observed epoch, with framing to detect interrupted files.
# Exit priority: CRITICAL > UNKNOWN > WARNING > OK. Unreliable metrics are omitted, never replaced by zero.
die() {
    monitor_error 'Puppet Server: ' "$1; check the local monitoring configuration" ' |'
    if [ "$#" -ge 2 ]; then
        LONG_OUTPUT=''
        monitor_section 'Invocation'
        monitor_items "$2"
        monitor_section 'Interpretation'
        monitor_item 'Inspection is incomplete; no unmeasured totals are reported.'
        printf '%s\n' "$LONG_OUTPUT"
    fi
    exit 3
}

# Discover tools directly; timeout bounds external inspections against one shared execution deadline.
AWK=$(command -v awk 2>/dev/null) || die 'awk unavailable'
CAT=$(command -v cat 2>/dev/null) || die 'cat unavailable'
DATE=$(command -v date 2>/dev/null) || die 'date unavailable'
FIND=$(command -v find 2>/dev/null) || die 'find unavailable'
FLOCK=$(command -v flock 2>/dev/null) || die 'flock unavailable'
ID=$(command -v id 2>/dev/null) || die 'id unavailable'
MKTEMP=$(command -v mktemp 2>/dev/null) || die 'mktemp unavailable'
MV=$(command -v mv 2>/dev/null) || die 'mv unavailable'
OPENSSL=$(command -v openssl 2>/dev/null) || die 'openssl unavailable'
PS=$(command -v ps 2>/dev/null) || die 'ps unavailable'
RM=$(command -v rm 2>/dev/null) || die 'rm unavailable'
SED=$(command -v sed 2>/dev/null) || die 'sed unavailable'
SORT=$(command -v sort 2>/dev/null) || die 'sort unavailable'
STAT=$(command -v stat 2>/dev/null) || die 'stat unavailable'
TIMEOUT=$(command -v timeout 2>/dev/null) || die 'timeout unavailable'

# CLI overrides non-empty environment values; only this executable owns monitoring defaults.
PUPPET_BIN=${PUPPET_BIN:-}
PUPPET_CONFDIR=${PUPPET_CONFDIR:-}
PUPPET_VARDIR=${PUPPET_VARDIR:-}
SERVER_SERVICE=${SERVER_SERVICE:-}
SERVER_PACKAGE=${SERVER_PACKAGE:-}
STATE_DIR=${STATE_DIR:-<%= @state_dir %>}
STALE_SECONDS=${STALE_SECONDS:-86400}
CERT_WARNING_DAYS=${CERT_WARNING_DAYS:-30}
CERT_CRITICAL_DAYS=${CERT_CRITICAL_DAYS:-14}
CRL_WARNING_SECONDS=${CRL_WARNING_SECONDS:-86400}
OUTPUT_LIMIT=${OUTPUT_LIMIT:-3500}
CHECK_TIMEOUT=${CHECK_TIMEOUT:-80}
LC_ALL=C
export LC_ALL
umask 077
STATUS=0
PRIORITY=0
SUMMARY='daemon, certificates and stored reports are healthy'
INCOMPLETE=0
INVENTORY_OK=1
ACTIVITY_OK=1
CA_OK=1
CRL_OK=1
CA_DAYS_LEFT=''
NODES_TOTAL=0
CERTS_EXPIRING=0
CERTS_EXPIRED=0
REVOKED=0
WORK=''

# Paths describe the server layout, not alternative copies of its CA/report configuration.
USAGE_TEXT="Usage: $0 -p puppet -d confdir -v server_vardir -s service -k package [-S state_dir] [-a seconds] [-w days] [-c days] [-r seconds] [-l bytes] [-t seconds]
Required environment equivalents: PUPPET_BIN (-p), PUPPET_CONFDIR (-d), PUPPET_VARDIR (-v), SERVER_SERVICE (-s), SERVER_PACKAGE (-k).
Optional: STATE_DIR (-S, <%= @state_dir %>), STALE_SECONDS (-a, 86400), CERT_WARNING_DAYS (-w, 30), CERT_CRITICAL_DAYS (-c, 14), CRL_WARNING_SECONDS (-r, 86400), OUTPUT_LIMIT (-l, 3500), CHECK_TIMEOUT (-t, 80).
CLI wins; repeated options use the last value. Empty environment values use defaults; explicit empty options are invalid.
Run as root; monitoring_custom manages the root-owned 0700 state directory. Explicit -S/STATE_DIR overrides must exist with those permissions. Output limit >= 2000 bytes; timeout 1..80 seconds. Help exits UNKNOWN."
OPTERR=0
while getopts ':p:d:v:s:k:S:a:w:c:r:l:t:h' opt; do
    case "$opt" in
        p) PUPPET_BIN=$OPTARG ;;
        d) PUPPET_CONFDIR=$OPTARG ;;
        v) PUPPET_VARDIR=$OPTARG ;;
        s) SERVER_SERVICE=$OPTARG ;;
        k) SERVER_PACKAGE=$OPTARG ;;
        S) STATE_DIR=$OPTARG ;;
        a) STALE_SECONDS=$OPTARG ;;
        w) CERT_WARNING_DAYS=$OPTARG ;;
        c) CERT_CRITICAL_DAYS=$OPTARG ;;
        r) CRL_WARNING_SECONDS=$OPTARG ;;
        l) OUTPUT_LIMIT=$OPTARG ;;
        t) CHECK_TIMEOUT=$OPTARG ;;
        *) die 'check invocation requires valid options' "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die 'unexpected positional arguments' "$USAGE_TEXT"

# Record every incomplete inspection, while preserving already established failures.
issue() {
    case "$1" in
        2) issue_priority=3 ;;
        3) issue_priority=2; INCOMPLETE=1 ;;
        1) issue_priority=1 ;;
        *) return ;;
    esac
    issue_text=$(monitor_summary "$2")
    printf '%s\t%s\t%s\n' "$issue_priority" "$issue_text" "${ISSUE_SCOPE:-source}" >> "$WORK/issues"
    if [ "$issue_priority" -gt "$PRIORITY" ]; then
        PRIORITY=$issue_priority
        STATUS=$1
        SUMMARY=$issue_text
    fi
}

# Every expensive subprocess gets the remaining total budget, including termination grace within the executor's 90s.
run() {
    run_left=$((DEADLINE - $($DATE +%s)))
    [ "$run_left" -gt 0 ] || return 124
    $TIMEOUT -k 1 "$run_left" "$@"
}

# Reject ambiguous line-oriented paths before using them as data or options; no shell evaluation is used.
absolute_path() {
    case "$1" in
        /*) ;;
        *) return 1 ;;
    esac
    case "$1" in
        *[!a-zA-Z0-9_./-]*|*/../*|*/..|*/./*|/) return 1 ;;
    esac
}

certname_valid() {
    case "$1" in
        ''|.|..|*[!a-zA-Z0-9_.-]*) return 1 ;;
    esac
}

# OpenSSL consumes PEM files; split bundles without ever reading or accepting private-key material.
split_pem() {
    run $AWK -v kind="$2" -v directory="$3" '
        $0 == "-----BEGIN " kind "-----" {
            if (inside) exit 1
            inside=1; count++; file=directory "/" count ".pem"
        }
        inside { print > file }
        $0 == "-----END " kind "-----" { if (!inside) exit 1; close(file); inside=0; next }
        !inside && $0 !~ /^[[:space:]]*$/ { exit 1 }
        END { if (inside || !count) exit 1 }
    ' "$1"
}

# Shared fields are refreshed for every certificate; malformed data cannot inherit a previous certificate's identity.
certificate_fields() {
    cert_fields=$(run $OPENSSL x509 -in "$1" -noout -subject -issuer -serial -dates -fingerprint -sha256 -nameopt RFC2253 2>/dev/null) || return 1
    CERT_SUBJECT=$(printf '%s\n' "$cert_fields" | $SED -n 's/^subject=//p')
    CERT_ISSUER=$(printf '%s\n' "$cert_fields" | $SED -n 's/^issuer=//p')
    CERT_SERIAL=$(printf '%s\n' "$cert_fields" | $SED -n 's/^serial=//p')
    CERT_START=$(printf '%s\n' "$cert_fields" | $SED -n 's/^notBefore=//p')
    CERT_END=$(printf '%s\n' "$cert_fields" | $SED -n 's/^notAfter=//p')
    CERT_FINGERPRINT=$(printf '%s\n' "$cert_fields" | $SED -n 's/^[sS][hH][aA]256 Fingerprint=//p')
    CERT_BEGIN=$(run $DATE -d "$CERT_START" +%s 2>/dev/null) || return 1
    CERT_UNTIL=$(run $DATE -d "$CERT_END" +%s 2>/dev/null) || return 1
    CERT_LEFT=$((CERT_UNTIL - NOW))
    CERT_DAYS=$((CERT_LEFT / 86400))
    [ "$CERT_LEFT" -ge 0 ] || CERT_DAYS=$(((CERT_LEFT - 86399) / 86400))
    [ -n "$CERT_SERIAL" ] && [ -n "$CERT_SUBJECT" ] && [ -n "$CERT_FINGERPRINT" ]
}

certificate_expiry() {
    CERT_STATE='valid'
    if [ "$CERT_BEGIN" -gt "$NOW" ]; then
        CERT_STATE='not yet valid'
        issue 2 "$1 is not yet valid; check certificate issuance and the server clock"
    elif [ "$CERT_LEFT" -le 0 ]; then
        CERT_STATE='expired'
        issue 2 "$1 has expired; renew its certificate"
    elif [ "$CERT_LEFT" -le "$((CERT_CRITICAL_DAYS * 86400))" ]; then
        CERT_STATE='renewal urgent'
        issue 2 "$1 expires soon; renew its certificate urgently"
    elif [ "$CERT_LEFT" -le "$((CERT_WARNING_DAYS * 86400))" ]; then
        CERT_STATE='expiry approaching'
        issue 1 "$1 expires soon; schedule certificate renewal"
    fi
}

# Validate signatures separately from time/revocation so an expired signed agent remains in the active inventory.
verify_signature() {
    # -trusted excludes all default system stores, including OpenSSL 3 CAstore.
    run $OPENSSL verify -trusted "$WORK/root.pem" -untrusted "$WORK/chain.pem" \
        -no_check_time -check_ss_sig "$1" > "$WORK/verify" 2>&1
    verify_result=$?
    case "$verify_result" in
        0) return 0 ;;
        2) return 2 ;;
        *) return 3 ;;
    esac
}

# Match issuer and serial, never serial alone (different CAs can issue the same serial).
is_revoked() {
    MATCH_ISSUER="$CERT_ISSUER" $AWK -F '\t' -v serial="$CERT_SERIAL" '
        $1 == ENVIRON["MATCH_ISSUER"] && $2 == serial { found=1 } END { exit !found }
    ' "$WORK/revoked"
}

# Render complete records under one total byte budget, reserving the final interpretation and omission notice.
emit_result() {
    PERF=''
    if [ "$INVENTORY_OK" -eq 1 ]; then
        PERF="nodes_total=$NODES_TOTAL"
        if [ "$ACTIVITY_OK" -eq 1 ]; then
            PERF="$PERF nodes_today=$NODES_TODAY nodes_stale=$NODES_STALE"
        fi
        PERF="$PERF certs_expiring=$CERTS_EXPIRING"
    fi
    [ -z "$CA_DAYS_LEFT" ] || PERF="$PERF ca_days_left=$CA_DAYS_LEFT"
    $SORT -s -t "$TAB" -k1,1nr "$WORK/issues" > "$WORK/issues.sorted"
    $SORT -s -t "$TAB" -k1,1n -k2,2 "$WORK/agents" > "$WORK/agents.sorted"
    DISPLAY_SUMMARY=$(monitor_text_limit "$SUMMARY" "$((OUTPUT_LIMIT / 4))")
    LONG_OUTPUT=''
    monitor_section 'Interpretation'
    monitor_item 'Check-in means a stored report (mtime), not every connection. Snapshot retains observed times after cleanup; pre-installation history cannot be recovered.'
    monitor_item 'Certificate notBefore approximates issuance for the 24h first-report grace. Check reporting, scheduling and connectivity on the named agents.'
    [ "$INCOMPLETE" -eq 0 ] || monitor_item 'Inspection incomplete: repair the named sources/permissions and rerun; omitted metrics are unknown.'
    ENDING=$LONG_OUTPUT
    LONG_OUTPUT=''; MONITOR_ACTIVE_TOPIC=''
    # Keep the primary cause/action and interpretation outside the record-selection budget.
    if [ "$STATUS" -ne 0 ]; then
        monitor_section 'Server findings'
        monitor_item "$DISPLAY_SUMMARY"
        monitor_item 'Inspect the named source, service journal or agent report before rerunning.'
    fi
    LEADING=$LONG_OUTPUT
    LONG_OUTPUT=''; MONITOR_ACTIVE_TOPIC=''
    monitor_section 'Server findings'
    monitor_items "$(MAIN_CAUSE="$SUMMARY" $AWK -F '\t' '$3 == "source" && $2 != ENVIRON["MAIN_CAUSE"] {print $2}' "$WORK/issues.sorted")"
    monitor_section 'Puppet Server'
    monitor_item "Service: $SERVER_SERVICE; source: $DAEMON_SOURCE; state: $DAEMON_STATE"
    monitor_section 'CA and CRL'
    monitor_records "$($CAT "$WORK/ca-details")"
    monitor_section 'Certificates'
    if [ "$INVENTORY_OK" -eq 1 ]; then
        monitor_item "Active agents: $NODES_TOTAL; expired: $CERTS_EXPIRED; expiring: $CERTS_EXPIRING; revoked and excluded: $REVOKED"
    else
        monitor_item 'Active inventory unavailable; no current agent totals published.'
    fi
    monitor_records "$($CAT "$WORK/cert-details")"
    monitor_section 'Agents missing reports'
    monitor_items "$($AWK -F '\t' '{print $3}' "$WORK/agents.sorted")"
    monitor_section 'Agent overview'
    if [ "$INVENTORY_OK" -eq 1 ] && [ "$ACTIVITY_OK" -eq 1 ]; then
        monitor_item "Total: $NODES_TOTAL; today: $NODES_TODAY; stale: $NODES_STALE; never seen: $NEVER_SEEN"
        monitor_item "Local day: $DAY_START_TEXT to $NOW_TEXT"
    else
        monitor_item 'Agent activity incomplete; inspect the source/state errors above.'
    fi
    HEAD="Puppet Server: $DISPLAY_SUMMARY | ${PERF# }"
    RECORD_BUDGET=$((OUTPUT_LIMIT - ${#HEAD} - ${#LEADING} - ${#ENDING} - 7))
    monitor_limit "$RECORD_BUDGET"
    BODY=$LONG_OUTPUT
    LONG_OUTPUT=$LEADING
    monitor_append "$BODY"
    monitor_append "$ENDING"
    monitor_result "Puppet Server: $DISPLAY_SUMMARY" "${PERF# }"

}

# Only decimal integers in bounded ranges enter shell arithmetic.
for VALUE in "$STALE_SECONDS" "$CERT_WARNING_DAYS" "$CERT_CRITICAL_DAYS" "$CRL_WARNING_SECONDS" "$OUTPUT_LIMIT" "$CHECK_TIMEOUT"; do
    case "$VALUE" in
        ''|*[!0-9]*|0[0-9]*|??????????*) die 'numeric options require decimal integers without leading zeroes (at most nine digits)' ;;
    esac
done
[ "$STALE_SECONDS" -gt 0 ] || die 'stale window must be positive'
[ "$CERT_WARNING_DAYS" -ge "$CERT_CRITICAL_DAYS" ] || die 'certificate warning days must be at least critical days'
[ "$OUTPUT_LIMIT" -ge 2000 ] || die 'output limit must be at least 2000 bytes'
[ "$CHECK_TIMEOUT" -ge 1 ] && [ "$CHECK_TIMEOUT" -le 80 ] || die 'timeout must be 1..80 seconds'
for VALUE in "$PUPPET_BIN" "$PUPPET_CONFDIR" "$PUPPET_VARDIR" "$STATE_DIR"; do
    absolute_path "$VALUE" || die 'required paths must be absolute and contain only letters, digits, slash, dot, underscore or hyphen'
done
certname_valid "$SERVER_SERVICE" || die 'invalid or missing server service'
case "$SERVER_PACKAGE" in
    puppetserver|openvox-server) ;;
    *) die 'unsupported server package; this check requires Puppet Server or OpenVox Server' ;;
esac
[ -x "$PUPPET_BIN" ] || die 'Puppet CLI is not executable'
[ "$($ID -u)" = 0 ] || die 'root execution is required for the private CA/report directories and monitoring state'
# Directory ownership belongs to monitoring_custom; the check owns only the files inside it.
[ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] && [ "$($STAT -c '%u:%a' "$STATE_DIR" 2>/dev/null)" = 0:700 ] || die 'state directory must exist, be root-owned 0700 and not a symlink'
NOW=$($DATE +%s) || die 'cannot read clock'
DEADLINE=$((NOW + CHECK_TIMEOUT))
TAB=$(printf '\t')

# flock releases the lock after signals or agent restarts; never unlink its inode while another check may be waiting.
[ ! -L "$STATE_DIR/lock" ] || die 'state lock must not be a symlink'
if [ -e "$STATE_DIR/lock" ]; then
    [ -f "$STATE_DIR/lock" ] && [ "$($STAT -c '%u:%a:%h' "$STATE_DIR/lock" 2>/dev/null)" = 0:600:1 ] || die 'existing state lock must be a private regular file'
fi
# command keeps an exec redirection failure recoverable in dash instead of aborting with exit 2.
{ command exec 9> "$STATE_DIR/lock"; } 2>/dev/null || die 'state directory is not writable'
$FLOCK -n 9 || die 'another check is inspecting this state directory; retry after it finishes'
WORK=$($MKTEMP -d "$STATE_DIR/run.XXXXXXXX") || die 'cannot create private working directory'
trap '$RM -rf -- "$WORK"' 0
trap 'exit 3' HUP INT TERM
for PART in issues agents ca-details cert-details active revoked ca-index observed; do
    : > "$WORK/$PART" || die 'cannot prepare inspection files'
done

# This check explicitly supports non-systemd hosts; only call the shared inspector after runtime detection.
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
DAEMON_SOURCE=ps
DAEMON_STATE=unknown
if use_systemd; then
    DAEMON_SOURCE=systemd
    # The shared inspector discovers systemctl; bound that command through the common deadline.
    SYSTEMCTL=$(command -v systemctl 2>/dev/null || true)
    if [ -n "$SYSTEMCTL" ]; then
        systemctl() { run "$SYSTEMCTL" "$@"; }
        systemd_service_status "$SERVER_SERVICE"
        DAEMON_RESULT=$?
        DAEMON_STATE=${SERVICE_ACTIVE_STATE:-unknown}
        [ "$DAEMON_RESULT" -eq 0 ] || issue "$DAEMON_RESULT" "$SERVICE_CONTEXT; inspect the service journal"
    else
        issue 3 'systemd is active but systemctl is unavailable; restore the inspection tool'
    fi
elif run $PS -e -o stat= -o comm= -o args= > "$WORK/processes" 2>/dev/null; then
    # JVM identity AND the Puppet Server main class/JAR are required; wrappers, agents and zombies do not qualify.
    if $AWK '$1 !~ /^Z/ && ($2 == "java" || $2 ~ /\/java$/) {
        for (i=3; i<=NF; i++) {
            if ($i == "clojure.main" && $(i+1) == "-m" && $(i+2) == "puppetlabs.trapperkeeper.main") main=1
            if ($i ~ /(^|\/)(puppetserver|puppet-server)([^\/ ]*)\.jar($|:)/) jar=1
            if ($i == "-jar" && $(i+1) ~ /(^|\/)puppetserver\.jar$/) main=1
        }
        if (main && jar) found=1
        main=jar=0
    } END { exit !found }' "$WORK/processes"; then
        DAEMON_STATE=running
    else
        DAEMON_STATE=absent
        issue 2 "$SERVER_SERVICE daemon is absent; inspect the server startup logs"
    fi
else
    issue 3 'process information is unavailable; check process visibility and timeout'
fi

# Read only explicitly selected settings, never config print all (which can expose credentials).
if run "$PUPPET_BIN" config print cacert cacrl signeddir hostcert certname reportdir reports report \
    --section server --confdir "$PUPPET_CONFDIR" --vardir "$PUPPET_VARDIR" > "$WORK/config" 2>/dev/null; then
    CACERT=$($SED -n 's/^cacert = //p' "$WORK/config")
    CACRL=$($SED -n 's/^cacrl = //p' "$WORK/config")
    SIGNEDDIR=$($SED -n 's/^signeddir = //p' "$WORK/config")
    HOSTCERT=$($SED -n 's/^hostcert = //p' "$WORK/config")
    CERTNAME=$($SED -n 's/^certname = //p' "$WORK/config")
    REPORTDIR=$($SED -n 's/^reportdir = //p' "$WORK/config")
    REPORTS=$($SED -n 's/^reports = //p' "$WORK/config")
    REPORT=$($SED -n 's/^report = //p' "$WORK/config")
    for VALUE in "$CACERT" "$CACRL" "$SIGNEDDIR" "$HOSTCERT"; do
        if ! absolute_path "$VALUE"; then
            CA_OK=0
            issue 3 'effective Puppet paths are missing or unsupported; inspect server configuration'
            break
        fi
    done
    if ! absolute_path "$REPORTDIR"; then
        ACTIVITY_OK=0
        issue 3 'effective reportdir is missing or unsupported; inspect server configuration'
    fi
    if ! certname_valid "$CERTNAME"; then
        CA_OK=0
        issue 3 'server certname is missing or unsupported; inspect Puppet configuration'
    fi
else
    CA_OK=0
    ACTIVITY_OK=0
    issue 3 'effective Puppet configuration could not be read; check CLI, server paths and timeout'
fi

# Root plus intermediate bundles are supported; ambiguous roots or incomplete CRL chains remain unknown.
if [ "$CA_OK" -eq 1 ]; then
    CA_DIR=$($MKTEMP -d "$WORK/ca.XXXXXXXX")
    CRL_DIR=$($MKTEMP -d "$WORK/crl.XXXXXXXX")
    if [ -f "$CACERT" ] && [ -r "$CACERT" ] && split_pem "$CACERT" CERTIFICATE "$CA_DIR"; then
        : > "$WORK/chain.pem"
        ROOTS=0
        for CERT in "$CA_DIR"/*.pem; do
            if certificate_fields "$CERT"; then
                if [ "$CERT_SUBJECT" = "$CERT_ISSUER" ]; then
                    ROOTS=$((ROOTS + 1))
                    $CAT "$CERT" > "$WORK/root.pem"
                fi
                $CAT "$CERT" >> "$WORK/chain.pem"
                printf '%s\t%s\t%s\n' "$CERT_SUBJECT" "$CERT" "$CERT_FINGERPRINT" >> "$WORK/ca-index"
            else
                CA_OK=0
                issue 3 'CA certificate cannot be decoded; inspect its file and permissions'
            fi
        done
        if [ "$ROOTS" -ne 1 ]; then
            CA_OK=0
            issue 3 'unsupported CA topology: exactly one local root is required; provide the complete CA chain'
        fi
    else
        CA_OK=0
        issue 3 'local CA bundle is unavailable or malformed; external CA needs a reliable local inspection source'
    fi
fi
if [ "$CA_OK" -eq 1 ]; then
    for CERT in "$CA_DIR"/*.pem; do
        if ! certificate_fields "$CERT"; then
            CA_OK=0
            CA_DAYS_LEFT=''
            issue 3 'CA inspection became incomplete; check files and execution timeout'
            break
        fi
        certificate_expiry "CA $CERT_SUBJECT"
        if [ -z "$CA_DAYS_LEFT" ] || [ "$CERT_DAYS" -lt "$CA_DAYS_LEFT" ]; then
            CA_DAYS_LEFT=$CERT_DAYS
        fi
        verify_signature "$CERT"
        VERIFY_RESULT=$?
        CA_VERIFICATION=verified
        if [ "$VERIFY_RESULT" -ne 0 ]; then
            CA_OK=0
            CA_VERIFICATION='failed or incomplete'
            issue "$VERIFY_RESULT" "CA $CERT_SUBJECT chain/signature verification failed or could not finish; inspect the CA chain and timeout"
        fi
        if run $OPENSSL x509 -in "$CERT" -noout -ext basicConstraints,keyUsage > "$WORK/constraints" 2>/dev/null; then
            if ! $AWK '/CA:TRUE/ {ca=1} END {exit !ca}' "$WORK/constraints"; then
                CA_OK=0
                CA_VERIFICATION='not a CA certificate'
                issue 2 "$CERT_SUBJECT is not a CA certificate; repair the configured CA bundle"
            fi
            if ! $AWK '/X509v3 Key Usage:/ {restricted=1} /CRL Sign/ {allowed=1} END {exit restricted && !allowed}' "$WORK/constraints"; then
                CA_OK=0
                CA_VERIFICATION='CRL signing not permitted'
                issue 2 "$CERT_SUBJECT does not permit CRL signing; repair the CA certificate usage"
            fi
        else
            CA_OK=0
            issue 3 'CA constraints could not be inspected; check OpenSSL and timeout'
        fi
        printf '%s\n' "- Subject: $(monitor_summary "$CERT_SUBJECT"); issuer: $(monitor_summary "$CERT_ISSUER"); serial: $CERT_SERIAL" \
            "  SHA256 fingerprint: $CERT_FINGERPRINT" \
            "  Valid from: $CERT_START; until: $CERT_END; validity: $(((CERT_UNTIL - CERT_BEGIN) / 86400)) days; days left: $CERT_DAYS; chain/signature: $CA_VERIFICATION; $CERT_STATE" >> "$WORK/ca-details"
    done
fi
if [ "$CA_OK" -eq 1 ] && [ -f "$CACRL" ] && [ -r "$CACRL" ] && split_pem "$CACRL" 'X509 CRL' "$CRL_DIR"; then
    : > "$WORK/crl-issuers"
    for CRL in "$CRL_DIR"/*.pem; do
        CRL_FIELDS=$(run $OPENSSL crl -in "$CRL" -noout -issuer -lastupdate -nextupdate -nameopt RFC2253 2>/dev/null)
        if [ "$?" -ne 0 ]; then
            CRL_OK=0
            issue 3 'full CA CRL cannot be decoded; inspect the CRL file'
            continue
        fi
        CRL_ISSUER=$(printf '%s\n' "$CRL_FIELDS" | $SED -n 's/^issuer=//p')
        CRL_START=$(printf '%s\n' "$CRL_FIELDS" | $SED -n 's/^lastUpdate=//p')
        CRL_END=$(printf '%s\n' "$CRL_FIELDS" | $SED -n 's/^nextUpdate=//p')
        CRL_BEGIN=$(run $DATE -d "$CRL_START" +%s 2>/dev/null)
        CRL_UNTIL=$(run $DATE -d "$CRL_END" +%s 2>/dev/null)
        CRL_SIGNER=$(MATCH_ISSUER="$CRL_ISSUER" $AWK -F '\t' '$1 == ENVIRON["MATCH_ISSUER"] {print $2}' "$WORK/ca-index")
        if [ -z "$CRL_BEGIN" ] || [ -z "$CRL_UNTIL" ] || [ ! -f "$CRL_SIGNER" ]; then
            CRL_OK=0
            issue 3 'CRL issuer or validity cannot be established; provide the complete CA and CRL chain'
            continue
        fi
        CRL_STATE='signature verified'
        run $OPENSSL crl -in "$CRL" -noout -verify -CAfile "$CRL_SIGNER" > "$WORK/verify" 2>&1
        VERIFY_RESULT=$?
        if [ "$VERIFY_RESULT" -eq 124 ] || [ "$VERIFY_RESULT" -eq 137 ]; then
            CRL_OK=0
            CRL_STATE='verification timed out'
            issue 3 "CRL from $CRL_ISSUER could not be verified within the time budget; inspect runtime load"
        elif [ "$VERIFY_RESULT" -ne 0 ]; then
            CRL_OK=0
            CRL_STATE='invalid signature'
            issue 2 "CRL from $CRL_ISSUER has an invalid signature; repair the full CA CRL"
        elif [ "$CRL_UNTIL" -le "$NOW" ] || [ "$CRL_BEGIN" -gt "$NOW" ]; then
            CRL_OK=0
            CRL_STATE='expired or not yet valid'
            issue 2 "CRL from $CRL_ISSUER is outside its validity period; refresh the CRL and check the clock"
        elif [ "$((CRL_UNTIL - NOW))" -le "$CRL_WARNING_SECONDS" ]; then
            issue 1 "CRL from $CRL_ISSUER expires soon; check CRL renewal"
        fi
        printf '%s\n' "- CRL issuer: $(monitor_summary "$CRL_ISSUER"); thisUpdate: $CRL_START; nextUpdate: $CRL_END; $CRL_STATE" >> "$WORK/ca-details"
        printf '%s\n' "$CRL_ISSUER" >> "$WORK/crl-issuers"
        if run $OPENSSL crl -in "$CRL" -noout -text > "$WORK/crl-text" 2>/dev/null; then
            if $AWK '/Delta CRL Indicator|Issuing Distribution Point/ {unsupported=1} END {exit !unsupported}' "$WORK/crl-text"; then
                CRL_OK=0
                issue 3 'delta or scoped/indirect CRLs are unsupported; provide the complete direct CA CRLs'
            else
                MATCH_ISSUER="$CRL_ISSUER" $AWK '/Serial Number:/ {print ENVIRON["MATCH_ISSUER"] "\t" $3}' "$WORK/crl-text" >> "$WORK/revoked"
            fi
        else
            CRL_OK=0
            issue 3 'revocations could not be read; check CRL permissions and timeout'
        fi
    done
    while IFS="$TAB" read -r SUBJECT CERT FINGERPRINT; do
        if ! MATCH_ISSUER="$SUBJECT" $AWK '$0 == ENVIRON["MATCH_ISSUER"] {n++} END {exit n != 1}' "$WORK/crl-issuers"; then
            CRL_OK=0
            issue 3 "CA $SUBJECT has no unique full CRL; provide all relevant CRLs"
        fi
    done < "$WORK/ca-index"
else
    CRL_OK=0
    issue 3 'full local CA CRL is unavailable; do not substitute an infrastructure-only CRL'
fi

# Check intermediate revocation after reading the full signed CRLs.
if [ "$CA_OK" -eq 1 ] && [ "$CRL_OK" -eq 1 ]; then
    for CERT in "$CA_DIR"/*.pem; do
        if ! certificate_fields "$CERT"; then
            CA_OK=0
            issue 3 'CA revocation inspection became incomplete; check files and execution timeout'
        elif is_revoked; then
            issue 2 "CA $CERT_SUBJECT is revoked; repair the certificate chain"
            printf '%s\n' "- CA $(monitor_summary "$CERT_SUBJECT"): revoked; serial: $CERT_SERIAL; notAfter: $CERT_END" >> "$WORK/ca-details"
            CA_OK=0
        fi
    done
fi

# Inventory enumeration must succeed completely before publishing totals or pruning any snapshot record.
if [ "$CA_OK" -eq 1 ] && [ "$CRL_OK" -eq 1 ] && [ -d "$SIGNEDDIR" ] && [ -r "$SIGNEDDIR" ] && \
    run $FIND -H "$SIGNEDDIR" -mindepth 1 -maxdepth 1 -name '*.pem' -printf '%f\n' > "$WORK/signed" 2>/dev/null; then
    # The host certificate is inspected independently and excluded by identity, even if also present in signeddir.
    printf '%s\n' "$HOSTCERT" > "$WORK/certificates"
    while IFS= read -r BASENAME; do
        NAME=${BASENAME%.pem}
        if certname_valid "$NAME"; then
            [ "$NAME" = "$CERTNAME" ] || printf '%s/%s\n' "$SIGNEDDIR" "$BASENAME" >> "$WORK/certificates"
        else
            INVENTORY_OK=0
            issue 3 'signed certificate filename is unsupported; inspect the CA inventory'
        fi
    done < "$WORK/signed"
    ISSUE_SCOPE=certificate
    while IFS= read -r CERT; do
        if [ "$($DATE +%s)" -ge "$DEADLINE" ]; then
            INVENTORY_OK=0
            ISSUE_SCOPE=source
            issue 3 'certificate inventory did not finish within the time budget; inspect runtime load'
            break
        fi
        if [ "$CERT" = "$HOSTCERT" ]; then
            NAME=$CERTNAME
            ROLE=server
        else
            NAME=${CERT##*/}
            NAME=${NAME%.pem}
            ROLE=agent
        fi
        if [ ! -f "$CERT" ] || [ ! -r "$CERT" ] || ! certificate_fields "$CERT"; then
            INVENTORY_OK=0
            issue 3 "$NAME certificate is unreadable or malformed; inspect the certificate file"
            printf '%s\n' "- $NAME ($ROLE): unreadable or malformed; certificate details unavailable" >> "$WORK/cert-details"
            continue
        fi
        if $AWK -F '\t' -v fingerprint="$CERT_FINGERPRINT" '$3 == fingerprint {found=1} END {exit !found}' "$WORK/ca-index"; then
            continue
        fi
        CERT_STATE='valid'
        verify_signature "$CERT"
        VERIFY_RESULT=$?
        if [ "$VERIFY_RESULT" -ne 0 ]; then
            CERT_STATE='chain/signature invalid or unverified'
            issue "$VERIFY_RESULT" "$NAME certificate verification failed or could not finish; inspect CA issuance and timeout"
            [ "$VERIFY_RESULT" -ne 3 ] || INVENTORY_OK=0
        fi
        if [ "$VERIFY_RESULT" -eq 0 ] && is_revoked; then
            if [ "$ROLE" = agent ]; then
                REVOKED=$((REVOKED + 1))
                continue
            fi
            CERT_STATE='revoked'
            issue 2 "$NAME server certificate is revoked; replace it through the CA administrator"
        fi
        if [ "$ROLE" = agent ]; then
            NODES_TOTAL=$((NODES_TOTAL + 1))
            printf '%s\t%s\n' "$NAME" "$CERT_BEGIN" >> "$WORK/active"
            [ "$CERT_LEFT" -gt 0 ] || CERTS_EXPIRED=$((CERTS_EXPIRED + 1))
            if [ "$CERT_LEFT" -gt 0 ] && [ "$CERT_LEFT" -le "$((CERT_WARNING_DAYS * 86400))" ]; then
                CERTS_EXPIRING=$((CERTS_EXPIRING + 1))
            fi
        fi
        SAVED_STATE=$CERT_STATE
        certificate_expiry "$NAME"
        [ "$SAVED_STATE" = valid ] || CERT_STATE=$SAVED_STATE
        if [ "$CERT_SUBJECT" != "CN=$NAME" ]; then
            CERT_STATE='identity mismatch or unsupported subject'
            issue 3 "$NAME certificate identity cannot be matched to its report directory; inspect its subject"
            INVENTORY_OK=0
        fi
        if [ "$CERT_STATE" != valid ] || [ "$ROLE" = server ]; then
            CERT_DETAIL="- $NAME ($ROLE): $CERT_STATE; serial: $CERT_SERIAL; issuer: $(monitor_summary "$CERT_ISSUER"); notAfter: $CERT_END; days left: $CERT_DAYS"
            if [ "$ROLE" = server ]; then
                CERT_DETAIL="$CERT_DETAIL; notBefore: $CERT_START"
            fi
            [ "$CERT_STATE" != valid ] || CERT_DETAIL="$CERT_DETAIL; chain/signature verified; not revoked"
            printf '%s\n' "$CERT_DETAIL" >> "$WORK/cert-details"
        fi
    done < "$WORK/certificates"
    ISSUE_SCOPE=source
else
    INVENTORY_OK=0
    issue 3 'active CA inventory cannot be established; inspect local signed certificates and the full CRL'
fi

# A valid snapshot has a version header and a matching final count; duplicates, future times and truncation are errors.
STATE_FILE="$STATE_DIR/last_seen"
: > "$WORK/previous"
if [ -e "$STATE_FILE" ] || [ -L "$STATE_FILE" ]; then
    if [ -f "$STATE_FILE" ] && [ ! -L "$STATE_FILE" ] && [ "$($STAT -c '%u:%a:%h' "$STATE_FILE" 2>/dev/null)" = 0:600:1 ] && \
        $AWK -F '\t' -v now="$NOW" '
            NR==1 {if ($0 != "# check_puppetserver v1") bad=1; next}
            /^# records [0-9]+$/ {if (end) bad=1; end=1; split($0,a," "); expected=a[3]; next}
            {if (end || NF!=2 || $1 !~ /^[a-zA-Z0-9_.-]+$/ || $1=="." || $1==".." || $2 !~ /^[1-9][0-9]*$/ || $2>now || seen[$1]++) bad=1; print; count++}
            END {exit bad || !end || count!=expected}
        ' "$STATE_FILE" > "$WORK/previous"; then
        :
    else
        ACTIVITY_OK=0
        issue 3 'last-seen snapshot is unreadable, unsafe or incomplete; repair it without inventing historical times'
    fi
fi

# One metadata traversal covers all nodes; no YAML deserialization or repeated scan per certificate is needed.
if [ "$ACTIVITY_OK" -eq 1 ]; then
    if [ "$REPORT" = true ] && printf '%s\n' "$REPORTS" | $AWK -F ',' '{for(i=1;i<=NF;i++){gsub(/[[:space:]]/,"",$i);if($i=="store") found=1}} END {exit !found}'; then
        if [ -d "$REPORTDIR" ] && [ -r "$REPORTDIR" ] && run $FIND -H "$REPORTDIR" -ignore_readdir_race \
            -mindepth 1 -maxdepth 2 -printf '%y\t%P\t%T@\t%s\n' ! -readable -printf 'unreadable\n' > "$WORK/report-files" 2>/dev/null && \
            $AWK -F '\t' -v now="$NOW" '
                $1=="d" && $2 ~ /^[a-zA-Z0-9_.-]+$/ {next}
                $1=="f" && NF==4 {
                    if ($2 !~ /\.yaml$/) next
                    n=split($2,p,"/"); stamp=p[2]; sub(/\.yaml$/, "", stamp)
                    if (n==2 && p[1] ~ /^[a-zA-Z0-9_.-]+$/ && p[2] ~ /\.yaml$/ && stamp ~ /^[0-9]+$/ && length(stamp)==12 && $4>0 && $3>0 && int($3)<=now) {
                        t=int($3); if(t>latest[p[1]]) latest[p[1]]=t; next
                    }
                }
                {bad=1}
                END {for(node in latest) printf "%s\t%.0f\n",node,latest[node]; exit bad}
            ' "$WORK/report-files" > "$WORK/observed"; then
            :
        else
            ACTIVITY_OK=0
            issue 3 'reportdir is unreadable or contains unsupported report metadata; inspect store reporting and file permissions'
        fi
    else
        ACTIVITY_OK=0
        issue 3 'reporting or the store report processor is disabled; enable server report storage and agent reporting'
    fi
fi

# Merge only observed times and only after a complete live inventory; a failed scan never prunes state.
if [ "$INVENTORY_OK" -eq 1 ] && [ "$ACTIVITY_OK" -eq 1 ]; then
    if $AWK -F '\t' 'FILENAME==ARGV[1] {active[$1]=1;next} $1 in active && $2>last[$1] {last[$1]=$2}
        END {for(node in last) printf "%s\t%.0f\n",node,last[node]}' "$WORK/active" "$WORK/previous" "$WORK/observed" > "$WORK/merged.unsorted" && \
        $SORT "$WORK/merged.unsorted" > "$WORK/merged" && \
        RECORDS=$($AWK 'END {print NR+0}' "$WORK/merged") && \
        { printf '# check_puppetserver v1\n' && $CAT "$WORK/merged" && printf '# records %s\n' "$RECORDS"; } > "$WORK/last_seen" && \
        $MV -f -- "$WORK/last_seen" "$STATE_FILE"; then
        :
    else
        ACTIVITY_OK=0
        issue 3 'last-seen snapshot could not be replaced atomically; repair state-directory access'
    fi
fi

if [ "$INVENTORY_OK" -eq 1 ] && [ "$ACTIVITY_OK" -eq 1 ]; then
    DAY_START=$($DATE -d "$($DATE -d "@$NOW" '+%F') 00:00:00" +%s)
    DAY_START_TEXT=$($DATE -d "@$DAY_START" '+%F %T %Z (%z)')
    NOW_TEXT=$($DATE -d "@$NOW" '+%F %T %Z (%z)')
    $AWK -F '\t' 'FILENAME==ARGV[1] {last[$1]=$2;next} {printf "%s\t%s\t%.0f\n",$1,$2,last[$1]}' \
        "$WORK/merged" "$WORK/active" | $SORT -t "$TAB" -k3,3n -k1,1 > "$WORK/activity"
    NODES_TODAY=0
    NODES_STALE=0
    NEVER_SEEN=0
    ISSUE_SCOPE=agent
    while IFS="$TAB" read -r NAME ISSUED LAST; do
        if [ "$LAST" -eq 0 ]; then
            NEVER_SEEN=$((NEVER_SEEN + 1))
            AGE=$((NOW - ISSUED))
            AGE_TEXT="$((AGE / 3600))h $(((AGE % 3600) / 60))m"
            if [ "$AGE" -lt 0 ]; then
                ACTIVITY_OK=0
                AGE_TEXT=unknown
                issue 3 "$NAME has never reported and its certificate age is unknown; check future notBefore and the clock"
                REASON='future notBefore; no first-report grace can be established'
            elif [ "$AGE" -gt 86400 ]; then
                NODES_STALE=$((NODES_STALE + 1))
                issue 1 "$NAME has never reported; check agent reporting, scheduling and connectivity"
                REASON='first-report grace exceeded'
            else
                REASON='within first-report grace (notBefore approximation)'
            fi
            DETAIL="$NAME: never reported; certificate age $AGE_TEXT; $REASON; check agent reporting"
        else
            AGE=$((NOW - LAST))
            [ "$LAST" -lt "$DAY_START" ] || NODES_TODAY=$((NODES_TODAY + 1))
            if [ "$AGE" -le "$STALE_SECONDS" ]; then
                continue
            fi
            NODES_STALE=$((NODES_STALE + 1))
            issue 1 "$NAME is missing a recent stored report; check agent scheduling and connectivity"
            LAST_TEXT=$($DATE -d "@$LAST" '+%F %T %Z (%z)')
            DETAIL="$NAME: last report $LAST_TEXT; age $((AGE / 3600))h $(((AGE % 3600) / 60))m; stale; check the agent run"
        fi
        printf '%s\t%s\t%s\n' "$LAST" "$NAME" "$DETAIL" >> "$WORK/agents"
    done < "$WORK/activity"
    ISSUE_SCOPE=source
fi
if [ "$($DATE +%s)" -ge "$DEADLINE" ]; then
    issue 3 'inspection time budget exhausted; inspect runtime load and the configured check timeout'
fi
if ! emit_result; then
    printf 'Puppet Server: output could not be completed; inspect the monitoring filesystem |\nInterpretation:\n- Inspection is incomplete.\n'
    [ "$STATUS" -eq 2 ] || STATUS=3
fi
exit "$STATUS"
