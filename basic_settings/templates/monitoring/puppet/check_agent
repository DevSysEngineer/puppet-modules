#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'Puppet check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
<% if @systemd_enable -%>
SYSTEMDCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null) || die "journalctl not available"
TAIL=$(command -v tail 2>/dev/null) || die "tail not available"
<% end -%>
PS=$(command -v ps 2>/dev/null) || die "ps not available"

# Last-run age thresholds decide when stale Puppet runs become WARNING or CRITICAL.
CRIT_AGE=3600 # 60 minutes (your preference: >1h = critical)
WARN_AGE=2700 # 45 minutes

# Runtime status and last-run fields are derived from Puppet's lastrun summary.
EXITCODE_STATE=0 # 0=OK, 1=WARNING, 2=CRITICAL
LAST_RUN_AGE=U
LAST_RUN_HUMAN="unknown"
STATUS_DETAIL="no changes"

# Journal long output is bounded by Puppet's own last-run timestamp, runtime metric, fallback input, and emitted line count.
JOURNAL_JOINED=""
LOG_LINES=${LOG_LINES:-20}
LOG_SCAN_LINES=${LOG_SCAN_LINES:-100}
RUN_JOURNAL_START_GRACE=${RUN_JOURNAL_START_GRACE:-30}
RUN_JOURNAL_END_GRACE=${RUN_JOURNAL_END_GRACE:-120}
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}

# CLI options tune last-run age thresholds without changing the managed check registration.
USAGE_TEXT="Usage: $0 [-w warn_seconds] [-c crit_seconds]"
OPTERR=0
while getopts "w:c:" opt; do
    case "$opt" in
        w) WARN_AGE="$OPTARG" ;;
        c) CRIT_AGE="$OPTARG" ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
for numeric_value in "$WARN_AGE" "$CRIT_AGE" "$LOG_LINES" "$LOG_SCAN_LINES" "$RUN_JOURNAL_START_GRACE" "$RUN_JOURNAL_END_GRACE"; do
    case "$numeric_value" in
        ''|*[!0-9]*) die "age thresholds, log limits, and journal grace values must be numeric" ;;
    esac
done
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$CRIT_AGE" -ge "$WARN_AGE" ] || die "critical age must be greater than or equal to warning age"
[ "$LOG_LINES" -ge 1 ] || die "LOG_LINES must be at least 1"
[ "$LOG_SCAN_LINES" -ge 1 ] || die "LOG_SCAN_LINES must be at least 1"
[ "$RUN_JOURNAL_START_GRACE" -ge 0 ] || die "RUN_JOURNAL_START_GRACE must be zero or greater"
[ "$RUN_JOURNAL_END_GRACE" -ge 0 ] || die "RUN_JOURNAL_END_GRACE must be zero or greater"
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

# Emit the summary line and optional long output.
emit_check() {
    # $1 = summary/status line, $2 = perfdata
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$JOURNAL_JOINED" ]; then
        monitor_text_value "$JOURNAL_JOINED"
    fi
}

# Nagios treats raw pipes after the first output line as perfdata separators.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Bound journal details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_text_details() {
    $AWK -v max="$DETAIL_LIMIT" '
        {
            line = $0
            line_len = length(line)
            separator_len = printed ? 1 : 0
            if (used + separator_len + line_len <= max) {
                print line
                used += separator_len + line_len
                printed = 1
                next
            }
            remaining = max - used - separator_len
            if (remaining > 0) {
                print substr(line, 1, remaining) "... [detail truncated]"
            }
            print "Long output details truncated after " max " characters to keep Interpretation visible."
            exit
        }
    '
}

# Emit a direct CRITICAL result and stop immediately.
crit() {
    printf '%s\n' "$(monitor_text_value "Puppet $*")"
    exit 2
}

# Keep only Puppet-tagged journal lines plus relevant systemd unit messages.
filter_puppet_journal() {
    printf '%s\n' "$1" | $AWK '
        NF == 0 { next }
        {
            ident = $3

            if (ident ~ /^puppet([-.[:alnum:]_]+)?(\[[0-9]+\])?:$/) {
                print
                next
            }

            if (ident ~ /^systemd\[[0-9]+\]:$/ && index($0, "puppet.service") > 0) {
                print
            }
        }
    '
}

# Verify the Puppet service before reading state files generated by the agent.
<% if @systemd_enable -%>
$SYSTEMDCTL is-active --quiet "puppet.service" || crit "service is not active"
<% else -%>
$PS -C puppet >/dev/null 2>&1 || crit "service is not active"
<% end -%>

# Resolve Puppet's state locations from the installed agent rather than hard-coding distro paths.
STATEDIR="$(<%= @agent_bin_dir %>/puppet config print statedir 2>/dev/null)"   || die "could not determine puppet statedir"
PUBLICDIR="$(<%= @agent_bin_dir %>/puppet config print publicdir 2>/dev/null)" || PUBLICDIR=""
LOCKFILE="${STATEDIR}/agent_disabled.lock"

# An administrative disable lock is a direct CRITICAL cause because no new catalogs will apply.
if [ -f "$LOCKFILE" ]; then
    # Try to extract the disabled message from the JSON lock file for operator context.
    DISABLE_MSG=$($SED -n 's/.*"disabled_message"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p' "$LOCKFILE")
    [ -z "$DISABLE_MSG" ] && DISABLE_MSG="no message"
    printf '%s\n' "$(monitor_text_value "Puppet agent disabled: $DISABLE_MSG")"
    exit 2
fi

# Locate last_run_summary.yaml across Puppet versions and publicdir fallbacks.
SUMMARY_FILE="$(<%= @agent_bin_dir %>/puppet config print lastrunfile 2>/dev/null)"
[ -z "$SUMMARY_FILE" ] && SUMMARY_FILE="${STATEDIR}/last_run_summary.yaml"
if [ ! -f "$SUMMARY_FILE" ]; then
    if [ -n "$PUBLICDIR" ] && [ -f "${PUBLICDIR}/last_run_summary.yaml" ]; then
        SUMMARY_FILE="${PUBLICDIR}/last_run_summary.yaml"
    elif [ -f "${STATEDIR}/last_run_summary.yaml" ]; then
        SUMMARY_FILE="${STATEDIR}/last_run_summary.yaml"
    fi
fi
if [ ! -f "$SUMMARY_FILE" ]; then
    die "summary file not found"
fi

# Parse the small Puppet summary YAML with AWK to avoid adding a YAML dependency to the check.
PARSED="$($AWK 'BEGIN{
        OFS="|";
        sect=""; last=""; rc=rf=rt=rs=es=ef=0; tt=0; cr=0
    }
    # top-level last_run
    /^[[:space:]]*last_run:[[:space:]]*/ && sect=="" { gsub(/[^0-9]/,"",$2); last=$2; next }
    # section switches
    /^resources:/ { sect="resources"; next }
    /^events:/    { sect="events";    next }
    /^time:/      { sect="time";      next }
    # leaving a section on new top-level key
    /^[^[:space:]]/ { sect=""; }
    # resources.*
    sect=="resources" && /[[:space:]]changed:/ { gsub(/[^0-9]/,"",$2); rc=$2; next }
    sect=="resources" && /[[:space:]]failed:/  { gsub(/[^0-9]/,"",$2); rf=$2; next }
    sect=="resources" && /[[:space:]]total:/   { gsub(/[^0-9]/,"",$2); rt=$2; next }
    sect=="resources" && /[[:space:]]skipped:/ { gsub(/[^0-9]/,"",$2); rs=$2; next }
    # events.*
    sect=="events" && /[[:space:]]successes:/  { gsub(/[^0-9]/,"",$2); es=$2; next }
    sect=="events" && /[[:space:]]failures:/   { gsub(/[^0-9]/,"",$2); ef=$2; next }
    # time.*
    sect=="time" && /[[:space:]]total:/        { tt=$2; next }
    sect=="time" && /[[:space:]]config_retrieval:/ { cr=$2; next }
    sect=="time" && /[[:space:]]last_run:/     { if (last=="") { gsub(/[^0-9]/,"",$2); last=$2 } next }
    END{ print last, rc, rf, rt, rs, es, ef, tt, cr }' "$SUMMARY_FILE"
)"

# Split the serialized AWK result into shell variables in one controlled IFS scope.
OLD_IFS=$IFS
IFS='|'
set -- $PARSED
IFS=$OLD_IFS
[ $# -lt 9 ] && die "failed to parse summary: $PARSED"

# Leave LAST_RUN_TS empty when Puppet omitted it so age becomes UNKNOWN-like perfdata.
LAST_RUN_TS=$1
RES_CHANGED=${2:-0}
RES_FAILED=${3:-0}
RES_TOTAL=${4:-0}
RES_SKIPPED=${5:-0}
EV_SUCC=${6:-0}
EV_FAIL=${7:-0}
TIME_TOTAL=${8:-0}
TIME_CONF_RETR=${9:-0}

# Derive totals
EV_TOTAL=$((EV_SUCC + EV_FAIL))

# Compute age and human-readable timestamp
if [ -n "$LAST_RUN_TS" ]; then
    NOW_TS=$($DATE +%s)
    LAST_RUN_AGE=$((NOW_TS - LAST_RUN_TS))
    LAST_RUN_HUMAN=$($DATE -d "@$LAST_RUN_TS" '+%F %T' 2>/dev/null)
    [ -z "$LAST_RUN_HUMAN" ] && LAST_RUN_HUMAN="$LAST_RUN_TS"
fi

# Resource/event failures are CRITICAL; stale successful runs follow the configured age thresholds.
[ "$RES_CHANGED" -gt 0 ] && STATUS_DETAIL="$RES_CHANGED change(s) applied"
if [ "$RES_FAILED" -gt 0 ] || [ "$EV_FAIL" -gt 0 ]; then
    STATUS_DETAIL="$STATUS_DETAIL, ${RES_FAILED} resource fail(s), ${EV_FAIL} event fail(s)"
    EXITCODE_STATE=2
fi

if [ "$LAST_RUN_AGE" != "U" ]; then
    if [ "$LAST_RUN_AGE" -ge "$CRIT_AGE" ]; then
        EXITCODE_STATE=2
        STATUS_DETAIL="$STATUS_DETAIL, last run ${LAST_RUN_AGE}s ago"
    elif [ "$LAST_RUN_AGE" -ge "$WARN_AGE" ] && [ "$EXITCODE_STATE" -eq 0 ]; then
        EXITCODE_STATE=1
        STATUS_DETAIL="$STATUS_DETAIL, last run ${LAST_RUN_AGE}s ago"
    fi
fi

# Recent Puppet-tagged journal lines provide bounded context for the same Puppet-timed last-run window below the summary.
<% if @systemd_enable -%>
JOURNAL_CONTEXT_LABEL="the last ${LOG_SCAN_LINES} unit log lines"
if [ -n "$LAST_RUN_TS" ]; then
    # Puppet reports last_run as the run completion time, so derive the start from the reported total runtime.
    RUN_JOURNAL_RUNTIME=$($AWK -v runtime="$TIME_TOTAL" 'BEGIN {
        runtime += 0
        seconds = int(runtime)
        if (runtime > seconds) {
            seconds += 1
        }
        if (seconds > 0) {
            print seconds
        } else {
            print 0
        }
    }')
    RUN_JOURNAL_START=$((LAST_RUN_TS - RUN_JOURNAL_RUNTIME - RUN_JOURNAL_START_GRACE))
    [ "$RUN_JOURNAL_START" -lt 0 ] && RUN_JOURNAL_START=0
    RUN_JOURNAL_END=$((LAST_RUN_TS + RUN_JOURNAL_END_GRACE))
    RUN_JOURNAL_SINCE=$($DATE -d "@$RUN_JOURNAL_START" '+%F %T' 2>/dev/null)
    RUN_JOURNAL_UNTIL=$($DATE -d "@$RUN_JOURNAL_END" '+%F %T' 2>/dev/null)
    if [ -n "$RUN_JOURNAL_SINCE" ] && [ -n "$RUN_JOURNAL_UNTIL" ]; then
        JOURNAL_RAW=$($JOURNALCTL --since "$RUN_JOURNAL_SINCE" --until "$RUN_JOURNAL_UNTIL" -o short-iso -u "puppet.service" --no-pager 2>/dev/null || true)
        JOURNAL_CONTEXT_LABEL="the last Puppet run window (${RUN_JOURNAL_SINCE} to ${RUN_JOURNAL_UNTIL}, ${RUN_JOURNAL_RUNTIME}s runtime from lastrun summary)"
    else
        JOURNAL_RAW=$($JOURNALCTL -n "$LOG_SCAN_LINES" -o short-iso -u "puppet.service" --no-pager 2>/dev/null || true)
    fi
else
    JOURNAL_RAW=$($JOURNALCTL -n "$LOG_SCAN_LINES" -o short-iso -u "puppet.service" --no-pager 2>/dev/null || true)
fi
JOURNAL_FILTERED=$(filter_puppet_journal "$JOURNAL_RAW")
JOURNAL_FILTERED_COUNT=$(printf '%s\n' "$JOURNAL_FILTERED" | $AWK 'NF { count++ } END { print count + 0 }')

if [ "$JOURNAL_FILTERED_COUNT" -gt 0 ]; then
    JOURNAL_TRUNCATED=0
    JOURNAL_OMITTED=0
    if [ "$JOURNAL_FILTERED_COUNT" -gt "$LOG_LINES" ]; then
        JOURNAL_OMITTED=$((JOURNAL_FILTERED_COUNT - LOG_LINES))
        JOURNAL_FILTERED=$(printf '%s\n' "$JOURNAL_FILTERED" | $TAIL -n "$LOG_LINES")
        JOURNAL_TRUNCATED=1
    fi

    JOURNAL_JOINED=$(
        {
            if [ "$JOURNAL_TRUNCATED" -eq 1 ]; then
                printf '%s\n' "- Showing last ${LOG_LINES} Puppet journal lines from ${JOURNAL_CONTEXT_LABEL}; ${JOURNAL_OMITTED} older line(s) omitted"
            else
                printf '%s\n' "- Showing Puppet journal lines from ${JOURNAL_CONTEXT_LABEL}"
            fi
            printf '%s\n' "$JOURNAL_FILTERED" | $SED '/^$/d; s/[[:space:]]\+$//; s/^/- /'
        }
    )
elif [ -n "$JOURNAL_RAW" ]; then
    JOURNAL_JOINED="- No Puppet-tagged journal lines found in ${JOURNAL_CONTEXT_LABEL}"
else
    JOURNAL_JOINED=""
fi
<% else -%>
JOURNAL_JOINED=""
<% end -%>

# Add interpretation after journal details when long output exists.
if [ -n "$JOURNAL_JOINED" ]; then
    JOURNAL_JOINED=$(
        {
            printf '%s\n' "$JOURNAL_JOINED" | limit_text_details
            printf '%s\n' ''
            printf '%s\n' 'Interpretation:'
            printf '%s\n' 'Puppet lastrun summary fields and last-run age decide the exit code; filtered journal lines are diagnostic context from the Puppet-timed last-run window.'
            printf '%s\n' 'Inspect the Puppet service, catalog errors, and the named lastrun summary file when the summary reports stale runs, failed resources, failed events, or a disabled agent.'
        }
    )
fi

# Build perfdata while keeping the unknown age sentinel unit-free.
AGE_METRIC="$LAST_RUN_AGE"
[ "$AGE_METRIC" != "U" ] && AGE_METRIC="${AGE_METRIC}s"

# Time metrics use seconds as UOM and stable labels.
TIME_TOTAL_METRIC="${TIME_TOTAL}s"
TIME_CONF_RETR_METRIC="${TIME_CONF_RETR}s"

# Perfdata exposes run age, resource/event totals, and agent timing.
PERF="last_run_age=${AGE_METRIC};${WARN_AGE};${CRIT_AGE};0"
PERF="$PERF resources_total=${RES_TOTAL}"
PERF="$PERF resources_changed=${RES_CHANGED}"
PERF="$PERF resources_failed=${RES_FAILED}"
PERF="$PERF resources_skipped=${RES_SKIPPED}"
PERF="$PERF events_successes=${EV_SUCC}"
PERF="$PERF events_failures=${EV_FAIL}"
PERF="$PERF events_total=${EV_TOTAL}"
PERF="$PERF time_total=${TIME_TOTAL_METRIC}"
PERF="$PERF time_config_retrieval=${TIME_CONF_RETR_METRIC}"

# Emit the final Nagios line; the exit code carries the machine-readable state.
case "$EXITCODE_STATE" in
  0) emit_check "Puppet is running (${STATUS_DETAIL}); last run: ${LAST_RUN_HUMAN}" "$PERF"; exit 0 ;;
  1) emit_check "Puppet last run is stale (${STATUS_DETAIL}); last run: ${LAST_RUN_HUMAN}" "$PERF"; exit 1 ;;
  *) emit_check "Puppet failed (${STATUS_DETAIL}); last run: ${LAST_RUN_HUMAN}" "$PERF"; exit 2 ;;
esac
