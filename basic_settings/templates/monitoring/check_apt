#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'APT check cannot run: %s\n' "$*"
    exit 3
}

<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
<% end -%>

# Binary checks
APTGET=$(command -v apt-get 2>/dev/null) || die "apt-get not available"
APTCACHE=$(command -v apt-cache 2>/dev/null) || die "apt-cache not available"
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
FIND=$(command -v find 2>/dev/null) || die "find not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
MKDIR=$(command -v mkdir 2>/dev/null) || die "mkdir not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
STAT=$(command -v stat 2>/dev/null) || die "stat not available"
SORT=$(command -v sort 2>/dev/null) || die "sort not available"
TIMEOUT=$(command -v timeout 2>/dev/null || true)
TR=$(command -v tr 2>/dev/null) || die "tr not available"
CHMOD=$(command -v chmod 2>/dev/null || true)

# Managed input files and cache locations used by the APT check.
BLACKLIST_FILE="<%= @apt_settings_file %>"
CHANGELOG_CACHE_DIR=/var/cache/check_apt/changelogs
CHANGELOG_FETCH_TIMEOUT=${CHANGELOG_FETCH_TIMEOUT:-6}
CHANGELOG_GROUP_LIMIT=${CHANGELOG_GROUP_LIMIT:-10}
CHANGELOG_TOTAL_BUDGET=${CHANGELOG_TOTAL_BUDGET:-20}
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
SECURITY_PACKAGE_SUMMARY_LIMIT=${SECURITY_PACKAGE_SUMMARY_LIMIT:-10}

# Long output is assembled in-memory and emitted only after the perfdata line.
LONG_OUTPUT=""
LONG_OUTPUT_LAST_BLANK=0
LONG_OUTPUT_SEP="__CHECK_APT_NL__"

# Update counters are parsed from the apt simulation output.
UPDATES_BLACKLISTED=0
UPDATES_TOTAL=0
UPDATES_SECURITY=0

# Metadata freshness uses both the apt periodic stamp and list-file mtimes.
TIMESTAMP_UNKNOWN=0
STAMP_FILE=/var/lib/apt/periodic/update-success-stamp
STAMP_TS=0
LISTS_TS=0
LAST_UPDATE_TIMESTAMP=""
LAST_UPDATE_SEC=0
LAST_UPDATE_AGE_SEC=0

# Final Nagios state and metadata-age threshold.
STATE_CODE=0 # 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN
GRACE=${GRACE:-172800} # 48h
CHECK_START=$($DATE +%s)

# CLI options tune metadata age, changelog collection and output limits for this invocation.
USAGE_TEXT="Usage: $0 [-c <seconds>] [-t seconds] [-g groups] [-b seconds] [-l chars] [-s packages]
Environment: GRACE (-c); CHANGELOG_FETCH_TIMEOUT (-t); CHANGELOG_GROUP_LIMIT (-g); CHANGELOG_TOTAL_BUDGET (-b); DETAIL_LIMIT (-l); SECURITY_PACKAGE_SUMMARY_LIMIT (-s).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ":c:t:g:b:l:s:h" opt; do
    case "$opt" in
        c) GRACE=$OPTARG ;;
        t) CHANGELOG_FETCH_TIMEOUT=$OPTARG ;;
        g) CHANGELOG_GROUP_LIMIT=$OPTARG ;;
        b) CHANGELOG_TOTAL_BUDGET=$OPTARG ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        s) SECURITY_PACKAGE_SUMMARY_LIMIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
case "$GRACE" in
    ''|*[!0-9]*) die "metadata-age grace period must be numeric" ;;
esac
case "$CHANGELOG_FETCH_TIMEOUT" in
    ''|*[!0-9]*) die "changelog fetch timeout must be numeric" ;;
esac
case "$CHANGELOG_GROUP_LIMIT" in
    ''|*[!0-9]*) die "changelog group limit must be numeric" ;;
esac
case "$CHANGELOG_TOTAL_BUDGET" in
    ''|*[!0-9]*) die "changelog runtime budget must be numeric" ;;
esac
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
case "$SECURITY_PACKAGE_SUMMARY_LIMIT" in
    ''|*[!0-9]*) die "security package summary limit must be numeric" ;;
esac
[ "$GRACE" -ge 1 ] || die "metadata-age grace period must be at least 1"
[ "$CHANGELOG_FETCH_TIMEOUT" -ge 1 ] || die "changelog fetch timeout must be at least 1"
[ "$CHANGELOG_GROUP_LIMIT" -ge 1 ] || die "changelog group limit must be at least 1"
[ "$CHANGELOG_TOTAL_BUDGET" -ge 1 ] || die "changelog runtime budget must be at least 1"
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"
[ "$SECURITY_PACKAGE_SUMMARY_LIMIT" -ge 1 ] || die "security package summary limit must be at least 1"

# Append one line to the long output buffer while preserving at most one blank separator.
append_long() {
    if [ -z "$1" ]; then
        [ -n "$LONG_OUTPUT" ] || return
        [ "$LONG_OUTPUT_LAST_BLANK" -eq 0 ] || return
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}"
        LONG_OUTPUT_LAST_BLANK=1
        return
    fi

    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
    LONG_OUTPUT_LAST_BLANK=0
}

# Keep monitoring text safe before and after the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# APT changelog snippets are external multi-line text, so sanitize pipes and collapse accidental blanks before storing them.
sanitize_external_block() {
    printf '%s\n' "$1" | $AWK '
        function emit_line(line) {
            gsub(/[|]/, "[or]", line)
            sub(/[[:space:]]+$/, "", line)
            if (line == "") {
                if (printed && !pending_blank) {
                    pending_blank = 1
                }
                return
            }
            if (pending_blank) {
                print ""
                pending_blank = 0
            }
            print line
            printed = 1
        }
        {
            emit_line($0)
        }
    '
}

# Append a sanitized external text block as individual long-output lines.
append_external_block() {
    [ -n "$1" ] || return

    while IFS= read -r line; do
        append_long "$line"
    done <<EOF
$1
EOF
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
    LONG_OUTPUT_LAST_BLANK=0
}

# Emit the summary line and optional long output.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    printf "%s\n", lines[i]
                }
            }
        '
    fi
}

# Sanitize arbitrary text into a safe cache-key fragment.
sanitize_key() {
    printf '%s' "$1" | $TR -c 'A-Za-z0-9._-' '_'
}

# The changelog cache stores package metadata fetched as root, so keep it private.
ensure_cache_dir() {
    [ -d "$CHANGELOG_CACHE_DIR" ] || $MKDIR -p "$CHANGELOG_CACHE_DIR" 2>/dev/null || return 1
    if [ -n "$CHMOD" ]; then
        $CHMOD 0700 "$CHANGELOG_CACHE_DIR" 2>/dev/null || true
    fi
    return 0
}

# Resolve the source package name for a binary package/version pair.
resolve_source_pkg() {
    pkg=$1
    version=$2
    source_pkg=$($APTCACHE show --no-all-versions "${pkg}=${version}" 2>/dev/null | $AWK '
        /^Source:/ { print $2; found=1; exit }
        /^Package:/ && pkg == "" { pkg=$2 }
        END {
            if (!found && pkg != "") {
                print pkg
            }
        }
    ')

    [ -n "$source_pkg" ] || source_pkg=$pkg
    printf '%s\n' "$source_pkg"
}

# Trim a changelog to entries newer than the installed version.
filter_changelog_since() {
    installed_version=$1
    $AWK -v installed="$installed_version" '
        /^[^[:space:]][^()]* \([^)]+\)/ {
            version=$0
            sub(/^[^(]*\(/, "", version)
            sub(/\).*/, "", version)
            if (installed != "" && version == installed) {
                exit
            }
        }
        { print }
    '
}

# Simulate the upgrade without taking dpkg locks so the check stays read-only.
APT_SIM_OUTPUT=$(LC_ALL=C DEBIAN_FRONTEND=noninteractive $APTGET -s -o Debug::NoLocking=1 -o APT::Get::Show-Upgraded=true -o Debug::pkgProblemResolver=yes dist-upgrade 2>&1)
APT_SIM_RC=$?

# Resolver failures are UNKNOWN because the check cannot trust package counts.
if [ $APT_SIM_RC -ne 0 ]; then
    # Extract first 10 error/warning lines
    APT_SIM_ERR=$(printf '%s\n' "$APT_SIM_OUTPUT" | $AWK '
        BEGIN{c=0}
        /^(E:|Err:|W:)/{gsub(/\r/,""); sub(/^[[:space:]]+/, ""); lines[++c]=$0}
        END{
            if(c==0){print "no apt errors in output"; exit}
            max=(c>10?10:c);
            for(i=1;i<=max;i++){printf "%s%s", (i>1?" ":""), lines[i]}
        }
    ')

    # Return the resolver failure directly; perfdata would be misleading here.
    printf '%s\n' "$(monitor_text_value "APT simulation failed with exit ${APT_SIM_RC}: ${APT_SIM_ERR}")"
    exit 3
fi

# apt's update-success stamp is the preferred metadata freshness signal.
if [ -e "$STAMP_FILE" ]; then
    STAMP_TS=$($STAT -c %Y "$STAMP_FILE" 2>/dev/null || printf '0')
fi

# Latest mtime in /var/lib/apt/lists (exclude lock and partial)
if [ -d /var/lib/apt/lists ]; then
    LISTS_TS=$($FIND /var/lib/apt/lists -type f ! -name lock ! -path '*/partial/*' -printf '%T@\n' 2>/dev/null | $SORT -n | $AWK 'END { if ($0 ~ /^[0-9.]+$/) printf "%d", $0; else print 0 }')
fi

# Prefer the newest trustworthy timestamp between apt's stamp and package list files.
case "${STAMP_TS:-0}" in (*[!0-9]*) STAMP_TS=0 ;; esac
case "${LISTS_TS:-0}" in (*[!0-9]*) LISTS_TS=0 ;; esac
if [ "$STAMP_TS" -ge "$LISTS_TS" ]; then
    LAST_UPDATE_TIMESTAMP=$STAMP_TS
else
    LAST_UPDATE_TIMESTAMP=$LISTS_TS
fi

# Convert the chosen metadata timestamp into an age for status and perfdata.
CURRENT_TIME=$($DATE +%s)
if [ -n "$LAST_UPDATE_TIMESTAMP" ] && [ "$LAST_UPDATE_TIMESTAMP" -gt 0 ]; then
    LAST_UPDATE_SEC=${LAST_UPDATE_TIMESTAMP%%.*}
    LAST_UPDATE_AGE_SEC=$((CURRENT_TIME - LAST_UPDATE_SEC))
else
    LAST_UPDATE_AGE_SEC=0
fi

# Invalid / skewed timestamp -> UNKNOWN
if [ "$LAST_UPDATE_AGE_SEC" -le 0 ] || [ "$LAST_UPDATE_SEC" -gt "$CURRENT_TIME" ]; then
    TIMESTAMP_UNKNOWN=1
fi

# Parse Puppet-generated blacklist patterns from the managed settings file.
BLACKLIST_PATTERNS=$($AWK '
    /^[[:space:]]*Package-Blacklist/ {inblk=1; next}
    inblk && /^[[:space:]]*}/ {exit}
    inblk && match($0, /"[^"]+"/) { print substr($0, RSTART+1, RLENGTH-2) }
' "$BLACKLIST_FILE" 2>/dev/null || true)

# Convert the apt simulation output into package, security, and version records.
APT_SIM_SUMMARY=$(printf '%s\n' "$APT_SIM_OUTPUT" | $AWK '
    /^Inst /{
        total++
        pkg=$2
        line=$0
        old=""
        new=""

        if (!(pkg in seen_pkg)) {
            seen_pkg[pkg]=1
            pkg_order[++pkg_n]=pkg
        }

        if (match(line, /\[[^][]+\]/)) {
            old=substr(line, RSTART+1, RLENGTH-2)
        }

        sub(/^[^(]*\(/, "", line)
        new=line
        sub(/[[:space:]].*$/, "", new)

        if (tolower($0) ~ /security/) {
            sec++
            if (!(pkg in seen_sec)) {
                seen_sec[pkg]=1
                sec_order[++sec_n]=pkg
                sec_old[pkg]=old
                sec_new[pkg]=new
            }
        }
    }
    END{
        for(i=1;i<=pkg_n;i++){
            pkg=pkg_order[i]
            printf "PKG:%s\n",pkg
        }
        for(i=1;i<=sec_n;i++){
            pkg=sec_order[i]
            printf "SECPKG:%s\n",pkg
            printf "SECINFO\t%s\t%s\t%s\n",pkg,sec_old[pkg],sec_new[pkg]
        }
        printf "TOT:%d\nSEC:%d\n",total,sec
    }
')

# Extract aggregate counters and the package list from the serialized summary.
UPDATES_TOTAL=$(printf '%s\n' "$APT_SIM_SUMMARY" | $AWK -F: '/^TOT:/ {print $2}')
UPDATES_SECURITY=$(printf '%s\n' "$APT_SIM_SUMMARY" | $AWK -F: '/^SEC:/ {print $2}')
PKG_LIST=$(printf '%s\n' "$APT_SIM_SUMMARY" | $AWK -F: '/^PKG:/ {print $2}')

# Apply shell-style blacklist patterns to the simulated package names.
if [ "$UPDATES_TOTAL" -gt 0 ] && [ -n "$BLACKLIST_PATTERNS" ]; then
    for pkg in $PKG_LIST; do
        for pat in $BLACKLIST_PATTERNS; do
            case "$pkg" in
                $pat) UPDATES_BLACKLISTED=$((UPDATES_BLACKLISTED+1)); break ;;
            esac
        done
    done
fi

# Security updates and stale metadata are CRITICAL; regular updates are WARNING.
if [ "$TIMESTAMP_UNKNOWN" -eq 0 ]; then
    if [ "$LAST_UPDATE_AGE_SEC" -ge "$GRACE" ] || [ "$UPDATES_SECURITY" -gt 0 ]; then
        STATE_CODE=2
    elif [ "$UPDATES_TOTAL" -gt 0 ]; then
        STATE_CODE=1
    fi
else
    STATE_CODE=3
fi

# Inspect APT automation only when the running manager exposes the optional units.
# Missing distro-specific units do not establish that package updates are disabled.
<% if @systemd_enable != false -%>
apt_unit_active() {
    systemd_service_status "$1" optional
    unit_result=$?
    if [ "$unit_result" -eq 3 ]; then
        printf U
        return 3
    fi
    case "$unit_result" in
        0) printf 1 ;;
        2) printf 0 ;;
        *) printf U ;;
    esac
}
<% end -%>
APT_AUTOMATION_CHECKED=0
TIMER_DAILY_ACTIVE=U
TIMER_UPGRADE_ACTIVE=U
UNATTENDED_ACTIVE=U
<% if @systemd_enable != false -%>
systemd_status
APT_SYSTEMD_STATE=$?
APT_SYSTEMD_CONTEXT=$SERVICE_CONTEXT
if [ "$APT_SYSTEMD_STATE" -eq 0 ]; then
    APT_AUTOMATION_CHECKED=1
    TIMER_DAILY_ACTIVE=$(apt_unit_active apt-daily.timer) || APT_SYSTEMD_STATE=3
    TIMER_UPGRADE_ACTIVE=$(apt_unit_active apt-daily-upgrade.timer) || APT_SYSTEMD_STATE=3
    UNATTENDED_ACTIVE=$(apt_unit_active unattended-upgrades.service) || APT_SYSTEMD_STATE=3
    [ "$APT_SYSTEMD_STATE" -eq 3 ] && APT_SYSTEMD_CONTEXT="systemd unit status unavailable for APT automation"
fi
<% end -%>
append_long "Optional APT automation: daily timer ${TIMER_DAILY_ACTIVE}, upgrade timer ${TIMER_UPGRADE_ACTIVE}, unattended upgrades ${UNATTENDED_ACTIVE} (U: unavailable or not applicable)"

# Start the summary with only meaningful freshness and update causes; the healthy path is filled in after all optional causes have been evaluated.
MSG="APT"

# An expected manager is required even though individual distro-specific automation units remain optional.
<% if @systemd_enable != false -%>
if [ "$SYSTEMD_ENABLE" = true ]; then
    case "$APT_SYSTEMD_STATE" in
        2) MSG="$MSG $APT_SYSTEMD_CONTEXT."; STATE_CODE=2 ;;
        3) MSG="$MSG $APT_SYSTEMD_CONTEXT."; [ "$STATE_CODE" -eq 2 ] || STATE_CODE=3 ;;
    esac
fi
<% end -%>
if [ "$TIMESTAMP_UNKNOWN" -eq 0 ]; then
    if [ "$LAST_UPDATE_AGE_SEC" -ge "$GRACE" ]; then
        DAYS=$((LAST_UPDATE_AGE_SEC / 86400))
        MSG="$MSG metadata ${DAYS} days old."
    fi
else
    MSG="$MSG could not determine last 'apt update' timestamp."
fi

if [ "$UPDATES_TOTAL" -gt 0 ]; then
    if [ "$UPDATES_SECURITY" -gt 0 ]; then
        MSG="$MSG ${UPDATES_TOTAL} updates (${UPDATES_SECURITY} security)."
    else
        MSG="$MSG ${UPDATES_TOTAL} updates."
    fi
fi

# Inactive automation units are warning-level operational findings because package freshness now depends on manual intervention.
if [ "$APT_AUTOMATION_CHECKED" -eq 1 ]; then
    if [ "$TIMER_DAILY_ACTIVE" = 0 ]; then
        MSG="$MSG apt-daily.timer inactive."
        [ "$STATE_CODE" -lt 1 ] && STATE_CODE=1
    fi
    if [ "$TIMER_UPGRADE_ACTIVE" = 0 ]; then
        MSG="$MSG apt-daily-upgrade.timer inactive."
        [ "$STATE_CODE" -lt 1 ] && STATE_CODE=1
    fi
    if [ "$UNATTENDED_ACTIVE" = 0 ]; then
        MSG="$MSG unattended-upgrades.service inactive."
        [ "$STATE_CODE" -lt 1 ] && STATE_CODE=1
    fi
fi

# A required reboot is operationally critical even when no update remains pending.
if [ -e /var/run/reboot-required ]; then
    MSG="$MSG Reboot required."
    [ "$STATE_CODE" -lt 2 ] && STATE_CODE=2
fi

# Blacklisted updates are counted separately so operators can distinguish held packages.
if [ "$UPDATES_BLACKLISTED" -gt 0 ]; then
    MSG="$MSG ${UPDATES_BLACKLISTED} blacklisted."
fi

[ "$MSG" = "APT" ] && MSG="APT is healthy."

# Security packages
if [ "$UPDATES_SECURITY" -gt 0 ]; then
    SEC_CSV=$(printf '%s\n' "$APT_SIM_SUMMARY" | $AWK -F: -v max="$SECURITY_PACKAGE_SUMMARY_LIMIT" '
        /^SECPKG:/ {
            total++
            if (shown < max) {
                pkgs[++shown] = $2
            }
        }
        END {
            for (i = 1; i <= shown; i++) {
                printf "%s%s", (i > 1 ? ", " : ""), pkgs[i]
            }
            if (total > shown) {
                printf "%s+%d more", (shown > 0 ? ", " : ""), total - shown
            }
        }
    ')
    [ -n "$SEC_CSV" ] && MSG="$MSG Security packages: ${SEC_CSV}."

    # Keep this flow inline; it is only used once and sits next to the summary output that depends on it.
    if [ -n "$TIMEOUT" ]; then
        SECURITY_META=$(printf '%s\n' "$APT_SIM_SUMMARY" | $AWK -F '\t' '$1 == "SECINFO" { print $2 "|" $3 "|" $4 }')
        if [ -n "$SECURITY_META" ]; then
            GROUP_INPUT=""
            while IFS='|' read -r pkg oldver newver; do
                [ -n "$pkg" ] || continue
                source_pkg=$(resolve_source_pkg "$pkg" "$newver")
                if [ -z "$GROUP_INPUT" ]; then
                    GROUP_INPUT="${source_pkg}|${pkg}|${oldver}|${newver}"
                else
                    GROUP_INPUT=$(printf '%s\n%s|%s|%s|%s' "$GROUP_INPUT" "$source_pkg" "$pkg" "$oldver" "$newver")
                fi
            done <<EOF
$SECURITY_META
EOF

            if [ -n "$GROUP_INPUT" ]; then
                # Group binary packages by source package so one changelog fetch can cover related packages such as vim/vim-runtime/xxd or kernel sets.
                SECURITY_GROUPS=$(printf '%s\n' "$GROUP_INPUT" | $AWK -F '|' '
                    {
                        key=$1 "|" $4
                        if (!seen[key]++) {
                            order[++n]=key
                            source[key]=$1
                            first_pkg[key]=$2
                            first_old[key]=$3
                            newver[key]=$4
                            packages[key]=$2
                        } else {
                            packages[key]=packages[key] ", " $2
                        }
                    }
                    END {
                        for (i = 1; i <= n; i++) {
                            key=order[i]
                            printf "%s|%s|%s|%s|%s\n", source[key], first_pkg[key], first_old[key], newver[key], packages[key]
                        }
                    }
                ')

                if [ -n "$SECURITY_GROUPS" ]; then
                    if ensure_cache_dir; then
                        append_long "Security changelogs:"
                        CHANGELOG_GROUPS_RENDERED=0
                        while IFS='|' read -r source_pkg first_pkg oldver newver packages; do
                            [ -n "$source_pkg" ] || continue

                            # Bound external changelog retrieval work separately from the single diagnostic character limit.
                            NOW=$($DATE +%s)
                            ELAPSED=$((NOW - CHECK_START))
                            if [ "$ELAPSED" -ge "$CHANGELOG_TOTAL_BUDGET" ]; then
                                append_long ""
                                append_long "  Remaining changelogs skipped after ${CHANGELOG_TOTAL_BUDGET}s runtime budget."
                                break
                            fi
                            if [ "$CHANGELOG_GROUPS_RENDERED" -ge "$CHANGELOG_GROUP_LIMIT" ]; then
                                append_long ""
                                append_long "  Remaining changelogs skipped after ${CHANGELOG_GROUP_LIMIT} package group(s)."
                                break
                            fi
                            CHANGELOG_GROUPS_RENDERED=$(( CHANGELOG_GROUPS_RENDERED + 1 ))

                            CACHE_KEY=$(sanitize_key "${source_pkg}_${newver}")
                            CACHE_FILE="${CHANGELOG_CACHE_DIR}/${CACHE_KEY}.txt"
                            FETCH_ERR=""
                            FETCH_RC=0

                            # Reuse cached changelogs when possible; fetches are best-effort diagnostics.
                            if [ -r "$CACHE_FILE" ]; then
                                RAW_CHANGELOG=$($SED -n 'p' "$CACHE_FILE" 2>/dev/null)
                            else
                                RAW_CHANGELOG=$(PAGER=cat LC_ALL=C DEBIAN_FRONTEND=noninteractive $TIMEOUT "$CHANGELOG_FETCH_TIMEOUT" "$APTGET" changelog "${first_pkg}=${newver}" 2>&1)
                                FETCH_RC=$?

                                case "$FETCH_RC" in
                                    0)
                                        OLD_UMASK=$(umask)
                                        umask 077
                                        printf '%s\n' "$RAW_CHANGELOG" > "$CACHE_FILE" 2>/dev/null || true
                                        umask "$OLD_UMASK"
                                        ;;
                                    124)
                                        FETCH_ERR="timeout after ${CHANGELOG_FETCH_TIMEOUT}s"
                                        ;;
                                    *)
                                        FETCH_ERR="fetch failed (rc=${FETCH_RC})"
                                        ;;
                                esac
                            fi

                            # Each long-output section names the source package and covered binaries.
                            append_long ""
                            if [ -n "$oldver" ]; then
                                append_long "$(monitor_text_value "[${source_pkg}] ${packages} (${oldver} -> ${newver})")"
                            else
                                append_long "$(monitor_text_value "[${source_pkg}] ${packages} (not installed -> ${newver})")"
                            fi

                            if [ "$FETCH_RC" -ne 0 ] || [ -z "$RAW_CHANGELOG" ]; then
                                if [ -n "$FETCH_ERR" ]; then
                                    append_long "  Changelog unavailable: ${FETCH_ERR}."
                                else
                                    append_long "  Changelog unavailable."
                                fi
                                continue
                            fi

                            # Select newer entries; the single character limit applies to the complete diagnostic body later.
                            FILTERED_CHANGELOG=$(printf '%s\n' "$RAW_CHANGELOG" | filter_changelog_since "$oldver" | $SED 's/^/  /')
                            if [ -z "$FILTERED_CHANGELOG" ]; then
                                append_long "  No newer changelog entries found."
                                continue
                            fi

                            append_external_block "$(sanitize_external_block "$FILTERED_CHANGELOG")"
                        done <<EOF
$SECURITY_GROUPS
EOF
                    else
                        append_long "Security changelogs: cache directory could not be created."
                    fi
                fi
            fi
        fi
    else
        append_long "Security changelogs: skipped because 'timeout' is unavailable."
    fi
fi

# Explain the status scope after any changelog diagnostics so OpenITCOCKPIT operators can triage from long output alone.
if [ -n "$LONG_OUTPUT" ]; then
    limit_long_output_details
    append_long ""
    append_long "Interpretation:"
    append_long "Security changelogs are diagnostic context for pending security updates; package counts, metadata age, an expected systemd manager, inactive APT automation units, blacklist counts, and reboot-required state decide the exit code."
    append_long "Inspect APT automation and package changelogs on the host when the summary names stale metadata, security updates, inactive timers, or a required reboot."
fi

# Perfdata exposes update counts and metadata age with unit-free labels.
PERF_DATA="total_updates=${UPDATES_TOTAL};1;;0"
PERF_DATA="$PERF_DATA security_updates=${UPDATES_SECURITY};;1;0"
PERF_DATA="$PERF_DATA blacklisted_updates=${UPDATES_BLACKLISTED};;;0"
PERF_DATA="$PERF_DATA last_update_age=${LAST_UPDATE_AGE_SEC}s;;${GRACE};0"

# Emit summary, perfdata, and any bounded security changelog detail.
emit_check "$MSG" "$PERF_DATA"
exit "$STATE_CODE"
