#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'ESET check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CUT=$(command -v cut 2>/dev/null) || die "cut not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
<% if @systemd_enable -%>
SYSTEMDCTL=$(command -v systemctl 2>/dev/null)  || die "systemctl not available"
<% end -%>
TAIL=$(command -v tail 2>/dev/null) || die "tail not available"
PS=$(command -v ps 2>/dev/null) || die "ps not available"
WC=$(command -v wc 2>/dev/null) || die "wc not available"

# Status buffers hold daemon, module, update, and scan findings.
CRIT_MSG=""
WARN_MSG=""
STATE_CODE=0

# Update and scan staleness thresholds are operator-tunable through CLI options.
CRIT_NO_SCAN_DAYS=14  # CRITICAL if >14 days
CRIT_UPDATE_MIN=1440   # CRITICAL if >24h
WARN_NO_SCAN_DAYS=7   # WARNING if no on-demand scan in >7 days
WARN_UPDATE_MIN=720   # WARNING if no engine update for >12h

# Latest scan metrics are parsed from ESET lslog output and exported as perfdata.
ENGINE_VER=0
LAST_CLEAN=0
LAST_DET=0
LAST_FILES=0
LAST_SCAN_EPOCH=0
LAST_SCAN_AGE=9999
LAST_SCAN_SECS=0

# ESET command paths and long-output buffers.
LONG_OUTPUT=""
SCAN_HISTORY_LIMIT=${SCAN_HISTORY_LIMIT:-5}
LSLOG=/opt/eset/efs/bin/lslog
UPD=/opt/eset/efs/bin/upd
WAP_FLAG=/opt/eset/efs/etc/WAP_DISABLED

# Update-age defaults assume unknown/stale until log parsing proves otherwise.
NOW_EPOCH=$($DATE +%s)
UPDATE_AGE_MIN=999999

# Keep the long-output history cap numeric before AWK uses it as a ring-buffer size.
case "$SCAN_HISTORY_LIMIT" in
    ''|*[!0-9]*) SCAN_HISTORY_LIMIT=5 ;;
esac
[ "$SCAN_HISTORY_LIMIT" -ge 1 ] || SCAN_HISTORY_LIMIT=5

# CLI thresholds keep operational tuning outside of the static template.
USAGE_TEXT="Usage: $0 [-n <days>] [-N <days>] [-u <min>] [-U <min>]"
OPTERR=0
while getopts 'n:N:u:U:' opt; do
  case "$opt" in
    n) WARN_NO_SCAN_DAYS="$OPTARG" ;;
    N) CRIT_NO_SCAN_DAYS="$OPTARG" ;;
    u) WARN_UPDATE_MIN="$OPTARG" ;;
    U) CRIT_UPDATE_MIN="$OPTARG" ;;
    *) die "$USAGE_TEXT" ;;
  esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
for threshold_value in "$WARN_NO_SCAN_DAYS" "$CRIT_NO_SCAN_DAYS" "$WARN_UPDATE_MIN" "$CRIT_UPDATE_MIN"; do
    case "$threshold_value" in
        ''|*[!0-9]*) die "scan and update thresholds must be numeric" ;;
    esac
done
[ "$CRIT_NO_SCAN_DAYS" -ge "$WARN_NO_SCAN_DAYS" ] || die "critical scan threshold must be greater than or equal to warning threshold"
[ "$CRIT_UPDATE_MIN" -ge "$WARN_UPDATE_MIN" ] || die "critical update threshold must be greater than or equal to warning threshold"

# Emit a direct CRITICAL result and stop immediately.
crit() {
    printf 'ESET %s\n' "$*"
    exit 2
}

# Append one critical reason to the summary.
add_crit() {
    CRIT_MSG="${CRIT_MSG:+$CRIT_MSG; }$1"
}

# Append one warning reason to the summary.
add_warn() {
    WARN_MSG="${WARN_MSG:+$WARN_MSG; }$1"
}

# Emit the summary line and optional long output.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "${LONG_OUTPUT:-}" ]; then
        monitor_text_value "$LONG_OUTPUT"
    fi
}

# Nagios treats raw pipes after the first output line as perfdata separators.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Parse the scan CSV once into typed records for latest-scan metrics and capped history.
parse_scan_csv() {
    printf '%s\n' "$1" | $AWK -F',' -v limit="$SCAN_HISTORY_LIMIT" '
        NR == 1 { next }
        NF < 6 { next }
        {
            # Normalize CSV fields from lslog before storing the ring-buffer entry.
            for (i = 1; i <= NF; i++) {
                gsub(/\r/, "", $i)
                sub(/^[[:space:]]+/, "", $i)
                sub(/[[:space:]]+$/, "", $i)
            }

            if ($1 == "") {
                next
            }

            triggered = (NF >= 7 ? $7 : "")
            for (i = 8; i <= NF; i++) {
                triggered = triggered FS $i
            }

            # Keep only the newest entries while still reporting the total scan count.
            total++
            idx = ((total - 1) % limit) + 1
            started[idx] = $1
            progress[idx] = $2
            scanned[idx] = $3
            cleaned[idx] = $4
            detections[idx] = $5
            duration[idx] = $6
            triggered_by[idx] = triggered

            last_started = $1
            last_scanned = $3
            last_cleaned = $4
            last_detections = $5
            last_duration = $6
        }
        END {
            # The shell parser consumes typed records instead of raw CSV columns.
            printf "TOTAL|%d\n", total
            if (total == 0) {
                exit
            }

            printf "LAST|%s|%s|%s|%s|%s\n", last_started, last_scanned, last_cleaned, last_detections, last_duration

            count = total < limit ? total : limit
            for (i = total; i > total - count; i--) {
                idx = ((i - 1) % limit) + 1
                printf "HISTORY|%s|%s|%s|%s|%s|%s|%s\n", \
                    started[idx], progress[idx], scanned[idx], cleaned[idx], detections[idx], duration[idx], triggered_by[idx]
            }
        }
    '
}

# Verify the ESET service before checking daemon internals.
<% if @systemd_enable -%>
$SYSTEMDCTL is-active --quiet "efs.service" || crit "service is not active"
<% else -%>
$PS -C efs >/dev/null 2>&1 || crit "service is not active"
<% end -%>

# Core daemon checks catch partial ESET failures that systemd may not expose.
DAEMONS="oaeventd scand updated logd confd licensed utild sysinfod"
[ ! -f "$WAP_FLAG" ] && DAEMONS="$DAEMONS wapd"
for d in $DAEMONS; do
  $PS -e -o comm= | $GREP -qx "$d" || add_crit "$d down"
done

# Kernel modules confirm real-time protection is active at the kernel boundary.
$GREP -qw eset_rtp /proc/modules || add_crit "eset_rtp missing"
if [ ! -f "$WAP_FLAG" ]; then
  $GREP -qw eset_wap /proc/modules || add_crit "eset_wap missing"
fi

# Detection engine version is included for operators even when update age is healthy.
LINE=$($UPD -l 2>/dev/null | $GREP -m1 "Detection engine")
if [ -n "$LINE" ]; then
    ENGINE_VER=$(printf '%s' "$LINE" | $AWK '{print $2}')
fi
ENGINE_VER_METRIC=$ENGINE_VER
case "$ENGINE_VER_METRIC" in
    ''|*[!0-9.]*|*.*.*) ENGINE_VER_METRIC=U ;;
esac

# ESET log output is reused for update age and recent update errors.
LOG_CSV=$($LSLOG -c 2>/dev/null)

# On-demand scan history drives stale-scan status and bounded long output.
SCAN_CSV=$($LSLOG -s -c 2>/dev/null)
SCAN_PARSE=$(parse_scan_csv "$SCAN_CSV")
SCANS_TOTAL=0
SCAN_HISTORY=""

while IFS='|' read -r KIND COL1 COL2 COL3 COL4 COL5 COL6 COL7; do
    case "$KIND" in
        TOTAL)
            SCANS_TOTAL=$COL1
            ;;
        LAST)
            STARTED=$COL1
            LAST_FILES=$COL2
            LAST_CLEAN=$COL3
            LAST_DET=$COL4
            DURATION=$COL5

            # Convert the last scan start time to both age and human timestamp later.
            LAST_SCAN_EPOCH=$($DATE -d "$STARTED" +%s 2>/dev/null)
            case "$LAST_SCAN_EPOCH" in
                ''|*[!0-9]*) LAST_SCAN_EPOCH=0 ;;
                *) LAST_SCAN_AGE=$(( (NOW_EPOCH - LAST_SCAN_EPOCH) / 86400 )) ;;
            esac

            # ESET reports scan duration as HH:MM:SS; convert it to seconds for perfdata.
            OLD_IFS=$IFS
            IFS=':'
            set -- $DURATION
            IFS=$OLD_IFS
            H=${1:-0}
            M=${2:-0}
            S=${3:-0}
            H=${H#0}; [ -z "$H" ] && H=0
            M=${M#0}; [ -z "$M" ] && M=0
            S=${S#0}; [ -z "$S" ] && S=0
            LAST_SCAN_SECS=$(( H * 3600 + M * 60 + S ))
            ;;
        HISTORY)
            # History lines are diagnostic only and are capped in the long output below.
            DETAIL_LINE="- ${COL1}: status ${COL2}, scanned ${COL3}, cleaned ${COL4}, detections ${COL5}, duration ${COL6}"
            [ -n "$COL7" ] && DETAIL_LINE="$DETAIL_LINE, triggered by ${COL7}"
            if [ -z "$SCAN_HISTORY" ]; then
                SCAN_HISTORY=$DETAIL_LINE
            else
                SCAN_HISTORY=$(printf '%s\n%s' "$SCAN_HISTORY" "$DETAIL_LINE")
            fi
            ;;
    esac
done <<EOF
$SCAN_PARSE
EOF

# State the history cap explicitly when the ESET scan list is truncated.
if [ -n "$SCAN_HISTORY" ]; then
    if [ "$SCANS_TOTAL" -gt "$SCAN_HISTORY_LIMIT" ]; then
        LONG_OUTPUT=$(printf 'Last %s of %s scans:\n%s\n... truncated to %s of %s scans' "$SCAN_HISTORY_LIMIT" "$SCANS_TOTAL" "$SCAN_HISTORY" "$SCAN_HISTORY_LIMIT" "$SCANS_TOTAL")
    else
        LONG_OUTPUT=$(printf 'Last %s scans:\n%s' "$SCANS_TOTAL" "$SCAN_HISTORY")
    fi
else
    LONG_OUTPUT="Last ${SCAN_HISTORY_LIMIT} scans: none"
fi

# Explain how ESET scan history relates to the status decision.
LONG_OUTPUT=$(
    {
        printf '%s\n' "$LONG_OUTPUT"
        printf '%s\n' ''
        printf '%s\n' 'Interpretation:'
        printf '%s\n' 'Daemon/module health, engine update age, latest scan age, latest scan detections, and recent update errors decide the exit code.'
        printf '%s\n' 'Scan history is bounded diagnostic context. Inspect ESET services, kernel modules, updater logs, and the latest scan result when the summary reports stale updates, stale scans, missing protection, detections, or cleaned files.'
    }
)

# Stale scans and detections are status causes; full scan history stays in long output.
[ "$LAST_SCAN_AGE" -ge "$CRIT_NO_SCAN_DAYS" ] && add_crit "no scan ${LAST_SCAN_AGE}d"
[ "$LAST_SCAN_AGE" -ge "$WARN_NO_SCAN_DAYS" ] && [ "$LAST_SCAN_AGE" -lt "$CRIT_NO_SCAN_DAYS" ] && add_warn "no scan ${LAST_SCAN_AGE}d"
[ "$LAST_DET" -gt 0 ] && add_crit "scan detections $LAST_DET"
[ "$LAST_CLEAN" -gt 0 ] && [ "$LAST_DET" -eq 0 ] && add_warn "scan cleaned files $LAST_CLEAN"

# Cumulative detections are trend perfdata; the latest scan detections drive status.
DETECTIONS_TOTAL=$($LSLOG -d -c 2>/dev/null | $TAIL -n +2 | $WC -l | $AWK '{print $1}')

# Update age is computed from the latest successful detection-engine update log line.
LAST_OK=$(printf '%s\n' "$LOG_CSV" | $GREP -F "Detection Engine was successfully updated" | $TAIL -n 1)
if [ -n "$LAST_OK" ]; then
    LAST_OK_TS=$($DATE -d "$(printf '%s' "$LAST_OK" | $CUT -d ',' -f1)" +%s 2>/dev/null || printf '')
    case "$LAST_OK_TS" in
        ''|*[!0-9]*)
            UPDATE_AGE_MIN=U
            add_crit "engine update timestamp could not be parsed"
            ;;
        *)
            UPDATE_AGE_MIN=$(( (NOW_EPOCH - LAST_OK_TS) / 60 ))
            [ "$UPDATE_AGE_MIN" -lt 0 ] && UPDATE_AGE_MIN=0
            ;;
    esac
else
    UPDATE_AGE_MIN=U
    add_crit "no successful engine update found"
fi
if [ "$UPDATE_AGE_MIN" != U ]; then
    [ "$UPDATE_AGE_MIN" -ge "$CRIT_UPDATE_MIN" ] && add_crit "engine update ${UPDATE_AGE_MIN}m old"
    [ "$UPDATE_AGE_MIN" -ge "$WARN_UPDATE_MIN" ] && [ "$UPDATE_AGE_MIN" -lt "$CRIT_UPDATE_MIN" ] && add_warn "engine update ${UPDATE_AGE_MIN}m old"
fi

# Recent updater errors are WARNING-only because a successful update may still be recent.
UPDATES_FAILED=0
UPDATE_FAILED_TIMESTAMPS=$(printf '%s\n' "$LOG_CSV" | $GREP -F "Cannot check new application update" | $AWK -F ',' '{print $1}')
while IFS= read -r TS; do
    [ -n "$TS" ] || continue
    TS_EPOCH=$($DATE -d "$TS" +%s 2>/dev/null || printf '')
    case "$TS_EPOCH" in
        ''|*[!0-9]*) continue ;;
    esac
    [ $((NOW_EPOCH - TS_EPOCH)) -le 3600 ] && UPDATES_FAILED=$((UPDATES_FAILED + 1))
done <<EOF
$UPDATE_FAILED_TIMESTAMPS
EOF
[ "$UPDATES_FAILED" -gt 0 ] && add_warn "$UPDATES_FAILED update errors (1h)"

# Start the summary with the engine and latest scan because those are the operator-facing health anchors.
if [ "$UPDATE_AGE_MIN" = U ]; then
    UPDATE_AGE_TEXT="unknown"
else
    UPDATE_AGE_TEXT="${UPDATE_AGE_MIN}m"
fi
if [ "$LAST_SCAN_EPOCH" -gt 0 ]; then
    LAST_SCAN_HUMAN=$($DATE -d "@$LAST_SCAN_EPOCH" '+%Y-%m-%d %H:%M')
    MSG="ESET engine version $ENGINE_VER (update age ${UPDATE_AGE_TEXT}); last scan ${LAST_SCAN_HUMAN}"
else
    MSG="ESET engine version $ENGINE_VER (update age ${UPDATE_AGE_TEXT})"
fi

# CRITICAL causes take precedence over WARNING causes.
[ -n "$CRIT_MSG" ] && STATE_CODE=2;
[ -z "$CRIT_MSG" ] && [ -n "$WARN_MSG" ] && STATE_CODE=1;

# Append status causes without Nagios state labels in the visible text.
[ -n "$CRIT_MSG" ] && MSG="$MSG; issues: $CRIT_MSG"
[ -n "$WARN_MSG" ] && MSG="$MSG; attention: $WARN_MSG"

# Convert day/minute thresholds to seconds for perfdata UOM consistency.
if [ "$UPDATE_AGE_MIN" = U ]; then
    UPDATE_AGE_SECONDS=U
    UPDATE_AGE_METRIC=U
else
    UPDATE_AGE_SECONDS=$(( UPDATE_AGE_MIN * 60 ))
    UPDATE_AGE_METRIC="${UPDATE_AGE_SECONDS}s"
fi
WARN_UPDATE_SECONDS=$(( WARN_UPDATE_MIN * 60 ))
CRIT_UPDATE_SECONDS=$(( CRIT_UPDATE_MIN * 60 ))
LAST_SCAN_AGE_SECONDS=$(( LAST_SCAN_AGE * 86400 ))
WARN_NO_SCAN_SECONDS=$(( WARN_NO_SCAN_DAYS * 86400 ))
CRIT_NO_SCAN_SECONDS=$(( CRIT_NO_SCAN_DAYS * 86400 ))

PERF="engine_version=${ENGINE_VER_METRIC}"
PERF="$PERF update_age=${UPDATE_AGE_METRIC};${WARN_UPDATE_SECONDS};${CRIT_UPDATE_SECONDS};0"
PERF="$PERF update_failed=${UPDATES_FAILED}"
PERF="$PERF detections=${DETECTIONS_TOTAL}"
PERF="$PERF scans_total=${SCANS_TOTAL}"
PERF="$PERF last_scan_age=${LAST_SCAN_AGE_SECONDS}s;${WARN_NO_SCAN_SECONDS};${CRIT_NO_SCAN_SECONDS};0"
PERF="$PERF last_scan_cleaned=${LAST_CLEAN}"
PERF="$PERF last_scan_detections=${LAST_DET}"
PERF="$PERF last_scan_duration=${LAST_SCAN_SECS}s"
PERF="$PERF last_scan_files=${LAST_FILES}"

# Emit summary, perfdata, and bounded scan-history long output.
emit_check "$MSG" "$PERF"
exit $STATE_CODE
