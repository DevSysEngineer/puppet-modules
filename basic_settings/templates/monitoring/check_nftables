#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'nftables check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
NFT=$(command -v nft 2>/dev/null) || die "nft not available"
SORT=$(command -v sort 2>/dev/null) || die "sort not available"
<% if @systemd_enable -%>
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
<% end -%>
TR=$(command -v tr 2>/dev/null) || die "tr not available"

# Dynamic blacklist set counts and rendered long-output sections.
BL_ITEMS=0
FILTER_SECTION_COUNT=0
FILTER_ITEMS_LIMIT=${FILTER_ITEMS_LIMIT:-50}
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_NFT_NL__"

# Perfdata is sorted after collection so busiest counters are easiest to inspect.
PERFDATA_BUFFER=""

# Ruleset structure counters drive empty table/chain alerts.
CHAIN_EMPTY=""
TABLE_COUNT=0
TABLE_EMPTY=""
TOTAL_RULES=0

# Keep potentially large blacklist sections bounded while preserving the summary count.
case "$FILTER_ITEMS_LIMIT" in
    ''|*[!0-9]*) FILTER_ITEMS_LIMIT=50 ;;
esac
[ "$FILTER_ITEMS_LIMIT" -ge 1 ] || FILTER_ITEMS_LIMIT=50

# Emit a direct CRITICAL result and stop immediately.
crit() {
    printf 'nftables %s\n' "$*"
    exit 2
}

# Add one perfdata item to the sortable buffer.
add_pd() {
    label_format=$(printf '%s' "$1" | $TR '[:upper:]' '[:lower:]' | $TR -c 'a-z0-9_' '_')
    case "$label_format" in
        [a-z]*) : ;;
        *) label_format="metric_${label_format}" ;;
    esac
    PERFDATA_BUFFER="${PERFDATA_BUFFER}${label_format} ${2:-0}\n"
}

# Append one line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Keep nftables object names safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $AWK '{gsub(/[|]/, "[or]"); print}'
}

# Emit the summary line and optional long output.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    printf "%s\n", lines[i]
                }
            }
        '
    fi
}

# Read one IP set and serialize its items as a comma-separated list.
collect_set_items_csv() {
    $NFT list set "$1" "$2" "$3" 2>/dev/null | $AWK '
        BEGIN { done=0; in_elements=0; data="" }
        done { next }
        {
            # nft may wrap set elements across lines; collect until the closing brace.
            if ($0 ~ /elements[[:space:]]*=/) {
                in_elements=1
            }
            if (in_elements) {
                data = data " " $0
                if ($0 ~ /}/) {
                    done=1
                }
            }
        }
        END {
            count = 0
            if (data == "") {
                exit
            }

            # Strip nft metadata so only address values are rendered in long output.
            sub(/^.*elements[[:space:]]*=[[:space:]]*\{/, "", data)
            sub(/[[:space:]]*}[[:space:]]*$/, "", data)
            gsub(/[[:space:]]*,[[:space:]]*/, "\n", data)

            entries = split(data, raw_items, /\n/)
            for (i = 1; i <= entries; i++) {
                item = raw_items[i]
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", item)
                sub(/[[:space:]]+expires[[:space:]].*$/, "", item)
                sub(/[[:space:]]+timeout[[:space:]].*$/, "", item)
                sub(/[[:space:]]+comment[[:space:]].*$/, "", item)

                if (item == "") {
                    continue
                }

                # Only IPv4/IPv6 address tokens are useful for blacklist diagnostics.
                if (item ~ /^[0-9]+(\.[0-9]+){3}(\/[0-9]+)?$/ || item ~ /^[0-9A-Fa-f:]+(\/[0-9]+)?$/) {
                    if (count == 0) {
                        output = item
                    } else {
                        output = output "," item
                    }
                    count++
                }
            }

            if (count > 0) {
                printf "%s", output
            }
        }
    '
}

# Render one filter-set section in the long output.
append_filter_section() {
    label=$1
    set_name=$2
    item_count=$3
    items_csv=$4

    append_long "${label} addresses in ${set_name} filter (${item_count}):"
    if [ "$item_count" -eq 0 ]; then
        append_long "None"
        return
    fi

    old_ifs=$IFS
    IFS=','
    set -- $items_csv
    IFS=$old_ifs
    shown_count=0
    for item do
        shown_count=$((shown_count + 1))
        [ "$shown_count" -le "$FILTER_ITEMS_LIMIT" ] || continue
        append_long "- $item"
    done
    if [ "$item_count" -gt "$FILTER_ITEMS_LIMIT" ]; then
        append_long "... truncated to ${FILTER_ITEMS_LIMIT} of ${item_count} addresses"
    fi
}

<% if @systemd_enable -%>
# Verify the service when systemd is available before reading the live ruleset.
$SYSTEMCTL is-active --quiet "nftables" || crit "service is not active"

<% end -%>

# Reading the live ruleset validates nft access without assuming a loadable kernel module.
RULESET=$($NFT list ruleset 2>/dev/null) || crit "ruleset cannot be read"
[ -z "$RULESET" ] && crit "ruleset is empty"

# Analyze ruleset structure
RULESET_STATS=$(printf '%s' "$RULESET" | $AWK '
BEGIN {
    FS=" "
    inside_chain=0
    table_key=""
    chain_key=""
}
{
    # Track table and chain scope so rule counts can be attributed correctly.
    if ($1 == "table") {
        table_key=$2 SUBSEP $3
        table_seen[table_key]=1
        inside_chain=0
        next
    }
    if ($1 == "chain") {
        chain_key=table_key SUBSEP $2
        chain_seen[chain_key]=1
        inside_chain=1
        next
    }
    if (inside_chain && $0 ~ /^[[:space:]]*}/) {
        inside_chain=0
        next
    }
    if (inside_chain) {
        # Metadata-only lines should not make a chain look like it has packet rules.
        if ($0 ~ /^[[:space:]]*$/) next
        if ($0 ~ /^[[:space:]]*#/) next
        if ($1 == "type" || $1 == "policy") { chain_has_meta[chain_key]=1; next }
        if ($1 ~ /^(set|counter|flags|elements|size|timeout)$/) next
        rules_in_chain[chain_key]++
    }
}
END {
    # Empty tables/chains are emitted as names for the short output cause.
    total_rules=0
    table_count=0
    empty_tables=""
    empty_chains=""

    for (chain_key in chain_seen) {
        split(chain_key, chain_parts, SUBSEP)
        fam=chain_parts[1]
        tab=chain_parts[2]
        chain=chain_parts[3]
        rules=(chain_key in rules_in_chain) ? rules_in_chain[chain_key] : 0

        if (!rules && !(chain_key in chain_has_meta)) {
            empty_chains = empty_chains " " fam "/" tab "/" chain
        }

        table_rules[fam SUBSEP tab] += rules
    }

    for (table_key in table_seen) {
        split(table_key, table_parts, SUBSEP)
        fam=table_parts[1]
        tab=table_parts[2]
        rules=(table_key in table_rules) ? table_rules[table_key] : 0

        if (!rules) {
            empty_tables = empty_tables " " fam "/" tab
        }

        total_rules += rules
        table_count++
    }

    sub(/^ /, "", empty_tables)
    sub(/^ /, "", empty_chains)

    printf "rules_total=%d\n", total_rules;
    printf "table_count=%d\n", table_count;
    printf "table_empty=%s\n", empty_tables;
    printf "chain_empty=%s\n", empty_chains;
}')

# Parse the AWK key/value report into shell variables used by status and perfdata.
while IFS='=' read -r K V; do
    case "$K" in
        rules_total) TOTAL_RULES=$V ;;
        table_count) TABLE_COUNT=$V ;;
        table_empty) TABLE_EMPTY=$V ;;
        chain_empty) CHAIN_EMPTY=$V ;;
    esac
done <<EOF
$RULESET_STATS
EOF

# Always expose the evaluated ruleset structure so empty table/chain alerts have immediate detail output.
append_long "Ruleset structure: ${TOTAL_RULES} rule(s) in ${TABLE_COUNT} table(s)"
[ -n "$CHAIN_EMPTY" ] && append_long "Empty chains: ${CHAIN_EMPTY}"
[ -n "$TABLE_EMPTY" ] && append_long "Empty tables: ${TABLE_EMPTY}"

# Find dynamic inet/filter sets that are actually referenced by drop/reject rules.
FILTER_SETS=$(printf '%s' "$RULESET" | $AWK '
BEGIN {
    FS=" "
    current_table=""
    inside_chain=0
    inside_set=0
    set_key=""
    set_type=""
    dynamic=0
}
{
    line=$0

    # First pass through chains records set references used by drop/reject rules.
    if ($1 == "table") {
        current_table=$2 SUBSEP $3
        inside_chain=0
        next
    }
    if ($1 == "chain") {
        inside_chain=1
        next
    }
    if (inside_chain && $0 ~ /^[[:space:]]*}/) {
        inside_chain=0
        next
    }
    if (inside_chain) {
        scrub=line
        gsub(/comment[[:space:]]+"[^"]*"/, "", scrub)

        if (scrub ~ /(^|[[:space:]])(drop|reject)([[:space:]]|$)/) {
            while (match(scrub, /@[[:alnum:]_.-]+/)) {
                blocking[current_table SUBSEP substr(scrub, RSTART + 1, RLENGTH - 1)]=1
                scrub=substr(scrub, RSTART + RLENGTH)
            }
        }

        next
    }

    if ($1 == "set") {
        # Dynamic set declarations are collected after chain parsing leaves scope.
        inside_set=1
        set_key=current_table SUBSEP $2
        set_type=""
        dynamic=(index($0, "dynamic") > 0)
        next
    }
    if (inside_set) {
        if ($1=="type" || $1=="typeof") {
            set_type=$0
            sub(/^[[:space:]]+/, "", set_type)
        }
        if ($0 ~ /}/) {
            if (dynamic) {
                set_types[set_key]=set_type
            }
            inside_set=0
            dynamic=0
            set_key=""
            set_type=""
            next
        }
        if (index($0, "dynamic") > 0) {
            dynamic=1
        }
    }
}
END {
    # Only inet/filter IPv4 and IPv6 blocking sets are useful for the long output.
    for (set_key in set_types) {
        if (!(set_key in blocking)) {
            continue
        }

        split(set_key, parts, SUBSEP)
        fam=parts[1]
        tab=parts[2]
        set_name=parts[3]

        if (fam != "inet" || tab != "filter") {
            continue
        }

        if (set_types[set_key] ~ /^type ipv4_addr/ || set_types[set_key] ~ /^typeof ip saddr/) {
            printf "IPv4|%s|%s|%s\n", fam, tab, set_name
        } else if (set_types[set_key] ~ /^type ipv6_addr/ || set_types[set_key] ~ /^typeof ip6 saddr/) {
            printf "IPv6|%s|%s|%s\n", fam, tab, set_name
        }
    }
}' | $SORT -t '|' -k1,1 -k4,4)

# Read matching blocking sets and render them in the long output.
if [ -n "$FILTER_SETS" ]; then
    while IFS='|' read -r LABEL FAM TAB SET_NAME; do
        [ -n "$LABEL" ] || continue

        ITEMS_CSV=$(collect_set_items_csv "$FAM" "$TAB" "$SET_NAME")

        old_ifs=$IFS
        IFS=','
        if [ -n "$ITEMS_CSV" ]; then
            set -- $ITEMS_CSV
        else
            set --
        fi
        IFS=$old_ifs

        BL_ITEMS=$((BL_ITEMS + $#))

        if [ -n "$LONG_OUTPUT" ]; then
            append_long ""
        fi

        append_filter_section "$LABEL" "$SET_NAME" "$#" "$ITEMS_CSV"
        FILTER_SECTION_COUNT=$((FILTER_SECTION_COUNT + 1))
    done <<EOF
$FILTER_SETS
EOF
fi

# Named nft counters become perfdata only when their packet count is non-zero.
NAMED_CTRS=$(printf '%s' "$RULESET" | $AWK '
BEGIN { RS = "}" }
{
    if ($0 !~ /^[[:space:]]*counter[[:space:]]+[A-Za-z0-9_]+/) {
        next
    }

    block=$0
    sub(/^[[:space:]]*counter[[:space:]]+/, "", block)
    split(block, fields, /[[:space:]]+/)
    counter_name=fields[1]

    if (counter_name == "" || counter_name == "packets") {
        next
    }

    if (match($0, /packets[[:space:]]+[0-9]+/)) {
        pkt_val=substr($0, RSTART, RLENGTH)
        sub(/^packets[[:space:]]+/, "", pkt_val)

        if (pkt_val > 0) {
            print counter_name, pkt_val
        }
    }
}')

# Process named counters
if [ -n "$NAMED_CTRS" ]; then
    while IFS=' ' read -r N P; do
        add_pd "ctr_${N}" "${P}c";
    done <<EOF
$NAMED_CTRS
EOF
fi

# Inline anonymous counters use the rule comment as label when available.
INLINE_CTRS=$(printf '%s' "$RULESET" | $AWK '
BEGIN { seq = 0 }
{
    if ($0 ~ /counter[[:space:]]+packets[[:space:]]+[0-9]+/) {
        n = split($0, f, /[[:space:]]+/)
        val = 0
        for (i = 1; i <= n; i++)
            if (f[i] == "counter" && i + 2 <= n && f[i + 1] == "packets") {
                val = f[i + 2]; break
            }

        if (val == 0) next

        lbl = ""
        if (match($0, /comment[[:space:]]+"[^"]+"/)) {
            c = substr($0, RSTART, RLENGTH)
            sub(/^comment[[:space:]]+"/, "", c)
            sub(/"$/, "", c)
            lbl = c
        } else {
            seq++; lbl = "anon_" seq
        }

        gsub(/[^A-Za-z0-9_]+/, "_", lbl)
        lbl = tolower(lbl)
        isdrop = (index($0, " drop") > 0) ? 1 : 0
        print lbl, val, isdrop
    }
}')

# Process inline counters
if [ -n "$INLINE_CTRS" ]; then
    while read -r LABEL VALUE ISDROP;do
        add_pd "rule_${LABEL}" "${VALUE}c"
        [ "$ISDROP" -eq 1 ] && add_pd "rule_${LABEL}_drops" "${VALUE}c"
    done <<EOF
$INLINE_CTRS
EOF
fi

# Sort counter perfdata by packet count so the busiest rules appear first without leaving a trailing perfdata separator space.
PERFDATA_BUFFER=$(printf '%b' "$PERFDATA_BUFFER" | $SORT -k2,2nr | $AWK 'NF { printf "%s%s=%s", sep, $1, $2; sep=" " }')
PERF_DATA="rules_total=$TOTAL_RULES blacklist_items=$BL_ITEMS"
[ -n "$PERFDATA_BUFFER" ] && PERF_DATA="$PERF_DATA $PERFDATA_BUFFER"

# Explain dynamic blocklist sections when the ruleset produced long output.
if [ -n "$LONG_OUTPUT" ]; then
    append_long ""
    append_long "Interpretation:"
    append_long "Ruleset structure lines show the table and chain inventory used for firewall effectiveness checks; blacklist sections show dynamic inet/filter sets referenced by drop or reject rules."
    append_long "Empty table and chain checks, nftables service state, and ruleset readability decide the exit code."
    append_long "Named and inline counter perfdata is context for traffic volume. Inspect the named empty table/chain first when the summary reports a firewall structure failure."
fi

# Empty tables or chains indicate a loaded but ineffective firewall.
if [ -n "$CHAIN_EMPTY" ]; then
    emit_check "nftables has no rules in chain(s): $CHAIN_EMPTY" "$PERF_DATA"
    exit 2
fi
if [ -n "$TABLE_EMPTY" ]; then
    emit_check "nftables has no rules in table(s): $TABLE_EMPTY" "$PERF_DATA"
    exit 2
fi

# Build a human-readable blacklist summary for the visible monitoring status line.
if [ "$BL_ITEMS" -eq 0 ]; then
    BLACKLIST_SUMMARY="no IP addresses in blacklist"
elif [ "$BL_ITEMS" -eq 1 ]; then
    BLACKLIST_SUMMARY="blacklist contains 1 IP address"
else
    BLACKLIST_SUMMARY="blacklist contains $BL_ITEMS IP addresses"
fi

# Final healthy summary includes rule/table counts and bounded blacklist detail.
emit_check "nftables has $TOTAL_RULES rules in $TABLE_COUNT table(s), $BLACKLIST_SUMMARY" "$PERF_DATA"
exit 0
