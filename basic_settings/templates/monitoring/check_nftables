#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf '%s\n' "$*" >&2
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
LSMOD=$(command -v lsmod 2>/dev/null) || die "lsmod not available"
NFT=$(command -v nft 2>/dev/null) || die "nft not available"
SORT=$(command -v sort 2>/dev/null) || die "sort not available"
<% if @systemd_enable -%>
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
<% end -%>
TR=$(command -v tr 2>/dev/null) || die "tr not available"

# Set some default values
BL_ITEMS=0
CHAIN_EMPTY=""
FILTER_SECTION_COUNT=0
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_NFT_NL__"
PREF_LIST=""
RULES_TOTAL=0
SEQ=0
TABLE_COUNT=0
TABLE_EMPTY=""
TABLE_PERF=""
TOTAL_RULES=0

# Emit a CRITICAL result and stop immediately.
crit() {
    printf '%s\n' "$*" >&2
    exit 2
}

# Add one perfdata item to the sortable buffer.
add_pd() {
    LABEL_FORMAT=$(printf '%s' "$1" | $TR -c 'A-Za-z0-9_' '_')
    PREF_LIST="${PREF_LIST}${LABEL_FORMAT} ${2:-0}\n"
}

# Append one line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Emit the summary line and optional long output.
emit_check() {
    printf '%s | %s\n' "$1" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        "$AWK" -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    printf "%s\n", lines[i]
                }
            }
        '
    fi
}

# Read one IP set and serialize its items as a comma-separated list.
collect_ip_set_csv() {
    $NFT list set "$1" "$2" "$3" 2>/dev/null | $AWK '
        BEGIN { done=0; in_elements=0; data="" }
        done { next }
        {
            if ($0 ~ /elements[[:space:]]*=/) {
                in_elements=1
            }
            if (in_elements) {
                data = data " " $0
                if ($0 ~ /}/) {
                    done=1
                }
            }
        }
        END {
            count = 0
            if (data == "") {
                exit
            }

            sub(/^.*elements[[:space:]]*=[[:space:]]*\{/, "", data)
            sub(/[[:space:]]*}[[:space:]]*$/, "", data)
            gsub(/[[:space:]]*,[[:space:]]*/, "\n", data)

            entries = split(data, raw_items, /\n/)
            for (i = 1; i <= entries; i++) {
                item = raw_items[i]
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", item)
                sub(/[[:space:]]+expires[[:space:]].*$/, "", item)
                sub(/[[:space:]]+timeout[[:space:]].*$/, "", item)
                sub(/[[:space:]]+comment[[:space:]].*$/, "", item)

                if (item == "") {
                    continue
                }

                if (item ~ /^[0-9]+(\.[0-9]+){3}(\/[0-9]+)?$/ || item ~ /^[0-9A-Fa-f:]+(\/[0-9]+)?$/) {
                    if (count == 0) {
                        output = item
                    } else {
                        output = output "," item
                    }
                    count++
                }
            }

            if (count > 0) {
                printf "%s", output
            }
        }
    '
}

# Count the number of comma-separated set items.
count_csv_items() {
    if [ -n "$1" ]; then
        printf '%s' "$1" | $AWK -F',' '{print NF}'
    else
        printf '0'
    fi
}

# Check whether a family/table/set key is used in a blocking rule.
is_blocking_set() {
    printf '%s\n' "$BLOCKING_SET_KEYS" | $AWK -v key="$1" '
        $0 == key { found=1; exit }
        END { exit(found ? 0 : 1) }
    '
}

# Render one filter-set section in the long output.
append_filter_section() {
    label=$1
    set_name=$2
    items_csv=$3

    item_count=$(count_csv_items "$items_csv")

    append_long "${label} addresses in ${set_name} filter (${item_count}):"
    if [ "$item_count" -eq 0 ]; then
        append_long "None"
        return
    fi

    old_ifs=$IFS
    IFS=','
    set -- $items_csv
    IFS=$old_ifs
    for item do
        append_long "- $item"
    done
}

<% if @systemd_enable -%>
# Check if nftables is running
$SYSTEMCTL is-active --quiet "nftables" || crit "nftables service is not active"

<% end -%>

# Kernel check
$LSMOD | $AWK '/\bnf_tables\b/' >/dev/null 2>&1 || crit "nf_tables kernel module not loaded"

# Try to get ruleset
RULESET=$($NFT list ruleset 2>/dev/null) || crit "cannot get ruleset"
[ -z "$RULESET" ] && crit "Ruleset empty"

# Analyze ruleset
KEYVALS=$(printf '%s' "$RULESET" | $AWK '
BEGIN {
    FS=" "; SUBSEP=SUBSEP; inside=0; tblkey=""; chainkey="";
}
{
    if ($1 == "table") { fam=$2; tab=$3; tblkey=fam SUBSEP tab; next }
    if ($1 == "chain") { inside=1; ch=$2; chainkey=tblkey SUBSEP ch; chain_seen[chainkey]=1; next }
    if (inside && $0 ~ /^[[:space:]]*}/) { inside=0; next }
    if (inside) {
        if ($0 ~ /^[[:space:]]*$/) next
        if ($0 ~ /^[[:space:]]*#/) next
        if ($1 == "type" || $1 == "policy") { chain_has_meta[chainkey]=1; next }
        if ($1 ~ /^(set|counter|flags|elements|size|timeout)$/) next
        rules_in_chain[chainkey]++
    }
}
END {
    total_rules=0; perf=""; empty_tables=""; empty_chains="";
    for (ck in chain_seen) {
        split(ck,a,SUBSEP); fam=a[1]; tab=a[2]; ch=a[3];
        rc = (ck in rules_in_chain) ? rules_in_chain[ck] : 0;
        if (!rc && !(ck in chain_has_meta)) empty_chains = empty_chains " " fam"/"tab"/"ch;
        table_key=fam SUBSEP tab; table_rules[table_key]+=rc;
    }
    for (t in table_rules) {
        split(t,b,SUBSEP); fam=b[1]; tab=b[2]; rc=table_rules[t];
        perf = perf "table_"fam"_"tab"=" rc " ";
        if (!rc) empty_tables = empty_tables " " fam"/"tab;
        total_rules+=rc; tblcount++;
    }
    printf "rules_total=%d\n", total_rules;
    printf "table_count=%d\n", tblcount;
    printf "table_perf=%s\n",  perf;
    printf "table_empty=%s\n", empty_tables;
    printf "chain_empty=%s\n",  empty_chains;
}')

# Parse keyvals
while IFS='=' read -r K V; do
    case "$K" in
        rules_total) TOTAL_RULES=$V ;;
        table_count) TABLE_COUNT=$V ;;
        table_perf)  TABLE_PERF=$V  ;;
        table_empty) TABLE_EMPTY=$V ;;
        chain_empty) CHAIN_EMPTY=$V ;;
    esac
done <<EOF
$KEYVALS
EOF

# Get dynamic set references used in drop/reject rules
BLOCKING_SET_KEYS=$(printf '%s' "$RULESET" | $AWK '
BEGIN { RS="\n"; fam=""; tab=""; inside=0 }
{
    line=$0

    if ($1=="table") { fam=$2; tab=$3; next }
    if ($1=="chain") { inside=1; next }
    if (inside && $0 ~ /^[[:space:]]*}/) { inside=0; next }
    if (!inside) next

    gsub(/comment[[:space:]]+"[^"]*"/, "", line)
    if (line !~ /(^|[[:space:]])(drop|reject)([[:space:]]|$)/) next

    while (match(line, /@[[:alnum:]_.-]+/)) {
        setn = substr(line, RSTART + 1, RLENGTH - 1)
        key = fam "|" tab "|" setn
        if (!seen[key]++) print key
        line = substr(line, RSTART + RLENGTH)
    }
}')

# Get dynamic sets
DYNSETS=$(printf '%s' "$RULESET" | $AWK '
BEGIN { RS="\n"; fam=""; tab=""; inst=0; dyn=0; setn=""; settype="" }
{
    if ($1=="table") { fam=$2; tab=$3 }
    if ($1=="set")   { setn=$2; dyn=(index($0,"dynamic")>0); inst=1; settype=""; next }
    if (inst) {
        if ($1=="type" || $1=="typeof") {
            settype=$0
            sub(/^[[:space:]]+/, "", settype)
        }
        if (index($0,"dynamic")>0) dyn=1
        if ($0 ~ /}/) {
            if (dyn) print fam "|" tab "|" setn "|" settype
            inst=0; dyn=0; settype=""
        }
    }
}')

# Read dynamic IP set data used by blocking rules and render matching inet/filter sets.
if [ -n "$BLOCKING_SET_KEYS" ] && [ -n "$DYNSETS" ]; then
    while IFS='|' read -r FAM TAB SET SET_TYPE; do
        [ -z "$FAM" ] && continue
        SET_KEY="${FAM}|${TAB}|${SET}"
        is_blocking_set "$SET_KEY" || continue
        [ "$FAM" = "inet" ] || continue
        [ "$TAB" = "filter" ] || continue

        ITEMS_CSV=$(collect_ip_set_csv "$FAM" "$TAB" "$SET")
        CNT=$(count_csv_items "$ITEMS_CSV")
        BL_ITEMS=$((BL_ITEMS + CNT))

        case "$SET_TYPE" in
            type\ ipv4_addr*|typeof\ ip\ saddr*)
                [ "$FILTER_SECTION_COUNT" -gt 0 ] && append_long ""
                append_filter_section "IPv4" "$SET" "$ITEMS_CSV"
                FILTER_SECTION_COUNT=$((FILTER_SECTION_COUNT + 1))
                ;;
            type\ ipv6_addr*|typeof\ ip6\ saddr*)
                [ "$FILTER_SECTION_COUNT" -gt 0 ] && append_long ""
                append_filter_section "IPv6" "$SET" "$ITEMS_CSV"
                FILTER_SECTION_COUNT=$((FILTER_SECTION_COUNT + 1))
                ;;
        esac
    done <<EOF
$DYNSETS
EOF
fi

# Get named counters
NAMED_CTRS=$(printf '%s' "$RULESET" | $AWK '
BEGIN {
    RS = "}"
    FS = "[[:space:]]+"
}
/^[[:space:]]*counter[[:space:]]+[A-Za-z0-9_]+[[:space:]]+packets/ {
    if ($2 == "packets") next
    for (i = 1; i <= NF; i++) {
        if ($i == "packets" && (i + 1) <= NF) {
            pkt_val = $(i + 1)
            if (pkt_val > 0)
                print $2, pkt_val
            break
        }
    }
}')

# Process named counters
if [ -n "$NAMED_CTRS" ]; then
    while IFS=' ' read -r N P; do
        add_pd "ctr_${N}_pkts" "$P";
    done <<EOF
$NAMED_CTRS
EOF
fi

# Inline counters 
INLINE_CTRS=$(printf '%s' "$RULESET" | $AWK '
BEGIN { seq = 0 }
{
    if ($0 ~ /counter[[:space:]]+packets[[:space:]]+[0-9]+/) {
        n = split($0, f, /[[:space:]]+/)
        val = 0
        for (i = 1; i <= n; i++)
            if (f[i] == "counter" && i + 2 <= n && f[i + 1] == "packets") {
                val = f[i + 2]; break
            }

        if (val == 0) next

        lbl = ""
        if (match($0, /comment[[:space:]]+"[^"]+"/)) {
            c = substr($0, RSTART, RLENGTH)
            sub(/^comment[[:space:]]+"/, "", c)
            sub(/"$/, "", c)
            lbl = c
        } else {
            seq++; lbl = "anon_" seq
        }

        gsub(/[^A-Za-z0-9_]+/, "_", lbl)
        lbl = tolower(lbl)
        isdrop = (index($0, " drop") > 0) ? 1 : 0
        print lbl, val, isdrop
    }
}')

# Process inline counters
if [ -n "$INLINE_CTRS" ]; then
    while read -r LABEL VALUE ISDROP;do
        add_pd "rule_${LABEL}_pkts" "$VALUE"
        [ "$ISDROP" -eq 1 ] && add_pd "rule_${LABEL}_drops" "$VALUE"
    done <<EOF
$INLINE_CTRS
EOF
fi

# Set performance data
PREF_LIST=$(printf '%b' "$PREF_LIST" | $SORT -k2,2nr | $AWK '{printf "%s=%s ", $1, $2}')
PERF_DATA="rules_total=$TOTAL_RULES blacklist_items=$BL_ITEMS $PREF_LIST"

# Check some values
if [ -n "$CHAIN_EMPTY" ]; then
    emit_check "No rules in chain(s): $CHAIN_EMPTY" "$PERF_DATA"
    exit 2
fi
if [ -n "$TABLE_EMPTY" ]; then
    emit_check "No rules in table(s): $TABLE_EMPTY" "$PERF_DATA"
    exit 2
fi

# Show output
emit_check "$TOTAL_RULES rules in $TABLE_COUNT table(s), blacklist=$BL_ITEMS" "$PERF_DATA"
exit 0
