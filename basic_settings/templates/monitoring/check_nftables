#!/bin/sh
# Managed by puppet

<%= scope.function_template(['basic_settings/monitoring/_output']) %>

# Runtime: nftables, jq with exact decimal literals, coreutils and awk (systemd helper).
# One kernel snapshot supplies structure, dynamic blacklists and cumulative byte counters.
# Structural CRITICAL precedes service inspection; required service CRITICAL precedes incomplete counters.
# Counter labels retain the old normalization but now carry bytes, not packets. No local rates or state.
die() {
    monitor_error 'nftables check cannot run: ' "$*"
    exit 3
}

# Discover only tools used by this check; the shared helper discovers systemctl on its own route.
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
NFT=$(command -v nft 2>/dev/null) || die "nft not available"
JQ=$(command -v jq 2>/dev/null) || die "jq not available"
SHA256SUM=$(command -v sha256sum 2>/dev/null) || die "sha256sum not available"

# The detail budget never limits inventory, perfdata or the final interpretation.
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
HASH_DATA=""
SERVICE_CONTEXT=""
COUNTER_ERROR=""
USAGE_TEXT="Usage: $0 [-l chars]
Environment: DETAIL_LIMIT (-l), default 6000.
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':l:h' opt; do
    case "$opt" in
        l) DETAIL_LIMIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"

# Direct failures retain their short output contract.
crit() {
    monitor_error 'nftables ' "$*"
    exit 2
}

# Convert number literals to decimal strings before any grouping, comparison or serialization.
# Object keys are canonicalized recursively; only literal match sets are unordered.
# Rule statements, concatenations, ranges and all other arrays retain their meaningful order.
analyze_ruleset() {
    $JQ -cse '
        def text: tostring | gsub("[\\x00-\\x1f\\x7f]"; " ") | gsub("\\|"; "[or]");
        def name_ok: type == "string" and length > 0;
        def fields_ok($keys): . as $o | type == "object" and all($keys[]; $o[.] | name_ok);
        def table_key: [.family, .table];
        def chain_key: [.family, .table, (.chain // .name)];
        def object_key: [.family, .table, .name];
        def scope_text: [.family, .table, (.chain // .name)] | map(select(. != null)) | join("/") | text;
        def rule_label: gsub("[^A-Za-z0-9_]+"; "_") | ascii_downcase;
        def named_label:
            explode | map([.] | implode | if test("^[A-Za-z0-9_]$") then ascii_downcase
                else "_" * utf8bytelength end) | join("");
        def canonical:
            if type == "object" then to_entries | sort_by(.key) | map(.value |= canonical) | from_entries
            elif type == "array" then map(canonical) else . end;
        def match_sets:
            if type == "object" then
                with_entries(.value |= match_sets)
                | if keys == ["set"] and (.set | type) == "array" then .set |= sort_by(tojson) else . end
            elif type == "array" then map(match_sets) else . end;
        def expression_identity:
            map(if has("counter") and (.counter | type) == "object" then
                    .counter |= del(.bytes, .packets)
                elif has("match") then .match |= (canonical | match_sets)
                else . end) | canonical;
        def byte_text:
            if type == "number" then tostring
                | if test("^(0|[1-9][0-9]*)$") and
                    (length < 20 or (length == 20 and . <= "18446744073709551615"))
                  then . else null end
            else null end;
        def statement_ok:
            type == "object" and length == 1 and
            (if has("match") then .match | type == "object" and has("left") and has("right")
                and (.op | type == "string") and .left != null and .right != null
             elif has("drop") then .drop == null
             elif has("accept") then .accept == null
             elif has("reject") then .reject == null or (.reject | type) == "object"
             else true end);
        def rule_ok:
            (.expr | type) == "array" and (.expr | length) > 0 and all(.expr[]; statement_ok)
            and ((has("comment") | not) or (.comment | type) == "string");
        def known_object:
            type == "object" and length == 1 and
            (keys[0] | IN("metainfo", "table", "chain", "rule", "set", "element", "counter",
                "map", "flowtable", "quota", "limit", "ct helper", "ct timeout", "ct expectation", "secmark", "synproxy"));
        def expression_text:
            if type != "object" then
                if type == "array" then "[" + (map(expression_text) | join(", ")) + "]" else tostring end
            elif keys == ["payload"] and (.payload | type == "object" and has("protocol") and has("field")) then
                .payload.protocol + " " + (.payload.field | if . == "saddr" then "src" elif . == "daddr" then "dst" else . end)
            elif keys == ["meta"] then "meta " + .meta.key
            elif keys == ["ct"] and (.ct | keys == ["key"]) then "ct " + .ct.key
            elif keys == ["prefix"] then (.prefix.addr | tostring) + "/" + (.prefix.len | tostring)
            elif keys == ["range"] then .range | map(expression_text) | join("-")
            elif keys == ["set"] and (.set | type) == "array" then "{" + (.set | map(expression_text) | join(", ")) + "}"
            else canonical | tojson end;
        def conditions:
            [(.expr | expression_identity)[] | if has("match") then
                (.match.left | expression_text) + " " + .match.op + " " + (.match.right | expression_text)
             elif has("limit") then "limit " + (.limit | canonical | tojson)
             elif has("quota") then "quota " + (.quota | canonical | tojson)
             else empty end] | join("; ");
        def description:
            (.expr | expression_identity) as $expr
            | [(.comment // "" | select(length > 0)),
                ($expr[] | if has("counter") then empty
                    elif has("match") then (.match.left | expression_text) + " " + .match.op + " " + (.match.right | expression_text)
                    elif . == {"accept":null} then "accept"
                    elif . == {"drop":null} then "drop"
                    else canonical | tojson end)] | join("; ") | text;
        def later_conditions($position):
            any(.expr[($position + 1):][]; has("match") or has("limit") or has("quota"));
        def docker_empty:
            (.family == "ip" or .family == "ip6") and
            ((.table == "filter" and (.name | IN("DOCKER-USER", "DOCKER", "DOCKER-BRIDGE", "DOCKER-CT", "DOCKER-INTERNAL")))
             or (.table == "nat" and .name == "DOCKER"));
        def ip4:
            type == "string" and test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}$")
            and (split(".") | all(.[]; tonumber <= 255));
        def ip6:
            if type != "string" then false else
                . as $ip | split("::") as $halves
                | split(":") | map(select(. != "")) as $groups
                | ([$groups[] | if test("\\.") then 2 else 1 end] | add // 0) as $size
                | ($halves | length <= 2) and ($ip | contains(":"))
                  and all($groups[]; test("^[0-9A-Fa-f]{1,4}$") or ip4)
                  and (all($groups[0:-1][]; contains(".") | not))
                  and (if $halves | length == 2 then $size < 8
                       else $size == 8 and ($ip | startswith(":") or endswith(":") | not) end)
                  and ($ip | contains(":::") | not)
            end;
        def address($kind): if (if $kind == "IPv4" then ip4 else ip6 end) then . else error("invalid address") end;
        def entry($kind):
            if type == "string" then
                split("/") as $parts
                | if ($parts | length) == 1 then address($kind)
                  elif ($parts | length) == 2 and ($parts[1] | test("^[0-9]+$")) then
                    $parts[0] | address($kind)
                    | if ($parts[1] | tonumber) <= (if $kind == "IPv4" then 32 else 128 end)
                      then . + "/" + $parts[1] else error("invalid prefix") end
                  else error("invalid address") end
            elif type == "object" and has("elem") then .elem.val | entry($kind)
            elif type == "object" and keys == ["prefix"] then
                if (.prefix.len | type) != "number" or (.prefix.len | tostring | test("^[0-9]+$") | not)
                then error("invalid prefix") else
                    .prefix as $p | $p.addr | address($kind)
                    | if $p.len <= (if $kind == "IPv4" then 32 else 128 end)
                      then . + "/" + ($p.len | tostring) else error("invalid prefix") end end
            elif type == "object" and keys == ["range"] and (.range | type == "array" and length == 2) then
                .range | map(address($kind)) | join("-")
            else error("unsupported address element") end;
        def elements: if has("elem") then .elem | if type == "array" then .[] else . end else empty end;
        def address_type:
            (if has("typeof") then {typeof:.typeof} else .type end) as $type
            | if $type == "ipv4_addr" or $type == ["ipv4_addr"] then "IPv4"
              elif $type == "ipv6_addr" or $type == ["ipv6_addr"] then "IPv6"
              elif ($type | type) == "object" and ($type | has("typeof")) then
                $type.typeof
                | if . == "ip saddr" or . == "ip daddr" or . == {payload:{protocol:"ip",field:"saddr"}}
                    or . == {payload:{protocol:"ip",field:"daddr"}} then "IPv4"
                  elif . == "ip6 saddr" or . == "ip6 daddr" or . == {payload:{protocol:"ip6",field:"saddr"}}
                    or . == {payload:{protocol:"ip6",field:"daddr"}} then "IPv6"
                  else null end
              else null end;
        def set_references:
            .expr[] | if has("match") then
                (.match.left, .match.right) | .. | strings | select(startswith("@")) | ltrimstr("@")
            elif has("set") and (.set.op == "add" or .set.op == "update") then
                .set.set | if type == "string" then ltrimstr("@") else error("invalid set reference") end
            else empty end;

        # Slurping rejects empty output and multiple JSON documents as well as a missing inventory.
        (if length != 1 or (.[0] | type) != "object" or (.[0].nftables | type) != "array"
        then error("expected one object with an nftables array") else .[0].nftables end) as $objects
        | [ $objects[] | objects | select(has("table")) | .table ] as $raw_tables
        | [ $objects[] | objects | select(has("chain")) | .chain ] as $raw_chains
        | [ $objects[] | objects | select(has("rule")) | .rule ] as $raw_rules
        | [ $objects[] | objects | select(has("set")) | .set ] as $raw_sets
        | [ $objects[] | objects | select(has("counter")) | .counter ] as $raw_named
        | [ $objects[] | objects | select(has("element")) | .element ] as $raw_elements
        | [$raw_tables[] | select(fields_ok(["family","name"]))] as $tables
        | [$raw_chains[] | select(fields_ok(["family","table","name"]))] as $chains
        | [$raw_rules[] | select(fields_ok(["family","table","chain"]))] as $rules
        | [$raw_sets[] | select(fields_ok(["family","table","name"]))] as $sets
        | [$raw_named[] | select(fields_ok(["family","table","name"]))] as $named
        | [$raw_elements[] | select(fields_ok(["family","table","name"]))] as $elements
        | [$tables[] | [.family,.name]] as $table_keys
        | [$chains[] | chain_key] as $chain_keys
        | [$sets[] | object_key] as $set_keys
        | [$named[] | object_key] as $named_keys
        | [$rules[] | select(rule_ok)] as $readable_rules
        | [
            ($objects[] | select(type != "object" or length != 1) | "invalid nftables inventory object"),
            ($objects[] | objects | select(known_object | not) | keys | join(", ")
                | "unsupported nftables inventory object: " + text),
            (if ($raw_tables|length) != ($tables|length) or ($raw_chains|length) != ($chains|length)
                or ($raw_rules|length) != ($rules|length) or ($raw_sets|length) != ($sets|length)
                or ($raw_named|length) != ($named|length) or ($raw_elements|length) != ($elements|length)
             then "invalid scope in table, chain, rule, set, counter or element object" else empty end),
            (($chains + $rules + $sets + $named + $elements)[] | . as $o
                | select($table_keys | index([$o | table_key]) | not)
                | "missing parent table: " + (scope_text)),
            ($rules[] | . as $r | select($chain_keys | index([$r | chain_key]) | not)
                | "missing parent chain: " + scope_text),
            ($elements[] | . as $e | select($set_keys | index([$e | object_key]) | not)
                | "missing parent set: " + scope_text),
            ($tables | group_by([.family,.name])[] | select(length > 1) | "duplicate table: " + (.[0] | scope_text)),
            ($chains | group_by(chain_key)[] | select(length > 1) | "duplicate chain: " + (.[0] | scope_text)),
            ($sets | group_by(object_key)[] | select(length > 1) | "duplicate set: " + (.[0] | scope_text)),
            ($chains[] | select((has("type") and (.type | name_ok | not)) or (has("policy") and (.policy | name_ok | not)))
                | "invalid chain metadata: " + scope_text),
            ($rules[] | select(rule_ok | not)
                | "invalid rule expression or comment: " + scope_text)
          ] as $structure_errors
        | [$readable_rules[] | . as $r
            | try (if any(.expr[] | del(.counter); .. | objects | has("counter")) then
                {error:("unsupported nested rule counter: " + scope_text)}
              else
                .expr | to_entries[] | select(.value | has("counter")) | .key as $position | .value.counter as $counter
                | if ($counter | type) == "string" then
                    if $named_keys | index([[$r.family,$r.table,$counter]]) then empty
                    else {error:("missing named counter: " + ([$r.family,$r.table,$counter] | join("/") | text))} end
                  elif ($counter | type) != "object" or ($counter | keys - ["bytes","packets"] | length) > 0 then
                    {error:("unsupported rule counter at statement " + ($position|tostring) + ": " + ($r|scope_text))}
                  else
                    ($r.expr | expression_identity) as $expr
                    | {label:("rule_" + (if ($r.comment // "" | test("[A-Za-z0-9_]")) then $r.comment
                            else ($r | conditions | if length > 0 then . else "unconditional" end) end | rule_label)),
                       drops:any($r.expr[]; . == {"drop":null}),
                       rejects:any($r.expr[]; has("reject")),
                       context:(([$r.family,$r.table,$r.chain,($r|conditions),"at",($position|tostring)] | join("_") | rule_label)),
                       identity:({object:"rule",family:$r.family,table:$r.table,chain:$r.chain,
                           expr:$expr,comment:($r.comment // null),position:$position} | canonical),
                       bytes:($counter.bytes | byte_text), scope:($r|scope_text),
                       detail:(($r|scope_text) + ": " + ($r|description)),
                       early:($r|later_conditions($position)),
                       valid: (($table_keys | index([$r | table_key])) != null and
                           ($chain_keys | index([$r | chain_key])) != null)}
                  end
              end) catch {error:("unreadable rule counter: " + ($r|scope_text))}] as $rule_counters
        | [$named[] | . as $n
            | try ({label:("ctr_" + (.name|named_label)), context:([.family,.table]|join("_")|rule_label),
               identity:({object:"counter",family:.family,table:.table,name:.name}|canonical),
               bytes:(.bytes|byte_text), scope:scope_text,
               valid:(($table_keys|index([$n|table_key])) != null), early:false,
               detail:((scope_text) + ": named counter; shared measurement; " +
                   ([$readable_rules[] | . as $r | .expr | to_entries[] | select(.value.counter? == $n.name) | .key as $position
                       | select($r.family == $n.family and $r.table == $n.table)
                       | ($r|scope_text) + ": " + ($r|description) +
                           (if $r|later_conditions($position) then "; counter precedes later conditions" else "" end)]
                    | if length == 0 then "no rule references" else sort | join(" / ") end))})
              catch {error:("unreadable named counter: " + ($n|scope_text))} ] as $named_counters
        | [$readable_rules[] | select(.family == "inet" and .table == "filter")
            | select(any(.expr[]; has("drop") or has("reject")))
            | try (set_references | {name:.}) catch {error:"invalid blocking set reference"}] as $references
        | [$references[] | select(has("name")) | .name] | unique as $blocking
        | [$sets[] | select(.family == "inet" and .table == "filter") | . as $s
            | select($blocking | index($s.name))
            | try (
                (if has("flags") then .flags else [] end
                    | if type == "string" then [.] elif type == "array" and all(.[]; type == "string") then .
                      else error("invalid flags") end) as $flags
                | select($flags | index("dynamic"))
                | address_type as $kind
                | if $kind == null then
                    (if has("typeof") then .typeof
                     elif (.type | type) == "object" then .type.typeof else null end) as $typeof
                    | if (.type | name_ok) or (.type | type) == "array" and all(.type[]; name_ok)
                        or ($typeof | type == "object" and length == 1) or ($typeof | name_ok)
                    then empty else error("unreadable set type/typeof") end
                  else
                    if ($set_keys | map(select(. == ($s|object_key))) | length) != 1 then error("ambiguous set") else . end
                    | {name:(.name|text), scope:scope_text, kind:$kind,
                        items:([($s, ($elements[] | select(object_key == ($s|object_key)))) | elements | entry($kind)] | unique)}
                  end
              ) catch {name:($s.name|text),scope:($s|scope_text),error:("unreadable selected set: " + ($s|scope_text) + ": " + .)}]
          as $blacklists
        | ($rule_counters + $named_counters | map(select(has("identity")))) as $counters
        | ($counters | group_by(.identity) | map(if length > 1 then map(.valid = false | .error = ("ambiguous counter identity: " + .scope + " (" + .label + ")")) else . end) | add // [])
        # Preserve existing conflict names for non-drop counters before adding the action suffix.
        | map(.base_label = .label)
        | group_by(.label) | map(if length > 1 then map(.label += "_" + .context | .has_context = true) else . end) | add // []
        | group_by(.label) | map(if length > 1 then map(.hash = true) else . end) | add // []
        | map(if .drops then .label = (.base_label | rtrimstr("_drops")) +
            (if .has_context then "_" + .context else "" end) + "_drops" else . end)
        # Resolve new suffix collisions as well, including zero counters; keep _drops last.
        | group_by(.label) | map(if length > 1 then map(if .has_context then . else
            .label = (if .drops then .label | rtrimstr("_drops") else .label end) + "_" + .context +
                (if .drops then "_drops" else "" end) | .has_context = true end) else . end) | add // []
        | group_by(.label) | map(if length > 1 then map(.hash = true) else . end) | add // []
        # Add rejects after existing drop naming so unrelated labels retain their context and hashes.
        | map(.suffix = (if .rejects then "_rejects" elif .drops then "_drops" else "" end)
            | if .rejects then .label = (.base_label | rtrimstr("_rejects")) +
                (if .has_context then "_" + .context else "" end) + "_rejects" else . end)
        | group_by(.label) | map(if length > 1 then map(if .has_context then . else
            .suffix as $suffix | .label = (.label | rtrimstr($suffix)) + "_" + .context + $suffix
          end) else . end) | add // []
        | group_by(.label) | map(if length > 1 then map(.hash = true) else . end) | add // []
        | to_entries | map(.value + {slot:.key}) as $labelled
        | {
            rules_total:($raw_rules|length), table_count:($tables|length),
            empty_ruleset:($objects | all(.[]; type == "object" and keys == ["metainfo"])),
            chain_empty:([$chains[] | . as $c
                | select(all($objects[]; known_object))
                | select(($raw_rules|length) == ($rules|length))
                | select(($table_keys | index([$c|table_key])) != null)
                | select(any($rules[]; chain_key == ($c|chain_key)) | not)
                | select((has("type") or has("policy")) | not) | select(docker_empty|not) | scope_text] | sort),
            table_empty:([$tables[] | . as $t
                | select(all($objects[]; known_object))
                | select(($raw_rules|length) == ($rules|length))
                | select(any($rules[]; .family == $t.family and .table == $t.name) | not)
                | [.family,.name] | join("/") | text] | sort),
            allowed:([$chains[] | . as $c | select(docker_empty)
                | select(any($rules[]; chain_key == ($c|chain_key)) | not) | scope_text] | sort),
            blacklists:$blacklists,
            blacklist_items:(if any($blacklists[]; has("error")) or any($references[]; has("error"))
                or ($raw_rules|length) != ($readable_rules|length)
                or ($raw_sets|length) != ($sets|length) or ($raw_elements|length) != ($elements|length)
                or any($blocking[]; . as $name | any($sets[]; .family == "inet" and .table == "filter" and .name == $name) | not)
                then "U" else [$blacklists[] | .items | length] | add // 0 end),
            counters:$labelled,
            errors:($structure_errors + [$rule_counters[], $named_counters[], $references[], $blacklists[] | .error // empty] +
                [$labelled[] | .error // empty, (if .bytes == null then "invalid byte value: " + .scope + " (" + .label + ")" else empty end)] +
                [$blocking[] | . as $name | select(any($sets[]; .family == "inet" and .table == "filter" and .name == $name) | not)
                    | "missing blocking set: inet/filter/" + ($name|text)] +
                [($sets + $elements)[] | select(any(.elem | .. | objects; has("counter")))
                    | "unsupported set-element counter: " + scope_text] | unique)
          }
    '
}

# Resolve only remaining conflicts with SHA-256 of canonical UTF-8 JSON, without a newline.
# Slots join internal records only; they never enter a label or its identity.
finish_counters() {
    $JQ -cs --arg error "$COUNTER_ERROR" '
        .[0] as $report | .[1:] as $hashes
        | $report
        | .counters |= map(. as $counter | if .hash then
            ($hashes | map(select(.[0] == $counter.slot)) | .[0][1]) as $hash
            | if ($hash | type) == "string" and ($hash | test("^[0-9a-f]{64}$"))
              then .suffix as $suffix | .label = (.label | rtrimstr($suffix)) + "_" + $hash[0:16] + $suffix
              else .valid = false | .error = "counter identity hash unavailable" end
          else . end)
        | .counters |= (group_by(.label) | map(if length > 1 then
            map(.valid = false | .error = ("counter label collision: " + .label)) else . end) | add // [])
        | .errors += [.counters[] | .error // empty]
        | if $error != "" then .errors += [$error] | .counters |= map(.valid = false) else . end
        | .errors |= unique
        | .counters |= (map(select(.valid and .bytes != null and .bytes != "0"))
            | group_by([(.bytes|length),.bytes]) | reverse | map(sort_by(.label)) | add // [])
    '
}

# Byte values are already validated decimal strings; no numeric conversion occurs here.
format_perfdata() {
    $JQ -r '(["rules_total=" + (.rules_total|tostring), "blacklist_items=" + (.blacklist_items|tostring)] +
        [.counters[] | .label + "=" + .bytes + "c"]) | join(" ")'
}

# Keep diagnostics ahead of byte details and Interpretation outside the shared detail budget.
# JSON strings carry all text between stages; no delimiter in a comment can split a record.
emit_check() {
    output_records=$(printf '%s' "$REPORT" | $JQ -r --arg service "$SERVICE_CONTEXT" --arg counter_error "$COUNTER_ERROR" '
        def safe: gsub("[\\x00-\\x1f\\x7f]"; " ");
        if $counter_error != "" then .counters = [] | .errors += [$counter_error] | .errors |= unique else . end
        | [
            ["section", "Ruleset structure"],
            ["item", "Rules: \(.rules_total); tables: \(.table_count)"],
            (if .chain_empty|length > 0 then ["item", "Empty chains: " + (.chain_empty|join(" "))] else empty end),
            (if .table_empty|length > 0 then ["item", "Empty tables: " + (.table_empty|join(" "))] else empty end),
            (if .allowed|length > 0 then ["item", "Allowed empty Docker chains: " + (.allowed|join(" "))] else empty end),
            (.errors[] | ["item", "Incomplete inspection: " + .]),
            ["section", "Service"], ($service | select(length > 0) | ["item", .]),
            ["section", "Blacklists"],
            (.blacklists[] |
                ["item", "\(.name): \(if .error then "inspection unavailable" else "\(.items|length) addresses" end)"],
                (if .error then ["continuation", .error] else (.items[] | ["continuation", .]) end)),
            ["section", "Traffic counters"],
            (.counters[] | ["item", .label + ": " + .bytes + " bytes"], ["continuation", .detail],
                (if .early then ["continuation", "Counter precedes later conditions and can include traffic rejected later in this rule."] else empty end))
          ] | .[] | map(safe) | join("\t")
    ')
    output_tab=$(printf '\t')
    while IFS="$output_tab" read -r output_kind output_text; do
        case "$output_kind" in
            section) monitor_section "$output_text" ;;
            item) monitor_item "$output_text" ;;
            continuation) monitor_continuation "$output_text" ;;
        esac
    done <<EOF
$output_records
EOF
    monitor_limit "$DETAIL_LIMIT"
    monitor_section "Interpretation"
    monitor_item "Ruleset structure and the required systemd loader decide availability. Incomplete inspection is unknown unless a critical defect is established; neither proves packet reachability."
    monitor_item "Blacklists are dynamic inet/filter address sets used by drop or reject rules; entries alone do not raise an alarm. Allowed empty Docker chains do not excuse empty tables."
    monitor_item "Counters measure cumulative bytes at their rule position. Only valid positive counters have perfdata; omitted counters do not prove absent rules. Named counters are shared measurements."
    monitor_item "Do not sum rule counters: traffic can cross several counters, earlier acceptance can bypass them, and replies need output counters. Monitoring handles rates/resets; keep old packet history separate from the byte baseline."
    monitor_item "Inspect the named empty chains, tables and incomplete sources before interpreting traffic."
    if [ "${2:-0}" -eq 1 ]; then
        monitor_prepend 'Firewall findings' "$1" 'Inspect the named chains, tables and incomplete sources.'
    fi
    monitor_result "$1" "$PERF_DATA"
}

<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
<% end -%>

# Validate the effective CLI/environment value before any observation.
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] 2>/dev/null || die "long-output detail character limit must be at least 1"

# nft uses netlink: loaded rules need neither a persistent daemon nor a configuration file.
# Never hide a failed nft call behind a successful parser.
RULESET=$($NFT -j -n list ruleset 2>/dev/null) || die "ruleset cannot be read"
REPORT=$(printf '%s' "$RULESET" | analyze_ruleset 2>/dev/null) || die "invalid or incomplete nftables JSON"
GENERAL_PERF_DATA=$(printf '%s' "$REPORT" | $JQ -r '"rules_total=\(.rules_total) blacklist_items=\(.blacklist_items)"')

# Exercise this build through the same extraction, selection, sorting and formatting path.
# Compare literal expected strings: jq-number equality itself can round on unsuitable builds.
PRECISION_REPORT=$(analyze_ruleset <<'JSON'
{"nftables":[{"table":{"family":"inet","name":"probe"}},{"chain":{"family":"inet","table":"probe","name":"input"}},{"counter":{"family":"inet","table":"probe","name":"large","bytes":18446744073709551615,"packets":0}},{"rule":{"family":"inet","table":"probe","chain":"input","comment":"large","expr":[{"counter":{"bytes":9007199254740993,"packets":0}},{"accept":null}]}}]}
JSON
) || COUNTER_ERROR="jq cannot preserve exact counter integers"
PRECISION_FINAL=$(printf '%s' "$PRECISION_REPORT" | finish_counters) || COUNTER_ERROR="jq cannot preserve exact counter integers"
PRECISION_DATA=$(printf '%s' "$PRECISION_FINAL" | format_perfdata) || COUNTER_ERROR="jq cannot preserve exact counter integers"
[ "$PRECISION_DATA" = 'rules_total=1 blacklist_items=0 ctr_large=18446744073709551615c rule_large=9007199254740993c' ] || COUNTER_ERROR="jq cannot preserve exact counter integers"

# Only canonical JSON and numeric slots cross this tab-separated internal hash handoff.
HASH_ROWS=$(printf '%s' "$REPORT" | $JQ -r '.counters[] | select(.hash) | [(.slot|tostring),(.identity|tojson)] | join("\t")') || COUNTER_ERROR="counter identities cannot be read"
if [ -n "$HASH_ROWS" ]; then
    while IFS="$(printf '\t')" read -r SLOT IDENTITY; do
        HASH=$(printf '%s' "$IDENTITY" | $SHA256SUM) || HASH=""
        HASH=${HASH%% *}
        HASH_DATA=$(printf '%s\n[%s,"%s"]' "$HASH_DATA" "$SLOT" "$HASH")
    done <<EOF
$HASH_ROWS
EOF
fi
if FINAL_REPORT=$(printf '%s\n%s' "$REPORT" "$HASH_DATA" | finish_counters); then
    REPORT=$FINAL_REPORT
else
    COUNTER_ERROR="counter labels cannot be resolved"
fi
PERF_DATA=$GENERAL_PERF_DATA
if [ -z "$COUNTER_ERROR" ]; then
    PERF_DATA=$(printf '%s' "$REPORT" | format_perfdata) || COUNTER_ERROR="counter perfdata cannot be formatted"
fi
[ -z "$COUNTER_ERROR" ] || PERF_DATA=$GENERAL_PERF_DATA

# Preserve detailed chain/table failures and their priority over supplementary service inspection.
CHAIN_EMPTY=$(printf '%s' "$REPORT" | $JQ -r '.chain_empty | join(" ")')
TABLE_EMPTY=$(printf '%s' "$REPORT" | $JQ -r '.table_empty | join(" ")')
if [ -n "$CHAIN_EMPTY" ]; then
    emit_check "nftables has no rules in chain(s): $CHAIN_EMPTY" 1
    exit 2
fi
if [ -n "$TABLE_EMPTY" ]; then
    emit_check "nftables has no rules in table(s): $TABLE_EMPTY" 1
    exit 2
fi
if [ "$(printf '%s' "$REPORT" | $JQ -r '.empty_ruleset')" = true ]; then
    printf 'nftables ruleset is empty | %s\n' "$PERF_DATA"
    exit 2
fi
<% if @systemd_enable != false -%>
check_systemd_service nftables.service
<% else -%>
SERVICE_CONTEXT="Firewall availability is verified through the loaded kernel rules."
<% end -%>

# Reliable counters remain available beside an explicit incomplete-inspection result.
INSPECTION_ERROR=$COUNTER_ERROR
[ -n "$INSPECTION_ERROR" ] || INSPECTION_ERROR=$(printf '%s' "$REPORT" | $JQ -r '.errors[0] // empty')
if [ -n "$INSPECTION_ERROR" ]; then
    emit_check "nftables inspection incomplete: $INSPECTION_ERROR" 1
    exit 3
fi
SUMMARY=$(printf '%s' "$REPORT" | $JQ -r '
    "nftables has \(.rules_total) rules in \(.table_count) table(s), " +
    (if .blacklist_items == 0 then "no IP addresses in blacklist"
     elif .blacklist_items == 1 then "blacklist contains 1 IP address"
     else "blacklist contains \(.blacklist_items) IP addresses" end)')
emit_check "$SUMMARY"
exit 0
