#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'Auditd check cannot run: %s\n' "$*"
    if [ -n "${CRITICAL_REASONS:-}" ]; then
        printf 'Verified failures: %s\n' "$CRITICAL_REASONS"
        exit 2
    fi
    exit 3
}

<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
<% end -%>

# Parse command output independently of the host locale.
LC_ALL=C
export LC_ALL

# Binary checks
AUDITCTL=$(command -v auditctl 2>/dev/null) || die "auditctl not available"
AUSEARCH=$(command -v ausearch 2>/dev/null || true)
AUREPORT=$(command -v aureport 2>/dev/null || true)
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CUT=$(command -v cut 2>/dev/null) || die "cut not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
<% if @systemd_enable != false -%>
if use_systemd; then
    JOURNALCTL=$(command -v journalctl 2>/dev/null || true)
fi
<% end -%>
TR=$(command -v tr 2>/dev/null) || die "tr not available"
UNAME=$(command -v uname 2>/dev/null) || die "uname not available"

# Hardware paths are optional context for physical inventory in alert output.
DMI_DIR="/sys/devices/virtual/dmi/id"

# Queue thresholds protect against dropped audit events and can be tuned at runtime.
DROPPED_CRIT=${DROPPED_CRIT:-"1"}
QUEUE_WARN=${QUEUE_WARN:-""}

# Summary state accumulates security-sensitive audit findings while keeping context in long output.
CRITICAL_REASONS=""
HW_SEG=""
LONG_OUTPUT=""
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
LONG_OUTPUT_SEP="__CHECK_AUDIT_NL__"
STATE_CODE=0 # 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN
USAGE_TEXT="Usage: $0 [-q <int>] [-d <int>] [-l chars]
Environment: QUEUE_WARN (-q); DROPPED_CRIT (-d); DETAIL_LIMIT (-l).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
WARNING_REASONS=""
UNKNOWN_REASONS=""

# CLI options tune queue and lost-event thresholds without changing the managed rule set.
OPTERR=0
while getopts ':q:d:l:h' opt; do
    case "$opt" in
        q) QUEUE_WARN="$OPTARG" ;;
        d) DROPPED_CRIT="$OPTARG" ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"

# Runtime thresholds are numeric audit counters and must fail before host state is evaluated.
case "$DROPPED_CRIT" in
    ''|*[!0-9]*) die "dropped threshold must be numeric" ;;
esac
case "$QUEUE_WARN" in
    *[!0-9]*) die "queue warning threshold must be numeric" ;;
esac
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

# Read the first trimmed line from a file.
trim_file() {
    [ -r "$1" ] || return 1
    val=$($SED -n '1{s/[[:space:]]\+$//;p;q}' "$1" 2>/dev/null | $TR -d '\000\r\n') || return 1
    [ -n "$val" ] || return 1
    printf '%s' "$val"
}

# Keep audit keys, journal snippets, and hardware fields safe before perfdata.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Attach a custom perfdata UOM only when the value is numeric; Nagios U stays unit-free.
metric_with_unit() {
    case "$1" in
        ''|U) printf '%s' 'U' ;;
        *)    printf '%s%s' "$1" "$2" ;;
    esac
}

# Append a semicolon-separated reason to an existing summary bucket.
append_reason() {
    if [ -n "$1" ]; then
        printf '%s; %s\n' "$1" "$2"
    else
        printf '%s\n' "$2"
    fi
}

# Record a CRITICAL cause for the short output.
add_critical() {
    CRITICAL_REASONS=$(append_reason "$CRITICAL_REASONS" "$1")
    STATE_CODE=2
}

# Record a WARNING cause without overriding an existing CRITICAL state.
add_warning() {
    WARNING_REASONS=$(append_reason "$WARNING_REASONS" "$1")
    [ "$STATE_CODE" -lt 1 ] && STATE_CODE=1
}

# Append one diagnostic line to the bounded long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
}

# Emit the summary line, perfdata, and sanitized detail output.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Emit a CRITICAL result and stop immediately.
crit() {
    printf '%s\n' "$(monitor_text_value "$1")"
    exit 2
}

# auditctl reads the kernel audit netlink interface, which has no equivalent procfs status/rule listing.
# The registered daemon PID and enabled flag establish runtime health independently of init and rule files.
AV_STAT=$(LC_ALL=C $AUDITCTL -s 2>/dev/null) || die "kernel audit status could not be read"
audit_value() {
    printf '%s\n' "$AV_STAT" | $AWK -v key="$1" '$1 == key && $2 ~ /^[0-9]+$/ { print $2; exit }'
}
ENABLED=$(audit_value enabled)
AUDIT_PID=$(audit_value pid)
BACKLOG=$(audit_value backlog)
LOST=$(audit_value lost)
BLIMIT=$(audit_value backlog_limit)
for audit_counter in "$ENABLED" "$AUDIT_PID" "$BACKLOG" "$LOST" "$BLIMIT"; do
    case "$audit_counter" in
        ''|*[!0-9]*) die "kernel audit status is incomplete or invalid" ;;
    esac
done
case "$ENABLED" in
    0) add_critical "kernel auditing is disabled" ;;
    1|2) : ;;
    *) die "kernel audit enabled flag is invalid" ;;
esac
[ "$AUDIT_PID" -eq 0 ] && add_critical "no audit daemon registered with the kernel"
append_long "Kernel audit status: enabled ${ENABLED}, daemon PID ${AUDIT_PID}"

# Use the kernel backlog limit as default warning threshold when Puppet did not pass one.
[ -z "$QUEUE_WARN" ] && QUEUE_WARN=$BLIMIT
case "$QUEUE_WARN" in
    ''|*[!0-9]*) die "queue warning threshold must be numeric" ;;
esac
if [ "$BACKLOG" -gt "$QUEUE_WARN" ]; then
    add_warning "audit backlog ${BACKLOG} is above the warning limit"
fi
if [ "$LOST" -gt "$DROPPED_CRIT" ]; then
    add_critical "lost audit events ${LOST} detected"
fi
append_long "Audit backlog: ${BACKLOG}/${BLIMIT}"
append_long "Lost audit events: ${LOST}"

# The daily audit summary is the authoritative source for account/config/anomaly counters.
SUM=""
if [ -z "$AUREPORT" ] || ! SUM=$(LC_ALL=C $AUREPORT --summary --start today 00:00:00 --end now 2>/dev/null); then
    UNKNOWN_REASONS="daily audit history unavailable"
fi

# Extract one numeric counter from the audit summary output.
get() {
    printf '%s\n' "$SUM" | $AWK -v p="$1" '
        index($0,p)==1 && $NF ~ /^[0-9]+$/ { value=$NF; found=1; exit }
        END { print found ? value : "U" }
    '
}

ACCT=$(get "Number of changes to accounts, groups, or roles:")
ANOM=$(get "Number of anomaly events:")
CFG=$(get "Number of changes in configuration:")
FAIL=$(get "Number of failed syscalls:")
FAILED_AUTH=$(get "Number of failed authentications:")
KEYS=$(get "Number of keys:")

# Preserve missing history as unknown, not zero, while retaining verified runtime failures.
for audit_counter in "$ACCT" "$ANOM" "$CFG" "$FAIL" "$FAILED_AUTH" "$KEYS"; do
    [ "$audit_counter" = U ] && UNKNOWN_REASONS="daily audit history unavailable or incomplete"
done

# Account, configuration, anomaly, syscall, and key events are security-sensitive.
if { [ "$ACCT" != U ] && [ "$ACCT" -gt 0 ]; } || { [ "$ANOM" != U ] && [ "$ANOM" -gt 0 ]; } || { [ "$CFG" != U ] && [ "$CFG" -gt 0 ]; } || { [ "$FAIL" != U ] && [ "$FAIL" -gt 0 ]; } || { [ "$KEYS" != U ] && [ "$KEYS" -gt 0 ]; }; then
    SECURITY_REASONS=""
    { [ "$ACCT" != U ] && [ "$ACCT" -gt 0 ]; } && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "account changes $ACCT")
    { [ "$ANOM" != U ] && [ "$ANOM" -gt 0 ]; } && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "anomaly events $ANOM")
    { [ "$CFG" != U ] && [ "$CFG" -gt 0 ]; } && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "config changes $CFG")
    { [ "$FAIL" != U ] && [ "$FAIL" -gt 0 ]; } && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "failed syscalls $FAIL")
    { [ "$KEYS" != U ] && [ "$KEYS" -gt 0 ]; } && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "keyed events $KEYS")
    add_critical "security events: ${SECURITY_REASONS}"
fi
append_long "Audit event counters: account changes ${ACCT}, anomaly events ${ANOM}, config changes ${CFG}, failed syscalls ${FAIL}, failed authentications ${FAILED_AUTH}, keyed events ${KEYS}"

<% if @systemd_enable != false -%>
if use_systemd && [ -n "$JOURNALCTL" ]; then
# Auditd and augenrules journal errors since boot indicate broken rule loading or runtime failures.
JLOG=$($JOURNALCTL -b -u auditd -u augenrules --no-pager -o cat 2>/dev/null)
JLOG_RC=$?
ERR_COMBINED=$(printf "%s\n" "$JLOG" | $AWK '
    {
        line=$0
        l=tolower(line)
        if (l ~ /(error|unknown)/) {
            c++
            errors[c]=line
        }
    }
    END{
        if (c==0) { print "0|"; exit }
        printf "%d|", c
        for (i=c; i>=1; i--) printf "%s%s", (i<c ? "; " : ""), errors[i]
    }')
ERROR_COUNT=${ERR_COMBINED%%|*}
[ "$JLOG_RC" -eq 0 ] || ERROR_COUNT=U
ERROR_SNIPPET=${ERR_COMBINED#*|}

# Journal errors override earlier OK text because they show audit runtime failure.
if [ "$ERROR_COUNT" != U ] && [ "$ERROR_COUNT" -gt 0 ]; then
    add_critical "journal errors since boot ${ERROR_COUNT}"
    append_long "Audit journal errors, newest first: ${ERROR_SNIPPET:-unknown}"
fi
else
<% end -%>
ERROR_COUNT=U
<% if @systemd_enable != false -%>
fi
<% end -%>
append_long "Journal errors since boot: ${ERROR_COUNT}"

# Loaded rule count verifies that auditd is enforcing something, not only running.
RULES_RAW=$($AUDITCTL -l 2>/dev/null) || die "audit rules could not be listed"
RULES_COUNT=$(printf '%s\n' "$RULES_RAW" | $GREP '^-' | $AWK 'END{print NR+0}')
if [ "$RULES_COUNT" -eq 0 ]; then
    add_critical "no audit rules loaded"
fi
append_long "Audit rules loaded: ${RULES_COUNT}"

# Rule files and augenrules only describe generated configuration, not the kernel's loaded rules.
append_long "Rule inspection uses the loaded kernel rules; generated rule files are not required."

# A fresh reboot changes audit context, so report it for operators reviewing recent events.
NOW=$($DATE +%s)
BTIME=$($AWK '/btime/ {print $2}' /proc/stat 2>/dev/null)
if [ -n "$BTIME" ]; then
    BOOT_AGE=$(( NOW - BTIME ))
    if [ "$BOOT_AGE" -lt 86400 ]; then
        BOOT_HUMAN=$($DATE -d "@$BTIME" '+%a %Y-%m-%d %H:%M:%S %Z')
        add_warning "reboot within 24h (${BOOT_HUMAN})"
        append_long "Boot context: reboot within 24h (${BOOT_HUMAN})"
    fi
elif [ -r /proc/uptime ]; then
    UPTIME_SEC=$($CUT -d. -f1 /proc/uptime 2>/dev/null)
    if [ "${UPTIME_SEC:-0}" -lt 86400 ]; then
        BOOT_HUMAN=$($DATE -d "@$(($NOW - UPTIME_SEC))" '+%a %Y-%m-%d %H:%M:%S %Z')
        add_warning "reboot within 24h (${BOOT_HUMAN})"
        append_long "Boot context: reboot within 24h (${BOOT_HUMAN})"
    fi
fi

<% if @systemd_enable != false -%>
if use_systemd && [ -n "$JOURNALCTL" ]; then
# Kernel change detection (previous boot)
UPTIME_SEC=$($CUT -d. -f1 /proc/uptime 2>/dev/null)
if [ "${UPTIME_SEC:-0}" -lt 86400 ]; then
    # Try to extract the previous kernel version from the previous boot's journal.
    KERNEL_CURRENT=$($UNAME -r)
    KERNEL_BOOT=$($JOURNALCTL -b -1 -o cat --no-pager 2>/dev/null | $AWK '
        BEGIN{found=0}
        {
            if ($0 ~ /^Linux version[[:space:]]+/) { print $3; found=1; exit }
        }')
    if [ -n "$KERNEL_BOOT" ]; then
        # Previous kernel found; only report if it differs from the current one.
        if [ "$KERNEL_BOOT" != "$KERNEL_CURRENT" ]; then
            add_warning "kernel changed from ${KERNEL_BOOT} to ${KERNEL_CURRENT}"
            append_long "Kernel context: previous=${KERNEL_BOOT}, current=${KERNEL_CURRENT}"
        fi
    else
        # Missing previous-boot history cannot establish a kernel change.
        append_long "Kernel context: previous kernel not retrieved from the previous boot journal"
    fi
fi
fi
<% end -%>

# Preserve distinct audit keys in recency order until the single diagnostic character limit applies.
if [ -n "$AUSEARCH" ] && { [ "$KEYS" != U ] && [ "$KEYS" -gt 0 ]; }; then
    LAST_KEYS=$($AUSEARCH --start 'today 00:00:00' --end now 2>/dev/null | $GREP -o 'key="[^"]\+"' | $SED 's/^key="//; s/"$//' | $AWK 'NF && $0!="(null)"{k[n++]=$0}
        END{
            for(i=n-1;i>=0; i--) if(!seen[k[i]]++) list[c++]=k[i];
            for(i=0;i<c;i++) printf "%s%s", (i? ", ":""), list[i]
        }')
    [ -n "$LAST_KEYS" ] && append_long "Latest distinct audit keys: ${LAST_KEYS}"
fi

# DMI hardware fields help correlate audit alerts with physical inventory.
if [ -d "$DMI_DIR" ]; then
    # Read DMI information
    CHASSIS_SERIAL=$(trim_file "$DMI_DIR/chassis_serial" 2>/dev/null)
    BOARD_SERIAL=$(trim_file "$DMI_DIR/board_serial" 2>/dev/null)
    PRODUCT_SERIAL=$(trim_file "$DMI_DIR/product_serial" 2>/dev/null)
    BIOS_VENDOR=$(trim_file "$DMI_DIR/bios_vendor" 2>/dev/null)
    BIOS_VERSION=$(trim_file "$DMI_DIR/bios_version" 2>/dev/null)
    BIOS_DATE=$(trim_file "$DMI_DIR/bios_date" 2>/dev/null)

    # Build hardware segment
    [ -n "$CHASSIS_SERIAL" ] && HW_SEG="$HW_SEG, chs: $CHASSIS_SERIAL"
    [ -n "$BOARD_SERIAL" ] && HW_SEG="$HW_SEG, brd: $BOARD_SERIAL"
    [ -n "$PRODUCT_SERIAL" ] && HW_SEG="$HW_SEG, prod: $PRODUCT_SERIAL"

    # BIOS summary
    if [ -n "$BIOS_VENDOR$BIOS_VERSION$BIOS_DATE" ]; then
        BIOS_SUM="$BIOS_VENDOR${BIOS_VERSION:+ }$BIOS_VERSION${BIOS_DATE:+ ($BIOS_DATE)}"
        HW_SEG="$HW_SEG, bios: $BIOS_SUM"
    fi
fi

# Fallback for device-tree platforms (e.g., Raspberry Pi)
if [ -z "$HW_SEG" ] && [ -d /proc/device-tree ]; then
    DT_MODEL=$(trim_file /proc/device-tree/model 2>/dev/null)
    DT_SERIAL=$(trim_file /proc/device-tree/serial-number 2>/dev/null)
    [ -n "$DT_SERIAL" ] && HW_SEG="$HW_SEG, serial: $DT_SERIAL"
    [ -n "$DT_MODEL" ] && HW_SEG="$HW_SEG, model: $DT_MODEL"
fi

# Append hardware summary if present.
if [ -n "$HW_SEG" ]; then
    HW_SEG=${HW_SEG#, }
    append_long "Hardware context: ${HW_SEG}"
fi

# Keep the kernel findings while inspecting the required auditd service or registered process.
<% if @systemd_enable != false -%>
systemd_service_status auditd.service
AUDIT_SERVICE_STATE=$?
case "$AUDIT_SERVICE_STATE" in
    2) add_critical "$SERVICE_CONTEXT" ;;
    3) UNKNOWN_REASONS=$(append_reason "$UNKNOWN_REASONS" "$SERVICE_CONTEXT") ;;
esac
append_long "$SERVICE_CONTEXT"
if [ "$AUDIT_SERVICE_STATE" -eq 4 ]; then
<% end -%>
    # Match the daemon registered with the kernel, preserving any proven audit failures.
    if [ "$AUDIT_PID" -gt 0 ]; then
        if PS=$(command -v ps 2>/dev/null) && PROCESS_DATA=$($PS -e -o pid= -o stat= 2>/dev/null); then
            printf '%s\n' "$PROCESS_DATA" | $AWK -v pid="$AUDIT_PID" '
                $1 == pid && $2 !~ /^Z/ { found=1 }
                END { exit !found }
            ' || add_critical "registered audit daemon process is not active"
        else
            UNKNOWN_REASONS=$(append_reason "$UNKNOWN_REASONS" "process inspection unavailable")
        fi
    fi
<% if @systemd_enable != false -%>
fi
<% end -%>

# Explain which audit findings are alert scope and which lines are supporting context.
limit_long_output_details
append_long ""
append_long "Interpretation:"
append_long "Audit event counters, journal errors, loaded rule count, backlog/lost counters, the required auditd service or process, recent reboot context, and kernel-change context can affect the exit code."
append_long "Latest keys and hardware context help identify the affected host or event source but do not by themselves add severity beyond the counters above."
append_long "Inspect auditd, augenrules, and the named audit keys first when the summary reports security events, missing loaded rules, backlog pressure, lost events, or journal errors."

# The five-minute event rate is a compact pressure signal for sudden audit volume changes.
EVENT_RESULT=U
if [ -n "$AUREPORT" ]; then
    EVENT_START=$($DATE -d '5 minute ago' '+%Y-%m-%d %H:%M:%S')
    if EVENT_RAW=$(LC_ALL=C $AUREPORT --start "$EVENT_START" --end now --event 2>/dev/null); then
        EVENT_REPORT=$(printf '%s\n' "$EVENT_RAW" | $AWK 'NR>2{c+=$2}END{print c+0}')
        EVENT_RESULT=$($AWK "BEGIN{printf \"%.2f\", (${EVENT_REPORT})/300}")
    fi
fi
EVENT_RATE_METRIC=$(metric_with_unit "$EVENT_RESULT" eps)

# Perfdata mirrors every status-relevant counter with stable, unit-free labels.
PERF="acct_changes=${ACCT};;1"
PERF="$PERF anomaly_events=${ANOM};;1"
PERF="$PERF cfg_changes=${CFG};;1"
PERF="$PERF dropped=${LOST}c;;${DROPPED_CRIT}"
ERROR_METRIC=$(metric_with_unit "$ERROR_COUNT" c)
PERF="$PERF errors=${ERROR_METRIC};;1"
PERF="$PERF event_rate=${EVENT_RATE_METRIC}"
PERF="$PERF failed_auth=${FAILED_AUTH}"
PERF="$PERF failed_syscalls=${FAIL};;1"
PERF="$PERF keys=${KEYS};;1"
PERF="$PERF rules=${RULES_COUNT};;0;0"
PERF="$PERF queue=${BACKLOG};${QUEUE_WARN}"

# Build a cause-oriented summary; counters and inventory stay in perfdata and long output.
if [ -n "$CRITICAL_REASONS" ]; then
    MSG="Auditd ${CRITICAL_REASONS}"
    [ -n "$WARNING_REASONS" ] && MSG="${MSG}; ${WARNING_REASONS}"
elif [ -n "$UNKNOWN_REASONS" ]; then
    MSG="Auditd ${UNKNOWN_REASONS}"
elif [ -n "$WARNING_REASONS" ]; then
    MSG="Auditd ${WARNING_REASONS}"
else
    MSG="Auditd is running with audit rules loaded and no security events today"
fi

# Confirmed failures take precedence over unavailable required history, then warnings.
if [ -n "$UNKNOWN_REASONS" ]; then
    [ "$STATE_CODE" -eq 2 ] || STATE_CODE=3
    append_long "Incomplete inspection: ${UNKNOWN_REASONS}"
fi

# Emit one monitoring line; dynamic audit and hardware text is sanitized before perfdata.
emit_check "$MSG" "$PERF"
exit $STATE_CODE
