#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'Auditd check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AUDITCTL=$(command -v auditctl 2>/dev/null) || die "auditctl not available"
AUGENRULES=$(command -v augenrules 2>/dev/null) || die "augenrules not available"
AUSEARCH=$(command -v ausearch 2>/dev/null) || die "ausearch not available"
AUREPORT=$(command -v aureport 2>/dev/null) || die "aureport not available"
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CUT=$(command -v cut 2>/dev/null) || die "cut not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
<% if @systemd_enable -%>
SYSTEMDCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null) || die "journalctl not available"
<% end -%>
TR=$(command -v tr 2>/dev/null) || die "tr not available"
PS=$(command -v ps 2>/dev/null) || die "ps not available"
UNAME=$(command -v uname 2>/dev/null) || die "uname not available"

# Hardware paths are optional context for physical inventory in alert output.
DMI_DIR="/sys/devices/virtual/dmi/id"

# Queue thresholds protect against dropped audit events and can be tuned at runtime.
DROPPED_CRIT="1"
QUEUE_WARN=""

# Summary state accumulates security-sensitive audit findings while keeping context in long output.
CRITICAL_REASONS=""
HW_SEG=""
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_AUDIT_NL__"
STATE_CODE=0 # 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN
USAGE_TEXT="Usage: $0 [-q <int>] [-d <int>]"
WARNING_REASONS=""

# CLI options tune queue and lost-event thresholds without changing the managed rule set.
OPTERR=0
while getopts 'q:d:' opt; do
    case "$opt" in
        q) QUEUE_WARN="$OPTARG" ;;
        d) DROPPED_CRIT="$OPTARG" ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"

# Runtime thresholds are numeric audit counters and must fail before host state is evaluated.
case "$DROPPED_CRIT" in
    ''|*[!0-9]*) die "dropped threshold must be numeric" ;;
esac

# Read the first trimmed line from a file.
trim_file() {
    [ -r "$1" ] || return 1
    val=$($SED -n '1{s/[[:space:]]\+$//;p;q}' "$1" 2>/dev/null | $TR -d '\000\r\n') || return 1
    [ -n "$val" ] || return 1
    printf '%s' "$val"
}

# Keep audit keys, journal snippets, and hardware fields safe before perfdata.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append a semicolon-separated reason to an existing summary bucket.
append_reason() {
    if [ -n "$1" ]; then
        printf '%s; %s\n' "$1" "$2"
    else
        printf '%s\n' "$2"
    fi
}

# Record a CRITICAL cause for the short output.
add_critical() {
    CRITICAL_REASONS=$(append_reason "$CRITICAL_REASONS" "$1")
    STATE_CODE=2
}

# Record a WARNING cause without overriding an existing CRITICAL state.
add_warning() {
    WARNING_REASONS=$(append_reason "$WARNING_REASONS" "$1")
    [ "$STATE_CODE" -lt 1 ] && STATE_CODE=1
}

# Append one diagnostic line to the bounded long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Emit the summary line, perfdata, and sanitized detail output.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Emit a CRITICAL result and stop immediately.
crit() {
    printf '%s\n' "$(monitor_text_value "$1")"
    exit 2
}

# Service health is checked before audit tools so a stopped daemon reports the direct cause.
<% if @systemd_enable -%>
$SYSTEMDCTL is-active --quiet "auditd" || crit "Auditd service is not active"
<% else -%>
$PS -C auditd >/dev/null 2>&1 || crit "Auditd service is not active"
<% end -%>

# The daily audit summary is the authoritative source for account/config/anomaly counters.
SUM=$($AUREPORT --summary --start today 00:00:00 --end now 2>/dev/null) || die "audit summary could not be read"

# Extract one numeric counter from the audit summary output.
get() {
    printf '%s' "$SUM" | $AWK -v p="$1" 'index($0,p)==1{print $NF}' | $TR -dc '0-9'
}

ACCT=$(get "Number of changes to accounts, groups, or roles:"); : "${ACCT:=0}"
ANOM=$(get "Number of anomaly events:"); : "${ANOM:=0}"
CFG=$(get "Number of changes in configuration:"); : "${CFG:=0}"
FAIL=$(get "Number of failed syscalls:"); : "${FAIL:=0}"
FAILED_AUTH=$(get "Number of failed authentications:"); : "${FAILED_AUTH:=0}"
KEYS=$(get "Number of keys:"); : "${KEYS:=0}"

# Account, configuration, anomaly, syscall, and key events are security-sensitive.
if [ "$ACCT" -gt 0 ] || [ "$ANOM" -gt 0 ] || [ "$CFG" -gt 0 ] || [ "$FAIL" -gt 0 ] || [ "$KEYS" -gt 0 ]; then
    SECURITY_REASONS=""
    [ "$ACCT" -gt 0 ] && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "account changes $ACCT")
    [ "$ANOM" -gt 0 ] && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "anomaly events $ANOM")
    [ "$CFG" -gt 0 ] && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "config changes $CFG")
    [ "$FAIL" -gt 0 ] && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "failed syscalls $FAIL")
    [ "$KEYS" -gt 0 ] && SECURITY_REASONS=$(append_reason "$SECURITY_REASONS" "keyed events $KEYS")
    add_critical "security events: ${SECURITY_REASONS}"
fi
append_long "Audit event counters: account changes ${ACCT}, anomaly events ${ANOM}, config changes ${CFG}, failed syscalls ${FAIL}, failed authentications ${FAILED_AUTH}, keyed events ${KEYS}"

<% if @systemd_enable -%>
# Auditd and augenrules journal errors since boot indicate broken rule loading or runtime failures.
JLOG=$($JOURNALCTL -b -u auditd -u augenrules --no-pager -o cat 2>/dev/null)
ERR_COMBINED=$(printf "%s\n" "$JLOG" | $AWK '
    {
        line=$0
        l=tolower(line)
        if (l ~ /(error|unknown)/) {
            c++
            prev=last
            last=line
        }
    }
    END{
        if (c==0) { print "0|"; exit }
        if (prev) printf "%d|%s; %s", c, prev, last;
        else      printf "%d|%s",      c, last
    }')
ERROR_COUNT=${ERR_COMBINED%%|*}
ERROR_SNIPPET=${ERR_COMBINED#*|}

# Journal errors override earlier OK text because they show audit runtime failure.
if [ "${ERROR_COUNT:-0}" -gt 0 ]; then
    add_critical "journal errors since boot: ${ERROR_SNIPPET:-unknown}"
fi
<% else -%>
ERROR_COUNT=0
<% end -%>
append_long "Journal errors since boot: ${ERROR_COUNT}"

# Loaded rule count verifies that auditd is enforcing something, not only running.
RULES_RAW=$($AUDITCTL -l 2>/dev/null) || die "audit rules could not be listed"
RULES_COUNT=$(printf '%s\n' "$RULES_RAW" | $GREP '^-' | $AWK 'END{print NR+0}')
if [ "$RULES_COUNT" -eq 0 ]; then
    add_critical "no audit rules loaded"
fi
append_long "Audit rules loaded: ${RULES_COUNT}"

# Backlog and lost-event counters detect audit pressure and dropped security events.
AV_STAT=$($AUDITCTL -s 2>/dev/null) || die "audit status could not be read"
BACKLOG=$(printf "%s" "$AV_STAT" | $SED -n 's/.*backlog=\([0-9]\+\).*/\1/p'); : "${BACKLOG:=0}"
LOST=$(printf "%s" "$AV_STAT" | $SED -n 's/.*lost=\([0-9]\+\).*/\1/p'); : "${LOST:=0}"
BLIMIT=$(printf "%s" "$AV_STAT" | $SED -n 's/.*backlog_limit=\([0-9]\+\).*/\1/p'); : "${BLIMIT:=0}"
case "$BACKLOG" in (*[!0-9]*) BACKLOG=0 ;; esac
case "$LOST" in (*[!0-9]*) LOST=0 ;; esac
case "$BLIMIT" in (*[!0-9]*) BLIMIT=0 ;; esac

# Use the kernel backlog limit as default warning threshold when Puppet did not pass one.
[ -z "$QUEUE_WARN" ] && QUEUE_WARN=$BLIMIT
case "$QUEUE_WARN" in
    ''|*[!0-9]*) die "queue warning threshold must be numeric" ;;
esac
if [ "$BACKLOG" -gt "$QUEUE_WARN" ]; then
    add_warning "audit backlog ${BACKLOG} is above the warning limit"
fi
if [ "$LOST" -gt "$DROPPED_CRIT" ]; then
    add_critical "lost audit events ${LOST} detected"
fi
append_long "Audit backlog: ${BACKLOG}/${BLIMIT}"
append_long "Lost audit events: ${LOST}"

# augenrules --check reports when generated rule files differ from the loaded ruleset.
if $AUGENRULES --check >/dev/null 2>&1; then
    AUGENRULES_TEXT="in sync"
else
    AUGENRULES_TEXT="generated rules differ from loaded ruleset"
    add_warning "augenrules generated rules differ from loaded ruleset"
fi
append_long "augenrules check: ${AUGENRULES_TEXT}"

# A fresh reboot changes audit context, so report it for operators reviewing recent events.
NOW=$($DATE +%s)
BTIME=$($AWK '/btime/ {print $2}' /proc/stat 2>/dev/null)
if [ -n "$BTIME" ]; then
    BOOT_AGE=$(( NOW - BTIME ))
    if [ "$BOOT_AGE" -lt 86400 ]; then
        BOOT_HUMAN=$($DATE -d "@$BTIME" '+%a %Y-%m-%d %H:%M:%S %Z')
        add_warning "reboot within 24h (${BOOT_HUMAN})"
        append_long "Boot context: reboot within 24h (${BOOT_HUMAN})"
    fi
elif [ -r /proc/uptime ]; then
    UPTIME_SEC=$($CUT -d. -f1 /proc/uptime 2>/dev/null)
    if [ "${UPTIME_SEC:-0}" -lt 86400 ]; then
        BOOT_HUMAN=$($DATE -d "@$(($NOW - UPTIME_SEC))" '+%a %Y-%m-%d %H:%M:%S %Z')
        add_warning "reboot within 24h (${BOOT_HUMAN})"
        append_long "Boot context: reboot within 24h (${BOOT_HUMAN})"
    fi
fi

<% if @systemd_enable -%>
# Kernel change detection (previous boot)
UPTIME_SEC=$($CUT -d. -f1 /proc/uptime 2>/dev/null)
if [ "${UPTIME_SEC:-0}" -lt 86400 ]; then
    # Try to extract the previous kernel version from the previous boot's journal.
    KERNEL_CURRENT=$($UNAME -r)
    KERNEL_BOOT=$($JOURNALCTL -b -1 -o cat --no-pager 2>/dev/null | $AWK '
        BEGIN{found=0}
        {
            if ($0 ~ /^Linux version[[:space:]]+/) { print $3; found=1; exit }
        }')
    if [ -n "$KERNEL_BOOT" ]; then
        # Previous kernel found; only report if it differs from the current one.
        if [ "$KERNEL_BOOT" != "$KERNEL_CURRENT" ]; then
            add_warning "kernel changed from ${KERNEL_BOOT} to ${KERNEL_CURRENT}"
            append_long "Kernel context: previous=${KERNEL_BOOT}, current=${KERNEL_CURRENT}"
        fi
    else
        # No previous kernel detected in the journal. We cannot confirm the prior version, but a change may have occurred. Emit a warning without details.
        add_warning "recent reboot but previous kernel could not be read"
        append_long "Kernel context: previous kernel not retrieved from the previous boot journal"
    fi
fi
<% end -%>

# Include the latest distinct audit keys so security events have immediate context.
if [ "$KEYS" -gt 0 ]; then
    LAST_KEYS=$($AUSEARCH --start 'today 00:00:00' --end now 2>/dev/null | $GREP -o 'key="[^"]\+"' | $SED 's/^key="//; s/"$//' | $AWK 'NF && $0!="(null)"{k[n++]=$0}
        END{
            for(i=n-1;i>=0 && c<5; i--) if(!seen[k[i]]++) list[c++]=k[i];
            for(i=c-1;i>=0;i--) printf "%s%s", list[i], (i? ", ":"")
        }')
    [ -n "$LAST_KEYS" ] && append_long "Latest distinct audit keys: ${LAST_KEYS}"
fi

# DMI hardware fields help correlate audit alerts with physical inventory.
if [ -d "$DMI_DIR" ]; then
    # Read DMI information
    CHASSIS_SERIAL=$(trim_file "$DMI_DIR/chassis_serial" 2>/dev/null)
    BOARD_SERIAL=$(trim_file "$DMI_DIR/board_serial" 2>/dev/null)
    PRODUCT_SERIAL=$(trim_file "$DMI_DIR/product_serial" 2>/dev/null)
    BIOS_VENDOR=$(trim_file "$DMI_DIR/bios_vendor" 2>/dev/null)
    BIOS_VERSION=$(trim_file "$DMI_DIR/bios_version" 2>/dev/null)
    BIOS_DATE=$(trim_file "$DMI_DIR/bios_date" 2>/dev/null)

    # Build hardware segment
    [ -n "$CHASSIS_SERIAL" ] && HW_SEG="$HW_SEG, chs: $CHASSIS_SERIAL"
    [ -n "$BOARD_SERIAL" ] && HW_SEG="$HW_SEG, brd: $BOARD_SERIAL"
    [ -n "$PRODUCT_SERIAL" ] && HW_SEG="$HW_SEG, prod: $PRODUCT_SERIAL"

    # BIOS summary
    if [ -n "$BIOS_VENDOR$BIOS_VERSION$BIOS_DATE" ]; then
        BIOS_SUM="$BIOS_VENDOR${BIOS_VERSION:+ }$BIOS_VERSION${BIOS_DATE:+ ($BIOS_DATE)}"
        HW_SEG="$HW_SEG, bios: $BIOS_SUM"
    fi
fi

# Fallback for device-tree platforms (e.g., Raspberry Pi)
if [ -z "$HW_SEG" ] && [ -d /proc/device-tree ]; then
    DT_MODEL=$(trim_file /proc/device-tree/model 2>/dev/null)
    DT_SERIAL=$(trim_file /proc/device-tree/serial-number 2>/dev/null)
    [ -n "$DT_SERIAL" ] && HW_SEG="$HW_SEG, serial: $DT_SERIAL"
    [ -n "$DT_MODEL" ] && HW_SEG="$HW_SEG, model: $DT_MODEL"
fi

# Append hardware summary if present.
if [ -n "$HW_SEG" ]; then
    HW_SEG=${HW_SEG#, }
    append_long "Hardware context: ${HW_SEG}"
fi

# The five-minute event rate is a compact pressure signal for sudden audit volume changes.
EVENT_START=$($DATE -d '5 minute ago' '+%Y-%m-%d %H:%M:%S')
EVENT_REPORT=$($AUREPORT --start "$EVENT_START" --end now --event 2>/dev/null | $AWK 'NR>2{c+=$2}END{print c+0}')
EVENT_RESULT=$($AWK "BEGIN{printf \"%.2f\", (${EVENT_REPORT:-0})/300}")

# Perfdata mirrors every status-relevant counter with stable, unit-free labels.
PERF="acct_changes=${ACCT};;1"
PERF="$PERF anomaly_events=${ANOM};;1"
PERF="$PERF cfg_changes=${CFG};;1"
PERF="$PERF dropped=${LOST};;${DROPPED_CRIT}"
PERF="$PERF errors=${ERROR_COUNT};;1"
PERF="$PERF event_rate=${EVENT_RESULT}"
PERF="$PERF failed_auth=${FAILED_AUTH}"
PERF="$PERF failed_syscalls=${FAIL};;1"
PERF="$PERF keys=${KEYS};;1"
PERF="$PERF rules=${RULES_COUNT};;0;0"
PERF="$PERF queue=${BACKLOG};${QUEUE_WARN}"

# Build a cause-oriented summary; counters and inventory stay in perfdata and long output.
if [ -n "$CRITICAL_REASONS" ]; then
    MSG="Auditd ${CRITICAL_REASONS}"
    [ -n "$WARNING_REASONS" ] && MSG="${MSG}; ${WARNING_REASONS}"
elif [ -n "$WARNING_REASONS" ]; then
    MSG="Auditd ${WARNING_REASONS}"
else
    MSG="Auditd is running with audit rules loaded and no security events today"
fi

# Emit one monitoring line; dynamic audit and hardware text is sanitized before perfdata.
emit_check "$MSG" "$PERF"
exit $STATE_CODE
