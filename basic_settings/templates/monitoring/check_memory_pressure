#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'Memory pressure check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SLEEP=$(command -v sleep 2>/dev/null) || die "sleep not available"

# Optional helpers keep the check useful on very small systems.
GETCONF=$(command -v getconf 2>/dev/null || true)
SORT=$(command -v sort 2>/dev/null || true)

# Nagios states
STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

# Thresholds and data paths keep memory pressure evaluation local and fixture-friendly.
MEM_AVAILABLE_PROFILES=<%= @memory_available_profiles_spec_shell %>
MEM_AVAILABLE_WARNING_OVERRIDE=""
MEM_AVAILABLE_CRITICAL_OVERRIDE=""
SWAP_FREE_PROFILES=<%= @swap_free_profiles_spec_shell %>
SWAP_FREE_WARNING_OVERRIDE=""
SWAP_FREE_CRITICAL_OVERRIDE=""
SWAP_WARNING_PERCENT=80
SWAP_CRITICAL_PERCENT=95
SWAP_IO_WARNING_KIB=1
SWAP_IO_CRITICAL_KIB=64
SWAP_IO_CRITICAL_SAMPLE_MIN=2
INCLUDE_TOP_SWAP_PROCESSES=1
TOP_SWAP_PROCESSES_LIMIT=10
SAMPLE_COUNT=3
SAMPLE_INTERVAL=1

# Data paths can be overridden by the environment for lightweight validation without adding a separate fixture parser or config file to the runtime check.
MEMINFO_PATH=${MEMINFO_PATH:-/proc/meminfo}
VMSTAT_PATH=${VMSTAT_PATH:-/proc/vmstat}
VMSTAT_SAMPLE_PATHS=${VMSTAT_SAMPLE_PATHS:-}
VMSTAT_SECOND_PATH=${VMSTAT_SECOND_PATH:-} # Backward-compatible single-sample fixture path when VMSTAT_SAMPLE_PATHS is not set.
PRESSURE_MEMORY_PATH=${PRESSURE_MEMORY_PATH:-/proc/pressure/memory}
PROC_PATH=${PROC_PATH:-/proc}
PASSWD_PATH=${PASSWD_PATH:-/etc/passwd}

# Output buffers
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_MEMORY_PRESSURE_NL__"

# Parse options. Puppet normally supplies these through monitoring_custom cmd, but the script stays directly usable for Nagios, Naemon, Icinga, and debugging.
USAGE_TEXT="Usage: $0 [-w swap_warning_percent] [-c swap_critical_percent] [-m memory_available_warning] [-M memory_available_critical] [-f swap_free_warning] [-F swap_free_critical] [-i swap_io_warning_kib] [-I swap_io_critical_kib] [-n swap_io_critical_samples] [-p] [-P] [-l top_swap_processes_limit] [-s sample_count] [-t sample_interval]"
OPTERR=0
while getopts 'w:c:m:M:f:F:i:I:n:pPl:s:t:' opt; do
    case "$opt" in
        w) SWAP_WARNING_PERCENT="$OPTARG" ;;
        c) SWAP_CRITICAL_PERCENT="$OPTARG" ;;
        m) MEM_AVAILABLE_WARNING_OVERRIDE="$OPTARG" ;;
        M) MEM_AVAILABLE_CRITICAL_OVERRIDE="$OPTARG" ;;
        f) SWAP_FREE_WARNING_OVERRIDE="$OPTARG" ;;
        F) SWAP_FREE_CRITICAL_OVERRIDE="$OPTARG" ;;
        i) SWAP_IO_WARNING_KIB="$OPTARG" ;;
        I) SWAP_IO_CRITICAL_KIB="$OPTARG" ;;
        n) SWAP_IO_CRITICAL_SAMPLE_MIN="$OPTARG" ;;
        p) INCLUDE_TOP_SWAP_PROCESSES=1 ;;
        P) INCLUDE_TOP_SWAP_PROCESSES=0 ;;
        l) TOP_SWAP_PROCESSES_LIMIT="$OPTARG" ;;
        s) SAMPLE_COUNT="$OPTARG" ;;
        t) SAMPLE_INTERVAL="$OPTARG" ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"

# Keep monitoring text safe before and after the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append one diagnostic line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Append pre-serialized diagnostic lines that already use the long-output separator.
append_long_block() {
    [ -n "$1" ] || return
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Print one block with raw pipes sanitized for Nagios continuation lines.
print_sanitized_block() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Emit the summary line, fixed long output, and optional process details.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
    print_top_swap_processes
}

# Numeric validation helpers keep CLI error handling consistent.
is_uint() {
    $AWK -v value="$1" 'BEGIN { exit(value ~ /^[0-9]+$/ ? 0 : 1) }'
}

# CLI integer validation keeps threshold failures in setup/UNKNOWN territory.
validate_uint() {
    is_uint "$2" || die "invalid numeric value for $1: $2"
}

# Percentage thresholds share integer parsing but must also stay within the UOM range.
validate_percent() {
    validate_uint "$1" "$2"
    [ "$2" -le 100 ] || die "$1 must be between 0 and 100"
}

# Absolute threshold sizes are parsed to KiB for procfs comparisons and perfdata thresholds.
parse_size_to_kib() {
    $AWK -v raw="$1" '
        BEGIN {
            value = raw
            gsub(/^[[:space:]]+/, "", value)
            gsub(/[[:space:]]+$/, "", value)
            lower = tolower(value)
            if (lower !~ /^[0-9]+([.][0-9]+)?[[:space:]]*(kib|kb|mib|mb|gib|gb|k|m|g)$/) {
                exit 1
            }
            unit = lower
            sub(/^[0-9]+([.][0-9]+)?[[:space:]]*/, "", unit)
            number = lower
            sub(/[[:space:]]*(kib|kb|mib|mb|gib|gb|k|m|g)$/, "", number)
            gsub(/[[:space:]]/, "", number)
            multiplier = 1
            if (unit == "mib" || unit == "mb" || unit == "m") {
                multiplier = 1024
            } else if (unit == "gib" || unit == "gb" || unit == "g") {
                multiplier = 1048576
            }
            kib = number * multiplier
            if (kib <= 0) {
                exit 1
            }
            printf "%.0f\n", kib
        }
    '
}

# CLI size validation keeps override mistakes in setup/UNKNOWN territory.
validate_size() {
    parse_size_to_kib "$2" >/dev/null || die "invalid size value for $1: $2"
}

# Kernel counters may be unavailable on minimal systems; normalize those values before arithmetic.
numeric_or_zero() {
    case "$1" in
        ''|U|*[!0-9]*) printf '%s\n' 0 ;;
        *)             printf '%s\n' "$1" ;;
    esac
}

# Human formatting is used only in the summary and long output.
format_kib() {
    $AWK -v kib="$1" '
        BEGIN {
            if (kib >= 1048576) {
                printf "%.1f GiB", kib / 1048576
            } else if (kib >= 1024) {
                printf "%.1f MiB", kib / 1024
            } else {
                printf "%d KiB", kib
            }
        }
    '
}

# Select the first profile whose maximum covers the detected total. An empty maximum is the final open-ended fallback.
select_profile() {
    PROFILE_SPEC=$1
    PROFILE_TOTAL_KIB=$2
    PROFILE_TOTAL_LABEL=$3
    PROFILE_REMAINING=$PROFILE_SPEC
    PROFILE_WARNING_KIB=""
    PROFILE_CRITICAL_KIB=""
    PROFILE_WARNING_RAW=""
    PROFILE_CRITICAL_RAW=""

    while [ -n "$PROFILE_REMAINING" ]; do
        case "$PROFILE_REMAINING" in
            *,*)
                PROFILE_ENTRY=${PROFILE_REMAINING%%,*}
                PROFILE_REMAINING=${PROFILE_REMAINING#*,}
                ;;
            *)
                PROFILE_ENTRY=$PROFILE_REMAINING
                PROFILE_REMAINING=""
                ;;
        esac

        PROFILE_MAX_RAW=${PROFILE_ENTRY%%|*}
        PROFILE_REST=${PROFILE_ENTRY#*|}
        [ "$PROFILE_REST" != "$PROFILE_ENTRY" ] || die "invalid ${PROFILE_TOTAL_LABEL} profile entry: $PROFILE_ENTRY"
        PROFILE_WARNING_RAW=${PROFILE_REST%%|*}
        PROFILE_CRITICAL_RAW=${PROFILE_REST#*|}
        [ "$PROFILE_CRITICAL_RAW" != "$PROFILE_REST" ] || die "invalid ${PROFILE_TOTAL_LABEL} profile entry: $PROFILE_ENTRY"
        case "$PROFILE_CRITICAL_RAW" in
            *'|'*) die "invalid ${PROFILE_TOTAL_LABEL} profile entry: $PROFILE_ENTRY" ;;
        esac

        PROFILE_WARNING_KIB=$(parse_size_to_kib "$PROFILE_WARNING_RAW") || die "invalid ${PROFILE_TOTAL_LABEL} warning threshold: $PROFILE_WARNING_RAW"
        PROFILE_CRITICAL_KIB=$(parse_size_to_kib "$PROFILE_CRITICAL_RAW") || die "invalid ${PROFILE_TOTAL_LABEL} critical threshold: $PROFILE_CRITICAL_RAW"
        [ "$PROFILE_CRITICAL_KIB" -le "$PROFILE_WARNING_KIB" ] || die "${PROFILE_TOTAL_LABEL} critical threshold must be less than or equal to warning threshold"

        if [ -z "$PROFILE_MAX_RAW" ]; then
            [ -z "$PROFILE_REMAINING" ] || die "${PROFILE_TOTAL_LABEL} profile has an open-ended maximum before the last entry"
            return 0
        fi

        PROFILE_MAX_KIB=$(parse_size_to_kib "$PROFILE_MAX_RAW") || die "invalid ${PROFILE_TOTAL_LABEL} maximum: $PROFILE_MAX_RAW"
        if [ "$PROFILE_TOTAL_KIB" -le "$PROFILE_MAX_KIB" ]; then
            return 0
        fi
    done

    die "no ${PROFILE_TOTAL_LABEL} profile matched"
}

# vmstat counters are read as a pair so swap I/O deltas come from the same snapshot.
read_vmstat_counters() {
    [ -r "$1" ] || return 1
    $AWK '
        $1 == "pswpin" { pswpin=$2 }
        $1 == "pswpout" { pswpout=$2 }
        END {
            if (pswpin ~ /^[0-9]+$/ && pswpout ~ /^[0-9]+$/) {
                printf "%s %s\n", pswpin, pswpout
            } else {
                exit 1
            }
        }
    ' "$1"
}

# Select the next vmstat input. Production uses the same procfs file after sleeping; validation can provide comma-separated fixture paths.
set_next_vmstat_sample_path() {
    if [ -n "$VMSTAT_SAMPLE_PATHS_REMAINING" ]; then
        case "$VMSTAT_SAMPLE_PATHS_REMAINING" in
            *,*)
                VMSTAT_NEXT_READ_PATH=${VMSTAT_SAMPLE_PATHS_REMAINING%%,*}
                VMSTAT_SAMPLE_PATHS_REMAINING=${VMSTAT_SAMPLE_PATHS_REMAINING#*,}
                ;;
            *)
                VMSTAT_NEXT_READ_PATH=$VMSTAT_SAMPLE_PATHS_REMAINING
                VMSTAT_SAMPLE_PATHS_REMAINING=""
                ;;
        esac
    elif [ -n "$VMSTAT_SECOND_PATH" ] && [ "$SAMPLE_INDEX" -eq 1 ]; then
        VMSTAT_NEXT_READ_PATH=$VMSTAT_SECOND_PATH
    else
        # Production sampling waits between cumulative-counter reads so each delta represents one interval.
        $SLEEP "$SAMPLE_INTERVAL"
        VMSTAT_NEXT_READ_PATH=$VMSTAT_PATH
    fi
}

# Store one sampled swap-I/O line for later diagnostic output.
append_swap_io_sample() {
    SAMPLE_LINE="Swap I/O sample ${1}: swap-in ${2} KiB/s, swap-out ${3} KiB/s"
    if [ -z "$SWAP_IO_SAMPLE_OUTPUT" ]; then
        SWAP_IO_SAMPLE_OUTPUT=$SAMPLE_LINE
    else
        SWAP_IO_SAMPLE_OUTPUT="${SWAP_IO_SAMPLE_OUTPUT}${LONG_OUTPUT_SEP}$SAMPLE_LINE"
    fi
}

# Swap process details are best-effort long output and must not change the check state.
print_top_swap_processes() {
    [ "$INCLUDE_TOP_SWAP_PROCESSES" -eq 1 ] || return
    monitor_text_value 'Top swap users:'

    # Per-process swap details are diagnostic only; missing helpers or /proc access should never change the memory pressure status.
    if [ -z "$SORT" ]; then
        monitor_text_value 'Top swap users unavailable: sort command not available'
        return
    fi

    if [ ! -d "$PROC_PATH" ]; then
        monitor_text_value "Top swap users unavailable: ${PROC_PATH} is not a directory"
        return
    fi

    # Read /proc/<pid>/status directly. Some processes may disappear or be unreadable while the check runs, so unreadable entries are skipped.
    TOP_SWAP_OUTPUT=$(
        for STATUS_PATH in "$PROC_PATH"/[0-9]*/status; do
            [ -r "$STATUS_PATH" ] || continue
            PID_DIR=${STATUS_PATH%/status}
            PID=${PID_DIR##*/}
            $AWK -v pid="$PID" -v passwd_path="$PASSWD_PATH" '
                BEGIN {
                    name = "unknown"
                    rss = 0
                    swp = 0
                    uid = ""
                    while ((getline passwd_line < passwd_path) > 0) {
                        split(passwd_line, passwd_parts, ":")
                        uid_name[passwd_parts[3]] = passwd_parts[1]
                    }
                    close(passwd_path)
                }
                # VmSwap and VmRSS are already reported in KiB by procfs.
                $1 == "Name:" { name=$2 }
                $1 == "Uid:" { uid=$2 }
                $1 == "VmRSS:" { rss=$2 }
                $1 == "VmSwap:" { swp=$2 }
                END {
                    if (swp + 0 > 0) {
                        user = uid
                        if (uid in uid_name) {
                            user = uid_name[uid]
                        }
                        gsub(/[|]/, "[or]", user)
                        gsub(/[|]/, "[or]", name)
                        printf "%010d %d KiB swap, %d KiB RSS, user %s, process %s, PID %s\n", swp, swp, rss + 0, user, name, pid
                    }
                }
            ' "$STATUS_PATH"
        done | $SORT -rn | $AWK -v limit="$TOP_SWAP_PROCESSES_LIMIT" '
            {
                count++
                if (count <= limit) {
                    sub(/^[0-9]+[[:space:]]+/, "")
                    print
                }
            }
            END {
                # Make truncation explicit so long output remains bounded.
                if (count == 0) {
                    print "No processes with swap usage found"
                } else if (count > limit) {
                    printf "... truncated to %d of %d processes\n", limit, count
                }
            }
        '
    )
    print_sanitized_block "$TOP_SWAP_OUTPUT"
}

# Validate options before reading system state so configuration mistakes return UNKNOWN instead of being mixed with real host pressure signals.
validate_percent 'swap warning percent' "$SWAP_WARNING_PERCENT"
validate_percent 'swap critical percent' "$SWAP_CRITICAL_PERCENT"
[ -z "$MEM_AVAILABLE_WARNING_OVERRIDE" ] || validate_size 'memory available warning override' "$MEM_AVAILABLE_WARNING_OVERRIDE"
[ -z "$MEM_AVAILABLE_CRITICAL_OVERRIDE" ] || validate_size 'memory available critical override' "$MEM_AVAILABLE_CRITICAL_OVERRIDE"
[ -z "$SWAP_FREE_WARNING_OVERRIDE" ] || validate_size 'swap free warning override' "$SWAP_FREE_WARNING_OVERRIDE"
[ -z "$SWAP_FREE_CRITICAL_OVERRIDE" ] || validate_size 'swap free critical override' "$SWAP_FREE_CRITICAL_OVERRIDE"
validate_uint 'swap I/O warning KiB' "$SWAP_IO_WARNING_KIB"
validate_uint 'swap I/O critical KiB' "$SWAP_IO_CRITICAL_KIB"
validate_uint 'swap I/O critical samples' "$SWAP_IO_CRITICAL_SAMPLE_MIN"
validate_uint 'top swap processes limit' "$TOP_SWAP_PROCESSES_LIMIT"
validate_uint 'sample count' "$SAMPLE_COUNT"
validate_uint 'sample interval' "$SAMPLE_INTERVAL"
[ "$TOP_SWAP_PROCESSES_LIMIT" -ge 1 ] || die "top swap processes limit must be at least 1"
[ "$SAMPLE_COUNT" -ge 1 ] || die "sample count must be at least 1"
[ "$SAMPLE_INTERVAL" -ge 1 ] || die "sample interval must be at least 1"
[ "$SWAP_IO_CRITICAL_SAMPLE_MIN" -ge 1 ] || die "swap I/O critical samples must be at least 1"
[ "$SWAP_IO_CRITICAL_SAMPLE_MIN" -le "$SAMPLE_COUNT" ] || die "swap I/O critical samples must be less than or equal to sample count"
[ "$SWAP_CRITICAL_PERCENT" -ge "$SWAP_WARNING_PERCENT" ] || die "swap critical percent must be greater than or equal to warning percent"
[ "$SWAP_IO_CRITICAL_KIB" -ge "$SWAP_IO_WARNING_KIB" ] || die "swap I/O critical threshold must be greater than or equal to warning threshold"

# /proc/meminfo is the authoritative source for this check. Missing required memory fields make the result UNKNOWN because no safe pressure decision exists.
[ -r "$MEMINFO_PATH" ] || {
    monitor_text_value "Memory pressure cannot be checked: ${MEMINFO_PATH} is unavailable"
    exit "$STATE_UNKNOWN"
}

# Collect all fields used for the summary, long output and perfdata in one pass so a fast-changing /proc/meminfo snapshot stays internally consistent.
MEMINFO_VALUES=$($AWK '
    function value(raw) { return raw == "" ? "U" : raw }
    $1 == "MemTotal:" { mem_total=$2 }
    $1 == "MemAvailable:" { mem_available=$2 }
    $1 == "SwapTotal:" { swap_total=$2 }
    $1 == "SwapFree:" { swap_free=$2 }
    $1 == "SwapCached:" { swap_cached=$2 }
    $1 == "Cached:" { cached=$2 }
    $1 == "Buffers:" { buffers=$2 }
    $1 == "SReclaimable:" { sreclaimable=$2 }
    $1 == "Shmem:" { shmem=$2 }
    $1 == "Unevictable:" { unevictable=$2 }
    END {
        printf "%s %s %s %s %s %s %s %s %s %s\n",
            value(mem_total), value(mem_available), value(swap_total), value(swap_free),
            value(swap_cached), value(cached), value(buffers), value(sreclaimable),
            value(shmem), value(unevictable)
    }
' "$MEMINFO_PATH") || {
    monitor_text_value "Memory pressure cannot be checked: unable to parse ${MEMINFO_PATH}"
    exit "$STATE_UNKNOWN"
}

set -- $MEMINFO_VALUES
MEM_TOTAL_KIB=$1
MEM_AVAILABLE_KIB=$2
SWAP_TOTAL_KIB=$3
SWAP_FREE_KIB=$4
SWAP_CACHED_KIB=$(numeric_or_zero "$5")
CACHED_KIB=$(numeric_or_zero "$6")
BUFFERS_KIB=$(numeric_or_zero "$7")
SRECLAIMABLE_KIB=$(numeric_or_zero "$8")
SHMEM_KIB=$(numeric_or_zero "$9")
UNEVICTABLE_KIB=$(numeric_or_zero "${10}")

# MemTotal, MemAvailable, SwapTotal and SwapFree are required for the decision tree. Secondary fields are useful diagnostics and fall back to zero above.
case "$MEM_TOTAL_KIB:$MEM_AVAILABLE_KIB:$SWAP_TOTAL_KIB:$SWAP_FREE_KIB" in
    *U*|*[!0-9:]*)
        monitor_text_value "Memory pressure cannot be checked: ${MEMINFO_PATH} misses required MemTotal, MemAvailable, SwapTotal, or SwapFree values"
        exit "$STATE_UNKNOWN"
        ;;
esac

[ "$MEM_TOTAL_KIB" -gt 0 ] || {
    monitor_text_value "Memory pressure cannot be checked: MemTotal is zero in ${MEMINFO_PATH}"
    exit "$STATE_UNKNOWN"
}

# A negative computed swap-used value means procfs data is inconsistent enough that an operator should see UNKNOWN instead of a misleading OK.
if [ "$SWAP_FREE_KIB" -gt "$SWAP_TOTAL_KIB" ]; then
    monitor_text_value "Memory pressure cannot be checked: SwapFree is greater than SwapTotal in ${MEMINFO_PATH}"
    exit "$STATE_UNKNOWN"
fi

# Use integer percentages for stable perfdata and passive swap-utilization context.
MEM_AVAILABLE_PERCENT=$((MEM_AVAILABLE_KIB * 100 / MEM_TOTAL_KIB))
SWAP_USED_KIB=$((SWAP_TOTAL_KIB - SWAP_FREE_KIB))
if [ "$SWAP_TOTAL_KIB" -gt 0 ]; then
    SWAP_USED_PERCENT=$((SWAP_USED_KIB * 100 / SWAP_TOTAL_KIB))
else
    SWAP_USED_PERCENT=0
fi

# Select absolute MemAvailable thresholds from MemTotal and then apply any manual CLI override.
select_profile "$MEM_AVAILABLE_PROFILES" "$MEM_TOTAL_KIB" "MemTotal"
MEM_AVAILABLE_WARNING_KIB=$PROFILE_WARNING_KIB
MEM_AVAILABLE_CRITICAL_KIB=$PROFILE_CRITICAL_KIB
if [ -n "$MEM_AVAILABLE_WARNING_OVERRIDE" ] || [ -n "$MEM_AVAILABLE_CRITICAL_OVERRIDE" ]; then
    if [ -n "$MEM_AVAILABLE_WARNING_OVERRIDE" ]; then
        MEM_AVAILABLE_WARNING_KIB=$(parse_size_to_kib "$MEM_AVAILABLE_WARNING_OVERRIDE") || die "invalid memory available warning override: $MEM_AVAILABLE_WARNING_OVERRIDE"
    fi
    if [ -n "$MEM_AVAILABLE_CRITICAL_OVERRIDE" ]; then
        MEM_AVAILABLE_CRITICAL_KIB=$(parse_size_to_kib "$MEM_AVAILABLE_CRITICAL_OVERRIDE") || die "invalid memory available critical override: $MEM_AVAILABLE_CRITICAL_OVERRIDE"
    fi
    [ "$MEM_AVAILABLE_CRITICAL_KIB" -le "$MEM_AVAILABLE_WARNING_KIB" ] || die "memory available critical override must be less than or equal to warning override"
fi

# Select absolute SwapFree thresholds only when swap exists; a no-swap host is handled by memory headroom alone.
if [ "$SWAP_TOTAL_KIB" -gt 0 ]; then
    select_profile "$SWAP_FREE_PROFILES" "$SWAP_TOTAL_KIB" "SwapTotal"
    SWAP_FREE_WARNING_KIB=$PROFILE_WARNING_KIB
    SWAP_FREE_CRITICAL_KIB=$PROFILE_CRITICAL_KIB
    if [ -n "$SWAP_FREE_WARNING_OVERRIDE" ] || [ -n "$SWAP_FREE_CRITICAL_OVERRIDE" ]; then
        if [ -n "$SWAP_FREE_WARNING_OVERRIDE" ]; then
            SWAP_FREE_WARNING_KIB=$(parse_size_to_kib "$SWAP_FREE_WARNING_OVERRIDE") || die "invalid swap free warning override: $SWAP_FREE_WARNING_OVERRIDE"
        fi
        if [ -n "$SWAP_FREE_CRITICAL_OVERRIDE" ]; then
            SWAP_FREE_CRITICAL_KIB=$(parse_size_to_kib "$SWAP_FREE_CRITICAL_OVERRIDE") || die "invalid swap free critical override: $SWAP_FREE_CRITICAL_OVERRIDE"
        fi
        [ "$SWAP_FREE_CRITICAL_KIB" -le "$SWAP_FREE_WARNING_KIB" ] || die "swap free critical override must be less than or equal to warning override"
    fi
else
    SWAP_FREE_WARNING_KIB=0
    SWAP_FREE_CRITICAL_KIB=0
fi

# Read current swap I/O from cumulative /proc/vmstat counters with a short sample.
SWAP_IO_AVAILABLE=0
SWAP_IO_NOTE=""
SWAP_IN_KIB_PER_SEC=0
SWAP_OUT_KIB_PER_SEC=0
SWAP_IN_WARNING_SAMPLE_COUNT=0
SWAP_OUT_WARNING_SAMPLE_COUNT=0
SWAP_IO_WARNING_SAMPLE_COUNT=0
SWAP_IN_CRITICAL_SAMPLE_COUNT=0
SWAP_OUT_CRITICAL_SAMPLE_COUNT=0
SWAP_IO_CRITICAL_SAMPLE_COUNT=0
SWAP_IO_SAMPLE_COUNT=0
SWAP_IO_SAMPLE_OUTPUT=""

# Convert cumulative pswpin/pswpout page counters to KiB/s. getconf is optional because a 4096 byte fallback is safe enough when page size cannot be queried.
if [ -n "$GETCONF" ]; then
    PAGE_SIZE_BYTES=$($GETCONF PAGESIZE 2>/dev/null || printf '%s\n' 4096)
else
    PAGE_SIZE_BYTES=4096
fi
case "$PAGE_SIZE_BYTES" in
    ''|*[!0-9]*) PAGE_SIZE_BYTES=4096 ;;
esac
[ "$PAGE_SIZE_BYTES" -gt 0 ] || PAGE_SIZE_BYTES=4096

# Take multiple deltas to distinguish sustained swap pressure from one short spike. If vmstat cannot be read, continue with absolute memory and swap-free thresholds.
if [ "$SWAP_TOTAL_KIB" -eq 0 ]; then
    VMSTAT_CURRENT=""
    SWAP_IO_NOTE="active swap I/O not sampled because no swap is configured"
else
    VMSTAT_CURRENT=$(read_vmstat_counters "$VMSTAT_PATH" 2>/dev/null || true)
fi

if [ "$SWAP_TOTAL_KIB" -gt 0 ] && [ -n "$VMSTAT_CURRENT" ]; then
    set -- $VMSTAT_CURRENT
    PSWPIN_CURRENT=$1
    PSWPOUT_CURRENT=$2
    SAMPLE_INDEX=1
    VMSTAT_SAMPLE_PATHS_REMAINING=$VMSTAT_SAMPLE_PATHS

    while [ "$SAMPLE_INDEX" -le "$SAMPLE_COUNT" ]; do
        set_next_vmstat_sample_path
        VMSTAT_NEXT=$(read_vmstat_counters "$VMSTAT_NEXT_READ_PATH" 2>/dev/null || true)
        if [ -n "$VMSTAT_NEXT" ]; then
            set -- $VMSTAT_NEXT
            PSWPIN_NEXT=$1
            PSWPOUT_NEXT=$2
            if [ "$PSWPIN_NEXT" -ge "$PSWPIN_CURRENT" ] && [ "$PSWPOUT_NEXT" -ge "$PSWPOUT_CURRENT" ]; then
                # pswpin/pswpout are page counters since boot, so each delta represents active swap I/O during one sample interval.
                PSWPIN_DELTA=$((PSWPIN_NEXT - PSWPIN_CURRENT))
                PSWPOUT_DELTA=$((PSWPOUT_NEXT - PSWPOUT_CURRENT))
                SAMPLE_SWAP_IN_KIB_PER_SEC=$((PSWPIN_DELTA * PAGE_SIZE_BYTES / 1024 / SAMPLE_INTERVAL))
                SAMPLE_SWAP_OUT_KIB_PER_SEC=$((PSWPOUT_DELTA * PAGE_SIZE_BYTES / 1024 / SAMPLE_INTERVAL))
                SWAP_IO_SAMPLE_COUNT=$((SWAP_IO_SAMPLE_COUNT + 1))
                append_swap_io_sample "$SWAP_IO_SAMPLE_COUNT" "$SAMPLE_SWAP_IN_KIB_PER_SEC" "$SAMPLE_SWAP_OUT_KIB_PER_SEC"

                # Perfdata and summary use the highest observed sample so short visible activity is not hidden by averaging.
                [ "$SAMPLE_SWAP_IN_KIB_PER_SEC" -gt "$SWAP_IN_KIB_PER_SEC" ] && SWAP_IN_KIB_PER_SEC=$SAMPLE_SWAP_IN_KIB_PER_SEC
                [ "$SAMPLE_SWAP_OUT_KIB_PER_SEC" -gt "$SWAP_OUT_KIB_PER_SEC" ] && SWAP_OUT_KIB_PER_SEC=$SAMPLE_SWAP_OUT_KIB_PER_SEC

                SAMPLE_IO_WARNING=0
                SAMPLE_IO_CRITICAL=0
                if [ "$SAMPLE_SWAP_IN_KIB_PER_SEC" -ge "$SWAP_IO_WARNING_KIB" ]; then
                    SWAP_IN_WARNING_SAMPLE_COUNT=$((SWAP_IN_WARNING_SAMPLE_COUNT + 1))
                    SAMPLE_IO_WARNING=1
                fi
                if [ "$SAMPLE_SWAP_OUT_KIB_PER_SEC" -ge "$SWAP_IO_WARNING_KIB" ]; then
                    SWAP_OUT_WARNING_SAMPLE_COUNT=$((SWAP_OUT_WARNING_SAMPLE_COUNT + 1))
                    SAMPLE_IO_WARNING=1
                fi
                if [ "$SAMPLE_IO_WARNING" -eq 1 ]; then
                    SWAP_IO_WARNING_SAMPLE_COUNT=$((SWAP_IO_WARNING_SAMPLE_COUNT + 1))
                fi

                if [ "$SAMPLE_SWAP_IN_KIB_PER_SEC" -ge "$SWAP_IO_CRITICAL_KIB" ]; then
                    SWAP_IN_CRITICAL_SAMPLE_COUNT=$((SWAP_IN_CRITICAL_SAMPLE_COUNT + 1))
                    SAMPLE_IO_CRITICAL=1
                fi
                if [ "$SAMPLE_SWAP_OUT_KIB_PER_SEC" -ge "$SWAP_IO_CRITICAL_KIB" ]; then
                    SWAP_OUT_CRITICAL_SAMPLE_COUNT=$((SWAP_OUT_CRITICAL_SAMPLE_COUNT + 1))
                    SAMPLE_IO_CRITICAL=1
                fi
                if [ "$SAMPLE_IO_CRITICAL" -eq 1 ]; then
                    SWAP_IO_CRITICAL_SAMPLE_COUNT=$((SWAP_IO_CRITICAL_SAMPLE_COUNT + 1))
                fi

                PSWPIN_CURRENT=$PSWPIN_NEXT
                PSWPOUT_CURRENT=$PSWPOUT_NEXT
            else
                # Counter reset or wrap is rare, but treating the remaining samples as unavailable is safer than making a pressure decision from a negative delta.
                SWAP_IO_NOTE="active swap I/O sampling stopped because pswpin/pswpout counters moved backwards"
                break
            fi
        else
            SWAP_IO_NOTE="active swap I/O sampling stopped because ${VMSTAT_NEXT_READ_PATH} is unavailable or missing pswpin/pswpout"
            break
        fi
        SAMPLE_INDEX=$((SAMPLE_INDEX + 1))
    done

    if [ "$SWAP_IO_SAMPLE_COUNT" -gt 0 ]; then
        SWAP_IO_AVAILABLE=1
        if [ "$SWAP_IO_SAMPLE_COUNT" -lt "$SAMPLE_COUNT" ] && [ -z "$SWAP_IO_NOTE" ]; then
            SWAP_IO_NOTE="active swap I/O sampling completed only ${SWAP_IO_SAMPLE_COUNT} of ${SAMPLE_COUNT} samples"
        fi
    elif [ -z "$SWAP_IO_NOTE" ]; then
        SWAP_IO_NOTE="active swap I/O could not be checked because no usable samples were collected from ${VMSTAT_PATH}"
    fi
elif [ "$SWAP_TOTAL_KIB" -gt 0 ]; then
    SWAP_IO_NOTE="active swap I/O could not be checked because ${VMSTAT_PATH} is unavailable or missing pswpin/pswpout"
fi

# Decide status from absolute memory headroom, absolute swap-free space, and sustained swap I/O. Swap utilization percentage is context only.
MEM_AVAILABLE_HUMAN=$(format_kib "$MEM_AVAILABLE_KIB")
MEM_AVAILABLE_WARNING_HUMAN=$(format_kib "$MEM_AVAILABLE_WARNING_KIB")
MEM_AVAILABLE_CRITICAL_HUMAN=$(format_kib "$MEM_AVAILABLE_CRITICAL_KIB")
SWAP_FREE_HUMAN=$(format_kib "$SWAP_FREE_KIB")
SWAP_FREE_WARNING_HUMAN=$(format_kib "$SWAP_FREE_WARNING_KIB")
SWAP_FREE_CRITICAL_HUMAN=$(format_kib "$SWAP_FREE_CRITICAL_KIB")
MEM_AVAILABLE_LOW=0
MEM_AVAILABLE_CRITICAL=0
SWAP_FREE_LOW=0
SWAP_FREE_CRITICAL=0
[ "$MEM_AVAILABLE_KIB" -lt "$MEM_AVAILABLE_WARNING_KIB" ] && MEM_AVAILABLE_LOW=1
[ "$MEM_AVAILABLE_KIB" -lt "$MEM_AVAILABLE_CRITICAL_KIB" ] && MEM_AVAILABLE_CRITICAL=1
if [ "$SWAP_TOTAL_KIB" -gt 0 ]; then
    [ "$SWAP_FREE_KIB" -lt "$SWAP_FREE_WARNING_KIB" ] && SWAP_FREE_LOW=1
    [ "$SWAP_FREE_KIB" -lt "$SWAP_FREE_CRITICAL_KIB" ] && SWAP_FREE_CRITICAL=1
fi

if [ "$MEM_AVAILABLE_CRITICAL" -eq 1 ]; then
    # Critically low MemAvailable is direct memory pressure even when swap I/O is quiet.
    EXIT_CODE=$STATE_CRITICAL
    SUMMARY="Memory pressure active: memory available is critically low: ${MEM_AVAILABLE_HUMAN} available"
elif [ "$SWAP_IO_AVAILABLE" -eq 1 ] && [ "$SWAP_IN_CRITICAL_SAMPLE_COUNT" -ge "$SWAP_IO_CRITICAL_SAMPLE_MIN" ] && [ "$SWAP_OUT_CRITICAL_SAMPLE_COUNT" -ge "$SWAP_IO_CRITICAL_SAMPLE_MIN" ]; then
    # Sustained swap-in plus swap-out is a stronger thrashing signal than either direction alone.
    EXIT_CODE=$STATE_CRITICAL
    SUMMARY="Memory pressure active: sustained swap-in and swap-out are detected: swap-in max ${SWAP_IN_KIB_PER_SEC} KiB/s, swap-out max ${SWAP_OUT_KIB_PER_SEC} KiB/s, memory available ${MEM_AVAILABLE_HUMAN}, swap free ${SWAP_FREE_HUMAN}"
elif [ "$SWAP_IO_AVAILABLE" -eq 1 ] && [ "$SWAP_OUT_CRITICAL_SAMPLE_COUNT" -ge "$SWAP_IO_CRITICAL_SAMPLE_MIN" ] && [ "$MEM_AVAILABLE_LOW" -eq 1 ]; then
    # Sustained swap-out with low MemAvailable means the kernel is actively trying to free RAM by writing pages to swap.
    EXIT_CODE=$STATE_CRITICAL
    SUMMARY="Memory pressure active: low memory headroom and active swap-out detected: memory available ${MEM_AVAILABLE_HUMAN}, swap-out max ${SWAP_OUT_KIB_PER_SEC} KiB/s"
elif [ "$SWAP_IO_AVAILABLE" -eq 1 ] && [ "$SWAP_OUT_CRITICAL_SAMPLE_COUNT" -ge "$SWAP_IO_CRITICAL_SAMPLE_MIN" ] && [ "$SWAP_FREE_CRITICAL" -eq 1 ]; then
    # Active swap-out while swap free space is critically low means the kernel is still trying to write to nearly exhausted swap.
    EXIT_CODE=$STATE_CRITICAL
    SUMMARY="Memory pressure active: swap free is critically low and active swap-out is detected: swap free ${SWAP_FREE_HUMAN}, swap-out max ${SWAP_OUT_KIB_PER_SEC} KiB/s"
elif [ "$MEM_AVAILABLE_LOW" -eq 1 ] && [ "$SWAP_FREE_CRITICAL" -eq 1 ]; then
    # Low memory headroom plus critically low swap free space deserves attention even without sampled current swap-out.
    EXIT_CODE=$STATE_WARNING
    SUMMARY="Memory pressure elevated: memory available is low and swap free is critically low: memory available ${MEM_AVAILABLE_HUMAN}, swap free ${SWAP_FREE_HUMAN}"
elif [ "$MEM_AVAILABLE_LOW" -eq 1 ]; then
    # MemAvailable is a headroom signal: warn before the host reaches critical pressure.
    EXIT_CODE=$STATE_WARNING
    SUMMARY="Memory pressure elevated: memory available is low: ${MEM_AVAILABLE_HUMAN} available"
elif [ "$SWAP_FREE_LOW" -eq 1 ]; then
    # Low SwapFree is warning-level when memory headroom is still healthy and no critical swap pressure is sampled.
    EXIT_CODE=$STATE_WARNING
    SUMMARY="Memory pressure elevated: swap free is low: ${SWAP_FREE_HUMAN} free; memory available ${MEM_AVAILABLE_HUMAN}"
elif [ "$SWAP_IO_AVAILABLE" -eq 1 ] && [ "$SWAP_IO_WARNING_SAMPLE_COUNT" -gt 0 ]; then
    # Light or one-off current swapping is reported as WARNING so operators can inspect the host without treating a single spike as critical pressure.
    EXIT_CODE=$STATE_WARNING
    SUMMARY="Memory pressure elevated: active swap I/O observed: swap-in max ${SWAP_IN_KIB_PER_SEC} KiB/s, swap-out max ${SWAP_OUT_KIB_PER_SEC} KiB/s, memory available ${MEM_AVAILABLE_HUMAN}, swap free ${SWAP_FREE_HUMAN}"
else
    EXIT_CODE=$STATE_OK
    if [ "$SWAP_TOTAL_KIB" -eq 0 ]; then
        # Hosts without swap are not automatically broken; memory headroom drives the status.
        SUMMARY="Memory pressure healthy: no swap configured and ${MEM_AVAILABLE_HUMAN} memory available"
    elif [ "$SWAP_USED_PERCENT" -ge "$SWAP_WARNING_PERCENT" ] && [ "$SWAP_IO_AVAILABLE" -eq 1 ] && [ "$SWAP_IN_KIB_PER_SEC" -eq 0 ] && [ "$SWAP_OUT_KIB_PER_SEC" -eq 0 ]; then
        # This is the expected false-positive reduction path: old swap pages can remain allocated while the host has enough available memory.
        SUMMARY="Memory pressure healthy: swap is ${SWAP_USED_PERCENT}% used but inactive; no active swap I/O and ${MEM_AVAILABLE_HUMAN} memory available"
    elif [ "$SWAP_IO_AVAILABLE" -eq 0 ]; then
        SUMMARY="Memory pressure healthy: memory available ${MEM_AVAILABLE_HUMAN}, swap free ${SWAP_FREE_HUMAN}; active swap I/O unavailable"
    else
        SUMMARY="Memory pressure healthy: memory available ${MEM_AVAILABLE_HUMAN}, swap free ${SWAP_FREE_HUMAN}, no active swap I/O detected"
    fi
fi

# Build perfdata with stable lowercase snake_case labels and UOMs; low-water thresholds use Nagios range syntax so lower values alert correctly.
PERFDATA="memory_available=${MEM_AVAILABLE_KIB}KB;${MEM_AVAILABLE_WARNING_KIB}:;${MEM_AVAILABLE_CRITICAL_KIB}:;0;${MEM_TOTAL_KIB}"
PERFDATA="${PERFDATA} memory_headroom=${MEM_AVAILABLE_PERCENT}%;;;0;100"
PERFDATA="${PERFDATA} swap_used=${SWAP_USED_KIB}KB"
PERFDATA="${PERFDATA} swap_utilization=${SWAP_USED_PERCENT}%;${SWAP_WARNING_PERCENT};${SWAP_CRITICAL_PERCENT};0;100"
PERFDATA="${PERFDATA} swap_free=${SWAP_FREE_KIB}KB;${SWAP_FREE_WARNING_KIB}:;${SWAP_FREE_CRITICAL_KIB}:;0;${SWAP_TOTAL_KIB}"
PERFDATA="${PERFDATA} swap_in=${SWAP_IN_KIB_PER_SEC};${SWAP_IO_WARNING_KIB};${SWAP_IO_CRITICAL_KIB}"
PERFDATA="${PERFDATA} swap_out=${SWAP_OUT_KIB_PER_SEC};${SWAP_IO_WARNING_KIB};${SWAP_IO_CRITICAL_KIB}"
PERFDATA="${PERFDATA} swap_cached=${SWAP_CACHED_KIB}KB"
PERFDATA="${PERFDATA} buffers=${BUFFERS_KIB}KB"
PERFDATA="${PERFDATA} cached=${CACHED_KIB}KB"
PERFDATA="${PERFDATA} sreclaimable=${SRECLAIMABLE_KIB}KB"
PERFDATA="${PERFDATA} shmem=${SHMEM_KIB}KB"
PERFDATA="${PERFDATA} unevictable=${UNEVICTABLE_KIB}KB"

# Long output starts with the memory snapshot because it is the primary evidence for the combined decision and useful even when swap I/O is unavailable.
append_long "MemTotal: ${MEM_TOTAL_KIB} KiB"
append_long "MemAvailable: ${MEM_AVAILABLE_KIB} KiB (${MEM_AVAILABLE_PERCENT}%)"
append_long "SwapTotal: ${SWAP_TOTAL_KIB} KiB"
append_long "SwapUsed: ${SWAP_USED_KIB} KiB (${SWAP_USED_PERCENT}%)"
append_long "SwapFree: ${SWAP_FREE_KIB} KiB"
append_long "SwapCached: ${SWAP_CACHED_KIB} KiB"
append_long "Buffers: ${BUFFERS_KIB} KiB"
append_long "Cached: ${CACHED_KIB} KiB"
append_long "SReclaimable: ${SRECLAIMABLE_KIB} KiB"
append_long "Shmem: ${SHMEM_KIB} KiB"
append_long "Unevictable: ${UNEVICTABLE_KIB} KiB"
if [ "$SWAP_IO_AVAILABLE" -eq 1 ]; then
    append_long "Swap I/O samples: ${SWAP_IO_SAMPLE_COUNT}/${SAMPLE_COUNT} collected over ${SAMPLE_INTERVAL}s intervals; max swap-in ${SWAP_IN_KIB_PER_SEC} KiB/s, max swap-out ${SWAP_OUT_KIB_PER_SEC} KiB/s"
    append_long_block "$SWAP_IO_SAMPLE_OUTPUT"
    [ -n "$SWAP_IO_NOTE" ] && append_long "Swap I/O note: ${SWAP_IO_NOTE}"
else
    append_long "Swap I/O: unavailable"
    append_long "Swap I/O note: ${SWAP_IO_NOTE}"
fi

# PSI is useful context on kernels that expose it, but not a hard dependency.
if [ -r "$PRESSURE_MEMORY_PATH" ]; then
    PSI_SOME=$($AWK '$1 == "some" { print; exit }' "$PRESSURE_MEMORY_PATH" 2>/dev/null || true)
    PSI_FULL=$($AWK '$1 == "full" { print; exit }' "$PRESSURE_MEMORY_PATH" 2>/dev/null || true)
    [ -n "$PSI_SOME" ] && append_long "Memory PSI some: ${PSI_SOME}"
    [ -n "$PSI_FULL" ] && append_long "Memory PSI full: ${PSI_FULL}"
else
    append_long "Memory PSI: unavailable"
fi

# Explain the combined memory decision so operators can distinguish status inputs from supporting context.
append_long "Interpretation:"
append_long "MemAvailable, SwapFree, and sustained swap I/O samples decide the exit code; swap utilization percentage, cache fields, PSI lines, and top swap users are supporting context for diagnosis."
append_long "Inspect current memory consumers and recent workload changes first when the summary reports low headroom, low swap free space, or active swap I/O."

emit_check "$SUMMARY" "$PERFDATA"
exit "$EXIT_CODE"
