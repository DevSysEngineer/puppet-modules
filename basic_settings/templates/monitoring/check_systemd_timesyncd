#!/bin/sh
# Managed by puppet

<%= scope.function_template(['basic_settings/monitoring/_output']) %>

# Fail helper
die() {
    monitor_error 'systemd-timesyncd check cannot run: ' "$*"
    exit 3
}

# These checks inspect systemd concepts; other init systems are not applicable (Nagios UNKNOWN).
[ -d /run/systemd/system ] || die "not applicable: systemd is not running"

# Parse systemd human-readable output in a stable locale.
LC_ALL=C
export LC_ALL

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
TIMEDATECTL=$(command -v timedatectl 2>/dev/null) || die "timedatectl not available"

# Status buffers collect the direct CRITICAL and WARNING causes.
CRIT_MSG=""
LONG_OUTPUT=""
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
WARN_MSG=""
STATE_CODE=0
INCOMPLETE=0

# Offset, jitter, and root-distance thresholds are seconds; perfdata uses the same values with `s` UOM.
JITTER_CRIT=${JITTER_CRIT:-0.2} # 200ms
JITTER_WARN=${JITTER_WARN:-0.1} # 100ms
OFFSET_CRIT=${OFFSET_CRIT:-0.125} # 125ms
OFFSET_WARN=${OFFSET_WARN:-0.05} # 50ms
ROOT_CRIT=${ROOT_CRIT:-5} # 5s (timesyncd RootDistanceMaxSec default)
ROOT_WARN=${ROOT_WARN:-0.5} # 500ms

# High stratum is treated as a synchronization quality signal.
STRAT_CRIT=${STRAT_CRIT:-15} # >15 ~= unsynchronised
STRAT_WARN=${STRAT_WARN:-10}

USAGE_TEXT="Usage: $0 [-l chars] [-w offset_warning_seconds] [-c offset_critical_seconds] [-j jitter_warning_seconds] [-J jitter_critical_seconds] [-r root_warning_seconds] [-R root_critical_seconds] [-s stratum_warning] [-S stratum_critical]
Environment: DETAIL_LIMIT (-l); OFFSET_WARN (-w); OFFSET_CRIT (-c); JITTER_WARN (-j); JITTER_CRIT (-J); ROOT_WARN (-r); ROOT_CRIT (-R); STRAT_WARN (-s); STRAT_CRIT (-S).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':l:w:c:j:J:r:R:s:S:h' opt; do
    case "$opt" in
        l) DETAIL_LIMIT=$OPTARG ;;
        w) OFFSET_WARN=$OPTARG ;;
        c) OFFSET_CRIT=$OPTARG ;;
        j) JITTER_WARN=$OPTARG ;;
        J) JITTER_CRIT=$OPTARG ;;
        r) ROOT_WARN=$OPTARG ;;
        R) ROOT_CRIT=$OPTARG ;;
        s) STRAT_WARN=$OPTARG ;;
        S) STRAT_CRIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"

for threshold_value in "$OFFSET_WARN" "$OFFSET_CRIT" "$JITTER_WARN" "$JITTER_CRIT" "$ROOT_WARN" "$ROOT_CRIT"; do
    $AWK -v value="$threshold_value" 'BEGIN { exit !(value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 0) }' || die "time thresholds must be non-negative seconds"
done
for stratum_value in "$STRAT_WARN" "$STRAT_CRIT"; do
    case "$stratum_value" in
        ''|*[!0-9]*) die "stratum thresholds must be integers" ;;
    esac
    [ "$stratum_value" -le 16 ] || die "stratum thresholds must not exceed 16"
done
$AWK -v warn="$OFFSET_WARN" -v crit="$OFFSET_CRIT" 'BEGIN { exit !(warn <= crit) }' || die "critical offset must be at least warning"
$AWK -v warn="$JITTER_WARN" -v crit="$JITTER_CRIT" 'BEGIN { exit !(warn <= crit) }' || die "critical jitter must be at least warning"
$AWK -v warn="$ROOT_WARN" -v crit="$ROOT_CRIT" 'BEGIN { exit !(warn <= crit) }' || die "critical root distance must be at least warning"
[ "$STRAT_WARN" -le "$STRAT_CRIT" ] || die "critical stratum must be at least warning"

# Validate the long-output cap before any diagnostic details are rendered.
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

# Emit a direct CRITICAL result and stop immediately.
crit() {
    monitor_error 'systemd-timesyncd ' "$*"
    exit 2
}

# Append one critical reason to the summary.
add_crit() {
    CRIT_MSG="${CRIT_MSG:+$CRIT_MSG; }$1"
}

# Append one warning reason to the summary.
add_warn() {
    WARN_MSG="${WARN_MSG:+$WARN_MSG; }$1"
}

# Compare two numeric values using awk for floating-point support.
ge() {
    $AWK -v a="$1" -v b="$2" 'BEGIN{exit (a != "U" && a>=b)?0:1}'
}

# Convert the subsystem's displayed units to seconds without inventing zero for missing fields.
get_seconds() {
    printf '%s\n' "$TIMESYNC" | $AWK -v key="$1:" '
        {
            sub(/^[[:space:]]+/, "")
            if (index($0, key) != 1) next
            value=substr($0, length(key)+1)
            sub(/^[[:space:]]+/, "", value)
            if (!match(value, /^[+-]?[0-9]+([.][0-9]+)?/)) exit
            number=substr(value, RSTART, RLENGTH)+0
            unit=substr(value, RLENGTH+1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", unit)
            if (unit=="s") scale=1
            else if (unit=="ms") scale=1000
            else if (unit=="us" || unit=="µs" || unit=="μs") scale=1000000
            else if (unit=="ns") scale=1000000000
            else exit
            printf "%.9f", number/scale
            found=1
            exit
        }
        END { if (!found) printf "U" }
    '
}

metric_seconds() {
    case "$1" in
        U) printf U ;;
        *) printf '%ss' "$1" ;;
    esac
}

# An unreadable manager is UNKNOWN; only an observed inactive unit establishes failure.
SERVICE_STATE=$($SYSTEMCTL show systemd-timesyncd.service -p ActiveState --value 2>/dev/null) || die "service state unavailable"
case "$SERVICE_STATE" in
    active) : ;;
    inactive|failed|activating|deactivating) crit "service is not active (${SERVICE_STATE})" ;;
    *) die "service state unavailable or invalid" ;;
esac

# `NTPSynchronized` is the primary binary health signal for the clock.
NTPSYNC=$($TIMEDATECTL show -p NTPSynchronized --value 2>/dev/null) || die "NTPSynchronized status not available"
case "$NTPSYNC" in
    yes|1) : ;;
    no|0) add_crit "clock not synchronised" ;;
    *) die "NTPSynchronized returned unexpected value: $NTPSYNC" ;;
esac

# Read the human timesync status once and parse all numeric metrics from that snapshot.
TIMESYNC="$($TIMEDATECTL timesync-status 2>/dev/null)" || {
    [ -z "$CRIT_MSG" ] || crit "$CRIT_MSG; timesync-status unavailable"
    die "timesync-status not available"
}

# The selected peer is useful in the short output when drift thresholds fire.
SERVER=$(printf '%s' "$TIMESYNC" | $AWK '/^[[:space:]]*Server:/ {sub(/^[[:space:]]*Server:[[:space:]]*/,""); print; exit}')

OFFSET_SEC=$(get_seconds Offset)
ABS_OFFSET=U
if [ "$OFFSET_SEC" != U ]; then
    ABS_OFFSET=$($AWK -v o="$OFFSET_SEC" 'BEGIN{if(o<0) printf "%.9f",-o; else printf "%.9f",o}')
fi
JITTER_SEC=$(get_seconds Jitter)
ROTDIST_SEC=$(get_seconds "Root distance")
DELAY_SEC=$(get_seconds Delay)
STRAT=$(printf '%s' "$TIMESYNC" | $SED -n 's/.*Stratum:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
[ -n "$STRAT" ] || STRAT=U
for timing_value in "$ABS_OFFSET" "$JITTER_SEC" "$ROTDIST_SEC" "$STRAT"; do
    [ "$timing_value" = U ] && INCOMPLETE=1
done

# Compare absolute offset, jitter, root distance, and stratum independently.
ge "$ABS_OFFSET" "$OFFSET_CRIT" && add_crit "offset ${ABS_OFFSET}s"
[ -z "$CRIT_MSG" ] && ge "$ABS_OFFSET" "$OFFSET_WARN" && add_warn "offset ${ABS_OFFSET}s"

ge "$JITTER_SEC" "$JITTER_CRIT" && add_crit "jitter ${JITTER_SEC}s"
[ -z "$CRIT_MSG" ] && ge "$JITTER_SEC" "$JITTER_WARN" && add_warn "jitter ${JITTER_SEC}s"

ge "$ROTDIST_SEC" "$ROOT_CRIT" && add_crit "root distance ${ROTDIST_SEC}s"
[ -z "$CRIT_MSG" ] && ge "$ROTDIST_SEC" "$ROOT_WARN" && add_warn "root distance ${ROTDIST_SEC}s"

if [ "$STRAT" != U ] && [ "$STRAT" -gt "$STRAT_CRIT" ]; then
    add_crit "stratum $STRAT"
elif [ "$STRAT" != U ] && [ "$STRAT" -ge "$STRAT_WARN" ]; then
    add_warn "stratum $STRAT"
fi

# Final state uses CRITICAL reasons first, then WARNING reasons.
[ -n "$CRIT_MSG" ] && STATE_CODE=2
[ $STATE_CODE -eq 0 ] && [ -n "$WARN_MSG" ] && STATE_CODE=1

if [ -n "$CRIT_MSG" ]; then
    MSG="systemd-timesyncd ${CRIT_MSG}; server ${SERVER:-unknown}; offset ${ABS_OFFSET}s"
elif [ -n "$WARN_MSG" ]; then
    MSG="systemd-timesyncd ${WARN_MSG}; server ${SERVER:-unknown}; offset ${ABS_OFFSET}s"
else
    MSG="systemd-timesyncd synchronised with ${SERVER:-unknown}; offset ${ABS_OFFSET}s"
fi

if [ "$INCOMPLETE" -eq 1 ]; then
    [ "$STATE_CODE" -eq 2 ] || STATE_CODE=3
    MSG="$MSG; timing inspection incomplete"
fi

# Perfdata labels are unit-free; second-based values carry `s` as UOM.
PERF="offset=$(metric_seconds "$ABS_OFFSET");${OFFSET_WARN};${OFFSET_CRIT};0"
PERF="$PERF jitter=$(metric_seconds "$JITTER_SEC");${JITTER_WARN};${JITTER_CRIT};0"
PERF="$PERF root_dist=$(metric_seconds "$ROTDIST_SEC");${ROOT_WARN};${ROOT_CRIT};0;5"
PERF="$PERF delay=$(metric_seconds "$DELAY_SEC");;;0"
PERF="$PERF stratum=${STRAT};${STRAT_WARN};${STRAT_CRIT};0;16"

# Group time quality measurements with their configured thresholds.
monitor_section "Time synchronization"
monitor_item "Timesyncd server: ${SERVER:-unknown}"
case "$NTPSYNC" in yes|1) SYNC_TEXT=yes ;; no|0) SYNC_TEXT=no ;; *) SYNC_TEXT=unavailable ;; esac
monitor_item "Clock synchronized: $SYNC_TEXT"
monitor_section "Time quality"
for timing_field in "Offset:$ABS_OFFSET" "Jitter:$JITTER_SEC" "Root distance:$ROTDIST_SEC" "Delay:$DELAY_SEC"; do
    timing_value=${timing_field#*:}
    if [ "$timing_value" = U ]; then timing_value=unavailable; else timing_value="${timing_value} s"; fi
    case "${timing_field%%:*}" in
        Offset) timing_limit="warning $OFFSET_WARN s; critical $OFFSET_CRIT s" ;;
        Jitter) timing_limit="warning $JITTER_WARN s; critical $JITTER_CRIT s" ;;
        'Root distance') timing_limit="warning $ROOT_WARN s; critical $ROOT_CRIT s" ;;
        *) timing_limit='' ;;
    esac
    monitor_item "${timing_field%%:*}: $timing_value${timing_limit:+; $timing_limit}"
done
if [ "$STRAT" = U ]; then monitor_item "Stratum: unavailable"; else monitor_item "Stratum: $STRAT; warning $STRAT_WARN; critical $STRAT_CRIT"; fi
monitor_limit "$DETAIL_LIMIT"
monitor_section "Interpretation"
monitor_item "systemd-timesyncd service state, NTPSynchronized, absolute offset, jitter, root distance, and stratum decide the exit code."
monitor_item "Inspect the configured NTP servers, DNS, routing, and systemd-timesyncd journal when the summary reports an unsynchronised clock or poor time quality."

# Emit one monitoring line; server names are sanitized before the perfdata delimiter.
if [ "$STATE_CODE" -ne 0 ]; then
    monitor_prepend 'Time synchronization findings' "$MSG" 'Verify the configured time source and current synchronization state.'
fi
monitor_result "$MSG" "$PERF"
exit "$STATE_CODE"
