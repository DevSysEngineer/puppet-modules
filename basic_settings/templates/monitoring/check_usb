#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'USB check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CAT=$(command -v cat 2>/dev/null) || die "cat not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
TR=$(command -v tr 2>/dev/null)   || die "tr not available"
WC=$(command -v wc 2>/dev/null)   || die "wc not available"

# Rule model:
# - expected: every active item must be present
# - whitelist: matching active item is allowed but not required
# - any-required: at least one active item from the set must be present
#
# "configured" keeps every known USB identifier from the config, regardless of time/day. "active" keeps only the subset that is relevant right now.
# Unauthorized detection uses the configured expected/any lists so a known device does not suddenly become unauthorized outside its active window.
# Missing/required checks use the active lists so alerts only happen when the current time/day says the rule matters.
# Any-required input and active/configured match state.
ANYREQ_IDS="" # -a CSV
ANYREQ_LIST="<%= @usb_any_requirements_correct %>"
ANYREQ_MATCHED_LIST=""
ANYREQ_MATCHED_SHOWN=0
ANYREQ_OK=1
ANYREQ_PRESENT_COUNT=0
ANYREQ_SERIALS_CONFIGURED=""
ANYREQ_SERIALS_ACTIVE=""
ANYREQ_TOTAL_COUNT=0
ANYREQ_VP_IDS_CONFIGURED=""
ANYREQ_VP_IDS_ACTIVE=""

# Expected devices are both an authorization source and an active presence requirement.
EXPECTED_IDS="" # -e CSV
EXPECTED_LIST="<%= @usb_expected_correct %>"
EXPECTED_LIST_MISSING=""
EXPECTED_MISSING_COUNT=0
EXPECTED_MISSING_SHOWN=0
EXPECTED_PRESENT_COUNT=0
EXPECTED_SERIALS_CONFIGURED=""
EXPECTED_SERIALS_ACTIVE=""
EXPECTED_TOTAL_COUNT=0
EXPECTED_VP_IDS_CONFIGURED=""
EXPECTED_VP_IDS_ACTIVE=""

# Time state and final monitoring status are captured once for deterministic rule evaluation.
DETAIL_LIMIT=${DETAIL_LIMIT:-10}
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_USB_NL__"
MSG=""
NOW_HM=""
NOW_MIN=0
TODAY_DOW=0
STATUS_CODE=0

# Attached-device counters and unauthorized detail feed summary and perfdata.
TOTAL_DEV=0
UNAUTHORIZED_COUNT=0
UNAUTHORIZED_DEV_LIST=""
UNAUTHORIZED_SHOWN=0

# Whitelist entries authorize matching devices without making them required.
WHITELISTED_COUNT=0
WHITELISTED_DEV_LIST=""
WHITELISTED_SHOWN=0
WHITELIST_IDS="" # -w CSV
WHITELIST_LIST="<%= @usb_whitelist_correct %>"
WHITELIST_SERIALS_ACTIVE=""
WHITELIST_VP_IDS_ACTIVE=""

# Parse rule and output options for one check invocation.
USAGE="Usage: $0 [-w <list>] [-e <list>] [-a <list>] [-l <detail_limit>]"
OPTERR=0
while getopts "w:e:a:l:" OPT; do
    case "$OPT" in
        w) WHITELIST_IDS="$OPTARG" ;;
        e) EXPECTED_IDS="$OPTARG"  ;;
        a) ANYREQ_IDS="$OPTARG"    ;;
        l) DETAIL_LIMIT="$OPTARG"  ;;
        *) die "$USAGE" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE"
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "detail limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] || die "detail limit must be at least 1"

# Keep USB product, manufacturer, and serial text safe before the perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append one line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Emit the short monitoring line and the bounded device detail output.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Append one semicolon-separated cause to the short output.
append_summary_reason() {
    if [ -n "$1" ]; then
        printf '%s; %s' "$1" "$2"
    else
        printf '%s' "$2"
    fi
}

# Append one bounded detail item to a comma-separated device list.
append_detail_item() {
    # $1 = current list, $2 = item to append
    if [ -z "$1" ]; then
        printf '%s' "$2"
    else
        printf '%s, %s' "$1" "$2"
    fi
}

# Normalize decimal time fields before POSIX shell arithmetic so 08 and 09 are not interpreted as octal.
strip_leading_zeroes() {
    VALUE=$1
    while [ "${VALUE#0}" != "$VALUE" ]; do
        VALUE=${VALUE#0}
    done
    [ -n "$VALUE" ] || VALUE=0
    printf '%s\n' "$VALUE"
}

# Convert HH:MM to minutes since midnight.
hm2min() {
    H=${1%:*}
    M=${1#*:}
    H=$(strip_leading_zeroes "$H")
    M=$(strip_leading_zeroes "$M")
    case "$H" in (*[!0-9]*) H=0 ;; esac
    case "$M" in (*[!0-9]*) M=0 ;; esac
    printf '%s\n' "$(( H*60 + M ))"
}

# Day helpers (1=Mon .. 7=Sun)
day2num() {
    D=$(printf '%s' "$1" | $TR 'A-Z' 'a-z')
    case "$D" in
        1|mon|monday) printf '%s\n' 1 ;;
        2|tue|tues|tuesday) printf '%s\n' 2 ;;
        3|wed|wednesday) printf '%s\n' 3 ;;
        4|thu|thur|thurs|thursday) printf '%s\n' 4 ;;
        5|fri|friday) printf '%s\n' 5 ;;
        6|sat|saturday) printf '%s\n' 6 ;;
        7|sun|sunday) printf '%s\n' 7 ;;
        *) printf '\n' ;;
    esac
}

# Spec examples: "Mon-Fri", "1-5", "Mon,Wed,Fri", "Sat,Sun"
# Empty spec => always active
in_days() {
    SPEC="$1"
    if [ -z "$SPEC" ]; then
        printf '%s\n' 1
        return
    fi

    TODAY_DOW="$2"
    [ -z "$TODAY_DOW" ] && TODAY_DOW=$($DATE +%u)

    # remove whitespace
    SPEC=$(printf '%s' "$SPEC" | $SED 's/[[:space:]]//g')

    OLDIFS=$IFS
    IFS=','
    for PART in $SPEC; do
        [ -z "$PART" ] && continue

        case "$PART" in
            *-*)
                START=${PART%-*}
                END=${PART#*-}
                S=$(day2num "$START")
                E=$(day2num "$END")
                ;;
            *)
                S=$(day2num "$PART")
                E="$S"
                ;;
        esac

        [ -z "$S" ] && continue
        [ -z "$E" ] && E="$S"

        if [ "$S" -le "$E" ]; then
            if [ "$TODAY_DOW" -ge "$S" ] && [ "$TODAY_DOW" -le "$E" ]; then
                IFS=$OLDIFS
                printf '%s\n' 1
                return
            fi
        else
            # wrap range, e.g. "Fri-Mon"
            if [ "$TODAY_DOW" -ge "$S" ] || [ "$TODAY_DOW" -le "$E" ]; then
                IFS=$OLDIFS
                printf '%s\n' 1
                return
            fi
        fi
    done
    IFS=$OLDIFS
    printf '%s\n' 0
}

# Check whether the current time falls within one window.
in_window() {
    WIN="$1"
    START=${WIN%-*}
    END=${WIN#*-}
    S=$(hm2min "$START")
    E=$(hm2min "$END")
    if [ "$S" -le "$E" ]; then
        if [ "$NOW_MIN" -ge "$S" ] && [ "$NOW_MIN" -le "$E" ]; then
            printf '%s\n' 1
        else
            printf '%s\n' 0
        fi
    else
        if [ "$NOW_MIN" -ge "$S" ] || [ "$NOW_MIN" -le "$E" ]; then
            printf '%s\n' 1
        else
            printf '%s\n' 0
        fi
    fi
}

# Parse a USB rule into:
# - base identifier: serial or VID:PID
# - optional time window
# - optional day filter
#
# Supported examples:
# - 00000001
# - 00000001@08:00-17:00
# - 00000001@08:00-17:00/1-5
# - 0781:5567/Mon-Fri
parse_item() {
    ITEM="$1"
    PARSE_BASE="$ITEM"
    PARSE_WIN=""
    PARSE_DAYS=""

    # Days are expressed with "/" at the end:
    #   SERIAL/Mon-Fri
    #   SERIAL@08:00-17:00/Mon-Fri
    #   0781:5567@08:00-17:00/1-5
    case "$ITEM" in
        */*)
            PARSE_BASE=${ITEM%%/*}
            PARSE_DAYS=${ITEM#*/}
            ITEM="$PARSE_BASE"
            ;;
        *) : ;;
    esac

    # Existing time-window logic (@HH:MM-HH:MM or :HH:MM-HH:MM)
    case "$ITEM" in
        *@*)
            PARSE_BASE=${ITEM%%@*}
            PARSE_WIN=${ITEM#*@}
            ;;
        *:*)
            SUF=${ITEM##*:}
            case "$SUF" in
                ??:??-??:??)
                    PARSE_BASE=${ITEM%:*}
                    PARSE_WIN=$SUF
                    ;;
                *) : ;;
            esac
            ;;
        *) : ;;
    esac
}

# Normalize CSV -> space-separated lists (only if provided)
[ -n "$WHITELIST_IDS" ] && WHITELIST_LIST=$(printf '%s' "$WHITELIST_IDS" | $TR ',' ' ')
[ -n "$EXPECTED_IDS"  ] && EXPECTED_LIST=$(printf '%s' "$EXPECTED_IDS"  | $TR ',' ' ')
[ -n "$ANYREQ_IDS"    ] && ANYREQ_LIST=$(printf '%s' "$ANYREQ_IDS"    | $TR ',' ' ')

# Capture the current time once for time-window and weekday rules.
NOW_HM=$($DATE +%H:%M)
NOW_MIN=$(hm2min "$NOW_HM")
TODAY_DOW=$($DATE +%u)  # 1=Mon .. 7=Sun

# Build the active lists for "now".
# For expected/any-required we also keep the configured lists so those devices stay authorized outside their active window.
# Expected
for ITEM in $EXPECTED_LIST; do
    parse_item "$ITEM"
    BASE="$PARSE_BASE"; WIN="$PARSE_WIN"; DAYS="$PARSE_DAYS"; ACTIVE=1
    case "$BASE" in
        *:*) EXPECTED_VP_IDS_CONFIGURED="$EXPECTED_VP_IDS_CONFIGURED $(printf '%s' "$BASE" | $TR 'A-F' 'a-f')" ;;
        *)   EXPECTED_SERIALS_CONFIGURED="$EXPECTED_SERIALS_CONFIGURED $BASE" ;;
    esac
    case "$WIN" in
        ??:??-??:??) ACTIVE=$(in_window "$WIN") ;;
        *) ACTIVE=1 ;;
    esac
    [ "$ACTIVE" -ne 1 ] && continue
    if [ -n "$DAYS" ]; then
        ACTIVE=$(in_days "$DAYS" "$TODAY_DOW")
    else
        ACTIVE=1
    fi
    [ "$ACTIVE" -ne 1 ] && continue
    case "$BASE" in
        *:*) EXPECTED_VP_IDS_ACTIVE="$EXPECTED_VP_IDS_ACTIVE $(printf '%s' "$BASE" | $TR 'A-F' 'a-f')" ;;
        *)   EXPECTED_SERIALS_ACTIVE="$EXPECTED_SERIALS_ACTIVE $BASE" ;;
    esac
done
[ -n "$EXPECTED_SERIALS_ACTIVE" ] && EXPECTED_TOTAL_COUNT=$(( EXPECTED_TOTAL_COUNT + $(printf '%s\n' "$EXPECTED_SERIALS_ACTIVE" | $WC -w) ))
[ -n "$EXPECTED_VP_IDS_ACTIVE" ] && EXPECTED_TOTAL_COUNT=$(( EXPECTED_TOTAL_COUNT + $(printf '%s\n' "$EXPECTED_VP_IDS_ACTIVE" | $WC -w) ))

# Whitelist
for ITEM in $WHITELIST_LIST; do
    parse_item "$ITEM"
    BASE="$PARSE_BASE"; WIN="$PARSE_WIN"; DAYS="$PARSE_DAYS"; ACTIVE=1
    case "$WIN" in
        ??:??-??:??) ACTIVE=$(in_window "$WIN") ;;
        *) ACTIVE=1 ;;
    esac
    [ "$ACTIVE" -ne 1 ] && continue
    if [ -n "$DAYS" ]; then
        ACTIVE=$(in_days "$DAYS" "$TODAY_DOW")
    else
        ACTIVE=1
    fi
    [ "$ACTIVE" -ne 1 ] && continue
    case "$BASE" in
        *:*) WHITELIST_VP_IDS_ACTIVE="$WHITELIST_VP_IDS_ACTIVE $(printf '%s' "$BASE" | $TR 'A-F' 'a-f')" ;;
        *)   WHITELIST_SERIALS_ACTIVE="$WHITELIST_SERIALS_ACTIVE $BASE" ;;
    esac
done

# Any-required
for ITEM in $ANYREQ_LIST; do
    parse_item "$ITEM"
    BASE="$PARSE_BASE"; WIN="$PARSE_WIN"; DAYS="$PARSE_DAYS"; ACTIVE=1
    case "$BASE" in
        *:*) ANYREQ_VP_IDS_CONFIGURED="$ANYREQ_VP_IDS_CONFIGURED $(printf '%s' "$BASE" | $TR 'A-F' 'a-f')" ;;
        *)   ANYREQ_SERIALS_CONFIGURED="$ANYREQ_SERIALS_CONFIGURED $BASE" ;;
    esac
    case "$WIN" in
        ??:??-??:??) ACTIVE=$(in_window "$WIN") ;;
        *) ACTIVE=1 ;;
    esac
    [ "$ACTIVE" -ne 1 ] && continue
    if [ -n "$DAYS" ]; then
        ACTIVE=$(in_days "$DAYS" "$TODAY_DOW")
    else
        ACTIVE=1
    fi
    [ "$ACTIVE" -ne 1 ] && continue
    case "$BASE" in
        *:*) ANYREQ_VP_IDS_ACTIVE="$ANYREQ_VP_IDS_ACTIVE $(printf '%s' "$BASE" | $TR 'A-F' 'a-f')" ;;
        *)   ANYREQ_SERIALS_ACTIVE="$ANYREQ_SERIALS_ACTIVE $BASE" ;;
    esac
done
[ -n "$ANYREQ_SERIALS_ACTIVE" ] && ANYREQ_TOTAL_COUNT=$(( ANYREQ_TOTAL_COUNT + $(printf '%s\n' "$ANYREQ_SERIALS_ACTIVE" | $WC -w) ))
[ -n "$ANYREQ_VP_IDS_ACTIVE" ] && ANYREQ_TOTAL_COUNT=$(( ANYREQ_TOTAL_COUNT + $(printf '%s\n' "$ANYREQ_VP_IDS_ACTIVE" | $WC -w) ))

# Enumerate attached USB devices via sysfs.
# Linux Foundation root hubs (vendor 1d6b) are host controllers, not endpoint devices, so they are ignored for this check.
for DEVPATH in /sys/bus/usb/devices/*; do
    [ -f "$DEVPATH/idVendor" ] || continue

    VID=$($CAT "$DEVPATH/idVendor" 2>/dev/null | $TR 'A-F' 'a-f')
    PID=$($CAT "$DEVPATH/idProduct" 2>/dev/null | $TR 'A-F' 'a-f')
    [ "$VID" = "1d6b" ] && continue  # Linux Foundation root hub (USB host controller)

    TOTAL_DEV=$(( TOTAL_DEV + 1 ))

    # Safe serial read (strip CR if present)
    if [ -f "$DEVPATH/serial" ]; then
        SERIAL=$($TR -d '\r' < "$DEVPATH/serial" 2>/dev/null)
    else
        SERIAL=""
    fi
    PRODUCT=$($CAT "$DEVPATH/product" 2>/dev/null)
    MANUFACTURER=$($CAT "$DEVPATH/manufacturer" 2>/dev/null)

    # Friendly name
    DEVNAME=""
    [ -n "$MANUFACTURER" ] && DEVNAME="$MANUFACTURER"
    [ -n "$PRODUCT" ] && DEVNAME="$DEVNAME $PRODUCT"
    DEVNAME=$(printf '%s' "$DEVNAME" | $SED 's/^ //; s/ $//')
    [ -z "$DEVNAME" ] && DEVNAME="$VID:$PID"

    # "_ALLOWED" answers "is this a known device from the config?"
    # "_EXPECTED"/"_ANYREQ" answer "does it currently satisfy an active rule?"
    IN_EXPECTED=0
    IN_EXPECTED_ALLOWED=0
    IN_WHITELIST=0
    IN_ANYREQ=0
    IN_ANYREQ_ALLOWED=0

    # Timed expected rules only require presence in their active window, but matching devices must remain authorized outside that window.
    if [ -n "$SERIAL" ]; then
        for EXP_SER in $EXPECTED_SERIALS_CONFIGURED; do
            [ "$SERIAL" = "$EXP_SER" ] && IN_EXPECTED_ALLOWED=1 && break
        done
    fi
    if [ $IN_EXPECTED_ALLOWED -eq 0 ]; then
        for EXP_ID in $EXPECTED_VP_IDS_CONFIGURED; do
            [ "$VID:$PID" = "$EXP_ID" ] && IN_EXPECTED_ALLOWED=1 && break
        done
    fi

    # Active expected match counts toward "missing expected" and the expected perfdata.
    if [ -n "$SERIAL" ]; then
        for EXP_SER in $EXPECTED_SERIALS_ACTIVE; do
            [ "$SERIAL" = "$EXP_SER" ] && IN_EXPECTED=1 && break
        done
    fi
    if [ $IN_EXPECTED -eq 0 ]; then
        for EXP_ID in $EXPECTED_VP_IDS_ACTIVE; do
            [ "$VID:$PID" = "$EXP_ID" ] && IN_EXPECTED=1 && break
        done
    fi

    # Active whitelist match. Whitelist remains a pure allow-list.
    if [ -n "$SERIAL" ]; then
        for WL_SER in $WHITELIST_SERIALS_ACTIVE; do
            [ "$SERIAL" = "$WL_SER" ] && IN_WHITELIST=1 && break
        done
    fi
    if [ $IN_WHITELIST -eq 0 ]; then
        for WL_ID in $WHITELIST_VP_IDS_ACTIVE; do
            [ "$VID:$PID" = "$WL_ID" ] && IN_WHITELIST=1 && break
        done
    fi

    # Timed any-required rules only enforce "at least one present" in their active window, but matching devices must remain authorized outside it.
    if [ -n "$SERIAL" ]; then
        for AR_SER in $ANYREQ_SERIALS_CONFIGURED; do
            [ "$SERIAL" = "$AR_SER" ] && IN_ANYREQ_ALLOWED=1 && break
        done
    fi
    if [ $IN_ANYREQ_ALLOWED -eq 0 ]; then
        for AR_ID in $ANYREQ_VP_IDS_CONFIGURED; do
            [ "$VID:$PID" = "$AR_ID" ] && IN_ANYREQ_ALLOWED=1 && break
        done
    fi

    # Active any-required match is only used for the "at least one present" policy inside the current active window.
    if [ -n "$SERIAL" ]; then
        for AR_SER in $ANYREQ_SERIALS_ACTIVE; do
            [ "$SERIAL" = "$AR_SER" ] && IN_ANYREQ=1 && break
        done
    fi
    if [ $IN_ANYREQ -eq 0 ]; then
        for AR_ID in $ANYREQ_VP_IDS_ACTIVE; do
            [ "$VID:$PID" = "$AR_ID" ] && IN_ANYREQ=1 && break
        done
    fi

    # Tally only active requirement matches. Authorization is evaluated below.
    [ $IN_EXPECTED  -eq 1 ] && EXPECTED_PRESENT_COUNT=$(( EXPECTED_PRESENT_COUNT + 1 ))
    if [ $IN_WHITELIST -eq 1 ]; then
        WHITELISTED_COUNT=$(( WHITELISTED_COUNT + 1 ))
        if [ "$WHITELISTED_SHOWN" -lt "$DETAIL_LIMIT" ]; then
            WHITELISTED_DETAIL="$DEVNAME"
            [ -n "$SERIAL" ] && WHITELISTED_DETAIL="$WHITELISTED_DETAIL (SN: $SERIAL)"
            WHITELISTED_DEV_LIST=$(append_detail_item "$WHITELISTED_DEV_LIST" "$WHITELISTED_DETAIL")
            WHITELISTED_SHOWN=$(( WHITELISTED_SHOWN + 1 ))
        fi
    fi
    if [ $IN_ANYREQ -eq 1 ]; then
        ANYREQ_PRESENT_COUNT=$(( ANYREQ_PRESENT_COUNT + 1 ))
        if [ "$ANYREQ_MATCHED_SHOWN" -lt "$DETAIL_LIMIT" ]; then
            ANYREQ_DETAIL="$DEVNAME"
            [ -n "$SERIAL" ] && ANYREQ_DETAIL="$ANYREQ_DETAIL (SN: $SERIAL)"
            ANYREQ_MATCHED_LIST=$(append_detail_item "$ANYREQ_MATCHED_LIST" "$ANYREQ_DETAIL")
            ANYREQ_MATCHED_SHOWN=$(( ANYREQ_MATCHED_SHOWN + 1 ))
        fi
    fi

    # Unauthorized only if the device is unknown to every allow source.
    # Expected/any-required use the configured lists here, not the active lists, so a known timed device does not alert outside its own window.
    if [ $IN_EXPECTED_ALLOWED -eq 0 ] && [ $IN_WHITELIST -eq 0 ] && [ $IN_ANYREQ_ALLOWED -eq 0 ]; then
        UNAUTHORIZED_COUNT=$(( UNAUTHORIZED_COUNT + 1 ))
        UNAUTHORIZED_DETAIL="$DEVNAME"
        if [ -n "$SERIAL" ]; then
            UNAUTHORIZED_DETAIL="$UNAUTHORIZED_DETAIL (SN: $SERIAL)"
        else
            UNAUTHORIZED_DETAIL="$UNAUTHORIZED_DETAIL (no serial)"
        fi
        if [ "$UNAUTHORIZED_SHOWN" -lt "$DETAIL_LIMIT" ]; then
            UNAUTHORIZED_DEV_LIST=$(append_detail_item "$UNAUTHORIZED_DEV_LIST" "$UNAUTHORIZED_DETAIL")
            UNAUTHORIZED_SHOWN=$(( UNAUTHORIZED_SHOWN + 1 ))
        fi
    fi
done

# Only active expected items can be missing. Expected rules outside their window/day are intentionally ignored here.
for EXP in $EXPECTED_SERIALS_ACTIVE; do
    FOUND=0
    for DEVPATH in /sys/bus/usb/devices/*; do
        [ -f "$DEVPATH/idVendor" ] || continue
        [ "$($CAT "$DEVPATH/idVendor" 2>/dev/null | $TR 'A-F' 'a-f')" = "1d6b" ] && continue
        SERIAL=$($TR -d '\r' < "$DEVPATH/serial" 2>/dev/null)
        [ -n "$SERIAL" ] && [ "$SERIAL" = "$EXP" ] && FOUND=1 && break
    done
    if [ $FOUND -eq 0 ]; then
        EXPECTED_MISSING_COUNT=$(( EXPECTED_MISSING_COUNT + 1 ))
        if [ "$EXPECTED_MISSING_SHOWN" -lt "$DETAIL_LIMIT" ]; then
            EXPECTED_LIST_MISSING=$(append_detail_item "$EXPECTED_LIST_MISSING" "$EXP")
            EXPECTED_MISSING_SHOWN=$(( EXPECTED_MISSING_SHOWN + 1 ))
        fi
    fi
done

for EXP in $EXPECTED_VP_IDS_ACTIVE; do
    FOUND=0
    for DEVPATH in /sys/bus/usb/devices/*; do
        [ -f "$DEVPATH/idVendor" ] || continue
        [ "$($CAT "$DEVPATH/idVendor" 2>/dev/null | $TR 'A-F' 'a-f')" = "1d6b" ] && continue
        VID=$($CAT "$DEVPATH/idVendor" 2>/dev/null | $TR 'A-F' 'a-f')
        PID=$($CAT "$DEVPATH/idProduct" 2>/dev/null | $TR 'A-F' 'a-f')
        [ "$VID:$PID" = "$EXP" ] && FOUND=1 && break
    done
    if [ $FOUND -eq 0 ]; then
        EXPECTED_MISSING_COUNT=$(( EXPECTED_MISSING_COUNT + 1 ))
        if [ "$EXPECTED_MISSING_SHOWN" -lt "$DETAIL_LIMIT" ]; then
            EXPECTED_LIST_MISSING=$(append_detail_item "$EXPECTED_LIST_MISSING" "$EXP")
            EXPECTED_MISSING_SHOWN=$(( EXPECTED_MISSING_SHOWN + 1 ))
        fi
    fi
done

# Mark truncated detail lists explicitly so long output stays bounded without hiding counts.
[ "$UNAUTHORIZED_COUNT" -gt "$UNAUTHORIZED_SHOWN" ] && UNAUTHORIZED_DEV_LIST=$(append_detail_item "$UNAUTHORIZED_DEV_LIST" "+$(( UNAUTHORIZED_COUNT - UNAUTHORIZED_SHOWN )) more")
[ "$EXPECTED_MISSING_COUNT" -gt "$EXPECTED_MISSING_SHOWN" ] && EXPECTED_LIST_MISSING=$(append_detail_item "$EXPECTED_LIST_MISSING" "+$(( EXPECTED_MISSING_COUNT - EXPECTED_MISSING_SHOWN )) more")
[ "$ANYREQ_PRESENT_COUNT" -gt "$ANYREQ_MATCHED_SHOWN" ] && ANYREQ_MATCHED_LIST=$(append_detail_item "$ANYREQ_MATCHED_LIST" "+$(( ANYREQ_PRESENT_COUNT - ANYREQ_MATCHED_SHOWN )) more")
[ "$WHITELISTED_COUNT" -gt "$WHITELISTED_SHOWN" ] && WHITELISTED_DEV_LIST=$(append_detail_item "$WHITELISTED_DEV_LIST" "+$(( WHITELISTED_COUNT - WHITELISTED_SHOWN )) more")

# Status combines:
# - unknown attached devices
# - active expected devices that are missing
# - active any-required policy failures
if [ $UNAUTHORIZED_COUNT -gt 0 ] || [ "$EXPECTED_MISSING_COUNT" -gt 0 ]; then
    STATUS_CODE=2
    if [ $UNAUTHORIZED_COUNT -gt 0 ]; then
        UNAUTHORIZED_SUMMARY="USB unauthorized device(s) detected: ${UNAUTHORIZED_COUNT}"
        MSG=$(append_summary_reason "$MSG" "$UNAUTHORIZED_SUMMARY")
    fi
    if [ "$EXPECTED_MISSING_COUNT" -gt 0 ]; then
        EXPECTED_MISSING_SUMMARY="USB expected device(s) missing: ${EXPECTED_MISSING_COUNT}"
        MSG=$(append_summary_reason "$MSG" "$EXPECTED_MISSING_SUMMARY")
    fi
else
    if [ -n "$EXPECTED_SERIALS_ACTIVE" ] || [ -n "$EXPECTED_VP_IDS_ACTIVE" ]; then
        MSG="USB has all expected devices present"
    else
        MSG="USB has no unauthorized devices detected"
    fi
fi

# Any-required policy
if [ "$ANYREQ_TOTAL_COUNT" -gt 0 ] && [ "$ANYREQ_PRESENT_COUNT" -eq 0 ]; then
    ANYREQ_OK=0
    STATUS_CODE=2
    MSG=$(append_summary_reason "$MSG" "USB any-required policy not met")
fi

# Keep device lists out of the short output; long output is bounded and explicitly marks truncation.
append_long "Attached USB endpoint devices: ${TOTAL_DEV}"
append_long "Active expected devices: ${EXPECTED_PRESENT_COUNT}/${EXPECTED_TOTAL_COUNT} present"
append_long "Active any-required devices: ${ANYREQ_PRESENT_COUNT}/${ANYREQ_TOTAL_COUNT} present"
[ -n "$UNAUTHORIZED_DEV_LIST" ] && append_long "Unauthorized devices: ${UNAUTHORIZED_DEV_LIST}"
[ -n "$EXPECTED_LIST_MISSING" ] && append_long "Expected devices missing: ${EXPECTED_LIST_MISSING}"
[ -n "$ANYREQ_MATCHED_LIST" ] && append_long "Any-required matched devices: ${ANYREQ_MATCHED_LIST}"
[ -n "$WHITELISTED_DEV_LIST" ] && append_long "Whitelisted attached devices: ${WHITELISTED_DEV_LIST}"
append_long ""
append_long "Interpretation:"
append_long "Unauthorized devices, active expected devices that are missing, and active any-required groups with no present member decide the exit code."
append_long "Whitelist and matched any-required device lists are diagnostic context; timed rules authorize known devices outside their active windows but only require presence during active windows."
append_long "Inspect the listed unauthorized or missing USB identifiers first, then update the Puppet USB policy if the device is expected for this host and time window."

# Perfdata (ACTIVE items only for expected/any-required totals)
PERF="usb_total=${TOTAL_DEV}"
PERF="$PERF expected_present=${EXPECTED_PRESENT_COUNT}"
PERF="$PERF expected_missing=${EXPECTED_MISSING_COUNT}"
PERF="$PERF whitelisted_present=${WHITELISTED_COUNT}"
PERF="$PERF unauthorized_count=${UNAUTHORIZED_COUNT};;1"
PERF="$PERF any_required_total=${ANYREQ_TOTAL_COUNT}"
PERF="$PERF any_required_present=${ANYREQ_PRESENT_COUNT}"
PERF="$PERF any_required_ok=${ANYREQ_OK}"

# Output one monitoring line; sysfs-provided device text is sanitized before perfdata.
emit_check "$MSG" "$PERF"
exit $STATUS_CODE
