#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'memory pressure check cannot run: %s\n' "$*" >&2
    exit 3
}

# Option parser helper: every supported threshold option requires one value.
need_arg() {
    [ "$#" -ge 2 ] || die "missing value for $1"
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SLEEP=$(command -v sleep 2>/dev/null) || die "sleep not available"

# Optional helpers keep the check useful on very small systems.
GETCONF=$(command -v getconf 2>/dev/null || true)
SORT=$(command -v sort 2>/dev/null || true)

# Nagios states
STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

# Defaults / thresholds
SWAP_WARNING_PERCENT=80
SWAP_CRITICAL_PERCENT=95
MEM_AVAILABLE_WARNING_PERCENT=20
MEM_AVAILABLE_CRITICAL_PERCENT=10
SWAP_IO_WARNING_KIB=1
SWAP_IO_CRITICAL_KIB=64
INCLUDE_TOP_SWAP_PROCESSES=1
TOP_SWAP_PROCESSES_LIMIT=10
SAMPLE_INTERVAL=1

# Data paths can be overridden by the environment for lightweight validation
# without adding a separate fixture parser or config file to the runtime check.
MEMINFO_PATH=${MEMINFO_PATH:-/proc/meminfo}
VMSTAT_PATH=${VMSTAT_PATH:-/proc/vmstat}
VMSTAT_SECOND_PATH=${VMSTAT_SECOND_PATH:-}
PRESSURE_MEMORY_PATH=${PRESSURE_MEMORY_PATH:-/proc/pressure/memory}
PROC_PATH=${PROC_PATH:-/proc}
PASSWD_PATH=${PASSWD_PATH:-/etc/passwd}

# Output buffers
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_MEMORY_PRESSURE_NL__"

# Parse options. Puppet normally supplies these through monitoring_custom cmd,
# but the script stays directly usable for Nagios, Naemon, Icinga, and debugging.
usage() {
    printf '%s\n' "Usage: $0 [options]"
    printf '%s\n' ''
    printf '%s\n' 'Options:'
    printf '%s\n' '  -w, --swap-warning-percent <0-100>          Default: 80'
    printf '%s\n' '  -c, --swap-critical-percent <0-100>         Default: 95'
    printf '%s\n' '      --mem-available-warning-percent <0-100> Default: 20'
    printf '%s\n' '      --mem-available-critical-percent <0-100> Default: 10'
    printf '%s\n' '      --swap-io-warning-kib <number>          Default: 1'
    printf '%s\n' '      --swap-io-critical-kib <number>         Default: 64'
    printf '%s\n' '      --include-top-swap-processes            Include process swap usage in long output'
    printf '%s\n' '      --no-include-top-swap-processes         Disable process swap usage in long output'
    printf '%s\n' '      --top-swap-processes-limit <number>     Default: 10'
    printf '%s\n' '      --sample-interval <seconds>             Default: 1'
    printf '%s\n' '  -h, --help'
}

# Keep option handling POSIX-compatible; long options are accepted explicitly because getopts cannot parse them portably.
while [ "$#" -gt 0 ]; do
    case "$1" in
        -w|--swap-warning-percent)
            need_arg "$1" "$@"
            shift
            SWAP_WARNING_PERCENT=$1
            ;;
        -c|--swap-critical-percent)
            need_arg "$1" "$@"
            shift
            SWAP_CRITICAL_PERCENT=$1
            ;;
        --mem-available-warning-percent)
            need_arg "$1" "$@"
            shift
            MEM_AVAILABLE_WARNING_PERCENT=$1
            ;;
        --mem-available-critical-percent)
            need_arg "$1" "$@"
            shift
            MEM_AVAILABLE_CRITICAL_PERCENT=$1
            ;;
        --swap-io-warning-kib)
            need_arg "$1" "$@"
            shift
            SWAP_IO_WARNING_KIB=$1
            ;;
        --swap-io-critical-kib)
            need_arg "$1" "$@"
            shift
            SWAP_IO_CRITICAL_KIB=$1
            ;;
        --include-top-swap-processes)
            INCLUDE_TOP_SWAP_PROCESSES=1
            ;;
        --no-include-top-swap-processes)
            INCLUDE_TOP_SWAP_PROCESSES=0
            ;;
        --top-swap-processes-limit)
            need_arg "$1" "$@"
            shift
            TOP_SWAP_PROCESSES_LIMIT=$1
            ;;
        --sample-interval)
            need_arg "$1" "$@"
            shift
            SAMPLE_INTERVAL=$1
            ;;
        -h|--help)
            usage
            exit "$STATE_OK"
            ;;
        *)
            die "invalid option: $1"
            ;;
    esac
    shift
done

# Keep monitoring text safe before and after the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append one diagnostic line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Print one block with raw pipes sanitized for Nagios continuation lines.
print_sanitized_block() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Emit the summary line, fixed long output, and optional process details.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
    print_top_swap_processes
}

# Numeric validation helpers keep CLI error handling consistent.
is_uint() {
    $AWK -v value="$1" 'BEGIN { exit(value ~ /^[0-9]+$/ ? 0 : 1) }'
}

validate_uint() {
    is_uint "$2" || die "invalid numeric value for $1: $2"
}

validate_percent() {
    validate_uint "$1" "$2"
    [ "$2" -le 100 ] || die "$1 must be between 0 and 100"
}

numeric_or_zero() {
    case "$1" in
        ''|U|*[!0-9]*) printf '%s\n' 0 ;;
        *)             printf '%s\n' "$1" ;;
    esac
}

format_kib() {
    $AWK -v kib="$1" '
        BEGIN {
            if (kib >= 1048576) {
                printf "%.1f GiB", kib / 1048576
            } else if (kib >= 1024) {
                printf "%.1f MiB", kib / 1024
            } else {
                printf "%d KiB", kib
            }
        }
    '
}

read_vmstat_counters() {
    [ -r "$1" ] || return 1
    $AWK '
        $1 == "pswpin" { pswpin=$2 }
        $1 == "pswpout" { pswpout=$2 }
        END {
            if (pswpin ~ /^[0-9]+$/ && pswpout ~ /^[0-9]+$/) {
                printf "%s %s\n", pswpin, pswpout
            } else {
                exit 1
            }
        }
    ' "$1"
}

print_top_swap_processes() {
    [ "$INCLUDE_TOP_SWAP_PROCESSES" -eq 1 ] || return
    printf '%s\n' 'Top swap users:'

    # Per-process swap details are diagnostic only; missing helpers or /proc
    # access should never change the memory pressure status.
    if [ -z "$SORT" ]; then
        printf '%s\n' 'Top swap users unavailable: sort command not available'
        return
    fi

    if [ ! -d "$PROC_PATH" ]; then
        printf '%s\n' "Top swap users unavailable: ${PROC_PATH} is not a directory"
        return
    fi

    # Read /proc/<pid>/status directly. Some processes may disappear or be unreadable while the check runs, so unreadable entries are skipped.
    TOP_SWAP_OUTPUT=$(
        for STATUS_PATH in "$PROC_PATH"/[0-9]*/status; do
            [ -r "$STATUS_PATH" ] || continue
            PID_DIR=${STATUS_PATH%/status}
            PID=${PID_DIR##*/}
            $AWK -v pid="$PID" -v passwd_path="$PASSWD_PATH" '
                BEGIN {
                    name = "unknown"
                    rss = 0
                    swp = 0
                    uid = ""
                    while ((getline passwd_line < passwd_path) > 0) {
                        split(passwd_line, passwd_parts, ":")
                        uid_name[passwd_parts[3]] = passwd_parts[1]
                    }
                    close(passwd_path)
                }
                # VmSwap and VmRSS are already reported in KiB by procfs.
                $1 == "Name:" { name=$2 }
                $1 == "Uid:" { uid=$2 }
                $1 == "VmRSS:" { rss=$2 }
                $1 == "VmSwap:" { swp=$2 }
                END {
                    if (swp + 0 > 0) {
                        user = uid
                        if (uid in uid_name) {
                            user = uid_name[uid]
                        }
                        gsub(/[|]/, "[or]", user)
                        gsub(/[|]/, "[or]", name)
                        printf "%010d %d KiB swap, %d KiB rss, user=%s, process=%s, pid=%s\n", swp, swp, rss + 0, user, name, pid
                    }
                }
            ' "$STATUS_PATH"
        done | $SORT -rn | $AWK -v limit="$TOP_SWAP_PROCESSES_LIMIT" '
            {
                count++
                if (count <= limit) {
                    sub(/^[0-9]+[[:space:]]+/, "")
                    print
                }
            }
            END {
                # Make truncation explicit so long output remains bounded.
                if (count == 0) {
                    print "No processes with swap usage found"
                } else if (count > limit) {
                    printf "... truncated to %d of %d processes\n", limit, count
                }
            }
        '
    )
    print_sanitized_block "$TOP_SWAP_OUTPUT"
}

# Validate options before reading system state so configuration mistakes return
# UNKNOWN instead of being mixed with real host pressure signals.
validate_percent 'swap warning percent' "$SWAP_WARNING_PERCENT"
validate_percent 'swap critical percent' "$SWAP_CRITICAL_PERCENT"
validate_percent 'memory available warning percent' "$MEM_AVAILABLE_WARNING_PERCENT"
validate_percent 'memory available critical percent' "$MEM_AVAILABLE_CRITICAL_PERCENT"
validate_uint 'swap I/O warning KiB' "$SWAP_IO_WARNING_KIB"
validate_uint 'swap I/O critical KiB' "$SWAP_IO_CRITICAL_KIB"
validate_uint 'top swap processes limit' "$TOP_SWAP_PROCESSES_LIMIT"
validate_uint 'sample interval' "$SAMPLE_INTERVAL"
[ "$TOP_SWAP_PROCESSES_LIMIT" -ge 1 ] || die "top swap processes limit must be at least 1"
[ "$SAMPLE_INTERVAL" -ge 1 ] || die "sample interval must be at least 1"
[ "$SWAP_CRITICAL_PERCENT" -ge "$SWAP_WARNING_PERCENT" ] || die "swap critical percent must be greater than or equal to warning percent"
[ "$MEM_AVAILABLE_CRITICAL_PERCENT" -le "$MEM_AVAILABLE_WARNING_PERCENT" ] || die "memory available critical percent must be less than or equal to warning percent"
[ "$SWAP_IO_CRITICAL_KIB" -ge "$SWAP_IO_WARNING_KIB" ] || die "swap I/O critical threshold must be greater than or equal to warning threshold"

# /proc/meminfo is the authoritative source for this check. Missing required
# memory fields make the result UNKNOWN because no safe pressure decision exists.
[ -r "$MEMINFO_PATH" ] || {
    printf 'Memory pressure cannot be checked: %s is unavailable\n' "$MEMINFO_PATH"
    exit "$STATE_UNKNOWN"
}

# Collect all fields used for the summary, long output and perfdata in one pass
# so a fast-changing /proc/meminfo snapshot stays internally consistent.
MEMINFO_VALUES=$($AWK '
    function value(raw) { return raw == "" ? "U" : raw }
    $1 == "MemTotal:" { mem_total=$2 }
    $1 == "MemAvailable:" { mem_available=$2 }
    $1 == "SwapTotal:" { swap_total=$2 }
    $1 == "SwapFree:" { swap_free=$2 }
    $1 == "SwapCached:" { swap_cached=$2 }
    $1 == "Cached:" { cached=$2 }
    $1 == "Buffers:" { buffers=$2 }
    $1 == "SReclaimable:" { sreclaimable=$2 }
    $1 == "Shmem:" { shmem=$2 }
    $1 == "Unevictable:" { unevictable=$2 }
    END {
        printf "%s %s %s %s %s %s %s %s %s %s\n",
            value(mem_total), value(mem_available), value(swap_total), value(swap_free),
            value(swap_cached), value(cached), value(buffers), value(sreclaimable),
            value(shmem), value(unevictable)
    }
' "$MEMINFO_PATH") || {
    printf 'Memory pressure cannot be checked: unable to parse %s\n' "$MEMINFO_PATH"
    exit "$STATE_UNKNOWN"
}

set -- $MEMINFO_VALUES
MEM_TOTAL_KIB=$1
MEM_AVAILABLE_KIB=$2
SWAP_TOTAL_KIB=$3
SWAP_FREE_KIB=$4
SWAP_CACHED_KIB=$(numeric_or_zero "$5")
CACHED_KIB=$(numeric_or_zero "$6")
BUFFERS_KIB=$(numeric_or_zero "$7")
SRECLAIMABLE_KIB=$(numeric_or_zero "$8")
SHMEM_KIB=$(numeric_or_zero "$9")
UNEVICTABLE_KIB=$(numeric_or_zero "${10}")

# MemTotal, MemAvailable, SwapTotal and SwapFree are required for the decision
# tree. Secondary fields are useful diagnostics and fall back to zero above.
case "$MEM_TOTAL_KIB:$MEM_AVAILABLE_KIB:$SWAP_TOTAL_KIB:$SWAP_FREE_KIB" in
    *U*|*[!0-9:]*)
        printf 'Memory pressure cannot be checked: %s misses required MemTotal, MemAvailable, SwapTotal, or SwapFree values\n' "$MEMINFO_PATH"
        exit "$STATE_UNKNOWN"
        ;;
esac

[ "$MEM_TOTAL_KIB" -gt 0 ] || {
    printf 'Memory pressure cannot be checked: MemTotal is zero in %s\n' "$MEMINFO_PATH"
    exit "$STATE_UNKNOWN"
}

# A negative computed swap-used value means procfs data is inconsistent enough
# that an operator should see UNKNOWN instead of a misleading OK.
if [ "$SWAP_FREE_KIB" -gt "$SWAP_TOTAL_KIB" ]; then
    printf 'Memory pressure cannot be checked: SwapFree is greater than SwapTotal in %s\n' "$MEMINFO_PATH"
    exit "$STATE_UNKNOWN"
fi

# Use integer percentages for stable perfdata and threshold comparisons.
MEM_AVAILABLE_PERCENT=$((MEM_AVAILABLE_KIB * 100 / MEM_TOTAL_KIB))
SWAP_USED_KIB=$((SWAP_TOTAL_KIB - SWAP_FREE_KIB))
if [ "$SWAP_TOTAL_KIB" -gt 0 ]; then
    SWAP_USED_PERCENT=$((SWAP_USED_KIB * 100 / SWAP_TOTAL_KIB))
else
    SWAP_USED_PERCENT=0
fi

# Read current swap I/O from cumulative /proc/vmstat counters with a short sample.
SWAP_IO_AVAILABLE=0
SWAP_IO_NOTE=""
SWAP_IN_KIB_PER_SEC=0
SWAP_OUT_KIB_PER_SEC=0

# Convert cumulative pswpin/pswpout page counters to KiB/s. getconf is optional
# because a 4096 byte fallback is safe enough when page size cannot be queried.
if [ -n "$GETCONF" ]; then
    PAGE_SIZE_BYTES=$($GETCONF PAGESIZE 2>/dev/null || printf '%s\n' 4096)
else
    PAGE_SIZE_BYTES=4096
fi
case "$PAGE_SIZE_BYTES" in
    ''|*[!0-9]*) PAGE_SIZE_BYTES=4096 ;;
esac
[ "$PAGE_SIZE_BYTES" -gt 0 ] || PAGE_SIZE_BYTES=4096

# Take two samples to detect current swap pressure instead of historical swap
# occupancy. If vmstat cannot be read, continue with memory/swap percentages.
VMSTAT_FIRST=$(read_vmstat_counters "$VMSTAT_PATH" 2>/dev/null || true)
if [ -n "$VMSTAT_FIRST" ]; then
    set -- $VMSTAT_FIRST
    PSWPIN_FIRST=$1
    PSWPOUT_FIRST=$2

    if [ -z "$VMSTAT_SECOND_PATH" ]; then
        # Production sampling waits briefly; tests may override the second path.
        $SLEEP "$SAMPLE_INTERVAL"
        VMSTAT_SECOND_READ_PATH=$VMSTAT_PATH
    else
        VMSTAT_SECOND_READ_PATH=$VMSTAT_SECOND_PATH
    fi

    VMSTAT_SECOND=$(read_vmstat_counters "$VMSTAT_SECOND_READ_PATH" 2>/dev/null || true)
    if [ -n "$VMSTAT_SECOND" ]; then
        set -- $VMSTAT_SECOND
        PSWPIN_SECOND=$1
        PSWPOUT_SECOND=$2
        if [ "$PSWPIN_SECOND" -ge "$PSWPIN_FIRST" ] && [ "$PSWPOUT_SECOND" -ge "$PSWPOUT_FIRST" ]; then
            # pswpin/pswpout are page counters since boot, so only the delta
            # over the sample interval represents active swap I/O.
            PSWPIN_DELTA=$((PSWPIN_SECOND - PSWPIN_FIRST))
            PSWPOUT_DELTA=$((PSWPOUT_SECOND - PSWPOUT_FIRST))
            SWAP_IN_KIB_PER_SEC=$((PSWPIN_DELTA * PAGE_SIZE_BYTES / 1024 / SAMPLE_INTERVAL))
            SWAP_OUT_KIB_PER_SEC=$((PSWPOUT_DELTA * PAGE_SIZE_BYTES / 1024 / SAMPLE_INTERVAL))
            SWAP_IO_AVAILABLE=1
        else
            # Counter reset or wrap is rare, but treating it as unavailable is
            # safer than making a pressure decision from a negative delta.
            SWAP_IO_NOTE="active swap I/O could not be checked because pswpin/pswpout counters moved backwards"
        fi
    else
        SWAP_IO_NOTE="active swap I/O could not be checked because ${VMSTAT_SECOND_READ_PATH} is unavailable or missing pswpin/pswpout"
    fi
else
    SWAP_IO_NOTE="active swap I/O could not be checked because ${VMSTAT_PATH} is unavailable or missing pswpin/pswpout"
fi

# Decide status from active swap I/O first, then combined swap and MemAvailable
# thresholds. Swap occupancy alone is intentionally not a WARNING or CRITICAL.
MEM_AVAILABLE_HUMAN=$(format_kib "$MEM_AVAILABLE_KIB")
if [ "$SWAP_TOTAL_KIB" -eq 0 ]; then
    # Hosts without swap are not automatically broken; they are reported as
    # healthy unless the site policy adds a separate swap-presence check.
    FINAL_STATE='OK'
    EXIT_CODE=$STATE_OK
    SUMMARY="Memory pressure healthy: no swap configured; memory available ${MEM_AVAILABLE_PERCENT}% (${MEM_AVAILABLE_HUMAN})"
    DECISION="No swap is configured. This check treats that as healthy and reports memory availability only."
elif [ "$SWAP_IO_AVAILABLE" -eq 1 ] && { [ "$SWAP_IN_KIB_PER_SEC" -gt "$SWAP_IO_CRITICAL_KIB" ] || [ "$SWAP_OUT_KIB_PER_SEC" -gt "$SWAP_IO_CRITICAL_KIB" ]; }; then
    # Active swap I/O is the strongest pressure signal and can alert even before
    # swap occupancy or MemAvailable percentages look severe.
    FINAL_STATE='CRITICAL'
    EXIT_CODE=$STATE_CRITICAL
    SUMMARY="Memory pressure active: swap I/O is critical at si=${SWAP_IN_KIB_PER_SEC} KiB/s, so=${SWAP_OUT_KIB_PER_SEC} KiB/s; swap ${SWAP_USED_PERCENT}% used; memory available ${MEM_AVAILABLE_PERCENT}%"
    DECISION="Active swap I/O is above the critical threshold, which is treated as immediate memory pressure."
elif [ "$SWAP_USED_PERCENT" -ge "$SWAP_CRITICAL_PERCENT" ] && [ "$MEM_AVAILABLE_PERCENT" -lt "$MEM_AVAILABLE_CRITICAL_PERCENT" ]; then
    # High swap plus critically low MemAvailable is pressure even when the short
    # sample did not catch active swap I/O.
    FINAL_STATE='CRITICAL'
    EXIT_CODE=$STATE_CRITICAL
    if [ "$SWAP_IO_AVAILABLE" -eq 1 ]; then
        SUMMARY="Memory pressure active: swap ${SWAP_USED_PERCENT}% used and memory available ${MEM_AVAILABLE_PERCENT}%; si=${SWAP_IN_KIB_PER_SEC} KiB/s, so=${SWAP_OUT_KIB_PER_SEC} KiB/s"
    else
        SUMMARY="Memory pressure active: swap ${SWAP_USED_PERCENT}% used and memory available ${MEM_AVAILABLE_PERCENT}%; active swap I/O unavailable"
    fi
    DECISION="Swap usage is at or above the critical threshold and MemAvailable is below the critical threshold."
elif [ "$SWAP_IO_AVAILABLE" -eq 1 ] && { [ "$SWAP_IN_KIB_PER_SEC" -gt "$SWAP_IO_WARNING_KIB" ] || [ "$SWAP_OUT_KIB_PER_SEC" -gt "$SWAP_IO_WARNING_KIB" ]; }; then
    # Light current swapping is reported as WARNING so operators can inspect the
    # host before it becomes sustained critical pressure.
    FINAL_STATE='WARNING'
    EXIT_CODE=$STATE_WARNING
    SUMMARY="Memory pressure warning: active swap I/O observed at si=${SWAP_IN_KIB_PER_SEC} KiB/s, so=${SWAP_OUT_KIB_PER_SEC} KiB/s; swap ${SWAP_USED_PERCENT}% used; memory available ${MEM_AVAILABLE_PERCENT}%"
    DECISION="Active swap I/O is above the warning threshold but below the critical threshold."
elif [ "$SWAP_USED_PERCENT" -ge "$SWAP_WARNING_PERCENT" ] && [ "$MEM_AVAILABLE_PERCENT" -lt "$MEM_AVAILABLE_WARNING_PERCENT" ]; then
    # Occupied swap becomes actionable only when reclaim headroom is also small.
    FINAL_STATE='WARNING'
    EXIT_CODE=$STATE_WARNING
    if [ "$SWAP_IO_AVAILABLE" -eq 1 ]; then
        SUMMARY="Memory pressure warning: swap ${SWAP_USED_PERCENT}% used and memory available ${MEM_AVAILABLE_PERCENT}%; si=${SWAP_IN_KIB_PER_SEC} KiB/s, so=${SWAP_OUT_KIB_PER_SEC} KiB/s"
    else
        SUMMARY="Memory pressure warning: swap ${SWAP_USED_PERCENT}% used and memory available ${MEM_AVAILABLE_PERCENT}%; active swap I/O unavailable"
    fi
    DECISION="Swap usage is at or above the warning threshold and MemAvailable is below the warning threshold."
else
    FINAL_STATE='OK'
    EXIT_CODE=$STATE_OK
    if [ "$SWAP_USED_PERCENT" -ge "$SWAP_WARNING_PERCENT" ] && [ "$SWAP_IO_AVAILABLE" -eq 1 ] && [ "$SWAP_IN_KIB_PER_SEC" -eq 0 ] && [ "$SWAP_OUT_KIB_PER_SEC" -eq 0 ]; then
        # This is the expected false-positive reduction path: old swap pages can
        # remain allocated while the host has enough available memory.
        SUMMARY="Memory pressure healthy: swap is ${SWAP_USED_PERCENT}% used but inactive; no active swap I/O and ${MEM_AVAILABLE_HUMAN} memory available"
        DECISION="Swap usage is high, but MemAvailable is above the warning threshold and no active swap I/O was detected."
    elif [ "$SWAP_IO_AVAILABLE" -eq 0 ]; then
        SUMMARY="Memory pressure healthy: memory available ${MEM_AVAILABLE_PERCENT}%, swap ${SWAP_USED_PERCENT}% used; active swap I/O unavailable"
        DECISION="MemAvailable and swap usage are within thresholds. Active swap I/O was not available, so no I/O-based decision was made."
    else
        SUMMARY="Memory pressure healthy: memory available ${MEM_AVAILABLE_PERCENT}%, swap ${SWAP_USED_PERCENT}% used, no active swap I/O detected"
        DECISION="MemAvailable, swap usage, and active swap I/O are within thresholds."
    fi
fi

# Build perfdata with stable labels and UOMs. Labels intentionally avoid unit
# suffixes so graph history stays stable if thresholds change.
PERFDATA="memory_available=${MEM_AVAILABLE_KIB}KB;;;;"
PERFDATA="${PERFDATA} memory_available_percent=${MEM_AVAILABLE_PERCENT}%;;;0;100"
PERFDATA="${PERFDATA} swap_used=${SWAP_USED_KIB}KB;;;;"
PERFDATA="${PERFDATA} swap_used_percent=${SWAP_USED_PERCENT}%;${SWAP_WARNING_PERCENT};${SWAP_CRITICAL_PERCENT};0;100"
PERFDATA="${PERFDATA} swap_free=${SWAP_FREE_KIB}KB;;;;"
PERFDATA="${PERFDATA} swap_in=${SWAP_IN_KIB_PER_SEC}KB;${SWAP_IO_WARNING_KIB};${SWAP_IO_CRITICAL_KIB};;"
PERFDATA="${PERFDATA} swap_out=${SWAP_OUT_KIB_PER_SEC}KB;${SWAP_IO_WARNING_KIB};${SWAP_IO_CRITICAL_KIB};;"
PERFDATA="${PERFDATA} swap_cached=${SWAP_CACHED_KIB}KB;;;;"
PERFDATA="${PERFDATA} buffers=${BUFFERS_KIB}KB;;;;"
PERFDATA="${PERFDATA} cached=${CACHED_KIB}KB;;;;"
PERFDATA="${PERFDATA} sreclaimable=${SRECLAIMABLE_KIB}KB;;;;"
PERFDATA="${PERFDATA} shmem=${SHMEM_KIB}KB;;;;"
PERFDATA="${PERFDATA} unevictable=${UNEVICTABLE_KIB}KB;;;;"

# Long output starts with the memory snapshot because it is the primary evidence
# for the combined decision and useful even when swap I/O is unavailable.
append_long "MemTotal: ${MEM_TOTAL_KIB} KiB"
append_long "MemAvailable: ${MEM_AVAILABLE_KIB} KiB (${MEM_AVAILABLE_PERCENT}%)"
append_long "SwapTotal: ${SWAP_TOTAL_KIB} KiB"
append_long "SwapUsed: ${SWAP_USED_KIB} KiB (${SWAP_USED_PERCENT}%)"
append_long "SwapFree: ${SWAP_FREE_KIB} KiB"
append_long "SwapCached: ${SWAP_CACHED_KIB} KiB"
append_long "Buffers: ${BUFFERS_KIB} KiB"
append_long "Cached: ${CACHED_KIB} KiB"
append_long "SReclaimable: ${SRECLAIMABLE_KIB} KiB"
append_long "Shmem: ${SHMEM_KIB} KiB"
append_long "Unevictable: ${UNEVICTABLE_KIB} KiB"
if [ "$SWAP_IO_AVAILABLE" -eq 1 ]; then
    append_long "Swap I/O: si=${SWAP_IN_KIB_PER_SEC} KiB/s, so=${SWAP_OUT_KIB_PER_SEC} KiB/s"
else
    append_long "Swap I/O: unavailable"
    append_long "Swap I/O note: ${SWAP_IO_NOTE}"
fi

# PSI is useful context on kernels that expose it, but not a hard dependency.
if [ -r "$PRESSURE_MEMORY_PATH" ]; then
    PSI_SOME=$($AWK '$1 == "some" { print; exit }' "$PRESSURE_MEMORY_PATH" 2>/dev/null || true)
    PSI_FULL=$($AWK '$1 == "full" { print; exit }' "$PRESSURE_MEMORY_PATH" 2>/dev/null || true)
    [ -n "$PSI_SOME" ] && append_long "Memory PSI some: ${PSI_SOME}"
    [ -n "$PSI_FULL" ] && append_long "Memory PSI full: ${PSI_FULL}"
else
    append_long "Memory PSI: unavailable"
fi

# Record the exact thresholds and final rationale to avoid ambiguity during
# incident review or when per-host overrides differ from defaults.
THRESHOLDS="Thresholds: swap warning=${SWAP_WARNING_PERCENT}%, swap critical=${SWAP_CRITICAL_PERCENT}%"
THRESHOLDS="${THRESHOLDS}, memory available warning=${MEM_AVAILABLE_WARNING_PERCENT}%"
THRESHOLDS="${THRESHOLDS}, memory available critical=${MEM_AVAILABLE_CRITICAL_PERCENT}%"
THRESHOLDS="${THRESHOLDS}, swap I/O warning=${SWAP_IO_WARNING_KIB} KiB/s"
THRESHOLDS="${THRESHOLDS}, swap I/O critical=${SWAP_IO_CRITICAL_KIB} KiB/s"
append_long "$THRESHOLDS"
append_long "Decision: ${FINAL_STATE} - ${DECISION}"

emit_check "$SUMMARY" "$PERFDATA"
exit "$EXIT_CODE"
