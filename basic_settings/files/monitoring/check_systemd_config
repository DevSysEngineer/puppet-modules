#!/bin/sh
# Managed by puppet

# Fail helper used for missing runtime dependencies.
die() {
    printf 'systemd configuration check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks required by this monitoring check.
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
FIND=$(command -v find 2>/dev/null) || die "find not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
SYSTEMD_ANALYZE=$(command -v systemd-analyze 2>/dev/null) || die "systemd-analyze not available"

# Runtime options that control boot grace, output limits, and stricter reload handling.
BOOT_GRACE=300
MAX_DETAIL_LINES=10
MAX_FAILED_UNIT_LINES=10
MAX_VERIFY_LINES=10
QUIET=0
SHOW_RAW_VERIFY=0
STRICT_RELOAD=0

# Formatting sequences used when building multi-line detail sections.
LINE_BREAK='\n'
INDENT='    '

# Search roots used to locate backing files, symlinks, or textual references for missing units.
REFERENCE_SEARCH_ROOTS='/etc/systemd/system,/run/systemd/system,/run/systemd/generator,/run/systemd/generator.early,/run/systemd/generator.late,/usr/lib/systemd/system,/lib/systemd/system'

# Known runtime quirk rules that should be treated as contextual findings.
# Add a rule ID below and define its CLASS, UNIT, REFERENCE_PATTERN, and optional REQUIRED_FILE variables to extend the matcher without new functions.
KNOWN_RUNTIME_QUIRK_IDS='NETPLAN_OVS,RABBITMQ_EPMD'
QUIRK_NETPLAN_OVS_CLASS='netplan-ovs-generated-reference'
QUIRK_NETPLAN_OVS_UNIT='ovsdb-server.service'
QUIRK_NETPLAN_OVS_REFERENCE_PATTERN='^/run/systemd/system/(systemd-networkd[.]service[.]wants/)?netplan-ovs-cleanup[.]service([:]|$)'
QUIRK_NETPLAN_OVS_REQUIRED_FILE=''
QUIRK_RABBITMQ_EPMD_CLASS='rabbitmq-epmd-socket-mismatch'
QUIRK_RABBITMQ_EPMD_UNIT='epmd@0.0.0.0.socket'
QUIRK_RABBITMQ_EPMD_REFERENCE_PATTERN='^/(usr/lib|lib)/systemd/system/rabbitmq-server[.]service([:]|$)'
QUIRK_RABBITMQ_EPMD_REQUIRED_FILE='epmd.socket'

# Collected systemd manager context and top-level state used in summary and perfdata.
BOOT_GRACE_ACTIVE=U
BAD_LOAD_UNITS=U
CONTEXTUAL_NOT_FOUND_UNITS=0
DAEMON_RELOAD_METRIC=U
DEFAULT_TARGET=unknown
DEFAULT_TARGET_VALID=0
DEFAULT_TARGET_LOAD_STATE=unknown
FAILED_UNITS=0
FAILED_UNITS_UNKNOWN=0
FAILED_UNIT_DETAILS=''
FAILED_UNIT_SCAN_ERROR=''
KNOWN_RUNTIME_QUIRK_COUNT=0
MANAGER_STATE=unknown
MANAGER_STATE_CODE=7
NEED_DAEMON_RELOAD=unknown
UPTIME_SECONDS=U

# Verification state for `systemd-analyze verify` and the rendered detail output.
VERIFY_COMMAND_MODE='verify'
VERIFY_EXIT_NONZERO=U
VERIFY_MESSAGES=U
VERIFY_OUTPUT=''

# Aggregated reasons collected while determining the final Nagios status.
CRITICAL_REASONS=''
DEGRADED_STANDALONE_SUMMARY=''
MANAGER_WARNING_REASON=''
UNKNOWN_REASONS=''
WARNING_REASONS=''

# Filter settings and grouped detail output for load and parser style failures.
BAD_UNIT_FILTER='error,not-found,bad-setting'
ACTIVE_DEPENDENCY_UNITS=''
ACTIONABLE_BAD_SETTING_DETAILS=''
ACTIONABLE_ERROR_DETAILS=''
ACTIONABLE_NOT_FOUND_DETAILS=''
ACTIONABLE_OTHER_DETAILS=''
CONTEXTUAL_BAD_SETTING_DETAILS=''
CONTEXTUAL_ERROR_DETAILS=''
CONTEXTUAL_NOT_FOUND_DETAILS=''
CONTEXTUAL_OTHER_DETAILS=''

# Transient match state used while classifying known runtime quirks.
MATCHED_RUNTIME_QUIRK_CLASS=''

# Return codes captured from the external commands the check relies on.
DEFAULT_TARGET_RC=U
DEPENDENCY_TREE_RC=U
FAILED_UNIT_SCAN_RC=U
LOAD_STATE_RC=U
LIST_UNITS_RC=U
MANAGER_STATE_RC=U
NEED_DAEMON_RELOAD_RC=U
VERIFY_RC=U

# Usage text is shared by option parsing and numeric validation failures.
USAGE_TEXT="Usage: $0 [-g seconds] [-m verify_lines] [-d detail_lines] [-q] [-r] [-R]"

# Parse validation options before helper definitions and systemd calls so invalid invocations fail cleanly during setup.
OPTERR=0
while getopts 'g:m:d:qrR' opt; do
    case "$opt" in
        g) BOOT_GRACE="$OPTARG" ;;
        m) MAX_VERIFY_LINES="$OPTARG" ;;
        d)
            MAX_DETAIL_LINES="$OPTARG"
            MAX_FAILED_UNIT_LINES="$OPTARG"
            ;;
        q) QUIET=1 ;;
        r) STRICT_RELOAD=1 ;;
        R) SHOW_RAW_VERIFY=1 ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))

[ $# -eq 0 ] || die "$USAGE_TEXT"
case "$BOOT_GRACE" in
    ''|*[!0-9]*) die "$USAGE_TEXT" ;;
esac
case "$MAX_DETAIL_LINES" in
    ''|*[!0-9]*) die "$USAGE_TEXT" ;;
esac
case "$MAX_FAILED_UNIT_LINES" in
    ''|*[!0-9]*) die "$USAGE_TEXT" ;;
esac
case "$MAX_VERIFY_LINES" in
    ''|*[!0-9]*) die "$USAGE_TEXT" ;;
esac
[ "$MAX_DETAIL_LINES" -ge 1 ] || die "detail line limit must be at least 1"
[ "$MAX_FAILED_UNIT_LINES" -ge 1 ] || die "failed-unit line limit must be at least 1"
[ "$MAX_VERIFY_LINES" -ge 1 ] || die "verify line limit must be at least 1"

# Check whether a value contains only decimal digits.
is_number() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# Append a semicolon-separated reason to an existing summary string.
append_reason() {
    CURRENT_TEXT=$1
    NEW_TEXT=$2

    if [ -n "$CURRENT_TEXT" ]; then
        printf '%s; %s\n' "$CURRENT_TEXT" "$NEW_TEXT"
    else
        printf '%s\n' "$NEW_TEXT"
    fi
}

# Add one rendered unit line to the correct grouped detail bucket.
append_detail_line() {
    TARGET_NAME=$1
    TARGET_LOAD=$2
    TARGET_LINE=$3

    case "$TARGET_LOAD" in
        not-found)
            TARGET_BUCKET='NOT_FOUND'
            ;;
        error)
            TARGET_BUCKET='ERROR'
            ;;
        bad-setting)
            TARGET_BUCKET='BAD_SETTING'
            ;;
        *)
            TARGET_BUCKET='OTHER'
            ;;
    esac

    case "$TARGET_NAME" in
        actionable)
            # Actionable details are printed first because they drive the monitoring state.
            case "$TARGET_BUCKET" in
                NOT_FOUND)
                    if [ -n "$ACTIONABLE_NOT_FOUND_DETAILS" ]; then
                        ACTIONABLE_NOT_FOUND_DETAILS="${ACTIONABLE_NOT_FOUND_DETAILS},${TARGET_LINE}"
                    else
                        ACTIONABLE_NOT_FOUND_DETAILS=$TARGET_LINE
                    fi
                    ;;
                ERROR)
                    if [ -n "$ACTIONABLE_ERROR_DETAILS" ]; then
                        ACTIONABLE_ERROR_DETAILS="${ACTIONABLE_ERROR_DETAILS},${TARGET_LINE}"
                    else
                        ACTIONABLE_ERROR_DETAILS=$TARGET_LINE
                    fi
                    ;;
                BAD_SETTING)
                    if [ -n "$ACTIONABLE_BAD_SETTING_DETAILS" ]; then
                        ACTIONABLE_BAD_SETTING_DETAILS="${ACTIONABLE_BAD_SETTING_DETAILS},${TARGET_LINE}"
                    else
                        ACTIONABLE_BAD_SETTING_DETAILS=$TARGET_LINE
                    fi
                    ;;
                *)
                    if [ -n "$ACTIONABLE_OTHER_DETAILS" ]; then
                        ACTIONABLE_OTHER_DETAILS="${ACTIONABLE_OTHER_DETAILS},${TARGET_LINE}"
                    else
                        ACTIONABLE_OTHER_DETAILS=$TARGET_LINE
                    fi
                    ;;
            esac
            ;;
        contextual)
            # Contextual details stay in long output without changing the exit code.
            case "$TARGET_BUCKET" in
                NOT_FOUND)
                    if [ -n "$CONTEXTUAL_NOT_FOUND_DETAILS" ]; then
                        CONTEXTUAL_NOT_FOUND_DETAILS="${CONTEXTUAL_NOT_FOUND_DETAILS},${TARGET_LINE}"
                    else
                        CONTEXTUAL_NOT_FOUND_DETAILS=$TARGET_LINE
                    fi
                    ;;
                ERROR)
                    if [ -n "$CONTEXTUAL_ERROR_DETAILS" ]; then
                        CONTEXTUAL_ERROR_DETAILS="${CONTEXTUAL_ERROR_DETAILS},${TARGET_LINE}"
                    else
                        CONTEXTUAL_ERROR_DETAILS=$TARGET_LINE
                    fi
                    ;;
                BAD_SETTING)
                    if [ -n "$CONTEXTUAL_BAD_SETTING_DETAILS" ]; then
                        CONTEXTUAL_BAD_SETTING_DETAILS="${CONTEXTUAL_BAD_SETTING_DETAILS},${TARGET_LINE}"
                    else
                        CONTEXTUAL_BAD_SETTING_DETAILS=$TARGET_LINE
                    fi
                    ;;
                *)
                    if [ -n "$CONTEXTUAL_OTHER_DETAILS" ]; then
                        CONTEXTUAL_OTHER_DETAILS="${CONTEXTUAL_OTHER_DETAILS},${TARGET_LINE}"
                    else
                        CONTEXTUAL_OTHER_DETAILS=$TARGET_LINE
                    fi
                    ;;
            esac
            ;;
    esac
}

# Record a CRITICAL summary reason.
add_critical() {
    CRITICAL_REASONS=$(append_reason "$CRITICAL_REASONS" "$1")
}

# Record a WARNING summary reason.
add_warning() {
    WARNING_REASONS=$(append_reason "$WARNING_REASONS" "$1")
}

# Record an UNKNOWN summary reason.
add_unknown() {
    UNKNOWN_REASONS=$(append_reason "$UNKNOWN_REASONS" "$1")
}

# Return the first whitespace-delimited word from command output.
print_first_word() {
    printf '%s\n' "$1" | $AWK 'NF { print $1; exit }'
}

# Normalise empty metrics to Nagios unknown marker `U`.
metric_value() {
    if [ -n "$1" ]; then
        printf '%s' "$1"
    else
        printf '%s' 'U'
    fi
}

# Attach a UOM to known numeric values while preserving Nagios unknown markers.
metric_value_with_unit() {
    if [ -n "$1" ] && [ "$1" != 'U' ]; then
        printf '%s%s' "$1" "$2"
    else
        metric_value "$1"
    fi
}

# Nagios treats raw pipes after the first output line as perfdata separators.
sanitize_monitor_output() {
    $AWK '{ gsub(/[|]/, "[or]"); print }'
}

# Keep the first line safe before adding the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | sanitize_monitor_output | $AWK 'NR == 1 { print; exit }'
}

# Append one unique reference path to the current comma-separated list.
append_reference_path() {
    NEW_REFERENCE=$1

    case "$UNIT_REFERENCE_PATHS" in
        '')
            UNIT_REFERENCE_PATHS=$NEW_REFERENCE
            ;;
        *,"$NEW_REFERENCE",*|"$NEW_REFERENCE"|"$NEW_REFERENCE",*|*,"$NEW_REFERENCE")
            ;;
        *)
            UNIT_REFERENCE_PATHS="${UNIT_REFERENCE_PATHS},${NEW_REFERENCE}"
            ;;
    esac
}

# Collect filesystem or content references that still mention the current unit.
collect_reference_paths() {
    OLD_IFS=$IFS
    UNIT_REFERENCE_PATHS=''
    IFS=','

    for SEARCH_ROOT in $REFERENCE_SEARCH_ROOTS; do
        [ -d "$SEARCH_ROOT" ] || continue

        FOUND_NAME_PATHS=$($FIND "$SEARCH_ROOT" \( -type f -o -type l \) \( -name "$UNIT_NAME" -o -lname "*$UNIT_NAME" \) 2>/dev/null | $AWK 'NF { if (count) printf ","; printf "%s", $0; count++ }')
        if [ -n "$FOUND_NAME_PATHS" ]; then
            for FOUND_PATH in $FOUND_NAME_PATHS; do
                [ -n "$FOUND_PATH" ] || continue
                append_reference_path "$FOUND_PATH"
            done
        fi
    done

    if [ -n "$UNIT_REFERENCE_PATHS" ]; then
        IFS=$OLD_IFS
        return
    fi

    for SEARCH_ROOT in $REFERENCE_SEARCH_ROOTS; do
        [ -d "$SEARCH_ROOT" ] || continue

        FOUND_CONTENT_PATHS=$($GREP -R -n -F "$UNIT_NAME" "$SEARCH_ROOT" 2>/dev/null | $AWK 'NF { if (count) printf ","; printf "%s", $0; count++ }')
        if [ -n "$FOUND_CONTENT_PATHS" ]; then
            for FOUND_PATH in $FOUND_CONTENT_PATHS; do
                [ -n "$FOUND_PATH" ] || continue
                append_reference_path "$FOUND_PATH"
            done
        fi
    done

    IFS=$OLD_IFS
}

# Render the collected reference list as an indented multiline bullet block.
format_reference_paths() {
    if [ -n "$1" ]; then
        printf '%s\n' "$1" | $AWK -F',' -v indent="$INDENT" '
            {
                for (field_index = 1; field_index <= NF; field_index++) {
                    if ($field_index == "") {
                        continue
                    }
                    if (count > 0) {
                        printf "\\n"
                    }
                    printf "%s- %s", indent, $field_index
                    count++
                }
            }
        '
    fi
}

# Print a comma-separated detail bucket as individual rendered lines.
print_detail_block() {
    OLD_IFS=$IFS
    IFS=','

    for DETAIL_LINE in $1; do
        [ -n "$DETAIL_LINE" ] || continue
        printf '%b\n' "$DETAIL_LINE"
    done

    IFS=$OLD_IFS
}

# Extract one named property from `systemctl show` style key=value output.
get_show_property() {
    printf '%s\n' "$1" | $AWK -v key="$2" 'index($0, key "=") == 1 { sub(/^[^=]*=/, ""); print; exit }'
}

# Check whether every collected reference path matches the supplied AWK regex.
reference_paths_match_pattern() {
    [ -n "$UNIT_REFERENCE_PATHS" ] || return 1

    printf '%s\n' "$UNIT_REFERENCE_PATHS" | $AWK -F',' -v pattern="$1" '
        {
            for (field_index = 1; field_index <= NF; field_index++) {
                if ($field_index == "") {
                    continue
                }
                count++
                if ($field_index !~ pattern) {
                    bad = 1
                }
            }
        }
        END {
            exit(count > 0 && !bad ? 0 : 1)
        }
    '
}

# Check whether a helper file exists in any configured systemd search root.
search_roots_contain_file() {
    OLD_IFS=$IFS
    IFS=','
    for SEARCH_ROOT in $REFERENCE_SEARCH_ROOTS; do
        if [ -f "${SEARCH_ROOT}/$1" ]; then
            IFS=$OLD_IFS
            return 0
        fi
    done
    IFS=$OLD_IFS
    return 1
}

# Match the current unit against the configurable list of known runtime quirks.
match_known_runtime_quirk() {
    OLD_IFS=$IFS
    MATCHED_RUNTIME_QUIRK_CLASS=''
    IFS=','

    for QUIRK_ID in $KNOWN_RUNTIME_QUIRK_IDS; do
        [ -n "$QUIRK_ID" ] || continue

        eval "QUIRK_CLASS=\${QUIRK_${QUIRK_ID}_CLASS}"
        eval "QUIRK_UNIT=\${QUIRK_${QUIRK_ID}_UNIT}"
        eval "QUIRK_REFERENCE_PATTERN=\${QUIRK_${QUIRK_ID}_REFERENCE_PATTERN}"
        eval "QUIRK_REQUIRED_FILE=\${QUIRK_${QUIRK_ID}_REQUIRED_FILE}"

        [ "$UNIT_NAME" = "$QUIRK_UNIT" ] || continue

        if [ -n "$QUIRK_REQUIRED_FILE" ]; then
            search_roots_contain_file "$QUIRK_REQUIRED_FILE" || continue
        fi

        reference_paths_match_pattern "$QUIRK_REFERENCE_PATTERN" || continue
        MATCHED_RUNTIME_QUIRK_CLASS=$QUIRK_CLASS
        IFS=$OLD_IFS
        return 0
    done

    IFS=$OLD_IFS
    return 1
}

# Render grouped detail buckets with optional suppression of duplicate headers.
print_grouped_details() {
    GROUP_NOT_FOUND=$1
    GROUP_ERROR=$2
    GROUP_BAD_SETTING=$3
    GROUP_OTHER=$4
    SUPPRESS_SINGLE_NOT_FOUND_HEADER=$5
    GROUP_COUNT=0

    [ -n "$GROUP_NOT_FOUND" ] && GROUP_COUNT=$((GROUP_COUNT + 1))
    [ -n "$GROUP_ERROR" ] && GROUP_COUNT=$((GROUP_COUNT + 1))
    [ -n "$GROUP_BAD_SETTING" ] && GROUP_COUNT=$((GROUP_COUNT + 1))
    [ -n "$GROUP_OTHER" ] && GROUP_COUNT=$((GROUP_COUNT + 1))

    if [ -n "$GROUP_NOT_FOUND" ]; then
        printf '%s\n' ""
        if [ "$SUPPRESS_SINGLE_NOT_FOUND_HEADER" != '1' ] || [ "$GROUP_COUNT" -gt 1 ]; then
            printf '%s\n' 'not-found:'
        fi
        print_detail_block "$GROUP_NOT_FOUND"
    fi

    if [ -n "$GROUP_ERROR" ]; then
        printf '%s\n' ""
        printf '%s\n' 'error:'
        print_detail_block "$GROUP_ERROR"
    fi

    if [ -n "$GROUP_BAD_SETTING" ]; then
        printf '%s\n' ""
        printf '%s\n' 'bad-setting:'
        print_detail_block "$GROUP_BAD_SETTING"
    fi

    if [ -n "$GROUP_OTHER" ]; then
        printf '%s\n' ""
        printf '%s\n' 'other:'
        print_detail_block "$GROUP_OTHER"
    fi
}

# Count how many rendered lines a grouped detail section would emit.
count_grouped_detail_lines() {
    print_grouped_details "$1" "$2" "$3" "$4" "$5" | $AWK 'END { print NR + 0 }'
}

# Print a grouped detail section with a maximum rendered line limit.
print_grouped_details_limited() {
    print_grouped_details "$1" "$2" "$3" "$4" "$5" | $AWK -v max="$6" '
        NR <= max { print }
        END {
            if (NR > max) {
                print "[truncated after " max " lines]"
            }
        }
    '
}

# Print one detail section heading and apply the configured truncation policy.
print_detail_section() {
    SECTION_TITLE=$1
    SECTION_COUNT=$2
    GROUP_NOT_FOUND=$3
    GROUP_ERROR=$4
    GROUP_BAD_SETTING=$5
    GROUP_OTHER=$6
    SUPPRESS_SINGLE_NOT_FOUND_HEADER=$7

    if [ "$SECTION_COUNT" -eq 0 ]; then
        printf '%s\n' "${SECTION_TITLE}: none"
        return
    fi

    SECTION_TOTAL_LINES=$(count_grouped_detail_lines "$GROUP_NOT_FOUND" "$GROUP_ERROR" "$GROUP_BAD_SETTING" "$GROUP_OTHER" "$SUPPRESS_SINGLE_NOT_FOUND_HEADER")

    if [ "$SECTION_TOTAL_LINES" -gt "$MAX_DETAIL_LINES" ]; then
        printf '%s\n' "${SECTION_TITLE} (${SECTION_COUNT}, showing first ${MAX_DETAIL_LINES} of ${SECTION_TOTAL_LINES} lines):"
        print_grouped_details_limited "$GROUP_NOT_FOUND" "$GROUP_ERROR" "$GROUP_BAD_SETTING" "$GROUP_OTHER" "$SUPPRESS_SINGLE_NOT_FOUND_HEADER" "$MAX_DETAIL_LINES"
    else
        printf '%s\n' "${SECTION_TITLE} (${SECTION_COUNT}):"
        print_grouped_details "$GROUP_NOT_FOUND" "$GROUP_ERROR" "$GROUP_BAD_SETTING" "$GROUP_OTHER" "$SUPPRESS_SINGLE_NOT_FOUND_HEADER"
    fi
}

# Collect failed runtime units only as explanatory context for a degraded systemd manager state.
collect_failed_units() {
    FAILED_UNIT_SCAN_OUTPUT=$($SYSTEMCTL list-units --failed --plain --no-legend --no-pager 2>&1)
    FAILED_UNIT_SCAN_RC=$?

    if [ "$FAILED_UNIT_SCAN_RC" -ne 0 ]; then
        FAILED_UNITS=U
        FAILED_UNITS_UNKNOWN=1
        FAILED_UNIT_SCAN_ERROR=$(monitor_text_value "$FAILED_UNIT_SCAN_OUTPUT")
        [ -n "$FAILED_UNIT_SCAN_ERROR" ] || FAILED_UNIT_SCAN_ERROR="systemctl list-units --failed exited with ${FAILED_UNIT_SCAN_RC}"
        return
    fi

    # The expected list-units layout is UNIT LOAD ACTIVE SUB DESCRIPTION; anything else would make the explanation unreliable.
    printf '%s\n' "$FAILED_UNIT_SCAN_OUTPUT" | $AWK 'NF && (NF < 4 || $3 != "failed") { bad = 1 } END { exit(bad ? 1 : 0) }'
    if [ $? -ne 0 ]; then
        FAILED_UNITS=U
        FAILED_UNITS_UNKNOWN=1
        FAILED_UNIT_SCAN_ERROR='systemctl list-units --failed returned an unexpected format'
        return
    fi

    FAILED_UNITS=$(printf '%s\n' "$FAILED_UNIT_SCAN_OUTPUT" | $AWK 'NF { count++ } END { print count + 0 }')
    FAILED_UNITS_UNKNOWN=0

    if [ "$FAILED_UNITS" -gt 0 ]; then
        FAILED_UNIT_DETAILS=$(printf '%s\n' "$FAILED_UNIT_SCAN_OUTPUT" | $AWK '
            NF {
                description = ""
                for (field_index = 5; field_index <= NF; field_index++) {
                    if (description != "") {
                        description = description " "
                    }
                    description = description $field_index
                }
                if (description == "") {
                    description = "(no description)"
                }
                gsub(/[[:cntrl:]]/, " ", description)
                printf "- %s; load=%s; active=%s; sub=%s; description=%s\n", $1, $2, $3, $4, description
            }
        ')
    else
        FAILED_UNIT_DETAILS=''
    fi
}

# Print bounded failed-unit context without changing the check into a service-health check.
print_failed_units_section() {
    if [ "$MANAGER_STATE" != 'degraded' ]; then
        return
    fi

    if [ "$FAILED_UNITS_UNKNOWN" = '1' ]; then
        printf '%s\n' 'Failed units causing degraded state: unavailable'
        if [ -n "$FAILED_UNIT_SCAN_ERROR" ]; then
            printf '%s\n' "Reason: ${FAILED_UNIT_SCAN_ERROR}"
        fi
        printf '%s\n' ""
        printf '%s\n' 'Interpretation:'
        printf '%s\n' 'The check could not determine the failed runtime units behind the degraded manager state.'
        printf '%s\n' 'Escalate to server operations for manual investigation.'
        return
    fi

    if [ "$FAILED_UNITS" -eq 0 ]; then
        printf '%s\n' 'Failed units causing degraded state: none returned'
        printf '%s\n' ""
        printf '%s\n' 'Interpretation:'
        printf '%s\n' 'systemd reports degraded, but no failed units were returned by systemctl list-units --failed.'
        printf '%s\n' 'Escalate to server operations for manual investigation.'
        return
    fi

    if [ "$FAILED_UNITS" -gt "$MAX_FAILED_UNIT_LINES" ]; then
        printf '%s\n' "Failed units causing degraded state (showing first ${MAX_FAILED_UNIT_LINES} of ${FAILED_UNITS}):"
        printf '%s\n' "$FAILED_UNIT_DETAILS" | $AWK -v max="$MAX_FAILED_UNIT_LINES" '
            NR <= max { print }
            END {
                if (NR > max) {
                    print "[truncated after " max " lines]"
                }
            }
        '
    else
        printf '%s\n' "Failed units causing degraded state (${FAILED_UNITS}):"
        printf '%s\n' "$FAILED_UNIT_DETAILS"
    fi

    printf '%s\n' ""
    printf '%s\n' 'Interpretation:'
    if [ -n "$CRITICAL_REASONS" ]; then
        printf '%s\n' 'Systemd configuration errors were also found by this check.'
        printf '%s\n' 'Review the configuration findings first; the failed runtime units explain why the manager state is degraded.'
    else
        printf '%s\n' 'No systemd configuration errors were found by this check.'
        printf '%s\n' 'The degraded manager state is caused by failed runtime units.'
        printf '%s\n' 'Escalate to server/application operations if these failed units are unexpected.'
    fi
}

# Check whether the verify output explicitly mentions the current unit.
verify_mentions_unit() {
    [ -n "$VERIFY_OUTPUT" ] || return 1
    printf '%s\n' "$VERIFY_OUTPUT" | $AWK -v unit="$1" 'index($0, unit) { found = 1; exit } END { exit(found ? 0 : 1) }'
}

# Check whether the default target dependency tree includes the current unit.
dependency_tree_mentions_unit() {
    [ -n "$ACTIVE_DEPENDENCY_UNITS" ] || return 1
    printf '%s\n' "$ACTIVE_DEPENDENCY_UNITS" | $AWK -F',' -v unit="$1" '
        {
            for (field_index = 1; field_index <= NF; field_index++) {
                if ($field_index == unit) {
                    found = 1
                    exit
                }
            }
        }
        END { exit(found ? 0 : 1) }
    '
}

# Recognise systemd special placeholder units that are expected to be missing.
is_special_placeholder_unit() {
    case "$1" in
        display-manager.service|syslog.service|syslog.socket|syslog.target)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Recognise enable states that indicate an explicitly configured unit reference.
is_explicit_enable_state() {
    case "$1" in
        enabled|enabled-runtime|linked|linked-runtime|generated|transient)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Inspect each bad-load unit and classify it as actionable or contextual.
inspect_bad_units() {
    OLD_IFS=$IFS
    IFS=','

    for UNIT_LINE in $LIST_UNITS_RAW; do
        UNIT_NAME=$(printf '%s\n' "$UNIT_LINE" | $AWK 'NF { print $1; exit }')
        [ -n "$UNIT_NAME" ] || continue

        # Combine list-units and show data because missing units expose different fields per systemd version.
        UNIT_LIST_LOAD_STATE=$(printf '%s\n' "$UNIT_LINE" | $AWK 'NF { print $2; exit }')
        UNIT_SHOW=$($SYSTEMCTL show "$UNIT_NAME" -p LoadState -p FragmentPath -p SourcePath -p Where -p What 2>/dev/null || true)
        UNIT_ENABLE_STATE_RAW=$($SYSTEMCTL is-enabled "$UNIT_NAME" 2>/dev/null || true)

        UNIT_LOAD_STATE=$(get_show_property "$UNIT_SHOW" LoadState)
        [ -n "$UNIT_LOAD_STATE" ] || UNIT_LOAD_STATE=$UNIT_LIST_LOAD_STATE
        UNIT_FRAGMENT_PATH=$(get_show_property "$UNIT_SHOW" FragmentPath)
        UNIT_SOURCE_PATH=$(get_show_property "$UNIT_SHOW" SourcePath)
        UNIT_WHERE=$(get_show_property "$UNIT_SHOW" Where)
        UNIT_WHAT=$(get_show_property "$UNIT_SHOW" What)
        UNIT_ENABLE_STATE=$(print_first_word "$UNIT_ENABLE_STATE_RAW")
        UNIT_SUFFIX=${UNIT_NAME##*.}
        UNIT_CLASS='actionable'
        UNIT_ACTIONABLE=1
        UNIT_REFERENCE_PATHS=''

        # Classify not-found units before applying runtime-quirk suppression.
        case "$UNIT_LOAD_STATE" in
            error)
                UNIT_CLASS='load-error'
                ;;
            bad-setting)
                UNIT_CLASS='bad-setting'
                ;;
            not-found)
                if is_special_placeholder_unit "$UNIT_NAME"; then
                    UNIT_CLASS='special-placeholder'
                    UNIT_ACTIONABLE=0
                elif [ "$UNIT_SUFFIX" = 'mount' ] && [ -z "$UNIT_FRAGMENT_PATH$UNIT_SOURCE_PATH$UNIT_WHERE$UNIT_WHAT" ]; then
                    UNIT_CLASS='implicit-mount-dependency'
                    UNIT_ACTIONABLE=0
                elif verify_mentions_unit "$UNIT_NAME"; then
                    UNIT_CLASS='verify-reference'
                elif [ -n "$UNIT_FRAGMENT_PATH" ] || [ -n "$UNIT_SOURCE_PATH" ]; then
                    UNIT_CLASS='missing-fragment'
                elif is_explicit_enable_state "$UNIT_ENABLE_STATE"; then
                    UNIT_CLASS='enabled-missing-unit'
                elif dependency_tree_mentions_unit "$UNIT_NAME"; then
                    UNIT_CLASS='dependency-not-found'
                else
                    UNIT_CLASS='unbacked-not-found'
                    UNIT_ACTIONABLE=0
                fi
                ;;
            *)
                UNIT_CLASS='unexpected-load-state'
                ;;
        esac

        # Reference paths explain why an otherwise missing unit is still actionable.
        if [ -z "$UNIT_FRAGMENT_PATH$UNIT_SOURCE_PATH" ]; then
            collect_reference_paths
        fi

        # Runtime quirks are counted but not allowed to page when they match a known benign pattern.
        if [ "$UNIT_LOAD_STATE" = 'not-found' ] && [ "$UNIT_ACTIONABLE" -eq 1 ]; then
            if match_known_runtime_quirk; then
                UNIT_CLASS=$MATCHED_RUNTIME_QUIRK_CLASS
                UNIT_ACTIONABLE=0
                KNOWN_RUNTIME_QUIRK_COUNT=$((KNOWN_RUNTIME_QUIRK_COUNT + 1))
            fi
        fi

        # Detail buffers are split by actionable/contextual class for clearer long output.
        UNIT_DETAIL="- ${UNIT_NAME}; class=${UNIT_CLASS}"
        if [ -n "$UNIT_REFERENCE_PATHS" ]; then
            UNIT_DETAIL="${UNIT_DETAIL}; referenced_by:${LINE_BREAK}$(format_reference_paths "$UNIT_REFERENCE_PATHS")"
        fi

        if [ "$UNIT_ACTIONABLE" -eq 1 ]; then
            BAD_LOAD_UNITS=$((BAD_LOAD_UNITS + 1))
            append_detail_line actionable "$UNIT_LOAD_STATE" "$UNIT_DETAIL"
        else
            CONTEXTUAL_NOT_FOUND_UNITS=$((CONTEXTUAL_NOT_FOUND_UNITS + 1))
            append_detail_line contextual "$UNIT_LOAD_STATE" "$UNIT_DETAIL"
        fi
    done

    IFS=$OLD_IFS
}

# Boot grace suppresses transient manager states immediately after startup.
if [ -r /proc/uptime ]; then
    IFS=' ' read -r UPTIME_RAW _ </proc/uptime
    case "$UPTIME_RAW" in
        ''|*[!0-9.]*)
            UPTIME_SECONDS=U
            BOOT_GRACE_ACTIVE=U
            ;;
        *)
            UPTIME_SECONDS=${UPTIME_RAW%%.*}
            if [ -n "$UPTIME_SECONDS" ] && is_number "$UPTIME_SECONDS"; then
                if [ "$UPTIME_SECONDS" -lt "$BOOT_GRACE" ]; then
                    BOOT_GRACE_ACTIVE=1
                else
                    BOOT_GRACE_ACTIVE=0
                fi
            else
                UPTIME_SECONDS=U
                BOOT_GRACE_ACTIVE=U
            fi
            ;;
    esac
fi

# Manager state is the primary systemd-wide health signal.
MANAGER_STATE_RAW=$($SYSTEMCTL is-system-running 2>/dev/null)
MANAGER_STATE_RC=$?
MANAGER_STATE=$(print_first_word "$MANAGER_STATE_RAW")
[ -n "$MANAGER_STATE" ] || MANAGER_STATE=unknown

case "$MANAGER_STATE" in
    running) MANAGER_STATE_CODE=0 ;;
    degraded) MANAGER_STATE_CODE=1 ;;
    starting) MANAGER_STATE_CODE=2 ;;
    initializing) MANAGER_STATE_CODE=3 ;;
    stopping) MANAGER_STATE_CODE=4 ;;
    maintenance) MANAGER_STATE_CODE=5 ;;
    offline) MANAGER_STATE_CODE=6 ;;
    unknown) MANAGER_STATE_CODE=7 ;;
    *) MANAGER_STATE_CODE=8 ;;
esac

if [ -z "$MANAGER_STATE_RAW" ] && [ "$MANAGER_STATE_RC" -ne 0 ]; then
    add_unknown 'manager state unavailable'
fi

if [ "$MANAGER_STATE" = 'degraded' ]; then
    collect_failed_units
fi

# The default target anchors recursive verification and daemon-reload checks.
DEFAULT_TARGET_RAW=$($SYSTEMCTL get-default 2>/dev/null)
DEFAULT_TARGET_RC=$?
DEFAULT_TARGET=$(print_first_word "$DEFAULT_TARGET_RAW")

if [ "$DEFAULT_TARGET_RC" -ne 0 ] || [ -z "$DEFAULT_TARGET" ]; then
    DEFAULT_TARGET=unknown
    add_unknown 'default target unavailable'
else
    case "$DEFAULT_TARGET" in
        *.target)
            DEFAULT_TARGET_VALID=1
            ;;
        *)
            add_critical "default target invalid (${DEFAULT_TARGET})"
            ;;
    esac
fi

# Default-target properties expose stale daemon state even when the manager is running.
if [ "$DEFAULT_TARGET_VALID" -eq 1 ]; then
    LOAD_STATE_RAW=$($SYSTEMCTL show -p LoadState --value "$DEFAULT_TARGET" 2>/dev/null)
    LOAD_STATE_RC=$?
    DEFAULT_TARGET_LOAD_STATE=$(print_first_word "$LOAD_STATE_RAW")

    if [ "$LOAD_STATE_RC" -ne 0 ] || [ -z "$DEFAULT_TARGET_LOAD_STATE" ]; then
        DEFAULT_TARGET_LOAD_STATE=unknown
        add_unknown 'default target LoadState unavailable'
    elif [ "$DEFAULT_TARGET_LOAD_STATE" != 'loaded' ]; then
        add_critical "default target load=${DEFAULT_TARGET_LOAD_STATE}"
    fi

    NEED_DAEMON_RELOAD_RAW=$($SYSTEMCTL show -p NeedDaemonReload --value "$DEFAULT_TARGET" 2>/dev/null)
    NEED_DAEMON_RELOAD_RC=$?
    NEED_DAEMON_RELOAD=$(print_first_word "$NEED_DAEMON_RELOAD_RAW")

    case "$NEED_DAEMON_RELOAD" in
        yes)
            DAEMON_RELOAD_METRIC=1
            if [ "$STRICT_RELOAD" -eq 1 ]; then
                add_critical 'daemon_reload=yes'
            else
                add_warning 'daemon_reload=yes'
            fi
            ;;
        no)
            DAEMON_RELOAD_METRIC=0
            ;;
        *)
            NEED_DAEMON_RELOAD=unknown
            add_unknown 'NeedDaemonReload unavailable'
            ;;
    esac
fi

# Fall back to plain verify on older systemd releases that lack --recursive-errors=yes, while preferring the stricter path when available.
VERIFY_HELP=$($SYSTEMD_ANALYZE verify --help 2>&1 || true)
printf '%s\n' "$VERIFY_HELP" | $AWK 'index($0, "recursive-errors") { found = 1 } END { exit(found ? 0 : 1) }'
if [ $? -eq 0 ]; then
    VERIFY_COMMAND_MODE='verify --recursive-errors=yes'
    VERIFY_SUPPORTS_RECURSIVE=1
else
    VERIFY_COMMAND_MODE='verify'
    VERIFY_SUPPORTS_RECURSIVE=0
fi

if [ "$DEFAULT_TARGET_VALID" -eq 1 ]; then
    if [ "$VERIFY_SUPPORTS_RECURSIVE" -eq 1 ]; then
        VERIFY_OUTPUT=$($SYSTEMD_ANALYZE verify --recursive-errors=yes "$DEFAULT_TARGET" 2>&1)
    else
        VERIFY_OUTPUT=$($SYSTEMD_ANALYZE verify "$DEFAULT_TARGET" 2>&1)
    fi
    VERIFY_RC=$?

    if [ "$VERIFY_RC" -ne 0 ]; then
        VERIFY_EXIT_NONZERO=1
        add_critical 'verify failed'
    else
        VERIFY_EXIT_NONZERO=0
    fi

    VERIFY_MESSAGES=$(printf '%s\n' "$VERIFY_OUTPUT" | $AWK 'NF { count++ } END { print count + 0 }')
fi

if [ "$DEFAULT_TARGET_VALID" -eq 1 ]; then
    ACTIVE_DEPENDENCY_RAW=$($SYSTEMCTL list-dependencies --plain --all --no-legend "$DEFAULT_TARGET" 2>/dev/null)
    DEPENDENCY_TREE_RC=$?
    if [ "$DEPENDENCY_TREE_RC" -eq 0 ]; then
        ACTIVE_DEPENDENCY_UNITS=$(printf '%s\n' "$ACTIVE_DEPENDENCY_RAW" | $AWK 'NF { if (count) printf ","; printf "%s", $1; count++ }')
    fi
fi

# This scan is intentionally limited to load and parser style failures, not general runtime state, to keep the check scoped to systemd configuration.
LIST_UNITS_OUTPUT=$($SYSTEMCTL list-units --all --plain --no-legend --no-pager --state="$BAD_UNIT_FILTER" 2>/dev/null)
LIST_UNITS_RC=$?
LIST_UNITS_RAW=$(printf '%s\n' "$LIST_UNITS_OUTPUT" | $AWK 'NF { if (count) printf ","; printf "%s", $0; count++ }')

if [ "$LIST_UNITS_RC" -ne 0 ]; then
    add_unknown 'bad-load unit scan failed'
else
    BAD_LOAD_UNITS=0
    inspect_bad_units
    if [ "$BAD_LOAD_UNITS" -gt 0 ]; then
        add_critical "${BAD_LOAD_UNITS} actionable load/config error(s)"
    fi
fi

# Manager state is contextual only here. Boot grace softens transitional states, but never suppresses real config or load errors collected above.
case "$MANAGER_STATE" in
    degraded)
        if [ "$FAILED_UNITS_UNKNOWN" = '1' ]; then
            MANAGER_WARNING_REASON='manager degraded; failed units unavailable'
            DEGRADED_STANDALONE_SUMMARY='systemd manager degraded: cause unclear; failed units unavailable; no systemd config errors found'
        elif [ "$FAILED_UNITS" -gt 0 ]; then
            MANAGER_WARNING_REASON="manager degraded with ${FAILED_UNITS} failed unit(s)"
            DEGRADED_STANDALONE_SUMMARY="systemd manager degraded: ${FAILED_UNITS} failed unit(s); no systemd config errors found"
        else
            MANAGER_WARNING_REASON='manager degraded; no failed units returned'
            DEGRADED_STANDALONE_SUMMARY='systemd manager degraded: cause unclear; no failed units returned; no systemd config errors found'
        fi
        add_warning "$MANAGER_WARNING_REASON"
        ;;
    maintenance)
        add_warning "manager state ${MANAGER_STATE}"
        ;;
    starting|initializing|stopping)
        if [ "$BOOT_GRACE_ACTIVE" = '1' ]; then
            :
        else
            add_warning "manager state ${MANAGER_STATE}"
        fi
        ;;
    offline|unknown)
        if [ -n "$UNKNOWN_REASONS" ]; then
            :
        else
            add_warning "manager state ${MANAGER_STATE}"
        fi
        ;;
    running)
        :
        ;;
    *)
        add_warning "manager state ${MANAGER_STATE}"
        ;;
esac

if [ -n "$CRITICAL_REASONS" ]; then
    STATE=2
    SUMMARY_BASE='systemd configuration invalid'
    SUMMARY_REASONS=$CRITICAL_REASONS
    if [ -n "$WARNING_REASONS" ]; then
        SUMMARY_REASONS=$(append_reason "$SUMMARY_REASONS" "$WARNING_REASONS")
    fi
elif [ -n "$UNKNOWN_REASONS" ]; then
    STATE=3
    SUMMARY_BASE='systemd configuration check inconclusive'
    SUMMARY_REASONS=$UNKNOWN_REASONS
    if [ -n "$WARNING_REASONS" ]; then
        SUMMARY_REASONS=$(append_reason "$SUMMARY_REASONS" "$WARNING_REASONS")
    fi
elif [ -n "$WARNING_REASONS" ]; then
    STATE=1
    if [ "$MANAGER_STATE" = 'degraded' ] && [ "$WARNING_REASONS" = "$MANAGER_WARNING_REASON" ]; then
        SUMMARY_BASE=$DEGRADED_STANDALONE_SUMMARY
        SUMMARY_REASONS=''
    else
        SUMMARY_BASE='systemd configuration has non-critical findings'
        SUMMARY_REASONS=$WARNING_REASONS
    fi
else
    STATE=0
    SUMMARY_BASE='systemd configuration valid'
    SUMMARY_REASONS=''
fi

if [ -n "$SUMMARY_REASONS" ]; then
    SUMMARY="${SUMMARY_BASE}; ${SUMMARY_REASONS}"
else
    SUMMARY=$SUMMARY_BASE
fi

PERFDATA="manager_state_code=$(metric_value "$MANAGER_STATE_CODE")"
PERFDATA="${PERFDATA} bad_load_units=$(metric_value "$BAD_LOAD_UNITS")"
PERFDATA="${PERFDATA} failed_units=$(metric_value "$FAILED_UNITS")"
PERFDATA="${PERFDATA} failed_units_unknown=$(metric_value "$FAILED_UNITS_UNKNOWN")"
PERFDATA="${PERFDATA} contextual_not_found_units=$(metric_value "$CONTEXTUAL_NOT_FOUND_UNITS")"
PERFDATA="${PERFDATA} known_runtime_quirks=$(metric_value "$KNOWN_RUNTIME_QUIRK_COUNT")"
PERFDATA="${PERFDATA} daemon_reload=$(metric_value "$DAEMON_RELOAD_METRIC")"
PERFDATA="${PERFDATA} verify_exit_nonzero=$(metric_value "$VERIFY_EXIT_NONZERO")"
PERFDATA="${PERFDATA} verify_messages=$(metric_value "$VERIFY_MESSAGES")"
PERFDATA="${PERFDATA} boot_grace_active=$(metric_value "$BOOT_GRACE_ACTIVE")"
PERFDATA="${PERFDATA} uptime=$(metric_value_with_unit "$UPTIME_SECONDS" s)"

printf '%s | %s\n' "$(monitor_text_value "$SUMMARY")" "$PERFDATA"

if [ "$QUIET" -eq 1 ]; then
    exit "$STATE"
fi

{
if is_number "$UPTIME_SECONDS"; then
    UPTIME_TEXT="${UPTIME_SECONDS}s"
else
    UPTIME_TEXT='unknown'
fi

case "$BOOT_GRACE_ACTIVE" in
    0) BOOT_GRACE_TEXT='no' ;;
    1) BOOT_GRACE_TEXT='yes' ;;
    *) BOOT_GRACE_TEXT='unknown' ;;
esac

printf '%s\n' "Manager state: ${MANAGER_STATE}"
printf '%s\n' "Uptime: ${UPTIME_TEXT}"
printf '%s\n' "Boot grace active: ${BOOT_GRACE_TEXT}"
printf '%s\n' "Default target: ${DEFAULT_TARGET}"
printf '%s\n' "Default target LoadState: ${DEFAULT_TARGET_LOAD_STATE}"
printf '%s\n' "Need daemon reload: ${NEED_DAEMON_RELOAD}"
printf '%s\n' "Verify mode: ${VERIFY_COMMAND_MODE}"
printf '%s\n' ""

if [ "$DEFAULT_TARGET_VALID" -ne 1 ]; then
    printf '%s\n' 'Configuration result: invalid, default target is invalid or unavailable'
elif [ "$LIST_UNITS_RC" -ne 0 ]; then
    printf '%s\n' 'Configuration result: inconclusive, load/config unit scan failed'
elif [ "$BAD_LOAD_UNITS" -gt 0 ]; then
    printf '%s\n' "Configuration result: invalid, ${BAD_LOAD_UNITS} actionable load/config error(s) found"
elif [ "$VERIFY_EXIT_NONZERO" = '1' ]; then
    printf '%s\n' 'Configuration result: invalid, systemd-analyze verify failed'
elif [ "$DEFAULT_TARGET_LOAD_STATE" != 'loaded' ]; then
    printf '%s\n' "Configuration result: invalid, default target load=${DEFAULT_TARGET_LOAD_STATE}"
elif [ "$NEED_DAEMON_RELOAD" = 'yes' ]; then
    if [ "$STRICT_RELOAD" -eq 1 ]; then
        printf '%s\n' 'Configuration result: invalid, daemon-reload is required'
    else
        printf '%s\n' 'Configuration result: valid but daemon-reload is required'
    fi
else
    printf '%s\n' 'Configuration result: no actionable load/config errors found'
fi

case "$MANAGER_STATE" in
    degraded)
        if [ "$FAILED_UNITS_UNKNOWN" = '1' ]; then
            printf '%s\n' 'Runtime manager result: degraded, but failed units are unavailable'
        elif [ "$FAILED_UNITS" -gt 0 ]; then
            printf '%s\n' "Runtime manager result: degraded because ${FAILED_UNITS} unit(s) are failed"
        else
            printf '%s\n' 'Runtime manager result: degraded, but no failed units were returned'
        fi
        ;;
    starting|initializing|stopping)
        if [ "$BOOT_GRACE_ACTIVE" = '1' ]; then
            printf '%s\n' "Runtime manager result: ${MANAGER_STATE} during boot grace"
        else
            printf '%s\n' "Runtime manager result: ${MANAGER_STATE}"
        fi
        ;;
    *)
        printf '%s\n' "Runtime manager result: ${MANAGER_STATE}"
        ;;
esac

printf '%s\n' ""

if [ "$DEFAULT_TARGET_VALID" -ne 1 ]; then
    printf '%s\n' 'systemd-analyze verify output: skipped because the default target is invalid'
elif [ "$VERIFY_MESSAGES" = 'U' ]; then
    printf '%s\n' 'systemd-analyze verify output: unavailable'
elif [ "$VERIFY_MESSAGES" -eq 0 ]; then
    printf '%s\n' 'systemd-analyze verify output: no messages'
elif [ "$SHOW_RAW_VERIFY" -eq 1 ] || [ "$VERIFY_MESSAGES" -le "$MAX_VERIFY_LINES" ]; then
    printf '%s\n' "systemd-analyze verify output (${VERIFY_MESSAGES} lines):"
    printf '%s\n' "$VERIFY_OUTPUT"
else
    printf '%s\n' "systemd-analyze verify output (first ${MAX_VERIFY_LINES} of ${VERIFY_MESSAGES} lines):"
    printf '%s\n' "$VERIFY_OUTPUT" | $AWK -v max="$MAX_VERIFY_LINES" 'NR <= max { print }'
    printf '%s\n' '[truncated]'
fi

printf '%s\n' ""

if [ "$LIST_UNITS_RC" -eq 0 ]; then
    print_detail_section 'Actionable units with load/config errors' "$BAD_LOAD_UNITS" "$ACTIONABLE_NOT_FOUND_DETAILS" "$ACTIONABLE_ERROR_DETAILS" "$ACTIONABLE_BAD_SETTING_DETAILS" "$ACTIONABLE_OTHER_DETAILS" 0
else
    printf '%s\n' 'Actionable units with load/config errors: unavailable'
fi

if [ "$MANAGER_STATE" = 'degraded' ]; then
    printf '%s\n' ""
    print_failed_units_section
fi

if [ "$LIST_UNITS_RC" -eq 0 ] && [ "$CONTEXTUAL_NOT_FOUND_UNITS" -gt 0 ]; then
    printf '%s\n' ""
    print_detail_section 'Contextual not-found units not counted as config errors' "$CONTEXTUAL_NOT_FOUND_UNITS" "$CONTEXTUAL_NOT_FOUND_DETAILS" "$CONTEXTUAL_ERROR_DETAILS" "$CONTEXTUAL_BAD_SETTING_DETAILS" "$CONTEXTUAL_OTHER_DETAILS" 1
fi
} | sanitize_monitor_output

exit "$STATE"
