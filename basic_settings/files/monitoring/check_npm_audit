#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'UNKNOWN - %s\n' "$*"
    exit 3
}

# Binary checks
BASENAME=$(command -v basename 2>/dev/null) || die "basename not available"
JQ=$(command -v jq 2>/dev/null) || die "jq not available"
NPM=$(command -v npm 2>/dev/null) || die "npm not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"

# Defaults
AUDIT_EXIT=0
AUDIT_ERR=""
AUDIT_JSON=""
AUDIT_META=""
AUDIT_PAYLOAD=""
CHECK_DIR=""
CHECK_NAME=""
DETAILS=""
JQ_META=""
JQ_PAYLOAD=""
PARSE_ERR=""
SEP_ERR="__CHECK_NPM_AUDIT_ERR_$$__"
SEP_STATUS="__CHECK_NPM_AUDIT_STATUS_$$__"
STATE_CODE=3

# Read the first useful diagnostic line and ignore npm notice noise
first_line() {
    [ -n "$1" ] || return 1
    LINE=$(printf '%s\n' "$1" | "$SED" -n '
        s/[[:space:]]\+$//
        /^[[:space:]]*$/d
        /^npm notice\( \|$\)/d
        p
        q
    ' 2>/dev/null)
    [ -n "$LINE" ] || return 1
    printf '%s' "$LINE"
}

# Strip leading npm log chatter when audit JSON is prefixed by notices
normalize_audit_json() {
    [ -n "$1" ] || return 1

    printf '%s' "$1" | "$JQ" -e . >/dev/null 2>&1 && {
        printf '%s' "$1"
        return 0
    }

    NORMALIZED=$(printf '%s\n' "$1" | "$SED" -n '/^[[:space:]]*[{[]/,$p' 2>/dev/null)
    [ -n "$NORMALIZED" ] || return 1

    printf '%s' "$NORMALIZED" | "$JQ" -e . >/dev/null 2>&1 || return 1
    printf '%s' "$NORMALIZED"
}

# Prefer a compact message from JSON, stderr or jq parse errors
report_error() {
    LINE=$(printf '%s' "$AUDIT_JSON" | "$JQ" -r '.error.summary // .error.message // .message // empty' 2>/dev/null | "$SED" -n '1{s/[[:space:]]\+$//;p;q;}')
    if [ -n "$LINE" ]; then
        printf '%s' "$LINE"
        return 0
    fi
    LINE=$(first_line "$AUDIT_ERR") && {
        printf '%s' "$LINE"
        return 0
    }
    LINE=$(first_line "$PARSE_ERR") && {
        printf '%s' "$LINE"
        return 0
    }
    printf '%s' 'npm audit did not return a usable JSON report'
}

# Run jq while capturing both stdout and stderr for later reporting.
run_jq() {
    JQ_PAYLOAD=$(
        {
            JQ_ERROR=$(printf '%s' "$AUDIT_JSON" | "$JQ" -r "$1" 2>&1 1>&3)
            JQ_STATUS=$?
            printf '%s%s%s%s' "$SEP_STATUS" "$JQ_STATUS" "$SEP_ERR" "$JQ_ERROR"
        } 3>&1
    )

    case "$JQ_PAYLOAD" in
        *"$SEP_STATUS"*"$SEP_ERR"*)
            JQ_OUTPUT=${JQ_PAYLOAD%"$SEP_STATUS"*}
            JQ_META=${JQ_PAYLOAD#*"$SEP_STATUS"}
            JQ_STATUS=${JQ_META%%"$SEP_ERR"*}
            JQ_ERROR=${JQ_META#*"$SEP_ERR"}
            ;;
        *)
            JQ_OUTPUT=""
            JQ_STATUS=1
            JQ_ERROR="unable to capture jq output"
            ;;
    esac

    PARSE_ERR=$JQ_ERROR
    [ "$JQ_STATUS" -eq 0 ]
}

# Print usage help for invalid command-line arguments.
usage() {
    die "Usage: $0 -d <directory> [-n <name>]"
}

# Options
while getopts 'd:n:' opt; do
    case "$opt" in
        d) CHECK_DIR="$OPTARG" ;;
        n) CHECK_NAME="$OPTARG" ;;
        *) usage ;;
    esac
done

# Validate options
[ -n "$CHECK_DIR" ] || usage
[ -d "$CHECK_DIR" ] || die "directory '$CHECK_DIR' does not exist"
[ -r "$CHECK_DIR" ] || die "directory '$CHECK_DIR' is not readable"

# Check if check name is not provided
if [ -z "$CHECK_NAME" ]; then
    CHECK_NAME=$("$BASENAME" "$CHECK_DIR")
fi

# Check if this looks like a Node.js project
[ -f "$CHECK_DIR/package.json" ] || die "$CHECK_NAME: package.json not found in '$CHECK_DIR'"

# Run npm audit inside the requested project directory and keep stdout/stderr in memory
cd "$CHECK_DIR" || die "$CHECK_NAME: unable to cd to '$CHECK_DIR'"
AUDIT_PAYLOAD=$(
    {
        AUDIT_ERR=$("$NPM" audit --json 2>&1 1>&3)
        AUDIT_EXIT=$?
        printf '%s%s%s%s' "$SEP_STATUS" "$AUDIT_EXIT" "$SEP_ERR" "$AUDIT_ERR"
    } 3>&1
)

case "$AUDIT_PAYLOAD" in
    *"$SEP_STATUS"*"$SEP_ERR"*)
        AUDIT_JSON=${AUDIT_PAYLOAD%"$SEP_STATUS"*}
        AUDIT_META=${AUDIT_PAYLOAD#*"$SEP_STATUS"}
        AUDIT_EXIT=${AUDIT_META%%"$SEP_ERR"*}
        AUDIT_ERR=${AUDIT_META#*"$SEP_ERR"}
        ;;
    *)
        die "$CHECK_NAME: unable to capture npm audit output"
        ;;
esac

# Newer npm versions may prefix the JSON report with informational notice lines
NORMALIZED_JSON=$(normalize_audit_json "$AUDIT_JSON") && AUDIT_JSON=$NORMALIZED_JSON

# npm audit may return non-zero on findings; only invalid JSON should become UNKNOWN
PARSE_ERR=$(printf '%s' "$AUDIT_JSON" | "$JQ" -e . 2>&1 >/dev/null)
[ $? -eq 0 ] || die "$CHECK_NAME: $(report_error)"

# Reject responses that do not expose the expected audit metadata
run_jq '
    def vuln_total:
        (.metadata.vulnerabilities.total // (
            (.metadata.vulnerabilities.info // 0)
            + (.metadata.vulnerabilities.low // 0)
            + (.metadata.vulnerabilities.moderate // 0)
            + (.metadata.vulnerabilities.high // 0)
            + (.metadata.vulnerabilities.critical // 0)
        ));
    if (.metadata.vulnerabilities? | type) != "object" then
        "invalid"
    elif (vuln_total > 0 and ((.vulnerabilities? | type) != "object") and ((.advisories? | type) != "object")) then
        "invalid"
    else
        "ok"
    end
' || die "$CHECK_NAME: $(report_error)"
REPORT_STATUS=$(first_line "$JQ_OUTPUT")
[ "$REPORT_STATUS" = "ok" ] || die "$CHECK_NAME: $(report_error)"

# Extract vulnerability counts, dependency totals and package-level counters
run_jq '
    def sev_rank($severity):
        if $severity == "critical" then 5
        elif $severity == "high" then 4
        elif $severity == "moderate" then 3
        elif $severity == "low" then 2
        elif $severity == "info" then 1
        else 0
        end;
    def vuln_total:
        (.metadata.vulnerabilities.total // (
            (.metadata.vulnerabilities.info // 0)
            + (.metadata.vulnerabilities.low // 0)
            + (.metadata.vulnerabilities.moderate // 0)
            + (.metadata.vulnerabilities.high // 0)
            + (.metadata.vulnerabilities.critical // 0)
        ));
    def dep_prod:
        if (.metadata.dependencies? | type) == "object" then
            (.metadata.dependencies.prod // 0)
        else
            (.metadata.dependencies // 0)
        end;
    def dep_dev:
        if (.metadata.dependencies? | type) == "object" then
            (.metadata.dependencies.dev // 0)
        else
            (.metadata.devDependencies // 0)
        end;
    def dep_total:
        if (.metadata.dependencies? | type) == "object" then
            (.metadata.dependencies.total // (
                (.metadata.dependencies.prod // 0)
                + (.metadata.dependencies.dev // 0)
                + (.metadata.dependencies.optional // 0)
                + (.metadata.dependencies.peer // 0)
                + (.metadata.dependencies.peerOptional // 0)
            ))
        else
            (.metadata.totalDependencies // .metadata.dependencies // 0)
        end;
    def package_records:
        if (.vulnerabilities? | type) == "object" then
            (.vulnerabilities // {})
            | to_entries
            | map(
                .key as $name
                | .value as $v
                | {
                    name: $name,
                    severity: ($v.severity // "unknown"),
                    is_direct: ($v.isDirect // false),
                    fixable: (($v.fixAvailable // false) != false)
                }
            )
        elif (.advisories? | type) == "object" then
            (.advisories // {})
            | to_entries
            | group_by(.value.module_name // .key)
            | map(
                . as $group
                | {
                    name: ($group[0].value.module_name // $group[0].key),
                    severity: (($group | max_by(sev_rank(.value.severity // "unknown"))).value.severity // "unknown"),
                    is_direct: ([ $group[] | .value.findings[]? | .paths[]? | (contains(">") | not) ] | index(true) != null),
                    fixable: ([ $group[] | .value.patched_versions? | select(. != null and . != "" and . != "<0.0.0") ] | length > 0)
                }
            )
        else
            []
        end;
    . as $root
    | ($root | package_records) as $packages
    | [
        ($root.metadata.vulnerabilities.info // 0),
        ($root.metadata.vulnerabilities.low // 0),
        ($root.metadata.vulnerabilities.moderate // 0),
        ($root.metadata.vulnerabilities.high // 0),
        ($root.metadata.vulnerabilities.critical // 0),
        ($root | vuln_total),
        ($root | dep_prod),
        ($root | dep_dev),
        ($root | dep_total),
        ($packages | length),
        ($packages | map(select(.is_direct == true)) | length),
        ($packages | map(select(.is_direct != true)) | length),
        ($packages | map(select(.fixable == true)) | length)
    ]
    | map(tostring)
    | join("|")
' || die "$CHECK_NAME: $(report_error)"
PARSED=$(first_line "$JQ_OUTPUT")
[ -n "$PARSED" ] || die "$CHECK_NAME: $(report_error)"

# Render detail lines per affected package for troubleshooting
run_jq '
    def clean($value):
        ($value // "no advisory title returned")
        | tostring
        | gsub("[\r\n]+"; " ");
    def sev_rank($severity):
        if $severity == "critical" then 5
        elif $severity == "high" then 4
        elif $severity == "moderate" then 3
        elif $severity == "low" then 2
        elif $severity == "info" then 1
        else 0
        end;
    def fixlabel($name; $fix):
        if $fix == true then
            "yes"
        elif ($fix | type) == "object" then
            (($fix.name // $name // "unknown") + "@" + ($fix.version // "unknown")
            + (if ($fix.isSemVerMajor // false) then " (semver-major)" else "" end))
        elif ($fix | type) == "string" and $fix != "" then
            clean($fix)
        else
            "no"
        end;
    def package_records:
        if (.vulnerabilities? | type) == "object" then
            (.vulnerabilities // {})
            | to_entries
            | map(
                .key as $name
                | .value as $v
                | {
                    name: $name,
                    severity: ($v.severity // "unknown"),
                    is_direct: ($v.isDirect // false),
                    range: clean($v.range // "n/a"),
                    fix_label: fixlabel($name; $v.fixAvailable),
                    advisories: (
                        [ ($v.via // [])[]?
                          | if type == "object" then
                                clean((.severity // $v.severity // "unknown") + ": " + (.title // "no advisory title returned"))
                            else
                                clean(.)
                            end
                        ]
                        | unique
                        | if length == 0 then
                              ["no advisory title returned"]
                          else
                              .
                          end
                    )
                }
            )
        elif (.advisories? | type) == "object" then
            (.advisories // {})
            | to_entries
            | group_by(.value.module_name // .key)
            | map(
                . as $group
                | {
                    name: ($group[0].value.module_name // $group[0].key),
                    severity: (($group | max_by(sev_rank(.value.severity // "unknown"))).value.severity // "unknown"),
                    is_direct: ([ $group[] | .value.findings[]? | .paths[]? | (contains(">") | not) ] | index(true) != null),
                    range: (
                        [ $group[] | .value.vulnerable_versions? | select(. != null and . != "") | clean(.) ]
                        | unique
                        | if length == 0 then "n/a" else join(", ") end
                    ),
                    fix_label: (
                        if ([ $group[] | .value.patched_versions? | select(. != null and . != "" and . != "<0.0.0") ] | length) > 0 then
                            "yes"
                        else
                            "no"
                        end
                    ),
                    advisories: (
                        [ $group[] | clean((.value.severity // "unknown") + ": " + (.value.title // "no advisory title returned")) ]
                        | unique
                        | if length == 0 then
                              ["no advisory title returned"]
                          else
                              .
                          end
                    )
                }
            )
        else
            []
        end;
    package_records
    | sort_by([-(sev_rank(.severity)), .name])
    | .[]
    | "- " + .name
      + " ["
      + .severity
      + ", "
      + (if .is_direct then "direct" else "transitive" end)
      + ", range="
      + .range
      + ", fix="
      + .fix_label
      + "] - "
      + (.advisories | join("; "))
' || die "$CHECK_NAME: $(report_error)"
DETAILS=$JQ_OUTPUT

# Split the jq summary into shell variables
OLD_IFS=$IFS
IFS='|'
set -- $PARSED
IFS=$OLD_IFS

INFO_COUNT=$1
LOW_COUNT=$2
MODERATE_COUNT=$3
HIGH_COUNT=$4
CRITICAL_COUNT=$5
VULN_TOTAL=$6
DEP_PROD=$7
DEP_DEV=$8
DEP_TOTAL=$9
PKG_TOTAL=${10}
PKG_DIRECT=${11}
PKG_TRANSITIVE=${12}
FIXABLE=${13}

# Severity mapping for monitoring states
if [ "$HIGH_COUNT" -gt 0 ] || [ "$CRITICAL_COUNT" -gt 0 ]; then
    STATE_CODE=2
elif [ "$LOW_COUNT" -gt 0 ] || [ "$MODERATE_COUNT" -gt 0 ]; then
    STATE_CODE=1
else
    STATE_CODE=0
fi

# Compact summary plus perfdata for monitoring and Grafana
case "$PKG_TOTAL" in
    0) PKG_TEXT='no vulnerable packages' ;;
    1) PKG_TEXT='1 vulnerable package' ;;
    *) PKG_TEXT="${PKG_TOTAL} vulnerable packages" ;;
esac
SUMMARY="${CHECK_NAME}: ${PKG_TEXT}, severity: low=${LOW_COUNT} moderate=${MODERATE_COUNT} high=${HIGH_COUNT} critical=${CRITICAL_COUNT}"
PERF_DATA="vuln_total=${VULN_TOTAL};"
PERF_DATA="$PERF_DATA vuln_info=${INFO_COUNT};"
PERF_DATA="$PERF_DATA vuln_low=${LOW_COUNT};"
PERF_DATA="$PERF_DATA vuln_moderate=${MODERATE_COUNT};"
PERF_DATA="$PERF_DATA vuln_high=${HIGH_COUNT};"
PERF_DATA="$PERF_DATA vuln_critical=${CRITICAL_COUNT};"
PERF_DATA="$PERF_DATA pkg_total=${PKG_TOTAL};"
PERF_DATA="$PERF_DATA pkg_direct=${PKG_DIRECT};"
PERF_DATA="$PERF_DATA pkg_transitive=${PKG_TRANSITIVE};"
PERF_DATA="$PERF_DATA fixable=${FIXABLE};"
PERF_DATA="$PERF_DATA dep_prod=${DEP_PROD};"
PERF_DATA="$PERF_DATA dep_dev=${DEP_DEV};"
PERF_DATA="$PERF_DATA dep_total=${DEP_TOTAL};"
PERF_DATA="$PERF_DATA audit_exit=${AUDIT_EXIT};"

# Show first line for monitoring and optional detail lines below
printf '%s | %s\n' "$SUMMARY" "$PERF_DATA"

# Show details if available for troubleshooting
if [ -n "$DETAILS" ]; then
    printf '%s\n' "$DETAILS"
fi

# Exit with the appropriate monitoring state
exit "$STATE_CODE"
