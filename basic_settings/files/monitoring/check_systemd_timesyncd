#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'systemd-timesyncd check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
TIMEDATECTL=$(command -v timedatectl 2>/dev/null) || die "timedatectl not available"

# Status buffers collect the direct CRITICAL and WARNING causes.
CRIT_MSG=""
WARN_MSG=""
STATE_CODE=0

# Offset, jitter, and root-distance thresholds are seconds; perfdata uses the same values with `s` UOM.
JITTER_CRIT=0.2 # 200ms
JITTER_WARN=0.1 # 100ms
OFFSET_CRIT=0.125 # 125ms
OFFSET_WARN=0.05 # 50ms
ROOT_CRIT=5 # 5s (timesyncd RootDistanceMaxSec default)
ROOT_WARN=0.5 # 500ms

# High stratum is treated as a synchronization quality signal.
STRAT_CRIT=15 # >15 ~= unsynchronised
STRAT_WARN=10

# Emit a CRITICAL result and stop immediately.
crit() {
    printf 'systemd-timesyncd check failed: %s\n' "$*"
    exit 2
}

# Append one critical reason to the summary.
add_crit() {
    CRIT_MSG="${CRIT_MSG:+$CRIT_MSG; }$1"
}

# Append one warning reason to the summary.
add_warn() {
    WARN_MSG="${WARN_MSG:+$WARN_MSG; }$1"
}

# Compare two numeric values using awk for floating-point support.
ge() {
    $AWK -v a="$1" -v b="$2" 'BEGIN{exit (a>=b)?0:1}'
}

# Keep server/status text safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Extract a numeric value and its unit from timedatectl output.
get_num_unit() {
    printf '%s' "$TIMESYNC" | $SED -n "s/.*$1:[[:space:]]*\\(-*[0-9.]*\\)\\([mun]s\\).*/\\1\\n\\2/p"
}

# Verify the unit before asking timedatectl for synchronization state.
$SYSTEMCTL is-active --quiet systemd-timesyncd.service || crit "systemd-timesyncd.service is not active"

# `NTPSynchronized` is the primary binary health signal for the clock.
NTPSYNC=$($TIMEDATECTL show -p NTPSynchronized --value 2>/dev/null)
case "$NTPSYNC" in
    yes|1) : ;;
    no|0|"") add_crit "clock not synchronised" ;;
esac

# Read the human timesync status once and parse all numeric metrics from that snapshot.
TIMESYNC="$($TIMEDATECTL timesync-status 2>/dev/null)" || die "timesync-status not available"

# The selected peer is useful in the short output when drift thresholds fire.
SERVER=$(printf '%s' "$TIMESYNC" | $AWK '/^[[:space:]]*Server:/ {sub(/^[[:space:]]*Server:[[:space:]]*/,""); print; exit}')

# Convert timedatectl units to seconds so all threshold comparisons share one scale.
set_to_sec() {
    IFS= read -r val || return 1
    IFS= read -r u || u="s"
    $AWK -v v="$val" -v u="$u" 'BEGIN{
        if(u=="ms") printf "%.6f", v/1000;
        else if(u=="us") printf "%.6f", v/1000000;
        else printf "%.6f", v;
    }'
}

# Offset
OFF_LU=$(get_num_unit "Offset")
OFFSET_SEC=$(printf '%s\n' "$OFF_LU" | set_to_sec 2>/dev/null)
[ -z "$OFFSET_SEC" ] && OFFSET_SEC=0
ABS_OFFSET=$($AWK -v o="$OFFSET_SEC" 'BEGIN{if(o<0) printf "%.6f",-o; else printf "%.6f",o}')

# Jitter
JIT_LU=$(get_num_unit "Jitter")
JITTER_SEC=$(printf '%s\n' "$JIT_LU" | set_to_sec 2>/dev/null)
[ -z "$JITTER_SEC" ] && JITTER_SEC=0

# Root distance
RD_LU=$(get_num_unit "Root distance")
ROTDIST_SEC=$(printf '%s\n' "$RD_LU" | set_to_sec 2>/dev/null)
[ -z "$ROTDIST_SEC" ] && ROTDIST_SEC=0

# Delay (extra perfdata)
DLY_LU=$(get_num_unit "Delay")
DELAY_SEC=$(printf '%s\n' "$DLY_LU" | set_to_sec 2>/dev/null)
[ -z "$DELAY_SEC" ] && DELAY_SEC=0

# Stratum
STRAT=$(printf '%s' "$TIMESYNC" | $SED -n 's/.*Stratum:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
[ -z "$STRAT" ] && STRAT=0

# Compare absolute offset, jitter, root distance, and stratum independently.
ge "$ABS_OFFSET" "$OFFSET_CRIT" && add_crit "offset ${ABS_OFFSET}s"
[ -z "$CRIT_MSG" ] && ge "$ABS_OFFSET" "$OFFSET_WARN" && add_warn "offset ${ABS_OFFSET}s"

ge "$JITTER_SEC" "$JITTER_CRIT" && add_crit "jitter ${JITTER_SEC}s"
[ -z "$CRIT_MSG" ] && ge "$JITTER_SEC" "$JITTER_WARN" && add_warn "jitter ${JITTER_SEC}s"

ge "$ROTDIST_SEC" "$ROOT_CRIT" && add_crit "root distance ${ROTDIST_SEC}s"
[ -z "$CRIT_MSG" ] && ge "$ROTDIST_SEC" "$ROOT_WARN" && add_warn "root distance ${ROTDIST_SEC}s"

if [ "$STRAT" -gt "$STRAT_CRIT" ]; then
    add_crit "stratum $STRAT"
elif [ "$STRAT" -ge "$STRAT_WARN" ]; then
    add_warn "stratum $STRAT"
fi

# Final state uses CRITICAL reasons first, then WARNING reasons.
[ -n "$CRIT_MSG" ] && STATE_CODE=2
[ $STATE_CODE -eq 0 ] && [ -n "$WARN_MSG" ] && STATE_CODE=1

if [ -n "$CRIT_MSG" ]; then
    MSG="systemd-timesyncd ${CRIT_MSG}; server ${SERVER:-unknown}; offset ${ABS_OFFSET}s"
elif [ -n "$WARN_MSG" ]; then
    MSG="systemd-timesyncd ${WARN_MSG}; server ${SERVER:-unknown}; offset ${ABS_OFFSET}s"
else
    MSG="systemd-timesyncd synchronised with ${SERVER:-unknown}; offset ${ABS_OFFSET}s"
fi

# Perfdata labels are unit-free; second-based values carry `s` as UOM.
PERF="offset=${ABS_OFFSET}s;${OFFSET_WARN};${OFFSET_CRIT};0"
PERF="$PERF jitter=${JITTER_SEC}s;${JITTER_WARN};${JITTER_CRIT};0"
PERF="$PERF root_dist=${ROTDIST_SEC}s;${ROOT_WARN};${ROOT_CRIT};0;5"
PERF="$PERF delay=${DELAY_SEC}s;;;0;"
PERF="$PERF stratum=${STRAT};${STRAT_WARN};${STRAT_CRIT};0;16"

# Emit one monitoring line; server names are sanitized before the perfdata delimiter.
printf '%s | %s\n' "$(monitor_text_value "$MSG")" "$PERF"
exit "$STATE_CODE"
