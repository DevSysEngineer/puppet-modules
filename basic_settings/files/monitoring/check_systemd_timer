#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'systemd timer check cannot run: %s\n' "$*"
    exit 3
}

# These checks inspect systemd concepts; other init systems are not applicable (Nagios UNKNOWN).
[ -d /run/systemd/system ] || die "not applicable: systemd is not running"

# Parse command output independently of the host locale.
LC_ALL=C
export LC_ALL

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null || true)
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
TAIL=$(command -v tail 2>/dev/null) || die "tail not available"

# Window and log caps keep timer diagnosis bounded for monitoring output.
WINDOW=${WINDOW:-600} # seconds to scan logs after the timer trigger (default 10m)
LOG_LINES=${LOG_LINES:-20} # max journal lines to print below the summary
MAXLOG=${MAXLOG:-1000} # max characters per journal line in long output
DETAIL_LIMIT=${DETAIL_LIMIT:-6000} # max characters before Interpretation

# The timer target is read from the running manager after argument validation.
USAGE_TEXT="Usage: $0 [-l chars] [-n lines] [-t seconds] [-m chars_per_line] <timer>
Environment: DETAIL_LIMIT (-l); LOG_LINES (-n); WINDOW (-t); MAXLOG (-m).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':l:n:t:m:h' opt; do
    case "$opt" in
        l) DETAIL_LIMIT=$OPTARG ;;
        n) LOG_LINES=$OPTARG ;;
        t) WINDOW=$OPTARG ;;
        m) MAXLOG=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 1 ] || die "$USAGE_TEXT"
TIMER_UNIT=$1

# Validate diagnostic output limits before journal text is rendered.
case "$LOG_LINES" in
    ''|*[!0-9]*) die "LOG_LINES must be numeric" ;;
esac
case "$MAXLOG" in
    ''|*[!0-9]*) die "MAXLOG must be numeric" ;;
esac
case "$WINDOW" in
    ''|*[!0-9]*) die "WINDOW must be numeric" ;;
esac
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "DETAIL_LIMIT must be numeric" ;;
esac
[ "$LOG_LINES" -ge 1 ] || die "LOG_LINES must be at least 1"
[ "$MAXLOG" -ge 1 ] || die "MAXLOG must be at least 1"
[ "$WINDOW" -ge 1 ] || die "WINDOW must be at least 1"
[ "$DETAIL_LIMIT" -ge 1 ] || die "DETAIL_LIMIT must be at least 1"

# Emit the summary line and optional long output.
emit_check() {
    # $1 = summary/status line, $2 = perfdata
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "${JOURNAL_JOINED:-}" ]; then
        monitor_text_value "$JOURNAL_JOINED"
    fi
}

# Nagios treats raw pipes after the first output line as perfdata separators.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Format journal lines with a configurable line count and per-line character cap.
format_journal_lines() {
    printf '%s\n' "$1" | $SED '/^$/d; s/[[:space:]]\+$//' | $AWK -v max="$MAXLOG" '
        {
            line = $0
            if (length(line) > max) {
                line = substr(line, 1, max) "... [line truncated]"
            }
            print "- " line
        }
    '
}

# Bound journal details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_text_details() {
    $AWK -v max="$DETAIL_LIMIT" '
        {
            line = $0
            line_len = length(line)
            separator_len = printed ? 1 : 0
            if (used + separator_len + line_len <= max) {
                print line
                used += separator_len + line_len
                printed = 1
                next
            }
            remaining = max - used - separator_len
            if (remaining > 0) {
                print substr(line, 1, remaining) "... [detail truncated]"
            }
            print "Long output details truncated after " max " characters to keep Interpretation visible."
            exit
        }
    '
}

# Inspect manager properties: a bus failure does not prove a missing or inactive unit.
TIMER_LOAD=$($SYSTEMCTL show "$TIMER_UNIT" -p LoadState --value 2>/dev/null)
TIMER_RC=$?
if [ "$TIMER_LOAD" = not-found ]; then
    emit_check "${TIMER_UNIT} does not exist" "last_run_age=U exit_code=U"
    exit 2
fi
[ "$TIMER_RC" -eq 0 ] && [ -n "$TIMER_LOAD" ] || die "timer LoadState unavailable"
TIMER_ACTIVE=$($SYSTEMCTL show "$TIMER_UNIT" -p ActiveState --value 2>/dev/null) || die "timer ActiveState unavailable"
case "$TIMER_ACTIVE" in
    active) : ;;
    inactive|failed|activating|deactivating)
        emit_check "${TIMER_UNIT} is not active (${TIMER_ACTIVE})" "last_run_age=U exit_code=U"
        exit 2
        ;;
    *) die "timer ActiveState unavailable or invalid" ;;
esac
SERVICE_UNIT=$($SYSTEMCTL show "$TIMER_UNIT" -p Unit --value 2>/dev/null) || die "timer target unavailable"
[ -n "$SERVICE_UNIT" ] || die "timer target unavailable"

# The last trigger timestamp anchors both age perfdata and the journal window.
LAST_RUN_TEXT=$($SYSTEMCTL show "$TIMER_UNIT" -p LastTriggerUSec --value 2>/dev/null) || die "timer trigger timestamp unavailable"
if [ -z "$LAST_RUN_TEXT" ] || [ "$LAST_RUN_TEXT" = "0" ]; then
    emit_check "${TIMER_UNIT} has never been triggered" "last_run_age=U exit_code=U"
    exit 1
fi

# Convert systemd's timestamp into epoch seconds for age and journal range calculations.
LAST_RUN_TS=$($DATE -d "$LAST_RUN_TEXT" +%s 2>/dev/null || true)
NOW_TS=$($DATE +%s)
[ -n "${LAST_RUN_TS:-}" ] || {
    emit_check "${TIMER_UNIT} last run could not be parsed" "last_run_age=U exit_code=U"
    exit 3
}

LAST_RUN_AGE=$((NOW_TS - LAST_RUN_TS))
UNTIL_TS=$((LAST_RUN_TS + WINDOW))

# Pull only the paired service journal lines created shortly after the timer fired.
JOURNAL_RAW=""
if [ -n "$JOURNALCTL" ]; then
    JOURNAL_RAW=$($JOURNALCTL -u "$SERVICE_UNIT" --since "@${LAST_RUN_TS}" --until "@${UNTIL_TS}" -o short-iso --no-pager 2>/dev/null || true)
fi

# Current properties of the timer's actual target are authoritative; logs only add context.
EXIT_CODE_PROP=$($SYSTEMCTL show "$SERVICE_UNIT" -p ExecMainStatus --value 2>/dev/null || printf 'U')
RESULT_PROP=$($SYSTEMCTL show "$SERVICE_UNIT" -p Result --value 2>/dev/null || printf 'unknown')
MAIN_CODE_PROP=$($SYSTEMCTL show "$SERVICE_UNIT" -p ExecMainCode --value 2>/dev/null || printf 'U')
STATUS_TEXT=$($SYSTEMCTL show "$SERVICE_UNIT" -p StatusText --value 2>/dev/null || printf '')

EXIT_CODE=$EXIT_CODE_PROP
RESULT=$RESULT_PROP
case "$EXIT_CODE" in
    ''|*[!0-9]*) EXIT_CODE=U ;;
esac

# Render journal for long output with a predictable line cap.
JOURNAL_LINE_COUNT=$(printf '%s\n' "$JOURNAL_RAW" | $SED '/^$/d' | $SED -n '$=')
case "$JOURNAL_LINE_COUNT" in
    ''|*[!0-9]*) JOURNAL_LINE_COUNT=0 ;;
esac

if [ "$JOURNAL_LINE_COUNT" -gt 0 ]; then
    if [ "$JOURNAL_LINE_COUNT" -gt "$LOG_LINES" ]; then
        JOURNAL_OMITTED=$((JOURNAL_LINE_COUNT - LOG_LINES))
        JOURNAL_JOINED=$(
            {
                printf '%s\n' "- Showing last ${LOG_LINES} journal lines from this timer run; ${JOURNAL_OMITTED} older line(s) omitted"
                format_journal_lines "$JOURNAL_RAW" | $TAIL -n "$LOG_LINES"
            }
        )
    else
        JOURNAL_JOINED=$(format_journal_lines "$JOURNAL_RAW")
    fi
else
    JOURNAL_JOINED=""
fi

# Add interpretation after journal details when long output exists.
if [ -n "$JOURNAL_JOINED" ]; then
    JOURNAL_JOINED=$(
        {
            printf '%s\n' "$JOURNAL_JOINED" | limit_text_details
            printf '%s\n' ''
            printf '%s\n' 'Interpretation:'
            printf '%s\n' 'Current properties of the timer target decide the exit code; journal lines are bounded context from the last trigger window.'
            printf '%s\n' 'Inspect the named service journal around the timer trigger when the summary reports a failed result, non-zero exit status, or inconclusive timer outcome.'
        }
    )
fi

# Perfdata exposes timer age and the last observed service exit status.
PERFDATA="last_run_age=${LAST_RUN_AGE}s exit_code=${EXIT_CODE}"

# Zero ExecMainCode is the default before an execution completes, not evidence of success.
if [ "$RESULT" = success ] && [ "$EXIT_CODE" = 0 ]; then
    case "$MAIN_CODE_PROP" in
        ''|0|*[!0-9]*) die "timer target has no completed execution result" ;;
    esac
fi

# A completed target result and numeric zero exit status establish success.
if [ "$RESULT" = "success" ] && [ "${EXIT_CODE:-U}" = "0" ]; then
    emit_check \
        "$SERVICE_UNIT successful (${STATUS_TEXT:-unknown}); last run: $LAST_RUN_TEXT" \
        "$PERFDATA"
    exit 0
fi

# Preserve the observed result, including signal/timeout failures with zero ExecMainStatus.
emit_check \
    "$SERVICE_UNIT $RESULT with exit ${EXIT_CODE}, code ${MAIN_CODE_PROP}, status ${STATUS_TEXT:-unknown}; last run: $LAST_RUN_TEXT" \
    "$PERFDATA"

# Missing evidence is UNKNOWN; a concrete unsuccessful result is CRITICAL even with exit status zero.
case "$RESULT" in
    ''|unknown|n/a) exit 3 ;;
    success)
        case "$EXIT_CODE" in
            0) exit 0 ;;
            U) exit 3 ;;
            *) exit 2 ;;
        esac
        ;;
    *) exit 2 ;;
esac
