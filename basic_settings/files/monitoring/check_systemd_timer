#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'systemd timer check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
CUT=$(command -v cut 2>/dev/null) || die "cut not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
JOURNALCTL=$(command -v journalctl 2>/dev/null) || die "journalctl not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
SYSTEMCTL=$(command -v systemctl 2>/dev/null) || die "systemctl not available"
TAIL=$(command -v tail 2>/dev/null) || die "tail not available"

# Window and log caps keep timer diagnosis bounded for monitoring output.
WINDOW=${WINDOW:-600} # seconds to scan logs after the timer trigger (default 10m)
LOG_LINES=${LOG_LINES:-20} # max journal lines to print below the summary
MAXLOG=${MAXLOG:-1000} # max characters per journal line in long output

# The service name follows the timer name; this matches systemd's common .timer/.service pairing.
TIMER_UNIT=${1:-}
[ -n "$TIMER_UNIT" ] || die "No timer given"
SERVICE_UNIT=${TIMER_UNIT%.timer}.service

# Validate diagnostic output limits before journal text is rendered.
case "$LOG_LINES" in
    ''|*[!0-9]*) die "LOG_LINES must be numeric" ;;
esac
case "$MAXLOG" in
    ''|*[!0-9]*) die "MAXLOG must be numeric" ;;
esac
case "$WINDOW" in
    ''|*[!0-9]*) die "WINDOW must be numeric" ;;
esac
[ "$LOG_LINES" -ge 1 ] || die "LOG_LINES must be at least 1"
[ "$MAXLOG" -ge 1 ] || die "MAXLOG must be at least 1"
[ "$WINDOW" -ge 1 ] || die "WINDOW must be at least 1"

# Emit the summary line and optional long output.
emit_check() {
    # $1 = summary/status line, $2 = perfdata
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "${JOURNAL_JOINED:-}" ]; then
        monitor_text_value "$JOURNAL_JOINED"
    fi
}

# Nagios treats raw pipes after the first output line as perfdata separators.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Format journal lines with a configurable line count and per-line character cap.
format_journal_lines() {
    printf '%s\n' "$1" | $SED '/^$/d; s/[[:space:]]\+$//' | $AWK -v max="$MAXLOG" '
        {
            line = $0
            if (length(line) > max) {
                line = substr(line, 1, max) "... [line truncated]"
            }
            print "- " line
        }
    '
}

# Confirm the timer exists and is active before inspecting the paired service.
$SYSTEMCTL show "$TIMER_UNIT" >/dev/null 2>&1 || {
    emit_check "${TIMER_UNIT} does not exist" "last_run_age=U exit_code=U"
    exit 2
}
$SYSTEMCTL is-active --quiet "$TIMER_UNIT" || {
    emit_check "${TIMER_UNIT} is not active" "last_run_age=U exit_code=U"
    exit 2
}

# The last trigger timestamp anchors both age perfdata and the journal window.
LAST_RUN_TEXT=$($SYSTEMCTL show "$TIMER_UNIT" -p LastTriggerUSec --value)
if [ -z "$LAST_RUN_TEXT" ] || [ "$LAST_RUN_TEXT" = "0" ]; then
    emit_check "${TIMER_UNIT} has never been triggered" "last_run_age=U exit_code=U"
    exit 1
fi

# Convert systemd's timestamp into epoch seconds for age and journal range calculations.
LAST_RUN_TS=$($DATE -d "$LAST_RUN_TEXT" +%s 2>/dev/null || true)
NOW_TS=$($DATE +%s)
[ -n "${LAST_RUN_TS:-}" ] || {
    emit_check "${TIMER_UNIT} last run could not be parsed" "last_run_age=U exit_code=U"
    exit 1
}

LAST_RUN_AGE=$((NOW_TS - LAST_RUN_TS))
UNTIL_TS=$((LAST_RUN_TS + WINDOW))

# Pull only the paired service journal lines created shortly after the timer fired.
JOURNAL_RAW=$($JOURNALCTL -u "$SERVICE_UNIT" --since "@${LAST_RUN_TS}" --until "@${UNTIL_TS}" -o short-iso --no-pager 2>/dev/null || true)

# Prefer explicit status markers from this run window, then fall back to current unit properties.
LAST_STATUS=$(printf "%s\n" "$JOURNAL_RAW" | $SED -n 's/.*status=\([0-9][0-9]*\).*/\1/p' | $TAIL -n1)
RESULT_LINE=$(printf "%s\n" "$JOURNAL_RAW" | $GREP -E 'Failed with result|finished with (result|exit code)' | $TAIL -n1)

EXIT_CODE_PROP=$($SYSTEMCTL show "$SERVICE_UNIT" -p ExecMainStatus --value 2>/dev/null || printf 'U')
RESULT_PROP=$($SYSTEMCTL show "$SERVICE_UNIT" -p Result --value 2>/dev/null || printf 'unknown')
MAIN_CODE_PROP=$($SYSTEMCTL show "$SERVICE_UNIT" -p ExecMainCode --value 2>/dev/null || printf 'U')
STATUS_TEXT=$($SYSTEMCTL show "$SERVICE_UNIT" -p StatusText --value 2>/dev/null || printf '')

# Normalize the status source into one exit code/result pair for the final decision.
EXIT_CODE=U
RESULT="unknown"

if [ -n "${LAST_STATUS:-}" ]; then
    EXIT_CODE=$LAST_STATUS
    if [ "${EXIT_CODE}" = "0" ]; then
        RESULT="success"
    else
        RESULT="exit-code"
    fi
else
    # No explicit status within window; fall back to unit properties
    EXIT_CODE=$EXIT_CODE_PROP
    RESULT=$RESULT_PROP
fi

# Render journal for long output with a predictable line cap.
JOURNAL_LINE_COUNT=$(printf '%s\n' "$JOURNAL_RAW" | $SED '/^$/d' | $SED -n '$=')
case "$JOURNAL_LINE_COUNT" in
    ''|*[!0-9]*) JOURNAL_LINE_COUNT=0 ;;
esac

if [ "$JOURNAL_LINE_COUNT" -gt 0 ]; then
    if [ "$JOURNAL_LINE_COUNT" -gt "$LOG_LINES" ]; then
        JOURNAL_OMITTED=$((JOURNAL_LINE_COUNT - LOG_LINES))
        JOURNAL_JOINED=$(
            {
                printf '%s\n' "- Showing last ${LOG_LINES} journal lines from this timer run; ${JOURNAL_OMITTED} older line(s) omitted"
                format_journal_lines "$JOURNAL_RAW" | $TAIL -n "$LOG_LINES"
            }
        )
    else
        JOURNAL_JOINED=$(format_journal_lines "$JOURNAL_RAW")
    fi
else
    JOURNAL_JOINED=""
fi

# Perfdata exposes timer age and the last observed service exit status.
PERFDATA="last_run_age=${LAST_RUN_AGE}s exit_code=${EXIT_CODE}"

# A successful status marker from the timer window is the clean success path.
if [ "$RESULT" = "success" ] && [ "${EXIT_CODE:-U}" = "0" ]; then
    emit_check \
        "$SERVICE_UNIT successful (${STATUS_TEXT:-unknown}); last run: $LAST_RUN_TEXT" \
        "$PERFDATA"
    exit 0
fi

# If the window contained any failure markers, force CRITICAL even if current unit props say success
if printf "%s\n" "$RESULT_LINE" | $GREP -qi 'Failed with result\|status=[1-9]'; then
    emit_check \
        "$SERVICE_UNIT failed with result exit-code, exit ${EXIT_CODE}, code ${MAIN_CODE_PROP}, status ${STATUS_TEXT:-unknown}; last run: $LAST_RUN_TEXT" \
        "$PERFDATA"
    exit 2
fi

# With no explicit failure marker, report the normalized unit-property outcome.
emit_check \
    "$SERVICE_UNIT $RESULT with exit ${EXIT_CODE}, code ${MAIN_CODE_PROP}, status ${STATUS_TEXT:-unknown}; last run: $LAST_RUN_TEXT" \
    "$PERFDATA"

case "${EXIT_CODE}" in
    0) exit 0 ;;
    U) exit 1 ;;
    *) exit 2 ;;
esac
