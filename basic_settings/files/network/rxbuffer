#!/bin/sh

# Keep dispatcher failures non-fatal while still avoiding repeated ethtool
# writes after a successful buffer update.
usage() {
    printf '%s\n' 'Usage: rxbuffer --interface <name>' >&2
}

safe_exit() {
    printf '%s\n' "$1" >&2
    exit 0
}

AWK=$(command -v awk 2>/dev/null) || safe_exit 'awk not available'
ETHTOOL=$(command -v ethtool 2>/dev/null) || safe_exit 'ethtool not available'
MKDIR=$(command -v mkdir 2>/dev/null) || safe_exit 'mkdir not available'

INTERFACE=""
STATE_DIR=${STATE_DIR:-/run/puppet-rxbuffer}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -i|--interface)
            [ "$#" -ge 2 ] || {
                usage
                safe_exit 'Interface argument is missing'
            }
            INTERFACE=$2
            shift 2
            ;;
        *)
            usage
            safe_exit "Unknown argument: $1"
            ;;
    esac
done

[ -n "$INTERFACE" ] || {
    usage
    safe_exit 'Interface is empty'
}

mark_result() {
    interface_name=$1
    state_value=$2

    printf '%s\n' "$state_value" >"${STATE_DIR}/interface_${interface_name}_buffer"
}

buffer_already_applied() {
    interface_name=$1
    state_file="${STATE_DIR}/interface_${interface_name}_buffer"

    [ -r "$state_file" ] || return 1
    IFS= read -r state_value <"$state_file" || state_value=0
    [ "$state_value" = '1' ]
}

apply_interface_buffer() {
    interface_name=$1

    case "$interface_name" in
        ''|*/*) safe_exit "Unsupported interface name: ${interface_name}" ;;
    esac

    buffer_already_applied "$interface_name" && return 0

    if $ETHTOOL -G "$interface_name" tx 4096 && $ETHTOOL -G "$interface_name" rx 4096; then
        mark_result "$interface_name" 1
    else
        mark_result "$interface_name" 0
    fi
}

OLD_UMASK=$(umask)
umask 077
$MKDIR -p "$STATE_DIR" 2>/dev/null || {
    umask "$OLD_UMASK"
    safe_exit "State directory ${STATE_DIR} could not be created"
}
umask "$OLD_UMASK"

if [ -f "/proc/net/bonding/${INTERFACE}" ]; then
    $AWK -F': ' '/^Slave Interface:/ { print $2 }' "/proc/net/bonding/${INTERFACE}" |
    while IFS= read -r slave_interface; do
        [ -n "$slave_interface" ] && apply_interface_buffer "$slave_interface"
    done
else
    apply_interface_buffer "$INTERFACE"
fi
