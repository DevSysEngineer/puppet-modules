#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'RabbitMQ check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
GREP=$(command -v grep 2>/dev/null) || die "grep not available"
RABBITMQCTL=$(command -v rabbitmqctl 2>/dev/null) || die "rabbitmqctl not available"
RABBITMQADMIN=$(command -v rabbitmqadmin 2>/dev/null || true)

# Queue depth thresholds apply only to queues with consumers.
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
WARN=${WARN:-"25"} # warning threshold for queue backlog (can be set via -w)
CRIT=${CRIT:-"30"} # critical threshold for queue backlog (via -c)

# rabbitmqadmin is used only for rate metrics and needs the managed config file.
RABBITMQADMCONF=${RABBITMQADMCONF:-<%= @admin_config_path_shell %>}

# CLI options keep the same external contract as the generated custom check registration.
USAGE_TEXT="Usage: $0 [-w <warn_threshold>] [-c <crit_threshold>] [-C <rabbitmqadmin.conf>] [-l chars]
Environment: WARN (-w); CRIT (-c); RABBITMQADMCONF (-C); DETAIL_LIMIT (-l).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':w:c:C:l:h' opt; do
    case "$opt" in
        w) WARN="$OPTARG" ;;
        c) CRIT="$OPTARG" ;;
        C) RABBITMQADMCONF="$OPTARG" ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
for numeric_value in "$WARN" "$CRIT" "$DETAIL_LIMIT"; do
    case "$numeric_value" in
        ''|*[!0-9]*) die "queue thresholds and output limits must be numeric" ;;
    esac
done
[ "$CRIT" -ge "$WARN" ] || die "critical queue threshold must be greater than or equal to warning threshold"
[ "$DETAIL_LIMIT" -ge 1 ] || die "DETAIL_LIMIT must be at least 1"

# Emit a direct CRITICAL result and stop immediately.
crit() {
    printf 'RabbitMQ %s\n' "$*"
    exit 2
}

# Inspect the conventional service when systemd manages it, alongside native broker health.
<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
check_systemd_service rabbitmq-server.service
if ! use_systemd; then
<% end -%>
    PS=$(command -v ps 2>/dev/null) || die "ps not available"
    PROCESS_DATA=$($PS -ww -e -o stat= -o comm= -o args= 2>/dev/null) || die "process inspection unavailable"
    # The broker runs inside Erlang; an unrelated beam process or rabbitmqctl is not the server.
    printf '%s\n' "$PROCESS_DATA" | $AWK '
        $1 !~ /^Z/ && ($2 == "beam.smp" || $2 == "beam") {
            if ($0 ~ /[[:space:]]-s[[:space:]]+rabbit[[:space:]]+boot([[:space:]]|$)/ ||
                $0 ~ /[[:space:]]-boot[[:space:]]+([^[:space:]]*\/)?rabbit([[:space:]]|$)/) found=1
        }
        END { exit !found }
    ' || crit "service is not active"
    SERVICE_CONTEXT="RabbitMQ broker process is active."
<% if @systemd_enable != false -%>
fi
<% end -%>

# Queue depth data comes from rabbitmqctl because it is available on the local node without HTTP setup.
QUEUE_DATA=$($RABBITMQCTL list_queues -q name messages_ready messages_unacknowledged consumers 2>/dev/null) || die "Failed to fetch queue data"

# Critical queue counters and examples drive the visible state.
CRIT_COUNT=0
CRIT_LIST=""
MAX_MSG=0
MAX_MSG_CRIT=0
MAX_MSG_WARN=0
MAX_QUEUE=""
MAX_Q_CRIT=""
MAX_Q_WARN=""
MSG="RabbitMQ running"
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_RABBITMQ_NL__"

# Orphaned queues remain diagnostic and do not change status.
NO_CONSUMER_COUNT=0
ORPHAN_LIST=""

# Aggregate counters are emitted in diagnostic output and perfdata.
QUEUE_COUNT=0
RATE_NOTICE=""
STATE_CODE=0
QUEUE_INSPECTION_INCOMPLETE=0
TOTAL_CONSUMERS=0
TOTAL_MSG=0
TOTAL_READY=0
TOTAL_UNACK=0

# Warning queue counters are kept separate so CRITICAL output can take precedence.
WARN_COUNT=0
WARN_LIST=""

# Append one queue item to a comma-separated list.
append_item() {
    # $1 = current list, $2 = item to append
    if [ -z "$1" ]; then
        printf "%s" "$2"
    else
        printf "%s, %s" "$1" "$2"
    fi
}

# Render one queue name and depth pair for the summary line.
queue_item() {
    printf '%s (%s msgs)' "$1" "$2"
}

# Keep queue names safe before the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $AWK '{gsub(/[|]/, "[or]"); print}'
}

# Attach a custom perfdata UOM only when the value is numeric; Nagios U stays unit-free.
metric_with_unit() {
    case "$1" in
        ''|U) printf '%s' 'U' ;;
        *)    printf '%s%s' "$1" "$2" ;;
    esac
}

# Append one line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
}

# Emit one monitoring line followed by sanitized queue detail.
emit_check() {
    printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Read tab-separated lines; queue names may contain spaces, so TAB is the only safe separator.
OLDIFS="$IFS"; IFS='	'  # single literal tab character
while IFS='	' read -r QUEUE_NAME READY UNACK CONSUMERS; do
    # Skip empty and header lines
    [ -z "$QUEUE_NAME" ] && continue
    [ "$QUEUE_NAME" = "name" ] && continue

    # An incomplete row cannot establish an empty or healthy queue.
    case "$READY:$UNACK:$CONSUMERS" in
        *[!0-9:]*|:*|*::*|*:)
            QUEUE_INSPECTION_INCOMPLETE=1
            continue
            ;;
    esac

    QUEUE_COUNT=$((QUEUE_COUNT + 1))
    MESSAGES=$((READY + UNACK))
    TOTAL_READY=$((TOTAL_READY + READY))
    TOTAL_UNACK=$((TOTAL_UNACK + UNACK))
    TOTAL_MSG=$((TOTAL_MSG + MESSAGES))
    TOTAL_CONSUMERS=$((TOTAL_CONSUMERS + CONSUMERS))
    if [ "$MESSAGES" -gt "$MAX_MSG" ]; then
        MAX_MSG=$MESSAGES
        MAX_QUEUE="$QUEUE_NAME"
    fi

    # Backlog thresholds apply only when a consumer exists to drain the queue.
    if [ "$CONSUMERS" -gt 0 ]; then
        if [ "$MESSAGES" -ge "$CRIT" ]; then
            CRIT_COUNT=$((CRIT_COUNT + 1))
            if [ "$MESSAGES" -gt "$MAX_MSG_CRIT" ]; then
                MAX_MSG_CRIT=$MESSAGES
                MAX_Q_CRIT="$QUEUE_NAME"
            fi
            ITEM=$(queue_item "$QUEUE_NAME" "$MESSAGES")
            CRIT_LIST=$(append_item "$CRIT_LIST" "$ITEM")
        elif [ "$MESSAGES" -ge "$WARN" ]; then
            WARN_COUNT=$((WARN_COUNT + 1))
            if [ "$MESSAGES" -gt "$MAX_MSG_WARN" ]; then
                MAX_MSG_WARN=$MESSAGES
                MAX_Q_WARN="$QUEUE_NAME"
            fi
            ITEM=$(queue_item "$QUEUE_NAME" "$MESSAGES")
            WARN_LIST=$(append_item "$WARN_LIST" "$ITEM")
        fi
    fi

    # Queues with messages but no consumers are surfaced for diagnosis without changing status.
    if [ "$CONSUMERS" -eq 0 ] && [ "$MESSAGES" -gt 0 ]; then
        NO_CONSUMER_COUNT=$((NO_CONSUMER_COUNT + 1))
        ITEM=$(queue_item "$QUEUE_NAME" "$MESSAGES")
        ORPHAN_LIST=$(append_item "$ORPHAN_LIST" "$ITEM")
    fi
done <<EOF
$QUEUE_DATA
EOF
IFS="$OLDIFS"

# Primary state is driven by the worst queue depth class.
if [ "$CRIT_COUNT" -gt 0 ]; then
  STATE_CODE=2
  MSG="$MSG, $CRIT_COUNT queue(s) with high backlog"
  [ -n "$MAX_Q_CRIT" ] && MSG="$MSG; largest $(queue_item "$MAX_Q_CRIT" "$MAX_MSG_CRIT")"
elif [ "$WARN_COUNT" -gt 0 ]; then
  STATE_CODE=1
  MSG="$MSG, $WARN_COUNT queue(s) with elevated backlog"
  [ -n "$MAX_Q_WARN" ] && MSG="$MSG; largest $(queue_item "$MAX_Q_WARN" "$MAX_MSG_WARN")"
fi

# Sum per-queue rates into cluster-level publish/deliver rates when the managed HTTP config is usable.
PUBLISH_RATE=U
DELIVER_RATE=U
if [ -n "$RABBITMQADMIN" ] && [ -r "$RABBITMQADMCONF" ]; then
    RATE_DATA=$($RABBITMQADMIN --quiet --format=tsv --config "$RABBITMQADMCONF" list queues message_stats.publish_details.rate message_stats.deliver_get_details.rate 2>/dev/null)
    RATE_RC=$?

    if [ "$RATE_RC" -eq 0 ]; then
        # Empty rate output is valid on quiet systems, so the AWK pass defaults both rates to zero.
        RATE_SUM=$(printf "%s" "$RATE_DATA" | $AWK -F '	' '{pub+=$1; del+=$2} END {if (pub=="") pub=0; if (del=="") del=0; printf "%.2f %.2f", pub, del}')

        # Split into positional parameters (POSIX sh trick; no arrays)
        set -- $RATE_SUM
        PUBLISH_RATE=${1:-0}
        DELIVER_RATE=${2:-0}
    else
        RATE_NOTICE="rate metrics unavailable through rabbitmqadmin"
    fi
elif [ -z "$RABBITMQADMIN" ]; then
    RATE_NOTICE="rate metrics unavailable because rabbitmqadmin is not installed"
else
    RATE_NOTICE="rate metrics unavailable because rabbitmqadmin config is not readable"
fi

if [ "$QUEUE_INSPECTION_INCOMPLETE" -eq 1 ]; then
    [ "$STATE_CODE" -eq 2 ] || STATE_CODE=3
    MSG="$MSG; queue inspection incomplete"
fi
[ -n "$RATE_NOTICE" ] && MSG="$MSG, $RATE_NOTICE"

# Preserve all queue diagnostics until the single character limit is applied below.
if [ "$CRIT_COUNT" -gt 0 ]; then
    append_long "High backlog queues: ${CRIT_LIST}"
fi
if [ "$WARN_COUNT" -gt 0 ]; then
    append_long "Elevated backlog queues: ${WARN_LIST}"
fi
if [ "$NO_CONSUMER_COUNT" -gt 0 ]; then
    append_long "Queues with messages but no consumers: ${ORPHAN_LIST}"
fi
append_long "$SERVICE_CONTEXT"
append_long "Queue totals: ${QUEUE_COUNT} queue(s), ${TOTAL_MSG} message(s), ${TOTAL_CONSUMERS} consumer(s)"
[ -n "$RATE_NOTICE" ] && append_long "Rate metric context: ${RATE_NOTICE}"
limit_long_output_details
append_long ""
append_long "Interpretation:"
append_long "Queue depth for queues with consumers decides queue severity. Incomplete queue rows are UNKNOWN unless a critical backlog is verified; optional rate metrics are context only."
append_long "Queues with messages but no consumers are diagnostic context and do not raise severity by themselves."
append_long "Inspect the listed high or elevated backlog queues first. When only rate metrics are unavailable, verify rabbitmqadmin and the managed HTTP config while queue health continues to be checked through rabbitmqctl."

# Perfdata keeps labels stable; message rates use a custom messages-per-second UOM.
PUBLISH_RATE_METRIC=$(metric_with_unit "$PUBLISH_RATE" msgps)
DELIVER_RATE_METRIC=$(metric_with_unit "$DELIVER_RATE" msgps)
PERF="total_messages=${TOTAL_MSG}"
PERF="$PERF messages_ready=${TOTAL_READY}"
PERF="$PERF messages_unack=${TOTAL_UNACK}"
PERF="$PERF max_queue_depth=${MAX_MSG};${WARN};${CRIT};0"
PERF="$PERF publish_rate=${PUBLISH_RATE_METRIC}"
PERF="$PERF deliver_rate=${DELIVER_RATE_METRIC}"
PERF="$PERF consumers_total=${TOTAL_CONSUMERS}"
PERF="$PERF queues_total=${QUEUE_COUNT}"

# Emit one monitoring line; queue names are sanitized to avoid accidental perfdata separators.
emit_check "${MSG#, }" "$PERF"
exit $STATE_CODE
