#!/bin/sh
# Managed by puppet

<%= scope.function_template(['basic_settings/monitoring/_output']) %>

# Fail helper used for missing dependencies and unreadable Docker output.
die() {
    monitor_error 'Compose check cannot run: ' "$*"
    # Preserve a known critical backup finding if the Docker runtime cannot be inspected afterward.
    if [ -n "${CRITICAL_REASONS:-}" ]; then
        LONG_OUTPUT=''
        monitor_section 'Backup findings'
        monitor_item "$CRITICAL_REASONS"
        monitor_section 'Interpretation'
        monitor_item 'Resolve the backup finding and restore runtime inspection.'
        printf '%s\n' "$LONG_OUTPUT"
        exit 2
    fi
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
DOCKER=$(command -v docker 2>/dev/null) || die "docker not available"
JQ=$(command -v jq 2>/dev/null) || die "jq not available"
MKTEMP=$(command -v mktemp 2>/dev/null) || die "mktemp not available"
MV=$(command -v mv 2>/dev/null) || die "mv not available"
RM=$(command -v rm 2>/dev/null) || die "rm not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
TR=$(command -v tr 2>/dev/null) || die "tr not available"

# Compose identity and input paths define the project view being checked.
CHECK_NAME=${CHECK_NAME:-""}
COMPOSE_FILES=${COMPOSE_FILES:-""}
COMPOSE_FILES_CLI=0
ENV_FILE=${ENV_FILE:-""}
PROFILE_LIST=${PROFILE_LIST:-""}
PROJECT_DIRECTORY=${PROJECT_DIRECTORY:-""}
PROJECT_NAME=${PROJECT_NAME:-""}

# Runtime policy knobs control tolerated startup, expected exits, health requirements, orphan severity, and total diagnostic size.
BACKUP_DATABASE_TYPE=${BACKUP_DATABASE_TYPE:-""}
BACKUP_RETENTION_DAYS=${BACKUP_RETENTION_DAYS:-""}
BACKUP_PERFDATA=""
BACKUP_REASON=""
UNKNOWN_REASONS=""
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
EXPECTED_EXITED=${EXPECTED_EXITED:-""}
EXPECTED_LIST=""
HEALTH_REQUIRED=${HEALTH_REQUIRED:-""}
ORPHAN_CRITICAL=${ORPHAN_CRITICAL:-0}
STARTING_GRACE=${STARTING_GRACE:-300}

# State files remember restart counts between check runs.
STATE_DIR=${STATE_DIR:-/etc/openitcockpit-agent/state}
STATE_FILE=""
STATE_TMP=""

# Summary and long-output buffers keep status causes separate from diagnostics.
CONTAINER_DETAILS=""
CRITICAL_REASONS=""
ISSUE_DETAILS=""
LONG_OUTPUT=""
WARNING_REASONS=""

# Counters exposed in summary and perfdata
COMPOSE_SERVICES_EXPECTED=0
COMPOSE_SERVICES_MISSING=0
COMPOSE_SERVICES_PRESENT=0
COMPOSE_ORPHANS=0
CONTAINER_RESTARTS_INCREASED=0
CONTAINER_RESTARTS_TOTAL=0
CONTAINERS_CREATED=0
CONTAINERS_DEAD=0
CONTAINERS_EXITED=0
CONTAINERS_PAUSED=0
CONTAINERS_RESTARTING=0
CONTAINERS_RUNNING=0
CONTAINERS_TOTAL=0
CONTAINERS_UNEXPECTED_EXITED=0
CONTAINERS_WITHOUT_HEALTHCHECK=0
HEALTH_HEALTHY=0
HEALTH_STARTING=0
HEALTH_STARTING_TOO_LONG=0
HEALTH_UNHEALTHY=0
HEALTH_REQUIRED_MISSING=0
PRESENT_SERVICES=""

# CLI options define the Compose identity, expected exceptions, and diagnostic limits.
USAGE_TEXT="Usage: $0 -d project_directory [-p project_name] [-f compose_file] [-e env_file] [-n name] [-g seconds] [-l chars] [-x services] [-H services] [-P profiles] [-O] [-S state_directory] [-o] [-b postgresql] [-r retention_days]
Environment: BACKUP_DATABASE_TYPE (-b, empty disables and resets); BACKUP_RETENTION_DAYS (-r, required with -b); PROJECT_DIRECTORY (-d); PROJECT_NAME (-p); COMPOSE_FILES (-f); ENV_FILE (-e); CHECK_NAME (-n); STARTING_GRACE (-g); DETAIL_LIMIT (-l); EXPECTED_EXITED (-x); HEALTH_REQUIRED (-H); PROFILE_LIST (-P); ORPHAN_CRITICAL (-O); STATE_DIR (-S); ORPHAN_CRITICAL (-o).
Command-line options override non-empty environment values; unset or empty environment values use defaults.
The first -f replaces COMPOSE_FILES from the environment; repeated -f options append files. -O enables orphan critical status; -o disables it."
OPTERR=0
while getopts ':d:p:f:e:n:g:l:x:H:P:OS:ob:r:h' opt; do
    case "$opt" in
        b) BACKUP_DATABASE_TYPE=$OPTARG ;;
        r) BACKUP_RETENTION_DAYS=$OPTARG ;;
        d) PROJECT_DIRECTORY="$OPTARG" ;;
        p) PROJECT_NAME="$OPTARG" ;;
        f)
            if [ "$COMPOSE_FILES_CLI" -eq 0 ]; then
                COMPOSE_FILES=$OPTARG
                COMPOSE_FILES_CLI=1
            else
                COMPOSE_FILES="${COMPOSE_FILES:+$COMPOSE_FILES,}$OPTARG"
            fi
            ;;
        e) ENV_FILE="$OPTARG" ;;
        n) CHECK_NAME="$OPTARG" ;;
        g) STARTING_GRACE="$OPTARG" ;;
        l) DETAIL_LIMIT="$OPTARG" ;;
        x) EXPECTED_EXITED="$OPTARG" ;;
        H) HEALTH_REQUIRED="$OPTARG" ;;
        P) PROFILE_LIST="$OPTARG" ;;
        O) ORPHAN_CRITICAL=1 ;;
        S) STATE_DIR=$OPTARG ;;
        o) ORPHAN_CRITICAL=0 ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
case "$ORPHAN_CRITICAL" in
    0|1) : ;;
    *) die "ORPHAN_CRITICAL must be 0 or 1" ;;
esac
[ -n "$STATE_DIR" ] || die "state directory must not be empty"

# Check whether a value contains only decimal digits.
is_number() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# Return the first useful line from command output.
first_line() {
    printf '%s\n' "$1" | $SED -n '
        s/[[:space:]]\+$//
        /^[[:space:]]*$/d
        p
        q
    '
}

# Append a semicolon-separated reason to an existing summary string.
append_reason() {
    current_text=$1
    new_text=$2

    if [ -n "$current_text" ]; then
        printf '%s; %s\n' "$current_text" "$new_text"
    else
        printf '%s\n' "$new_text"
    fi
}

# Append one line to the issue detail buffer.
append_issue_detail() {
    if [ -z "$ISSUE_DETAILS" ]; then
        ISSUE_DETAILS=$1
    else
        ISSUE_DETAILS=$(printf '%s\n%s' "$ISSUE_DETAILS" "$1")
    fi
}

# Record a CRITICAL reason.
add_critical() {
    CRITICAL_REASONS=$(append_reason "$CRITICAL_REASONS" "$1")
    append_issue_detail "$1"
}

# Record a WARNING reason.
add_warning() {
    WARNING_REASONS=$(append_reason "$WARNING_REASONS" "$1")
    append_issue_detail "$1"
}

# Return the first semicolon-separated reason for the short output.
first_reason() {
    first_line_text=${1%%'
'*}
    printf '%s\n' "${first_line_text%%; *}"
}

# Append one comma-separated item if it is not already present.
append_csv_unique() {
    current_list=$1
    new_item=$2

    [ -n "$new_item" ] || {
        printf '%s\n' "$current_list"
        return
    }

    old_ifs=$IFS
    IFS=','
    for item in $current_list; do
        if [ "$item" = "$new_item" ]; then
            IFS=$old_ifs
            printf '%s\n' "$current_list"
            return
        fi
    done
    IFS=$old_ifs

    if [ -n "$current_list" ]; then
        printf '%s,%s\n' "$current_list" "$new_item"
    else
        printf '%s\n' "$new_item"
    fi
}

# Return success when a comma-separated list contains the requested item.
in_csv() {
    list=$1
    needle=$2

    old_ifs=$IFS
    IFS=','
    for item in $list; do
        if [ "$item" = "$needle" ]; then
            IFS=$old_ifs
            return 0
        fi
    done
    IFS=$old_ifs
    return 1
}

# Count entries in a comma-separated list.
count_csv() {
    list=$1
    count=0

    [ -n "$list" ] || {
        printf '%s\n' 0
        return
    }

    old_ifs=$IFS
    IFS=','
    for item in $list; do
        [ -n "$item" ] && count=$((count + 1))
    done
    IFS=$old_ifs
    printf '%s\n' "$count"
}

# Sanitize arbitrary text into a stable state filename fragment.
sanitize_label() {
    printf '%s' "$1" | $TR -c 'A-Za-z0-9_.-' '_'
}

# Append one container detail line; final long output is capped once before Interpretation.
append_container_detail() {
    if [ -z "$CONTAINER_DETAILS" ]; then
        CONTAINER_DETAILS=$1
    else
        CONTAINER_DETAILS=$(printf '%s\n%s' "$CONTAINER_DETAILS" "$1")
    fi
}

# Convert a Docker timestamp to age in seconds.
timestamp_age() {
    timestamp_text=$1

    case "$timestamp_text" in
        ''|0001-01-01*) printf '%s\n' U; return ;;
    esac

    timestamp_epoch=$($DATE -d "$timestamp_text" +%s 2>/dev/null) || {
        printf '%s\n' U
        return
    }

    age=$((NOW_EPOCH - timestamp_epoch))
    [ "$age" -lt 0 ] && age=0
    printf '%s\n' "$age"
}

# Read the previous restart count for one container name.
previous_restart_count() {
    [ -r "$STATE_FILE" ] || return 1
    $AWK -F'|' -v name="$1" '$1 == name { print $2; exit }' "$STATE_FILE"
}

# Use the same Compose identity and file/profile order for configuration and runtime discovery.
compose_command() {
    compose_action=$1
    set -- compose
    [ -n "$PROJECT_NAME" ] && set -- "$@" --project-name "$PROJECT_NAME"
    set -- "$@" --project-directory "$PROJECT_DIRECTORY"
    [ -n "$ENV_FILE" ] && set -- "$@" --env-file "$ENV_FILE"

    old_ifs=$IFS
    IFS=','
    for compose_file in $COMPOSE_FILES; do
        [ -n "$compose_file" ] && set -- "$@" --file "$compose_file"
    done
    IFS=$old_ifs

    old_ifs=$IFS
    IFS=','
    for profile_name in $PROFILE_LIST; do
        [ -n "$profile_name" ] && set -- "$@" --profile "$profile_name"
    done
    IFS=$old_ifs

    case "$compose_action" in
        config) set -- "$@" config --services ;;
        ps) set -- "$@" ps --all --quiet --orphans ;;
    esac
    $DOCKER "$@"
}

# Inspect the containers returned by Compose.
docker_inspect_containers() {
    set -- inspect
    for container_id in $CONTAINER_IDS; do
        set -- "$@" "$container_id"
    done
    $DOCKER "$@"
}

# Validate the completed filename before its timestamp can affect backup health or retention.
is_backup_filename() {
    case "$1" in
        postgresql-[0123456789][0123456789][0123456789][0123456789][0123456789][0123456789][0123456789][0123456789][0123456789][0123456789]-??????????.sql.gz) ;;
        *) return 1 ;;
    esac
    backup_run_id=${1#postgresql-??????????-}
    backup_run_id=${backup_run_id%.sql.gz}
    case "$backup_run_id" in
        *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
    esac
}

# Inspect completed files without querying the database or reading systemd state.
check_database_backup() (
    backup="$PROJECT_DIRECTORY/backup"
    retention=$BACKUP_RETENTION_DAYS
    [ ! -L "$backup" ] || { printf 'database backup directory is a symlink\n'; exit 3; }
    [ -d "$backup" ] || { printf 'database backup directory is missing\n'; exit 2; }
    [ -r "$backup" ] && [ -x "$backup" ] || { printf 'database backup directory is inaccessible\n'; exit 3; }
    latest=0
    invalid=0
    now=$($DATE +%s)
    for file in "$backup"/postgresql-*.sql.gz; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        name=${file##*/}
        is_backup_filename "$name" || continue
        epoch=${name#postgresql-}
        epoch=${epoch%%-*}
        if [ -L "$file" ] || [ ! -f "$file" ] || [ ! -r "$file" ] || [ ! -s "$file" ] || [ "$epoch" -gt "$now" ]; then
            invalid=$((invalid + 1))
        elif [ "$epoch" -gt "$latest" ]; then
            latest=$epoch
        fi
    done
    age=$((now - latest))
    if [ "$latest" -eq 0 ] || [ "$age" -gt 86400 ]; then
        printf 'no completed database backup within 24 hours; start the backup service | backup_age=%ss;;86400\n' "$age"
        exit 2
    fi
    expired=0
    cutoff=$((latest - retention * 86400))
    for file in "$backup"/postgresql-*.sql.gz; do
        [ -f "$file" ] && [ ! -L "$file" ] || continue
        name=${file##*/}
        is_backup_filename "$name" || continue
        epoch=${name#postgresql-}
        epoch=${epoch%%-*}
        [ "$epoch" -ge "$cutoff" ] || expired=$((expired + 1))
    done
    reason="database backup is ${age}s old and retention is current"
    [ "$expired" -eq 0 ] || reason="database backup is current; ${expired} expired files remain after cleanup"
    [ "$invalid" -eq 0 ] || reason="database backup is current; ${invalid} files are invalid or future-dated"
    printf '%s | backup_age=%ss;;86400 backup_expired=%s backup_invalid=%s\n' "$reason" "$age" "$expired" "$invalid"
    [ "$invalid" -eq 0 ] || exit 3
    [ "$expired" -eq 0 ] || exit 1
    exit 0
)

# Validate options before Docker is contacted.
[ -n "$PROJECT_DIRECTORY" ] || die "$USAGE_TEXT"
[ -d "$PROJECT_DIRECTORY" ] || die "compose project directory '$PROJECT_DIRECTORY' does not exist"
[ -r "$PROJECT_DIRECTORY" ] || die "compose project directory '$PROJECT_DIRECTORY' is not readable"
is_number "$STARTING_GRACE" || die "starting grace must be numeric"
is_number "$DETAIL_LIMIT" || die "detail limit must be numeric"
[ "$DETAIL_LIMIT" -ge 1 ] || die "detail limit must be at least 1"

if [ -n "$PROJECT_NAME" ]; then
    case "$PROJECT_NAME" in
        *[!A-Za-z0-9_.-]*) die "project name '$PROJECT_NAME' contains unsupported characters" ;;
    esac
fi

if [ -n "$ENV_FILE" ]; then
    [ -r "$ENV_FILE" ] || die "env file '$ENV_FILE' is not readable"
fi

old_ifs=$IFS
IFS=','
for compose_file in $COMPOSE_FILES; do
    [ -n "$compose_file" ] || continue
    [ -r "$compose_file" ] || die "compose file '$compose_file' is not readable"
done
IFS=$old_ifs

if [ -z "$CHECK_NAME" ]; then
    if [ -n "$PROJECT_NAME" ]; then
        CHECK_NAME=$PROJECT_NAME
    else
        CHECK_NAME=$(
            DIRECTORY_NAME=$PROJECT_DIRECTORY
            while [ "${DIRECTORY_NAME%/}" != "$DIRECTORY_NAME" ]; do
                DIRECTORY_NAME=${DIRECTORY_NAME%/}
            done
            DIRECTORY_NAME=${DIRECTORY_NAME##*/}
            printf '%s\n' "${DIRECTORY_NAME:-/}"
        )
    fi
fi

# Database checks read only completed backup files; execution failures remain with the existing timer monitoring.
case "$BACKUP_DATABASE_TYPE" in
    '') : ;;
    postgresql)
        case "$BACKUP_RETENTION_DAYS" in ''|0*|*[!0-9]*) die 'backup retention must be a positive integer' ;; esac
        [ "${#BACKUP_RETENTION_DAYS}" -le 9 ] || die 'backup retention is too large'
        BACKUP_OUTPUT=$(check_database_backup)
        BACKUP_RC=$?
        BACKUP_REASON=${BACKUP_OUTPUT%% | *}
        case "$BACKUP_OUTPUT" in *' | '*) BACKUP_PERFDATA=${BACKUP_OUTPUT#* | } ;; esac
        case "$BACKUP_RC" in
            0) : ;;
            1) add_warning "$BACKUP_REASON" ;;
            2) add_critical "$BACKUP_REASON" ;;
            *) UNKNOWN_REASONS=${BACKUP_REASON:-database backup check could not run}; append_issue_detail "$UNKNOWN_REASONS" ;;
        esac
        ;;
    *) die 'backup database type must be empty or postgresql' ;;
esac

# Prepare the private state file inside the directory managed by monitoring_custom.
PROJECT_KEY=$(sanitize_label "$CHECK_NAME")
STATE_FILE="${STATE_DIR}/docker_compose_${PROJECT_KEY}.state"
OLD_UMASK=$(umask)
umask 077
[ -d "$STATE_DIR" ] && [ -w "$STATE_DIR" ] || die "managed state directory ${STATE_DIR} is missing or not writable"
STATE_TMP=$($MKTEMP "${STATE_DIR}/docker_compose_${PROJECT_KEY}.XXXXXX") || {
    umask "$OLD_UMASK"
    die "state file could not be created"
}
umask "$OLD_UMASK"
trap '$RM -f "$STATE_TMP"' EXIT HUP INT QUIT TERM

# Resolve expected services from the rendered Compose model.
CONFIG_OUTPUT=$(compose_command config 2>&1)
CONFIG_RC=$?
[ "$CONFIG_RC" -eq 0 ] || die "$CHECK_NAME: compose config failed: $(first_line "$CONFIG_OUTPUT")"

while IFS= read -r service_name; do
    case "$service_name" in
        *[![:space:]]*) ;;
        *) continue ;;
    esac
    EXPECTED_LIST=$(append_csv_unique "$EXPECTED_LIST" "$service_name")
    COMPOSE_SERVICES_EXPECTED=$((COMPOSE_SERVICES_EXPECTED + 1))
done <<EOF
$CONFIG_OUTPUT
EOF

[ "$COMPOSE_SERVICES_EXPECTED" -gt 0 ] || die "$CHECK_NAME: compose config does not contain services"

# Compose supplies IDs directly; other runtime fields come from the detailed inspect below.
PS_OUTPUT=$(compose_command ps 2>&1)
PS_RC=$?
[ "$PS_RC" -eq 0 ] || die "$CHECK_NAME: compose ps failed: $(first_line "$PS_OUTPUT")"

CONTAINER_IDS=""
while IFS= read -r container_id; do
    case "$container_id" in
        '') continue ;;
        *[!a-fA-F0-9]*) die "$CHECK_NAME: compose ps returned an invalid container ID" ;;
    esac
    CONTAINER_IDS="${CONTAINER_IDS:+$CONTAINER_IDS }$container_id"
done <<EOF
$PS_OUTPUT
EOF

# Keep JSON for nested optional health data, the latest log entry and escaped diagnostic text.
if [ -n "$CONTAINER_IDS" ]; then
    INSPECT_JSON=$(docker_inspect_containers 2>&1)
    INSPECT_RC=$?
    [ "$INSPECT_RC" -eq 0 ] || die "$CHECK_NAME: docker inspect failed: $(first_line "$INSPECT_JSON")"

    INSPECT_TSV=$(printf '%s' "$INSPECT_JSON" | $JQ -r '
        .[]
        | [
            ((.Id // "")[0:12]),
            ((.Name // "") | sub("^/"; "")),
            (.Config.Labels["com.docker.compose.service"] // ""),
            (.Config.Image // ""),
            ((.RestartCount // 0) | tostring),
            (.Created // ""),
            (.State.Status // ""),
            (.State.Health.Status // "none"),
            ((.State.ExitCode // 0) | tostring),
            (.State.StartedAt // ""),
            ((((.State.Health.Log // [])[-1].Output // "") | gsub("[\r\n\t]+"; " ") | gsub("[[:space:]]+"; " ") | .[0:240]))
        ]
        | @tsv
    ' 2>&1)
    INSPECT_JQ_RC=$?
    [ "$INSPECT_JQ_RC" -eq 0 ] || die "$CHECK_NAME: docker inspect JSON parse failed: $(first_line "$INSPECT_TSV")"
else
    INSPECT_TSV=""
fi

NOW_EPOCH=$($DATE +%s)

while IFS='	' read -r container_id container_name service_name image_name restart_count created_at state_status health_status exit_code started_at health_output; do
    [ -n "$container_id$container_name" ] || continue

    # Normalize numeric Docker fields before they are used in counters and thresholds.
    is_number "$restart_count" || restart_count=0
    is_number "$exit_code" || exit_code=0

    CONTAINERS_TOTAL=$((CONTAINERS_TOTAL + 1))
    CONTAINER_RESTARTS_TOTAL=$((CONTAINER_RESTARTS_TOTAL + restart_count))

    # Compose labels decide whether a container belongs to the rendered project model.
    if [ -n "$service_name" ] && in_csv "$EXPECTED_LIST" "$service_name"; then
        PRESENT_SERVICES=$(append_csv_unique "$PRESENT_SERVICES" "$service_name")
    else
        COMPOSE_ORPHANS=$((COMPOSE_ORPHANS + 1))
        if [ "$ORPHAN_CRITICAL" -eq 1 ]; then
            add_critical "${service_name:-$container_name} is an orphan container"
        else
            add_warning "${service_name:-$container_name} is an orphan container"
        fi
    fi

    # State and health counters are kept even when no alert is raised so perfdata stays complete.
    case "$state_status" in
        running) CONTAINERS_RUNNING=$((CONTAINERS_RUNNING + 1)) ;;
        restarting) CONTAINERS_RESTARTING=$((CONTAINERS_RESTARTING + 1)) ;;
        paused) CONTAINERS_PAUSED=$((CONTAINERS_PAUSED + 1)) ;;
        exited) CONTAINERS_EXITED=$((CONTAINERS_EXITED + 1)) ;;
        dead) CONTAINERS_DEAD=$((CONTAINERS_DEAD + 1)) ;;
        created) CONTAINERS_CREATED=$((CONTAINERS_CREATED + 1)) ;;
    esac

    case "$health_status" in
        healthy) HEALTH_HEALTHY=$((HEALTH_HEALTHY + 1)) ;;
        unhealthy) HEALTH_UNHEALTHY=$((HEALTH_UNHEALTHY + 1)) ;;
        starting) HEALTH_STARTING=$((HEALTH_STARTING + 1)) ;;
        ''|none) CONTAINERS_WITHOUT_HEALTHCHECK=$((CONTAINERS_WITHOUT_HEALTHCHECK + 1)) ;;
    esac

    # Restart increases since the previous run are warning signals for otherwise running containers.
    previous_restart=$(previous_restart_count "$container_name" || true)
    if is_number "$previous_restart" && [ "$restart_count" -gt "$previous_restart" ]; then
        CONTAINER_RESTARTS_INCREASED=$((CONTAINER_RESTARTS_INCREASED + 1))
        add_warning "${service_name:-$container_name} restart count increased from ${previous_restart} to ${restart_count}"
    fi
    printf '%s|%s\n' "$container_name" "$restart_count" >>"$STATE_TMP"

    # Explicitly expected one-shot/exited services can finish cleanly without alerting.
    expected_exited=0
    if [ -n "$service_name" ] && in_csv "$EXPECTED_EXITED" "$service_name"; then
        expected_exited=1
    fi

    # Container state classification drives the final monitoring state.
    case "$state_status" in
        running)
            case "$health_status" in
                unhealthy)
                    add_critical "${service_name:-$container_name} is running but unhealthy"
                    ;;
                starting)
                    started_age=$(timestamp_age "$started_at")
                    if is_number "$started_age" && [ "$started_age" -gt "$STARTING_GRACE" ]; then
                        HEALTH_STARTING_TOO_LONG=$((HEALTH_STARTING_TOO_LONG + 1))
                        add_critical "${service_name:-$container_name} health is still starting after ${started_age}s"
                    else
                        add_warning "${service_name:-$container_name} health is starting"
                    fi
                    ;;
                ''|none)
                    if [ -n "$service_name" ] && in_csv "$HEALTH_REQUIRED" "$service_name"; then
                        HEALTH_REQUIRED_MISSING=$((HEALTH_REQUIRED_MISSING + 1))
                        add_warning "${service_name} has no healthcheck"
                    fi
                    ;;
            esac
            ;;
        restarting)
            add_critical "${service_name:-$container_name} is restarting"
            ;;
        paused)
            add_critical "${service_name:-$container_name} is paused"
            ;;
        dead)
            add_critical "${service_name:-$container_name} is dead"
            ;;
        created)
            created_age=$(timestamp_age "$created_at")
            if is_number "$created_age" && [ "$created_age" -gt "$STARTING_GRACE" ]; then
                add_critical "${service_name:-$container_name} is still created after ${created_age}s"
            else
                add_warning "${service_name:-$container_name} is created"
            fi
            ;;
        exited)
            # Expected exited services must exit cleanly; all other exited containers are critical.
            if [ "$expected_exited" -eq 1 ] && [ "$exit_code" = "0" ]; then
                :
            else
                CONTAINERS_UNEXPECTED_EXITED=$((CONTAINERS_UNEXPECTED_EXITED + 1))
                add_critical "${service_name:-$container_name} exited with code ${exit_code}"
            fi
            ;;
        *)
            add_critical "${service_name:-$container_name} has unexpected state ${state_status:-unknown}"
            ;;
    esac

    # Long output is capped separately so each container can contribute detail without unbounded output.
    detail_line="- ${service_name:-unknown}/${container_name:-unknown}: image ${image_name:-unknown}, state ${state_status:-unknown}, health ${health_status:-none}, restarts ${restart_count:-0}, exit ${exit_code:-0}"
    append_container_detail "$detail_line"
    if [ -n "$health_output" ] && { [ "$health_status" = "unhealthy" ] || [ "$health_status" = "starting" ]; }; then
        append_container_detail "  health: ${health_output}"
    fi
done <<EOF
$INSPECT_TSV
EOF

# Replace the restart-count state atomically after the full Docker view has been processed.
$MV "$STATE_TMP" "$STATE_FILE" 2>/dev/null || die "$CHECK_NAME: state file could not be updated"
STATE_TMP=""

# Missing services are checked after container iteration so profile and orphan handling are already known.
old_ifs=$IFS
IFS=','
for expected_service in $EXPECTED_LIST; do
    [ -n "$expected_service" ] || continue
    if ! in_csv "$PRESENT_SERVICES" "$expected_service"; then
        COMPOSE_SERVICES_MISSING=$((COMPOSE_SERVICES_MISSING + 1))
        add_critical "service ${expected_service} is missing"
    fi
done
IFS=$old_ifs

COMPOSE_SERVICES_PRESENT=$(count_csv "$PRESENT_SERVICES")

# Compose a compact Nagios summary and put the primary alert cause before aggregate counters.
if [ -n "$CRITICAL_REASONS" ]; then
    STATE_CODE=2
elif [ -n "$UNKNOWN_REASONS" ]; then
    STATE_CODE=3
elif [ -n "$WARNING_REASONS" ]; then
    STATE_CODE=1
else
    STATE_CODE=0
fi

if [ -n "$CRITICAL_REASONS" ]; then
    PRIMARY_REASON=$(first_reason "$CRITICAL_REASONS")
    SUMMARY="Compose ${CHECK_NAME}: ${PRIMARY_REASON}; ${CONTAINERS_RUNNING}/${CONTAINERS_TOTAL} running, ${HEALTH_HEALTHY} healthy"
elif [ -n "$UNKNOWN_REASONS" ]; then
    SUMMARY="Compose ${CHECK_NAME}: ${UNKNOWN_REASONS}"
elif [ -n "$WARNING_REASONS" ]; then
    PRIMARY_REASON=$(first_reason "$WARNING_REASONS")
    SUMMARY="Compose ${CHECK_NAME}: ${PRIMARY_REASON}; ${CONTAINERS_RUNNING}/${CONTAINERS_TOTAL} running, ${HEALTH_HEALTHY} healthy"
else
    SUMMARY="Compose ${CHECK_NAME}: ${CONTAINERS_RUNNING}/${CONTAINERS_TOTAL} running, ${HEALTH_HEALTHY} healthy"
fi
[ "$CONTAINERS_WITHOUT_HEALTHCHECK" -gt 0 ] && SUMMARY="${SUMMARY}, ${CONTAINERS_WITHOUT_HEALTHCHECK} no-healthcheck"
[ "$COMPOSE_SERVICES_MISSING" -gt 0 ] && SUMMARY="${SUMMARY}, ${COMPOSE_SERVICES_MISSING} missing"
[ "$HEALTH_UNHEALTHY" -gt 0 ] && SUMMARY="${SUMMARY}, ${HEALTH_UNHEALTHY} unhealthy"
[ "$HEALTH_STARTING" -gt 0 ] && SUMMARY="${SUMMARY}, ${HEALTH_STARTING} starting"
[ "$HEALTH_REQUIRED_MISSING" -gt 0 ] && SUMMARY="${SUMMARY}, ${HEALTH_REQUIRED_MISSING} missing-healthcheck"
[ "$CONTAINERS_UNEXPECTED_EXITED" -gt 0 ] && SUMMARY="${SUMMARY}, ${CONTAINERS_UNEXPECTED_EXITED} exited"
[ "$CONTAINERS_RESTARTING" -gt 0 ] && SUMMARY="${SUMMARY}, ${CONTAINERS_RESTARTING} restarting"
[ "$COMPOSE_ORPHANS" -gt 0 ] && SUMMARY="${SUMMARY}, ${COMPOSE_ORPHANS} orphan"

PERFDATA="containers_total=${CONTAINERS_TOTAL} containers_running=${CONTAINERS_RUNNING} containers_exited=${CONTAINERS_EXITED} containers_dead=${CONTAINERS_DEAD}"
PERFDATA="${PERFDATA} containers_restarting=${CONTAINERS_RESTARTING} containers_paused=${CONTAINERS_PAUSED} containers_created=${CONTAINERS_CREATED}"
PERFDATA="${PERFDATA} containers_healthy=${HEALTH_HEALTHY} containers_unhealthy=${HEALTH_UNHEALTHY} containers_starting=${HEALTH_STARTING}"
PERFDATA="${PERFDATA} containers_starting_too_long=${HEALTH_STARTING_TOO_LONG} containers_without_healthcheck=${CONTAINERS_WITHOUT_HEALTHCHECK}"
PERFDATA="${PERFDATA} containers_health_required_missing=${HEALTH_REQUIRED_MISSING} compose_services_expected=${COMPOSE_SERVICES_EXPECTED}"
PERFDATA="${PERFDATA} compose_services_present=${COMPOSE_SERVICES_PRESENT} compose_services_missing=${COMPOSE_SERVICES_MISSING}"
PERFDATA="${PERFDATA} compose_orphans=${COMPOSE_ORPHANS} container_restarts_total=${CONTAINER_RESTARTS_TOTAL}c container_restarts_increased=${CONTAINER_RESTARTS_INCREASED}"

PERFDATA="${PERFDATA}${BACKUP_PERFDATA:+ $BACKUP_PERFDATA}"

if [ -n "$ISSUE_DETAILS" ]; then
    monitor_section "Compose findings"
    monitor_items "$ISSUE_DETAILS"
fi

monitor_section "Compose project"
monitor_item "Project: ${CHECK_NAME}"
monitor_item "Project directory: ${PROJECT_DIRECTORY}"
[ -n "$PROJECT_NAME" ] && monitor_item "Compose project name: ${PROJECT_NAME}"
monitor_item "Expected services: ${EXPECTED_LIST}"
[ -z "$BACKUP_REASON" ] || monitor_item "Database: ${BACKUP_REASON}"

if [ -n "$CONTAINER_DETAILS" ]; then
    monitor_section "Containers"
    monitor_records "$CONTAINER_DETAILS"
fi

# Explain how the operator should read the collected Compose state without repeating thresholds or perfdata.
monitor_limit "$DETAIL_LIMIT"
monitor_section "Interpretation"
monitor_item "Restart changes, service/container health, required healthchecks and orphan policy affect the result; the container inventory is a snapshot."
[ -z "$BACKUP_DATABASE_TYPE" ] || monitor_item "Database backup checks use completed files and actual retention leftovers; timer monitoring reports execution failures. Known critical findings take precedence over unknown results, followed by warnings."
monitor_item "Inspect the named Compose service or container first, then use docker compose ps/logs in the project directory when the summary names a missing, unhealthy, exited, restarting, or orphaned item."

if [ "$STATE_CODE" -ne 0 ]; then
    monitor_prepend 'Project findings' "$SUMMARY" 'Inspect the named Compose service or container with docker compose ps/logs.'
fi
monitor_result "$SUMMARY" "$PERFDATA"
exit "$STATE_CODE"
