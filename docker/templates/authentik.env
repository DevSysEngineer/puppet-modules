# Managed by puppet
AUTHENTIK_TAG=<%= @image_tag %>
PG_PASS=<%= @pg_pass.unwrap %>
AUTHENTIK_SECRET_KEY=<%= @secret_key.unwrap %>
COMPOSE_PORT_HTTPS=<%= @port %>
<% if !@smtp_host_correct.nil? -%>
AUTHENTIK_EMAIL__HOST=<%= @smtp_host_correct %>
<% end -%>
<% if !@smtp_port_correct.nil? -%>
AUTHENTIK_EMAIL__PORT=<%= @smtp_port_correct %>
<% end -%>
<% if !@smtp_username_correct.nil? -%>
AUTHENTIK_EMAIL__USERNAME=<%= @smtp_username_correct %>
<% end -%>
<% if !@smtp_password_correct.nil? -%>
AUTHENTIK_EMAIL__PASSWORD=<%= @smtp_password_correct %>
<% end -%>
<% if !@smtp_use_tls_correct.nil? -%>
AUTHENTIK_EMAIL__USE_TLS=<%= @smtp_use_tls_correct ? 'true' : 'false' %>
<% end -%>
<% if !@smtp_use_ssl_correct.nil? -%>
AUTHENTIK_EMAIL__USE_SSL=<%= @smtp_use_ssl_correct ? 'true' : 'false' %>
<% end -%>
<% if !@smtp_timeout_correct.nil? -%>
AUTHENTIK_EMAIL__TIMEOUT=<%= @smtp_timeout_correct %>
<% end -%>
<% if !@smtp_from_correct.nil? -%>
AUTHENTIK_EMAIL__FROM=<%= @smtp_from_correct %>
<% end -%>
