# Managed by puppet
TAG=<%= @image_tag %>
PG_DATABASE_USER=<%= @database_user %>
PG_DATABASE_PASSWORD=<%= @database_password.unwrap %>
PG_DATABASE_HOST=<%= @database_host %>
PG_DATABASE_PORT=<%= @database_port %>
REDIS_URL=<%= @redis_url %>
SERVER_URL=<%= @server_url_correct %>
ENCRYPTION_KEY=<%= @secret_key.unwrap %>
<% if !@secret_key_fallback.nil? -%>
FALLBACK_ENCRYPTION_KEY=<%= @secret_key_fallback.unwrap %>
<% end -%>
STORAGE_TYPE=<%= @storage_type %>
<% if !@storage_s3_region.nil? and @storage_s3_region != '' -%>
STORAGE_S3_REGION=<%= @storage_s3_region %>
<% end -%>
<% if !@storage_s3_name.nil? and @storage_s3_name != '' -%>
STORAGE_S3_NAME=<%= @storage_s3_name %>
<% end -%>
<% if !@storage_s3_endpoint.nil? and @storage_s3_endpoint != '' -%>
STORAGE_S3_ENDPOINT=<%= @storage_s3_endpoint %>
<% end -%>
<% if !@storage_s3_access_key_id.nil? -%>
STORAGE_S3_ACCESS_KEY_ID=<%= @storage_s3_access_key_id.unwrap %>
<% end -%>
<% if !@storage_s3_secret_access_key.nil? -%>
STORAGE_S3_SECRET_ACCESS_KEY=<%= @storage_s3_secret_access_key.unwrap %>
<% end -%>
