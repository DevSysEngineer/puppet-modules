#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'GitLab check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
GITLAB_CTL=$(command -v gitlab-ctl 2>/dev/null) || die "gitlab-ctl not available"
GITLAB_RAKE=$(command -v gitlab-rake 2>/dev/null) || die "gitlab-rake not available"
GITLAB_RAILS=$(command -v gitlab-rails 2>/dev/null) || die "gitlab-rails not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
TR=$(command -v tr 2>/dev/null) || die "tr not available"

# License warning lead time is configurable through the environment for direct check use.
LIC_WARN_DAYS=${LIC_WARN_DAYS:-30}
case "$LIC_WARN_DAYS" in
    ''|*[!0-9]*) die "LIC_WARN_DAYS must be numeric" ;;
esac

# Runtime state is built from omnibus service status, Rails output, and license checks.
GROUP_COUNT=0
GROUP_STORAGE_MAX_MB=0
GROUP_STORAGE_MAX_NAME=""
GROUP_STORAGE_TOTAL_MB=0
LIC_CONTEXT="unknown"
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_GITLAB_NL__"
STATE_CODE=0
MSG=""
PERF=""
VERSION_CONTEXT="version check data unavailable"

# Nagios treats raw pipes after the first output line as perfdata separators.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Append one line to the diagnostic long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Read the first useful diagnostic line from command output.
first_line() {
    printf '%s\n' "$1" | $SED -n '
        s/[[:space:]]\+$//
        /^[[:space:]]*$/d
        p
        q
    '
}

# Emit one monitoring line with optional perfdata.
emit_check() {
    if [ -n "${2:-}" ]; then
        printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    else
        printf '%s\n' "$(monitor_text_value "$1")"
    fi
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# GitLab group paths may contain characters that are not safe in perfdata labels.
sanitize_label() {
    label=$(printf '%s' "$1" | $TR '[:upper:]' '[:lower:]' | $SED 's/[^a-z0-9_]/_/g; s/^_//; s/_$//')
    if [ -n "$label" ]; then
        printf '%s' "$label"
    else
        printf '%s' 'unknown'
    fi
}

# gitlab-ctl status is the fastest omnibus-wide signal for stopped components.
SVC_RAW=$($GITLAB_CTL status 2>&1)
SVC_RC=$?
DOWN=$(printf '%s\n' "$SVC_RAW" | $AWK -F': ' '/^down:/ {print $2}')
if [ -n "$DOWN" ]; then
    DOWN_LIST=$(printf '%s' "$DOWN" | $TR '\n' ',' | $SED 's/,$//')
    emit_check "GitLab service(s) down: ${DOWN_LIST}"
    exit 2
fi
[ "$SVC_RC" -eq 0 ] || {
    SVC_ERROR=$(first_line "$SVC_RAW")
    [ -n "$SVC_ERROR" ] || SVC_ERROR="gitlab-ctl status exited with ${SVC_RC}"
    emit_check "GitLab service status could not be read: ${SVC_ERROR}"
    exit 3
}

# A single Rails runner keeps expensive application boot cost to one process.
RAILS_RAW=$($GITLAB_RAILS runner -e production '
    # Normalize fields before writing tagged shell records so the check does not need to parse JSON with text tools.
    def check_field(value)
      value.to_s.gsub(/[\r\n|]+/, " ").strip
    end

    def check_value(source, key)
      if source.respond_to?(:[])
        begin
          value = source[key.to_s]
          value = source[key.to_sym] if value.nil?
          return value
        rescue StandardError
          # Some cache objects expose [] but reject one of the key types; method access below is the fallback.
        end
      end
      if source.respond_to?(key)
        source.public_send(key)
      end
    end

    # Trigger remote version check and tag the result so the shell parser can split sections safely.
    Gitlab::Version::VersionCheckCronWorker.new.perform
    sleep 5
    vc = Rails.cache.read("version_check")
    if vc
      critical = check_value(vc, :critical_vulnerability) ? 1 : 0
      version = check_field(check_value(vc, :version))
      severity = check_field(check_value(vc, :severity))
      puts "VC|#{critical}|#{version}|#{severity}"
    else
      puts "VC|0||"
    end

    # Group storage is emitted as a separate tagged stream for perfdata generation.
    Namespace.where(type: "Group").find_each do |g|
      size = 0
      if g.respond_to?(:root_storage_statistics) && g.root_storage_statistics
        size = g.root_storage_statistics.storage_size || 0
      elsif g.respond_to?(:statistics) && g.statistics
        size = g.statistics.storage_size || 0
      end
      puts "GR|#{check_field(g.full_path)}|#{size}"
    end
' 2>/dev/null) || die "gitlab-rails runner failed"

# Parse the tagged version-check fields emitted by Rails.
VC_LINE=$(printf '%s\n' "$RAILS_RAW" | $AWK -F'|' '/^VC\|/ {print; exit}')
if [ -n "$VC_LINE" ]; then
    CV=$(printf '%s\n' "$VC_LINE" | $AWK -F'|' '{print $2 + 0}')
    NEW_VER=$(printf '%s\n' "$VC_LINE" | $AWK -F'|' '{print $3}')
    SEV=$(printf '%s\n' "$VC_LINE" | $AWK -F'|' '{print $4}')

    if [ "$CV" -eq 1 ]; then
        STATE_CODE=2
        MSG="${MSG}${MSG:+; }GitLab critical security update available (-> $NEW_VER)"
        VERSION_CONTEXT="critical security update available: ${NEW_VER:-unknown}${SEV:+ ($SEV)}"
    elif [ "$SEV" = "success" ] || [ -z "$NEW_VER" ]; then
        VERSION_CONTEXT="up to date"
        : # Up-to-date
    else
        [ $STATE_CODE -lt 1 ] && STATE_CODE=1
        MSG="${MSG}${MSG:+; }GitLab update available ($SEV: $NEW_VER)"
        VERSION_CONTEXT="update available: ${NEW_VER:-unknown}${SEV:+ ($SEV)}"
    fi
fi

# Build per-group storage perfdata and compact aggregate context; group paths are label-sanitized but values remain raw megabytes.
GROUP_RECORDS=$(printf '%s' "$RAILS_RAW" | $AWK -F'|' '/^GR\|/ {sub(/^GR\|/, "", $0); print}')
while IFS='|' read -r N B; do
    [ -z "$N" ] && continue
    case "$B" in
        ''|*[!0-9]*) continue ;;
    esac
    MB=$(( B / 1048576 ))
    SAFE=$(sanitize_label "$N")
    GROUP_COUNT=$((GROUP_COUNT + 1))
    GROUP_STORAGE_TOTAL_MB=$((GROUP_STORAGE_TOTAL_MB + MB))
    if [ "$MB" -gt "$GROUP_STORAGE_MAX_MB" ]; then
        GROUP_STORAGE_MAX_MB=$MB
        GROUP_STORAGE_MAX_NAME=$N
    fi

    PERF="${PERF} group_${SAFE}=${MB}MB;;;0"
done <<EOF
$GROUP_RECORDS
EOF

# License checks are skipped for CE/no-license installations and evaluated for EE output only.
LIC_RAW=$($GITLAB_RAKE gitlab:license:info 2>&1)
LIC_RC=$?
if [ "$LIC_RC" -ne 0 ]; then
    LIC_MODE="unavailable"
    LIC_ERROR=$(first_line "$LIC_RAW")
    [ -n "$LIC_ERROR" ] || LIC_ERROR="gitlab-rake gitlab:license:info exited with ${LIC_RC}"
    [ "$STATE_CODE" -eq 0 ] && STATE_CODE=3
    MSG="${MSG}${MSG:+; }GitLab license info unavailable: ${LIC_ERROR}"
    LIC_CONTEXT="unavailable: ${LIC_ERROR}"
elif printf '%s\n' "$LIC_RAW" | $AWK '/No license has been applied/ {found=1} END{exit found ? 0 : 1}'; then
    LIC_MODE="none"
    LIC_CONTEXT="no license applied"
else
    LIC_MODE="ee"
    LIC_CONTEXT="EE license detected"
fi

if [ "$LIC_MODE" = "ee" ]; then
    CURR=$(printf '%s\n' "$LIC_RAW" | $AWK -F': *' '/Current User Count/ {print $2}')
    MAX=$(printf '%s\n' "$LIC_RAW"  | $AWK -F': *' '/Max Users in License/ {print $2}')
    EXP=$(printf '%s\n' "$LIC_RAW" | $AWK -F': *' '/License valid until/ {print $2}')

    # Expiry drives WARNING when the configured lead time is reached.
    if [ -n "$EXP" ]; then
        NOW=$($DATE +%s)
        EXP_S=$($DATE -d "$EXP" +%s 2>/dev/null || printf '0')
        if [ "$EXP_S" -gt 0 ]; then
            DLEFT=$(( (EXP_S - NOW) / 86400 ))
            if [ "$DLEFT" -le 0 ]; then
                [ $STATE_CODE -lt 1 ] && STATE_CODE=1
                MSG="${MSG}${MSG:+; }GitLab license expired"
                LIC_CONTEXT="${LIC_CONTEXT}; expired"
            elif [ "$DLEFT" -le "$LIC_WARN_DAYS" ]; then
                [ $STATE_CODE -lt 1 ] && STATE_CODE=1
                MSG="${MSG}${MSG:+; }GitLab license expires in ${DLEFT}d"
                LIC_CONTEXT="${LIC_CONTEXT}; expires in ${DLEFT}d"
            else
                LIC_CONTEXT="${LIC_CONTEXT}; expires in ${DLEFT}d"
            fi
        fi
    fi

    # User overage becomes CRITICAL only when it is materially above the license cap.
    case "$CURR:$MAX" in
        *[!0-9:]*|:*) CURR=""; MAX="" ;;
    esac
    if [ -n "$CURR" ] && [ -n "$MAX" ] && [ "$MAX" -gt 0 ]; then
        PERF="${PERF} active_users=${CURR};;;0 user_limit=${MAX};;;0"
        LIC_CONTEXT="${LIC_CONTEXT}; users ${CURR}/${MAX}"
        OVER=$(( CURR - MAX ))
        if [ "$OVER" -gt 0 ]; then
            PCT=$(( OVER * 100 / MAX ))
            if [ "$PCT" -gt 10 ]; then STATE_CODE=2; else [ $STATE_CODE -lt 1 ] && STATE_CODE=1; fi
            MSG="${MSG}${MSG:+; }GitLab license user limit exceeded by ${OVER} user(s)"
            PERF="${PERF} overage=${OVER};;;0"
        fi
    fi
fi

# Long output explains the independent GitLab checks without flooding operators with every group metric.
append_long "Version check: ${VERSION_CONTEXT}"
append_long "License: ${LIC_CONTEXT}"
append_long "Group storage: ${GROUP_COUNT} group(s), total ${GROUP_STORAGE_TOTAL_MB} MB"
[ -n "$GROUP_STORAGE_MAX_NAME" ] && append_long "Largest group storage: ${GROUP_STORAGE_MAX_NAME} (${GROUP_STORAGE_MAX_MB} MB)"
append_long "Interpretation:"
append_long "Omnibus service state, Rails version-check result, and EE license availability, expiry, or user overage can affect the exit code."
append_long "Group storage is emitted as perfdata for capacity trending and does not change severity by itself. Inspect stopped services, pending security updates, or license findings first when the summary names them."

# Finalize the short output; perfdata is optional because CE may have no group/license counters.
[ -z "$MSG" ] && MSG="GitLab is running"
PERF=${PERF# }

# Emit one monitoring line and sanitize GitLab-provided text before perfdata.
emit_check "$MSG" "$PERF"
exit "$STATE_CODE"
