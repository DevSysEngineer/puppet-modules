#!/bin/sh
# Managed by puppet

<%= scope.function_template(['basic_settings/monitoring/_output']) %>

# Fail helper
die() {
    monitor_error 'MySQL check cannot run: ' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
MYSQLADMIN=$(command -v mysqladmin 2>/dev/null) || die "mysqladmin not available"

# Preserve an existing Debian maintenance file; other installations use the client's native defaults.
DEFAULTS_FILE=${DEFAULTS_FILE:-""}
if [ -z "$DEFAULTS_FILE" ] && [ -r /etc/mysql/debian.cnf ]; then
    DEFAULTS_FILE=/etc/mysql/debian.cnf
fi

# Connection and cache thresholds stay local because this check manages one MySQL endpoint.
WARN_CONN_CURR_PCT=${WARN_CONN_CURR_PCT:-90} # WARNING when current connections >= 90%
CRIT_CONN_CURR_PCT=${CRIT_CONN_CURR_PCT:-95} # CRITICAL at 95%
WARN_CONN_PEAK_PCT=${WARN_CONN_PEAK_PCT:-90} # WARNING when historical peak >= 90%
CRIT_CONN_PEAK_PCT=${CRIT_CONN_PEAK_PCT:-95} # CRITICAL at 95%
WARN_HIT_PCT=${WARN_HIT_PCT:-95} # WARNING when buffer hit < 95%
CRIT_HIT_PCT=${CRIT_HIT_PCT:-90} # CRITICAL when buffer hit < 90%

# Runtime state collects the worst status and human-readable causes.
LONG_OUTPUT=""
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
STATE_CODE=0
ISSUES=""

# CLI options select the credentials file, percentage thresholds and diagnostic limit.
USAGE_TEXT="Usage: $0 [-c <config_file>] [-l chars] [-w current_warning_percent] [-W current_critical_percent] [-p peak_warning_percent] [-P peak_critical_percent] [-b hit_warning_percent] [-B hit_critical_percent]
Environment: DEFAULTS_FILE (-c; existing Debian maintenance file or native client defaults); DETAIL_LIMIT (-l); WARN_CONN_CURR_PCT (-w); CRIT_CONN_CURR_PCT (-W); WARN_CONN_PEAK_PCT (-p); CRIT_CONN_PEAK_PCT (-P); WARN_HIT_PCT (-b); CRIT_HIT_PCT (-B).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ":c:l:w:W:p:P:b:B:h" opt; do
    case "$opt" in
        c) DEFAULTS_FILE="$OPTARG" ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        w) WARN_CONN_CURR_PCT=$OPTARG ;;
        W) CRIT_CONN_CURR_PCT=$OPTARG ;;
        p) WARN_CONN_PEAK_PCT=$OPTARG ;;
        P) CRIT_CONN_PEAK_PCT=$OPTARG ;;
        b) WARN_HIT_PCT=$OPTARG ;;
        B) CRIT_HIT_PCT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"
for threshold_value in "$WARN_CONN_CURR_PCT" "$CRIT_CONN_CURR_PCT" "$WARN_CONN_PEAK_PCT" "$CRIT_CONN_PEAK_PCT" "$WARN_HIT_PCT" "$CRIT_HIT_PCT"; do
    case "$threshold_value" in
        [0123456789]|[123456789][0123456789]|100) ;;
        *) die "thresholds must be integer percentages between 0 and 100 without leading zeroes" ;;
    esac
done
[ "$WARN_CONN_CURR_PCT" -le "$CRIT_CONN_CURR_PCT" ] || die "critical current connection threshold must be at least warning"
[ "$WARN_CONN_PEAK_PCT" -le "$CRIT_CONN_PEAK_PCT" ] || die "critical peak connection threshold must be at least warning"
[ "$CRIT_HIT_PCT" -le "$WARN_HIT_PCT" ] || die "critical cache hit threshold must not exceed warning"
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

# Emit a direct CRITICAL result and stop immediately.
crit() {
    monitor_error 'MySQL ' "$*"
    exit 2
}

# Append one direct cause to the summary without exposing Nagios state labels.
add_issue() {
    if [ -n "$ISSUES" ]; then
        ISSUES="${ISSUES}; $1"
    else
        ISSUES=$1
    fi
}

# Keep unavailable counters distinct from an observed zero.
parse_to_int() {
    case "$1" in
        ''|*[!0-9]*) printf '%s\n' U ;;
        *)           printf '%s\n' "$1" ;;
    esac
}

# Extract one mysqladmin field by name from a pipe table.
get_field() {
    NEEDLE="$1"
    INPUT="$2"
    printf '%s\n' "$INPUT" | $AWK -F'|' -v n="$NEEDLE" '
    {
        gsub(/^ +| +$/, "", $2)  # trim column
        gsub(/^ +| +$/, "", $3)  # trim value
        if (toupper($2)==toupper(n)) { print $3; exit }
    }'
}

# Read one extended-status field from the cached output.
sf()  { get_field "$1" "$STATUS_OUT"; }

# Read one variables field from the cached output.
var() { get_field "$1" "$VAR_OUT"; }

# Explicit credentials must be readable. Without a selected file mysqladmin resolves its own defaults.
set --
if [ -n "$DEFAULTS_FILE" ]; then
    [ -r "$DEFAULTS_FILE" ] || die "defaults-file $DEFAULTS_FILE not readable"
    set -- "--defaults-file=$DEFAULTS_FILE"
fi

<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
check_systemd_service mysql.service
if ! use_systemd; then
<% end -%>
    PS=$(command -v ps 2>/dev/null) || die "ps not available"
    PROCESS_NAMES=$($PS -e -o stat= -o comm= 2>/dev/null) || die "process inspection unavailable"
    printf '%s\n' "$PROCESS_NAMES" | $AWK '
        $1 !~ /^Z/ && ($2 == "mysqld" || $2 == "mariadbd") { found=1 }
        END { exit !found }
    ' || crit "service is not active"
    SERVICE_CONTEXT="Database daemon process is active."
<% if @systemd_enable != false -%>
fi
<% end -%>

# mysqladmin ping confirms the daemon is accepting local administrative connections.
$MYSQLADMIN "$@" ping >/dev/null 2>/dev/null || crit "service running but not responding"

# Cache status and variables from one point in time so derived metrics are internally consistent.
STATUS_OUT=$($MYSQLADMIN "$@" extended-status 2>/dev/null) || die "Cannot read extended-status"
VAR_OUT=$($MYSQLADMIN "$@" variables 2>/dev/null) || die "Cannot read variables"

# Pull only the counters used for status and perfdata; optional engine counters can be unavailable.
THREADS_CONNECTED=$(parse_to_int "$(sf Threads_connected)")
THREADS_RUNNING=$(parse_to_int "$(sf Threads_running)")
SLOW_QUERIES=$(parse_to_int "$(sf Slow_queries)")
MAX_USED_CONN=$(parse_to_int "$(sf Max_used_connections)")
MAX_CONNECTIONS=$(parse_to_int "$(var max_connections)")
UPTIME=$(parse_to_int "$(sf Uptime)")
BUF_READ_REQ=$(parse_to_int "$(sf Innodb_buffer_pool_read_requests)")
BUF_READS=$(parse_to_int "$(sf Innodb_buffer_pool_reads)")
BUF_WAIT_FREE=$(parse_to_int "$(sf Innodb_buffer_pool_wait_free)")
BUF_PAGES_FREE=$(parse_to_int "$(sf Innodb_buffer_pool_pages_free)")
BUF_PAGES_TOTAL=$(parse_to_int "$(sf Innodb_buffer_pool_pages_total)")

# These server-wide fields are required to assess connection pressure and slow queries.
for value in "$THREADS_CONNECTED" "$MAX_USED_CONN" "$MAX_CONNECTIONS" "$SLOW_QUERIES"; do
    [ "$value" != U ] || die "required server status fields unavailable"
done

# Buffer-pool hit rate is computed only when read requests exist.
if [ "$BUF_READ_REQ" != U ] && [ "$BUF_READS" != U ] && [ "$BUF_READ_REQ" -gt 0 ]; then
    HIT_RATE_PCT=$($AWK -v reads="$BUF_READS" -v requests="$BUF_READ_REQ" 'BEGIN { printf "%.1f", (1 - (reads / requests)) * 100 }')
else
    HIT_RATE_PCT="N/A"
fi

# Connection thresholds are percentages, but perfdata needs the equivalent absolute limits.
if [ "$MAX_CONNECTIONS" -gt 0 ]; then
    CONN_PCT=$((THREADS_CONNECTED * 100 / MAX_CONNECTIONS))
    if [ "$CONN_PCT" -ge "$CRIT_CONN_CURR_PCT" ]; then
        STATE_CODE=2
        add_issue "connection usage ${CONN_PCT}% (${THREADS_CONNECTED}/${MAX_CONNECTIONS})"
    elif [ "$CONN_PCT" -ge "$WARN_CONN_CURR_PCT" ]; then
        STATE_CODE=1
        add_issue "connection usage ${CONN_PCT}% (${THREADS_CONNECTED}/${MAX_CONNECTIONS})"
    fi

    PEAK_PCT=$((MAX_USED_CONN * 100 / MAX_CONNECTIONS))
    if [ "$PEAK_PCT" -ge "$CRIT_CONN_PEAK_PCT" ]; then
        STATE_CODE=2
        add_issue "historical connection peak ${PEAK_PCT}% (${MAX_USED_CONN}/${MAX_CONNECTIONS})"
    elif [ "$PEAK_PCT" -ge "$WARN_CONN_PEAK_PCT" ]; then
        [ $STATE_CODE -lt 2 ] && STATE_CODE=1
        add_issue "historical connection peak ${PEAK_PCT}% (${MAX_USED_CONN}/${MAX_CONNECTIONS})"
    fi

    WARN_CURR_ABS=$((MAX_CONNECTIONS * WARN_CONN_CURR_PCT / 100))
    CRIT_CURR_ABS=$((MAX_CONNECTIONS * CRIT_CONN_CURR_PCT / 100))
    WARN_PEAK_ABS=$((MAX_CONNECTIONS * WARN_CONN_PEAK_PCT / 100))
    CRIT_PEAK_ABS=$((MAX_CONNECTIONS * CRIT_CONN_PEAK_PCT / 100))
else
    STATE_CODE=3
    add_issue "max_connections is zero"
    WARN_CURR_ABS=""
    CRIT_CURR_ABS=""
    WARN_PEAK_ABS=""
    CRIT_PEAK_ABS=""
fi

# Low buffer hit rate is a cache-efficiency signal; missing data is kept out of status.
if [ "$HIT_RATE_PCT" != "N/A" ]; then
    HIT_RATE_TEXT="${HIT_RATE_PCT}%"
    INT_HIT=${HIT_RATE_PCT%.*}
    if [ "$INT_HIT" -lt "$CRIT_HIT_PCT" ]; then
        STATE_CODE=2
        add_issue "buffer hit rate ${HIT_RATE_PCT}%"
    elif [ "$INT_HIT" -lt "$WARN_HIT_PCT" ]; then
        [ $STATE_CODE -lt 2 ] && STATE_CODE=1
        add_issue "buffer hit rate ${HIT_RATE_PCT}%"
    fi
    WARN_HIT_RANGE="${WARN_HIT_PCT}:"
    CRIT_HIT_RANGE="${CRIT_HIT_PCT}:"
    HIT_RATE_METRIC="${HIT_RATE_PCT}%"
else
    WARN_HIT_RANGE=""
    CRIT_HIT_RANGE=""
    HIT_RATE_METRIC=U
    HIT_RATE_TEXT="unavailable"
    [ "$BUF_READ_REQ" != 0 ] || HIT_RATE_TEXT="not applicable: no read requests"
fi

# Buffer wait events indicate pressure even when the hit-rate threshold has not fired.
if [ "$BUF_WAIT_FREE" != U ] && [ "$BUF_WAIT_FREE" -gt 0 ]; then
    [ $STATE_CODE -lt 2 ] && STATE_CODE=1
    add_issue "InnoDB wait events ${BUF_WAIT_FREE}"
fi

# Slow-query count is cumulative and therefore only raises WARNING.
if [ "$SLOW_QUERIES" -gt 0 ]; then
    [ $STATE_CODE -lt 2 ] && STATE_CODE=1
    add_issue "slow queries ${SLOW_QUERIES}"
fi

# Keep the summary cause-oriented; counters are emitted as perfdata.
OUTPUT_MSG="MySQL is responding"
[ -n "$ISSUES" ] && OUTPUT_MSG="${OUTPUT_MSG}; ${ISSUES}"

# Long output explains the summary with the observed MySQL state and separates status inputs from supporting counters.
monitor_section "Service"
monitor_item "$SERVICE_CONTEXT"
monitor_section "Connections"
monitor_item "Current: ${THREADS_CONNECTED} / ${MAX_CONNECTIONS}"
monitor_item "Historical peak: ${MAX_USED_CONN} / ${MAX_CONNECTIONS}"
monitor_item "Running threads: $(monitor_value "$THREADS_RUNNING")"
monitor_item "Current thresholds: warning ${WARN_CONN_CURR_PCT}%, critical ${CRIT_CONN_CURR_PCT}%"
monitor_item "Historical peak thresholds: warning ${WARN_CONN_PEAK_PCT}%, critical ${CRIT_CONN_PEAK_PCT}%"
monitor_section "InnoDB buffer pool"
monitor_item "Hit rate: ${HIT_RATE_TEXT}"
monitor_item "Hit-rate thresholds: warning below ${WARN_HIT_PCT}%, critical below ${CRIT_HIT_PCT}%"
monitor_item "Free pages: $(monitor_value "$BUF_PAGES_FREE") / $(monitor_value "$BUF_PAGES_TOTAL")"
monitor_item "Wait events: $(monitor_value "$BUF_WAIT_FREE")"
monitor_section "Workload"
monitor_item "Uptime: $(monitor_value "$UPTIME" ' s')"
monitor_item "Slow queries: ${SLOW_QUERIES}"
monitor_limit "$DETAIL_LIMIT"
monitor_section "Interpretation"
monitor_item "Current connections and the historical peak are evaluated separately."
monitor_item "Slow-query and InnoDB wait counts are cumulative."
monitor_item "Missing optional counters do not indicate zero; hit rate requires read requests."

# Perfdata labels are unit-free; low-water hit-rate thresholds use Nagios range syntax.
PERF="curr_connections=${THREADS_CONNECTED};${WARN_CURR_ABS};${CRIT_CURR_ABS};0;${MAX_CONNECTIONS}"
PERF="${PERF} max_used_connections=${MAX_USED_CONN};${WARN_PEAK_ABS};${CRIT_PEAK_ABS};0;${MAX_CONNECTIONS}"
PERF="${PERF} threads_running=${THREADS_RUNNING};;;0"
PERF="${PERF} slow_queries=${SLOW_QUERIES}c"
PERF="${PERF} hit_rate=${HIT_RATE_METRIC};${WARN_HIT_RANGE};${CRIT_HIT_RANGE};0;100"
BUF_PAGES_MAX=$BUF_PAGES_TOTAL
[ "$BUF_PAGES_MAX" != U ] || BUF_PAGES_MAX=""
PERF="${PERF} innodb_pages_free=${BUF_PAGES_FREE};;;0;${BUF_PAGES_MAX}"

# Emit one monitoring line; the summary and long output are sanitized so dynamic MySQL text cannot add perfdata separators.
if [ -n "$ISSUES" ]; then
    monitor_prepend 'MySQL findings' "$ISSUES" 'Check connection pressure, the processlist, buffer-pool sizing and the slow query log.'
fi
monitor_result "$OUTPUT_MSG" "$PERF"
exit $STATE_CODE
