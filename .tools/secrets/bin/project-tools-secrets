#!/usr/bin/env ruby
# frozen_string_literal: true

# Ruby debug mode prints rescued parser exceptions, which can contain source text.
$DEBUG = false

begin
  require 'project_tools/secrets'
  exit ProjectTools::Secrets.run(ARGV)
rescue LoadError, SyntaxError, StandardError, SystemStackError
  warn 'Sensitive data scan: execution_failed; incomplete; no content released.'
  exit 2
end
