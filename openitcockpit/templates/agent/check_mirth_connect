#!/bin/sh
# Managed by puppet

# Fail helper
die() {
    printf 'Mirth Connect check cannot run: %s\n' "$*"
    exit 3
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk not available"
DATE=$(command -v date 2>/dev/null) || die "date not available"
MKTEMP=$(command -v mktemp 2>/dev/null) || die "mktemp not available"
MKDIR=$(command -v mkdir 2>/dev/null) || die "mkdir not available"
SED=$(command -v sed 2>/dev/null) || die "sed not available"
TR=$(command -v tr 2>/dev/null) || die "tr not available"
RM=$(command -v rm 2>/dev/null) || die "rm not available"
MV=$(command -v mv 2>/dev/null) || die "mv not available"
# Connection and CLI paths are local to the Mirth installation.
CONFIG=${CONFIG:-"/opt/mirthconnect/conf/mirth-cli-config.properties"}
MCCOMMAND="/usr/local/bin/mccommand"
NOW=$($DATE +%s)

# Queue thresholds and grace period preserve the existing warning-before-critical behavior.
CRIT_Q=${CRIT_Q:-30}
DETAIL_LIMIT=${DETAIL_LIMIT:-6000}
GRACE=${GRACE:-600} # seconds before CRITICAL for queues
SUMMARY_ITEM_LIMIT=${SUMMARY_ITEM_LIMIT:-10}
WARN_Q=${WARN_Q:-25} # queued-message threshold

# Queue and status state accumulates direct causes for the summary.
QUEUE_CRIT=0
QUEUE_ISSUES=0
QUEUE_SHOWN=0
MAX_Q=0
STATUS_ISSUES=0
STATUS_UNKNOWN=0
STATUS_SHOWN=0
SUMMARY_QUEUE=""
SUMMARY_STATUS=""
LONG_OUTPUT=""
LONG_OUTPUT_SEP="__CHECK_MIRTH_CONNECT_NL__"

# Persistent queue state tracks how long channels have been above the warning threshold.
STATE_DIR="/etc/openitcockpit-agent/state"
STATE_FILE="${STATE_DIR}/mirth_queue_state.txt"

# CLI options select connection config, queue thresholds, grace and output limits.
USAGE_TEXT="Usage: $0 [-c <config_file>] [-t <seconds>] [-w <queue>] [-C queue_critical] [-l chars] [-s items]
Environment: CONFIG (-c); GRACE (-t); WARN_Q (-w); CRIT_Q (-C); DETAIL_LIMIT (-l); SUMMARY_ITEM_LIMIT (-s).
Command-line options override non-empty environment values; unset or empty environment values use defaults."
OPTERR=0
while getopts ':c:t:w:C:l:s:h' opt; do
    case "$opt" in
        c) CONFIG="$OPTARG" ;;
        t) GRACE="$OPTARG" ;;
        w) WARN_Q="$OPTARG" ;;
        C) CRIT_Q=$OPTARG ;;
        l) DETAIL_LIMIT=$OPTARG ;;
        s) SUMMARY_ITEM_LIMIT=$OPTARG ;;
        *) die "$USAGE_TEXT" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || die "$USAGE_TEXT"

case "$GRACE" in
    ''|*[!0-9]*) die "queue grace must be numeric" ;;
esac
case "$WARN_Q" in
    ''|*[!0-9]*) die "queue warning threshold must be numeric" ;;
esac
case "$CRIT_Q" in
    ''|*[!0-9]*) die "queue critical threshold must be numeric" ;;
esac
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "long-output detail character limit must be numeric" ;;
esac
case "$SUMMARY_ITEM_LIMIT" in
    ''|*[!0-9]*) die "summary item limit must be numeric" ;;
esac
[ "$SUMMARY_ITEM_LIMIT" -ge 1 ] || die "summary item limit must be at least 1"
[ "$CRIT_Q" -ge "$WARN_Q" ] || die "queue critical threshold must be greater than or equal to warning threshold"
[ "$DETAIL_LIMIT" -ge 1 ] || die "long-output detail character limit must be at least 1"

[ -x "$MCCOMMAND" ] || die "mccommand not available at ${MCCOMMAND}"
[ -r "$CONFIG" ] || die "config file ${CONFIG} is not readable"

# Keep monitoring text safe before and after the real perfdata delimiter.
monitor_text_value() {
    printf '%s\n' "$1" | $SED 's/|/[or]/g'
}

# Strip carriage returns, terminal escape sequences, and non-printable bytes before the CLI text is parsed or rendered.
strip_terminal_control() {
    $TR -d '\r' | $AWK '{ gsub(/\033\[[0-9;]*[A-Za-z]/, ""); print }' | $TR -cd '\11\12\40-\176'
}

# Append one line to the long output buffer.
append_long() {
    if [ -z "$LONG_OUTPUT" ]; then
        LONG_OUTPUT=$1
    else
        LONG_OUTPUT="${LONG_OUTPUT}${LONG_OUTPUT_SEP}$1"
    fi
}

# Bound diagnostic details before adding Interpretation so final operator guidance stays visible in monitoring UIs.
limit_long_output_details() {
    [ -n "$LONG_OUTPUT" ] || return

    LONG_OUTPUT=$(
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" -v max="$DETAIL_LIMIT" '
            function emit(line) {
                printf "%s%s", (printed ? sep : ""), line
                printed = 1
            }
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    line = lines[i]
                    line_len = length(line)
                    separator_len = printed ? 1 : 0
                    if (used + separator_len + line_len <= max) {
                        emit(line)
                        used += separator_len + line_len
                        continue
                    }
                    remaining = max - used - separator_len
                    if (remaining > 0) {
                        emit(substr(line, 1, remaining) "... [detail truncated]")
                    }
                    emit("Long output details truncated after " max " characters to keep Interpretation visible.")
                    exit
                }
            }
        '
    )
}

# Emit one monitoring line; perfdata is attached by the caller when available.
emit_check() {
    if [ -n "${2:-}" ]; then
        printf '%s | %s\n' "$(monitor_text_value "$1")" "$2"
    else
        printf '%s\n' "$(monitor_text_value "$1")"
    fi
    if [ -n "$LONG_OUTPUT" ]; then
        $AWK -v data="$LONG_OUTPUT" -v sep="$LONG_OUTPUT_SEP" '
            BEGIN {
                count = split(data, lines, sep)
                for (i = 1; i <= count; i++) {
                    gsub(/[|]/, "[or]", lines[i])
                    print lines[i]
                }
            }
        '
    fi
}

# Emit a CRITICAL result and stop immediately.
crit() {
    emit_check "Mirth Connect $1" "${2:-}"
    exit 2
}

# Inspect the conventional service when systemd manages it, alongside native channel health.
<% if @systemd_enable != false -%>
<%= scope.function_template(['basic_settings/monitoring/_systemd_service_status']) %>
check_systemd_service mcservice.service
if ! use_systemd; then
<% end -%>
    PS=$(command -v ps 2>/dev/null) || die "ps not available"
    PROCESS_DATA=$($PS -ww -e -o stat= -o comm= -o args= 2>/dev/null) || die "process inspection unavailable"
    # Recognize the server launcher, never an arbitrary JVM or the mccommand client.
    printf '%s\n' "$PROCESS_DATA" | $AWK '
        $1 ~ /^Z/ { next }
        $2 == "mcservice" || $2 == "mcserver" { found=1 }
        $2 == "java" {
            if ($0 ~ /[[:space:]]com\.mirth\.connect\.server\.launcher\.MirthLauncher([[:space:]]|$)/ ||
                $0 ~ /[[:space:]]-jar[[:space:]]+([^[:space:]]*\/)?mirth-launcher\.jar([[:space:]]|$)/) found=1
        }
        END { exit !found }
    ' || crit "service is not active"
    SERVICE_CONTEXT="Mirth Connect server process is active."
<% if @systemd_enable != false -%>
fi
<% end -%>

# Keep the persistent queue state inside the agent tree so root does not read or write a predictable file in /tmp.
OLD_UMASK=$(umask)
umask 077
$MKDIR -p "$STATE_DIR" 2>/dev/null || {
    umask "$OLD_UMASK"
    die "state directory ${STATE_DIR} could not be created"
}
umask "$OLD_UMASK"

# mccommand requires script files, so keep command input, parse artifacts, and persistent state updates private until cleanup.
WORK_UMASK=$(umask)
umask 077
WORK_DIR=$($MKTEMP -d "/tmp/mirthcheck.XXXXXX") || {
    umask "$WORK_UMASK"
    die "mktemp failed"
}
trap '$RM -rf "$WORK_DIR"' EXIT HUP INT QUIT TERM

# Request channel statistics through mccommand because it is the supported local interface.
printf 'channel stats *\n' >"$WORK_DIR/cli_stats.cmd"
OUTPUT_RAW=$($MCCOMMAND -c "$CONFIG" -s "$WORK_DIR/cli_stats.cmd" 2>&1) || die "mccommand stats failed"
[ -n "$OUTPUT_RAW" ] || die "returned empty stats output"

# Normalize terminal control characters before AWK parses channel sections.
OUTPUT_CLEAN=$(printf '%s\n' "$OUTPUT_RAW" | strip_terminal_control)
printf '%s\n' "$OUTPUT_CLEAN" | $AWK '
  function after_colon(s){ sub(/^[^:]+:[[:space:]]*/,"",s); sub(/[[:space:]]+$/, "", s); return s }
  function emit(){
    if (chan!="") {
      if (q !~ /^[0-9]+$/ || recv !~ /^[0-9]+$/ || sent !~ /^[0-9]+$/) { invalid=1; return }
      printf "C|%s|%d|%d|%d\n", chan, q+0, recv+0, sent+0;
      t_recv+=recv+0; t_sent+=sent+0;
    }
    chan=""; q=recv=sent="";
  }
  BEGIN { chan=""; q=recv=sent=""; t_recv=0; t_sent=0 }
  /^Channel Stats for[[:space:]]+/ { emit(); sub(/^Channel Stats for[[:space:]]+/,"",$0); chan=$0; next }
  /^Queued:/   { v=after_colon($0); gsub(",","",v); q=v; next }
  /^Received:/ { v=after_colon($0); gsub(",","",v); recv=v; next }
  /^Sent:/     { v=after_colon($0); gsub(",","",v); sent=v; next }
  END { emit(); if (invalid) exit 1; printf "T|%d|%d\n", t_recv+0, t_sent+0; }
' >"$WORK_DIR/parsed_all.txt" || die "channel statistics incomplete or invalid"

$AWK -F'|' '/^C\|/ {print}' "$WORK_DIR/parsed_all.txt" >"$WORK_DIR/parsed_channels.txt"
$AWK -F'|' '/^T\|/ {print}' "$WORK_DIR/parsed_all.txt" >"$WORK_DIR/parsed_totals.txt"

# Fetch channel status separately because stats output does not reliably expose started/stopped state.
printf 'status\n' >"$WORK_DIR/cli_status.cmd"
STATUS_RAW=$($MCCOMMAND -c "$CONFIG" -s "$WORK_DIR/cli_status.cmd" 2>&1) || die "mccommand status failed"
[ -n "$STATUS_RAW" ] || die "returned empty status output"

# Build a name|status map from the CLI output.
STATUS_CLEAN=$(printf '%s\n' "$STATUS_RAW" | strip_terminal_control)
printf '%s\n' "$STATUS_CLEAN" | $AWK '
  BEGIN{in_tbl=0}
  /^ID[[:space:]]+Status[[:space:]]+Name/ { in_tbl=1; next }
  in_tbl==0 { next }
  NF<3 { next }
  { st=$2; name=""; for(i=3;i<=NF;i++) name=(i==3?$i:name FS $i); print name "|" st }
' >"$WORK_DIR/status_map.txt"

# Determine total channel count and load previous queue-threshold timestamps.
TOTAL_CHANS=$($AWK -F'|' '/^C\|/ {c++} END{print c+0}' "$WORK_DIR/parsed_channels.txt")
[ "$TOTAL_CHANS" -gt 0 ] || die "no channel statistics available; inspection not applicable or incomplete"
STATE_IN="$STATE_FILE"; [ -f "$STATE_IN" ] || STATE_IN=/dev/null

# Evaluate channel state and queue age; queue depth becomes CRITICAL only after the grace window.
while IFS='|' read -r _c chan q recv sent; do
    # Track maximum queue depth for perfdata.
    [ "${q:-0}" -gt "$MAX_Q" ] && MAX_Q="$q"

    # Status names come from the separate map generated from `status` output.
    STATUS=$($AWK -F'|' -v c="$chan" '$1==c{print $2; exit}' "$WORK_DIR/status_map.txt")
    case "$STATUS" in
        [Ss][Tt][Aa][Rr][Tt][Ee][Dd]*) : ;;
        ''|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]) STATUS_UNKNOWN=$((STATUS_UNKNOWN+1)) ;;
        *)
            STATUS_ISSUES=$((STATUS_ISSUES+1))
            if [ "$STATUS_SHOWN" -lt "$SUMMARY_ITEM_LIMIT" ]; then
                SUMMARY_STATUS="${SUMMARY_STATUS}${SUMMARY_STATUS:+, }${chan}(${STATUS:-Unknown})"
                STATUS_SHOWN=$((STATUS_SHOWN + 1))
            fi
            ;;
    esac

    if [ "${q:-0}" -ge "$CRIT_Q" ]; then
        FIRST=$($AWK -F'|' -v c="$chan" '$1==c{print $2; exit}' "$STATE_IN")
        [ -z "$FIRST" ] && FIRST=$NOW
        printf '%s|%s\n' "$chan" "$FIRST" >>"$WORK_DIR/new_state"

        # The timestamp state prevents short transient critical queues from paging immediately.
        [ "$((NOW - FIRST))" -ge "$GRACE" ] && QUEUE_CRIT=1

        # Keep the visible queue list cause-oriented for the summary.
        QUEUE_ISSUES=$((QUEUE_ISSUES+1))
        if [ "$QUEUE_SHOWN" -lt "$SUMMARY_ITEM_LIMIT" ]; then
            SUMMARY_QUEUE="${SUMMARY_QUEUE}${SUMMARY_QUEUE:+, }${chan}(${q})"
            QUEUE_SHOWN=$((QUEUE_SHOWN + 1))
        fi
    elif [ "${q:-0}" -gt "$WARN_Q" ]; then
        QUEUE_ISSUES=$((QUEUE_ISSUES+1))
        if [ "$QUEUE_SHOWN" -lt "$SUMMARY_ITEM_LIMIT" ]; then
            SUMMARY_QUEUE="${SUMMARY_QUEUE}${SUMMARY_QUEUE:+, }${chan}(${q})"
            QUEUE_SHOWN=$((QUEUE_SHOWN + 1))
        fi
    fi
done <"$WORK_DIR/parsed_channels.txt"

# Persist only channels still above the warning threshold; stale state is removed.
if [ -f "$WORK_DIR/new_state" ]; then
    $MV "$WORK_DIR/new_state" "$STATE_FILE" 2>/dev/null || die "queue state file ${STATE_FILE} could not be updated"
else
    if [ -f "$STATE_FILE" ]; then
        $RM -f "$STATE_FILE" 2>/dev/null || die "queue state file ${STATE_FILE} could not be removed"
    fi
fi
umask "$WORK_UMASK"

# Make list truncation explicit in bounded channel lists without hiding the issue count.
QUEUE_MORE=$((QUEUE_ISSUES - QUEUE_SHOWN))
STATUS_MORE=$((STATUS_ISSUES - STATUS_SHOWN))
[ "$QUEUE_MORE" -gt 0 ] && SUMMARY_QUEUE="${SUMMARY_QUEUE}${SUMMARY_QUEUE:+, }+${QUEUE_MORE} more"
[ "$STATUS_MORE" -gt 0 ] && SUMMARY_STATUS="${SUMMARY_STATUS}${SUMMARY_STATUS:+, }+${STATUS_MORE} more"

# Perfdata exposes channel count, maximum queue depth, and status issue count.
PERF_DATA="channels=${TOTAL_CHANS};;;0 queue=${MAX_Q};${WARN_Q};${CRIT_Q};0 issues=${STATUS_ISSUES};;1;0"
if IFS='|' read -r _t tot_recv tot_sent <"$WORK_DIR/parsed_totals.txt"; then
    PERF_DATA="$PERF_DATA total_received=${tot_recv}c total_sent=${tot_sent}c"
fi

# Long output keeps channel names bounded while preserving the direct cause in the short output.
append_long "$SERVICE_CONTEXT"
append_long "Channels checked: ${TOTAL_CHANS}"
[ "$STATUS_ISSUES" -gt 0 ] && append_long "Channels not running: ${SUMMARY_STATUS}"
[ "$STATUS_UNKNOWN" -eq 0 ] || append_long "Channel state unavailable for ${STATUS_UNKNOWN} channel(s)."
[ "$QUEUE_ISSUES" -gt 0 ] && append_long "Channels with queued messages: ${SUMMARY_QUEUE}"
limit_long_output_details
append_long ""
append_long "Interpretation:"
append_long "Channel started/stopped state and queued-message age decide the exit code; received/sent totals and maximum queue depth are supporting metrics."
append_long "Queued channels affect the exit code only after they stay elevated for the configured grace window. Inspect the listed channel status or queue in Mirth Connect before restarting services."

# Status issues take precedence over aged queue warnings in the final state.
if [ "$STATUS_ISSUES" -gt 0 ]; then
    STATUS_PRIMARY=${SUMMARY_STATUS%%, *}
    crit "${STATUS_ISSUES} channel(s) not running${STATUS_PRIMARY:+: $STATUS_PRIMARY}" "$PERF_DATA"
elif [ "$QUEUE_CRIT" -eq 1 ]; then
    QUEUE_PRIMARY=${SUMMARY_QUEUE%%, *}
    crit "${QUEUE_ISSUES} channel(s) queue stayed high${QUEUE_PRIMARY:+: $QUEUE_PRIMARY}" "$PERF_DATA"
elif [ "$STATUS_UNKNOWN" -gt 0 ]; then
    emit_check "Mirth Connect channel status inspection incomplete" "$PERF_DATA"
    exit 3
elif [ "$QUEUE_ISSUES" -gt 0 ]; then
    QUEUE_PRIMARY=${SUMMARY_QUEUE%%, *}
    emit_check "Mirth Connect ${QUEUE_ISSUES} channel(s) have queued messages${QUEUE_PRIMARY:+: $QUEUE_PRIMARY}" "$PERF_DATA"
    exit 1
fi

emit_check "Mirth Connect ${TOTAL_CHANS} channel(s) running as expected" "$PERF_DATA"
exit 0
