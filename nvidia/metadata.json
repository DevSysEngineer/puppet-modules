{
    "name": "puppetmodules-nvidia",
    "version": "3.0.0",
    "author": "DevSysEngineer",
    "summary": "Pinned open headless NVIDIA drivers for Ubuntu 24.04 ARM64",
    "license": "Apache-2.0",
    "source": "https://github.com/DevSysEngineer/puppet-modules/tree/main/nvidia",
    "project_page": "https://github.com/DevSysEngineer/puppet-modules",
