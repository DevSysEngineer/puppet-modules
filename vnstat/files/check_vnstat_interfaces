#!/bin/sh
# Managed by puppet

# Failure and long-output text may contain regexes or command output with pipes.
# Sanitize those values so Nagios does not parse them as perfdata separators.
monitor_text_value() {
    _monitor_text=$1
    while :; do
        case "$_monitor_text" in
            *'|'*)
                printf '%s[or]' "${_monitor_text%%|*}"
                _monitor_text=${_monitor_text#*|}
                ;;
            *)
                printf '%s' "$_monitor_text"
                return
                ;;
        esac
    done
}

# Fail helper
die() {
    printf 'vnStat check cannot run: %s\n' "$(monitor_text_value "$*")"
    exit 3
}

# Options that take values fail early so later validation never sees shifted arguments.
need_arg() {
    [ "$#" -ge 2 ] || die "missing value for $1"
}

# Binary checks
AWK=$(command -v awk 2>/dev/null) || die "awk command not found"
DATE=$(command -v date 2>/dev/null) || die "date command not found"
GREP=$(command -v grep 2>/dev/null) || die "grep command not found"
JQ=$(command -v jq 2>/dev/null) || die "jq command not found"
SED=$(command -v sed 2>/dev/null) || die "sed command not found"
TR=$(command -v tr 2>/dev/null) || die "tr command not found"
VNSTAT=$(command -v vnstat 2>/dev/null) || die "vnStat command not found"

# Nagios states
STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

# Thresholds, filters, and config paths are kept together because capacity policy is resolved in one pass.
DEFAULT_EXCLUDE_REGEX='^lo$|^docker.*|^veth.*|^br-.*|^virbr.*|^tun.*|^tap.*|^wg.*'
CHECK_CONFIG='/etc/vnstat-monitoring.conf'
VNSTAT_CONFIG='/etc/vnstat.conf'
INCLUDE_REGEX=''
EXCLUDE_REGEX=$DEFAULT_EXCLUDE_REGEX
CAPACITY_WARNING_PERCENT='80'
CAPACITY_CRITICAL_PERCENT='90'
GROWTH_DAY_WARNING_PERCENT='25'
GROWTH_DAY_CRITICAL_PERCENT='50'
GROWTH_MONTH_WARNING_PERCENT='25'
GROWTH_MONTH_CRITICAL_PERCENT='50'
LAST_UPDATE_WARNING_SECONDS='900'
LAST_UPDATE_CRITICAL_SECONDS='1800'
DETAIL_LIMIT='20'

# Runtime state collected while all interfaces are evaluated.
CHECK_CONFIG_AVAILABLE=0
CHECKED_COUNT=0
CHECKED_INTERFACES=''
CHECKED_SEPARATOR=''
IGNORED_COUNT=0
IGNORED_ITEMS=''
IGNORED_SEPARATOR=''

# Aggregated final state, summary causes and per-status long output.
FINAL_STATE='OK'
CRITICAL_COUNT=0
WARNING_COUNT=0
UNKNOWN_COUNT=0
OK_COUNT=0
NAMES_CRITICAL=''
NAMES_WARNING=''
NAMES_UNKNOWN=''
NAMES_OK=''
LONG_CRITICAL=''
LONG_WARNING=''
LONG_UNKNOWN=''
LONG_OK=''
LONG_DETAIL_COUNT=0
LONG_DETAIL_TRUNCATED=0
SUMMARY_CRITICAL=''
SUMMARY_WARNING=''
SUMMARY_UNKNOWN=''
PERFDATA=''

# Parse options
usage() {
    printf '%s\n' "Usage: $0 [options]"
    printf '%s\n' ''
    printf '%s\n' 'Options:'
    printf '%s\n' '  --check-config <path>                    Defaults to /etc/vnstat-monitoring.conf'
    printf '%s\n' '  --vnstat-config <path>                   Defaults to /etc/vnstat.conf for explicit MaxBandwidth fallback'
    printf '%s\n' '  --include <regex>'
    printf '%s\n' '  --exclude <regex>                         Replaces the built-in default exclude regex'
    printf '%s\n' '  --capacity-warning-percent <number>'
    printf '%s\n' '  --capacity-critical-percent <number>'
    printf '%s\n' '  --growth-day-warning-percent <number>'
    printf '%s\n' '  --growth-day-critical-percent <number>'
    printf '%s\n' '  --growth-month-warning-percent <number>'
    printf '%s\n' '  --growth-month-critical-percent <number>'
    printf '%s\n' '  --last-update-warning-seconds <number>'
    printf '%s\n' '  --last-update-critical-seconds <number>'
    printf '%s\n' '  --detail-limit <interfaces>                 Maximum interface detail blocks in long output, default 20'
    printf '%s\n' '  --help'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check-config)
            need_arg "$1" "$@"
            shift
            CHECK_CONFIG=$1
            ;;
        --vnstat-config)
            need_arg "$1" "$@"
            shift
            VNSTAT_CONFIG=$1
            ;;
        --include)
            need_arg "$1" "$@"
            shift
            INCLUDE_REGEX=$1
            ;;
        --exclude)
            need_arg "$1" "$@"
            shift
            EXCLUDE_REGEX=$1
            ;;
        # Capacity thresholds compare current p95 traffic against the effective interface speed.
        --capacity-warning-percent)
            need_arg "$1" "$@"
            shift
            CAPACITY_WARNING_PERCENT=$1
            ;;
        --capacity-critical-percent)
            need_arg "$1" "$@"
            shift
            CAPACITY_CRITICAL_PERCENT=$1
            ;;
        --growth-day-warning-percent)
            need_arg "$1" "$@"
            shift
            GROWTH_DAY_WARNING_PERCENT=$1
            ;;
        --growth-day-critical-percent)
            need_arg "$1" "$@"
            shift
            GROWTH_DAY_CRITICAL_PERCENT=$1
            ;;
        # Growth thresholds compare current traffic against the previous day or month.
        --growth-month-warning-percent)
            need_arg "$1" "$@"
            shift
            GROWTH_MONTH_WARNING_PERCENT=$1
            ;;
        --growth-month-critical-percent)
            need_arg "$1" "$@"
            shift
            GROWTH_MONTH_CRITICAL_PERCENT=$1
            ;;
        --last-update-warning-seconds)
            need_arg "$1" "$@"
            shift
            LAST_UPDATE_WARNING_SECONDS=$1
            ;;
        --last-update-critical-seconds)
            need_arg "$1" "$@"
            shift
            LAST_UPDATE_CRITICAL_SECONDS=$1
            ;;
        # Detail limit bounds interface blocks in long output while keeping summary and perfdata complete.
        --detail-limit)
            need_arg "$1" "$@"
            shift
            DETAIL_LIMIT=$1
            ;;
        --help)
            usage
            exit "$STATE_OK"
            ;;
        *)
            die "invalid option: $1"
            ;;
    esac
    shift
done

# Read the first diagnostic line from command output.
first_line_value() {
    printf '%s\n' "$1" | $SED -n '1{s/[[:space:]]\+$//;p;q;}'
}

# Numeric validation helpers keep CLI error handling consistent.
is_number() {
    $AWK -v value="$1" 'BEGIN { exit(value ~ /^[0-9]+([.][0-9]+)?$/ ? 0 : 1) }'
}

# Positive thresholds protect capacity values where zero would make every rate invalid.
is_positive_number() {
    $AWK -v value="$1" 'BEGIN { exit(value ~ /^[0-9]+([.][0-9]+)?$/ && value + 0 > 0 ? 0 : 1) }'
}

# Numeric comparison wrappers avoid relying on non-POSIX shell arithmetic for decimals.
ge_number() {
    $AWK -v left="$1" -v right="$2" 'BEGIN { exit(left + 0 >= right + 0 ? 0 : 1) }'
}

# Less-than comparisons are used to validate warning/critical threshold ordering.
lt_number() {
    $AWK -v left="$1" -v right="$2" 'BEGIN { exit(left + 0 < right + 0 ? 0 : 1) }'
}

# Optional numeric settings are allowed to stay unset, but invalid values fail before collection.
validate_number() {
    [ -n "$2" ] || return 0
    is_number "$2" || die "invalid numeric value for $1: $2"
}

# Warning/critical threshold pairs must preserve the usual Nagios escalation order.
validate_pair() {
    if [ -n "$2" ] && [ -n "$3" ] && lt_number "$3" "$2"; then
        die "$1 critical threshold must be greater than or equal to warning threshold"
    fi
}

# Regex validation catches operator input errors before interface filtering starts.
validate_regex() {
    [ -n "$2" ] || return 0
    $GREP -E "$2" /dev/null >/dev/null 2>&1
    [ "$?" -eq 2 ] && die "invalid $1 regex: $2"
}

# Status helpers implement the project severity order for combined checks.
state_rank() {
    case "$1" in
        OK)       printf '%s\n' 0 ;;
        UNKNOWN)  printf '%s\n' 1 ;;
        WARNING)  printf '%s\n' 2 ;;
        CRITICAL) printf '%s\n' 3 ;;
        *)        printf '%s\n' 1 ;;
    esac
}

# Convert the final textual state into the Nagios exit code contract.
state_exit_code() {
    case "$1" in
        OK)       printf '%s\n' "$STATE_OK" ;;
        WARNING)  printf '%s\n' "$STATE_WARNING" ;;
        CRITICAL) printf '%s\n' "$STATE_CRITICAL" ;;
        UNKNOWN)  printf '%s\n' "$STATE_UNKNOWN" ;;
        *)        printf '%s\n' "$STATE_UNKNOWN" ;;
    esac
}

# Translate internal Nagios state names into operator-readable long-output text.
state_detail_text() {
    case "$1" in
        CRITICAL) printf '%s' 'needs immediate attention' ;;
        WARNING)  printf '%s' 'needs attention' ;;
        UNKNOWN)  printf '%s' 'has incomplete data' ;;
        *)        printf '%s' 'healthy' ;;
    esac
}

# Keep the most severe state when multiple interfaces or metrics are evaluated.
max_state() {
    if [ "$(state_rank "$2")" -gt "$(state_rank "$1")" ]; then
        printf '%s\n' "$2"
    else
        printf '%s\n' "$1"
    fi
}

# Compare one metric value against optional warning and critical thresholds.
threshold_status() {
    if [ "$1" = 'U' ] || [ -z "$1" ]; then
        printf '%s\n' 'UNKNOWN'
    elif [ -n "$3" ] && ge_number "$1" "$3"; then
        printf '%s\n' 'CRITICAL'
    elif [ -n "$2" ] && ge_number "$1" "$2"; then
        printf '%s\n' 'WARNING'
    else
        printf '%s\n' 'OK'
    fi
}

# Summary issues are bucketed by severity so the short output stays cause-oriented.
add_summary_issue() {
    _summary_severity=$1
    _summary_issue=$(monitor_text_value "$2")

    # Summary buckets preserve severity ordering while avoiding zero-count status text.
    case "$_summary_severity" in
        CRITICAL)
            if [ -n "$SUMMARY_CRITICAL" ]; then
                SUMMARY_CRITICAL="${SUMMARY_CRITICAL}; ${_summary_issue}"
            else
                SUMMARY_CRITICAL=$_summary_issue
            fi
            ;;
        WARNING)
            if [ -n "$SUMMARY_WARNING" ]; then
                SUMMARY_WARNING="${SUMMARY_WARNING}; ${_summary_issue}"
            else
                SUMMARY_WARNING=$_summary_issue
            fi
            ;;
        UNKNOWN)
            if [ -n "$SUMMARY_UNKNOWN" ]; then
                SUMMARY_UNKNOWN="${SUMMARY_UNKNOWN}; ${_summary_issue}"
            else
                SUMMARY_UNKNOWN=$_summary_issue
            fi
            ;;
    esac
}

# Keep interface long output bounded while preserving the full summary and perfdata.
append_interface_block() {
    _interface_state=$1
    _interface_block=$2

    if [ "$LONG_DETAIL_COUNT" -ge "$DETAIL_LIMIT" ]; then
        LONG_DETAIL_TRUNCATED=$((LONG_DETAIL_TRUNCATED + 1))
        return
    fi

    case "$_interface_state" in
        CRITICAL)
            if [ -n "$LONG_CRITICAL" ]; then LONG_CRITICAL=$(printf '%s\n\n%s' "$LONG_CRITICAL" "$_interface_block"); else LONG_CRITICAL=$_interface_block; fi
            ;;
        WARNING)
            if [ -n "$LONG_WARNING" ]; then LONG_WARNING=$(printf '%s\n\n%s' "$LONG_WARNING" "$_interface_block"); else LONG_WARNING=$_interface_block; fi
            ;;
        UNKNOWN)
            if [ -n "$LONG_UNKNOWN" ]; then LONG_UNKNOWN=$(printf '%s\n\n%s' "$LONG_UNKNOWN" "$_interface_block"); else LONG_UNKNOWN=$_interface_block; fi
            ;;
        *)
            if [ -n "$LONG_OK" ]; then LONG_OK=$(printf '%s\n\n%s' "$LONG_OK" "$_interface_block"); else LONG_OK=$_interface_block; fi
            ;;
    esac

    LONG_DETAIL_COUNT=$((LONG_DETAIL_COUNT + 1))
}

# Nagios metric labels cannot safely contain arbitrary interface characters.
sanitize_label() {
    _label=$(printf '%s' "$1" | $TR '[:upper:]' '[:lower:]' | $SED 's/[^a-z0-9_]/_/g')
    [ -n "$_label" ] || _label=interface
    case "$_label" in
        [a-z]*) printf '%s' "$_label" ;;
        *)      printf 'if_%s' "$_label" ;;
    esac
}

# Format values for human-readable long output; perfdata attaches units through UOM.
format_number() {
    if [ "$1" = 'U' ] || [ -z "$1" ]; then
        printf '%s' 'U'
        return
    fi
    $AWK -v value="$1" 'BEGIN { printf "%.2f", value + 0 }'
}

# Long-output byte formatting is human-friendly; perfdata keeps the raw byte value.
format_bytes() {
    if [ "$1" = 'U' ] || [ -z "$1" ]; then
        printf '%s' 'unavailable'
        return
    fi

    # Long output uses decimal units for operator readability; perfdata keeps raw bytes.
    $AWK -v value="$1" '
        BEGIN {
            split("B KB MB GB TB PB EB", units, " ")
            unit = 1
            while (value >= 1000 && unit < 7) {
                value = value / 1000
                unit++
            }
            if (unit == 1) {
                printf "%.0f %s", value, units[unit]
            } else {
                printf "%.2f %s", value, units[unit]
            }
        }
    '
}

# Bandwidth thresholds use Mbps, while vnStat reports byte counters.
calc_mbit_from_bytes_per_second() {
    if [ "$1" = 'U' ] || [ -z "$1" ]; then
        printf '%s\n' 'U'
        return
    fi
    $AWK -v bytes_per_second="$1" 'BEGIN { printf "%.2f\n", (bytes_per_second * 8) / 1000000 }'
}

# Preserve Nagios U values while appending UOM for numeric perfdata.
perf_value() {
    if [ "$1" = 'U' ] || [ -z "$1" ]; then
        printf '%s' 'U'
    else
        printf '%s%s' "$1" "$2"
    fi
}

# Percentage calculations intentionally return U when the source metric or baseline is unavailable.
calc_percent() {
    if [ "$1" = 'U' ] || [ "$2" = 'U' ] || [ -z "$1" ] || [ -z "$2" ]; then
        printf '%s\n' 'U'
        return
    fi

    # Invalid zero baselines become unavailable instead of dividing by zero.
    $AWK -v value="$1" -v base="$2" 'BEGIN {
        if (base + 0 <= 0) {
            printf "U\n"
        } else {
            printf "%.2f\n", (value / base) * 100
        }
    }'
}

# Growth is a period-over-period percentage and uses U for missing or zero baselines.
calc_growth_percent() {
    if [ "$1" = 'U' ] || [ "$2" = 'U' ] || [ -z "$1" ] || [ -z "$2" ]; then
        printf '%s\n' 'U'
        return
    fi

    # Growth compares current traffic against the previous period in percent.
    $AWK -v current="$1" -v previous="$2" 'BEGIN {
        if (previous + 0 <= 0) {
            printf "U\n"
        } else {
            printf "%.2f\n", ((current - previous) / previous) * 100
        }
    }'
}

# Interface include/exclude filters are regex-based and only match when the pattern exists.
match_regex() {
    [ -n "$2" ] || return 1
    printf '%s\n' "$1" | $GREP -Eq "$2"
}

# Read one effective vnStat configuration value from `vnstat --showconfig`.
showconfig_value() {
    printf '%s\n' "$SHOWCONFIG_TEXT" | $AWK -v key="$1" '
        /^[[:space:]]*($|[#;])/ { next }
        {
            line = $0
            sub(/^[[:space:]]+/, "", line)
            split(line, parts, /[[:space:]]+/)
            if (parts[1] == key) {
                value = line
                sub(/^[^[:space:]]+[[:space:]]*/, "", value)
                sub(/[[:space:]]*[#;].*$/, "", value)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                gsub(/^"|"$/, "", value)
                found = value
            }
        }
        END {
            if (found != "") {
                print found
            }
        }
    '
}

# Read one explicitly configured value from the managed vnStat config file.
config_file_value() {
    [ -n "$VNSTAT_CONFIG" ] || die "vnStat config path must not be empty"
    [ -r "$VNSTAT_CONFIG" ] || return 0

    $AWK -v key="$1" '
        /^[[:space:]]*($|[#;])/ { next }
        {
            line = $0
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]*[#;].*$/, "", line)
            split(line, parts, /[[:space:]]+/)
            if (parts[1] == key) {
                value = line
                sub(/^[^[:space:]]+[[:space:]]*/, "", value)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                gsub(/^"|"$/, "", value)
                found = value
            }
        }
        END {
            if (found != "") {
                print found
            }
        }
    ' "$VNSTAT_CONFIG"
}

# Validate the optional Puppet-managed monitoring config before any values are used.
validate_check_config() {
    CHECK_CONFIG_AVAILABLE=0
    [ -n "$CHECK_CONFIG" ] || die "check config path must not be empty"
    [ -e "$CHECK_CONFIG" ] || return 0
    [ -r "$CHECK_CONFIG" ] || die "check config is not readable: $CHECK_CONFIG"

    CHECK_CONFIG_VALIDATION=$($AWK '
        function positive(value) {
            return value ~ /^[0-9]+([.][0-9]+)?$/ && value + 0 > 0
        }
        function remember(scope, key, value) {
            values[scope SUBSEP key] = value
            scopes[scope] = 1
        }
        function fail(message) {
            if (first_error == "") {
                first_error = message
            }
        }
        {
            # Accept global p95 settings and per-interface overrides only.
            line = $0
            sub(/^[[:space:]]+/, "", line)
            if (line ~ /^($|[#;])/) {
                next
            }
            sub(/[[:space:]]+[#;].*$/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line == "") {
                next
            }

            count = split(line, parts, /[[:space:]]+/)
            if (count == 2 && (parts[1] == "p95_warning" || parts[1] == "p95_critical")) {
                key = parts[1]
                value = parts[2]
                scope = "global"
            } else if (count == 4 && parts[1] == "interface" && (parts[3] == "p95_warning" || parts[3] == "p95_critical")) {
                key = parts[3]
                value = parts[4]
                scope = "interface " parts[2]
            } else {
                fail("line " NR ": invalid syntax")
                next
            }

            # Threshold order is validated after all lines have been read.
            if (!positive(value)) {
                fail("line " NR ": " key " must be a positive number")
                next
            }
            remember(scope, key, value)
        }
        END {
            for (scope in scopes) {
                warning = values[scope SUBSEP "p95_warning"]
                critical = values[scope SUBSEP "p95_critical"]
                if (warning != "" && critical != "" && critical + 0 < warning + 0) {
                    fail(scope ": p95_critical must be greater than or equal to p95_warning")
                }
            }
            if (first_error != "") {
                print first_error
                exit 1
            }
        }
    ' "$CHECK_CONFIG" 2>&1)
    CHECK_CONFIG_RC=$?
    [ "$CHECK_CONFIG_RC" -eq 0 ] || die "invalid check config $CHECK_CONFIG: $(first_line_value "$CHECK_CONFIG_VALIDATION")"

    CHECK_CONFIG_AVAILABLE=1
}

# Read one threshold from the optional monitoring config. Later entries win.
check_config_value() {
    [ "$CHECK_CONFIG_AVAILABLE" -eq 1 ] || return 0

    $AWK -v scope="$1" -v iface="$2" -v key="$3" '
        {
            line = $0
            sub(/^[[:space:]]+/, "", line)
            if (line ~ /^($|[#;])/) {
                next
            }
            sub(/[[:space:]]+[#;].*$/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line == "") {
                next
            }

            count = split(line, parts, /[[:space:]]+/)
            if (scope == "global" && count == 2 && parts[1] == key) {
                found = parts[2]
            } else if (scope == "interface" && count == 4 && parts[1] == "interface" && parts[2] == iface && parts[3] == key) {
                found = parts[4]
            }
        }
        END {
            if (found != "") {
                print found
            }
        }
    ' "$CHECK_CONFIG"
}

# Parse only the conservative verbose `vnstat --iflist` speed shape: iface (N Mbit).
iflist_limit_mbit() {
    if [ "$IFLIST_RC" -ne 0 ]; then
        printf 'U|vnStat --iflist failed: %s\n' "$(first_line_value "$IFLIST_TEXT")"
        return
    fi

    printf '%s\n' "$IFLIST_TEXT" | $AWK -v iface="$1" '
        function emit(speed, unit) {
            sub(/^\(/, "", speed)
            sub(/\)$/, "", unit)
            if (unit == "kbit" || unit == "Kbit") {
                value = speed / 1000
            } else if (unit == "Mbit") {
                value = speed
            } else if (unit == "Gbit") {
                value = speed * 1000
            } else if (unit == "Tbit") {
                value = speed * 1000000
            } else {
                print "U|vnStat --iflist reported an unsupported speed unit for " iface
                exit
            }

            if (value > 0) {
                printf "%.2f|BandwidthDetection from vnStat --iflist\n", value
            } else {
                print "U|vnStat --iflist reported a non-positive speed for " iface
            }
            exit
        }
        {
            for (i = 1; i <= NF; i++) {
                if ($i == iface) {
                    found = 1
                    if (i + 2 <= NF && $(i + 1) ~ /^\([0-9]+([.][0-9]+)?$/ && $(i + 2) ~ /^(kbit|Kbit|Mbit|Gbit|Tbit)\)$/) {
                        emit($(i + 1), $(i + 2))
                    }
                    print "U|vnStat --iflist did not report a parseable speed for " iface
                    exit
                }
            }
        }
        END {
            if (!found) {
                print "U|interface not present in vnStat --iflist"
            }
        }
    '
}

# MaxBW<interface> has priority, then vnStat detection, then an explicit global MaxBandwidth.
showconfig_limit_mbit() {
    _iface_limit=$(showconfig_value "MaxBW${1}")
    if [ -n "$_iface_limit" ]; then
        is_number "$_iface_limit" || die "vnStat showconfig returned invalid MaxBW${1} value: $_iface_limit"
        if is_positive_number "$_iface_limit"; then
            printf '%s|MaxBW%s from vnStat showconfig\n' "$_iface_limit" "$1"
        else
            printf '%s|MaxBW%s is 0 in vnStat showconfig\n' 'U' "$1"
        fi
        return
    fi

    if [ "$BANDWIDTH_DETECTION" = '1' ]; then
        _detected_limit=$(iflist_limit_mbit "$1")
        _detected_value=${_detected_limit%%|*}
        _detected_source=${_detected_limit#*|}
        if is_positive_number "$_detected_value"; then
            printf '%s|%s\n' "$_detected_value" "$_detected_source"
            return
        fi
        _detection_note=$_detected_source
    else
        _detection_note='BandwidthDetection is disabled in vnStat showconfig'
    fi

    if is_positive_number "$EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT"; then
        printf '%s|MaxBandwidth from %s\n' "$EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT" "$VNSTAT_CONFIG"
    elif [ -n "$EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT" ] && is_number "$EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT"; then
        printf '%s|MaxBandwidth is 0 in %s\n' 'U' "$VNSTAT_CONFIG"
    else
        printf '%s|no MaxBW interface limit, no parseable BandwidthDetection speed (%s), and no explicit MaxBandwidth value in %s\n' 'U' "$_detection_note" "$VNSTAT_CONFIG"
    fi
}

# Validate options before calling vnStat so bad monitoring arguments return UNKNOWN.
validate_regex "include" "$INCLUDE_REGEX"
validate_regex "exclude" "$EXCLUDE_REGEX"
validate_number "capacity_warning_percent" "$CAPACITY_WARNING_PERCENT"
validate_number "capacity_critical_percent" "$CAPACITY_CRITICAL_PERCENT"
validate_number "growth_day_warning_percent" "$GROWTH_DAY_WARNING_PERCENT"
validate_number "growth_day_critical_percent" "$GROWTH_DAY_CRITICAL_PERCENT"
validate_number "growth_month_warning_percent" "$GROWTH_MONTH_WARNING_PERCENT"
validate_number "growth_month_critical_percent" "$GROWTH_MONTH_CRITICAL_PERCENT"
validate_number "last_update_warning_seconds" "$LAST_UPDATE_WARNING_SECONDS"
validate_number "last_update_critical_seconds" "$LAST_UPDATE_CRITICAL_SECONDS"
case "$DETAIL_LIMIT" in
    ''|*[!0-9]*) die "invalid numeric value for detail_limit: $DETAIL_LIMIT" ;;
esac
validate_pair "capacity" "$CAPACITY_WARNING_PERCENT" "$CAPACITY_CRITICAL_PERCENT"
validate_pair "day growth" "$GROWTH_DAY_WARNING_PERCENT" "$GROWTH_DAY_CRITICAL_PERCENT"
validate_pair "month growth" "$GROWTH_MONTH_WARNING_PERCENT" "$GROWTH_MONTH_CRITICAL_PERCENT"
validate_pair "last update" "$LAST_UPDATE_WARNING_SECONDS" "$LAST_UPDATE_CRITICAL_SECONDS"
[ "$DETAIL_LIMIT" -ge 1 ] || die "detail_limit must be at least 1"

validate_check_config

GLOBAL_P95_WARNING_MBIT=$(check_config_value 'global' '' 'p95_warning')
GLOBAL_P95_CRITICAL_MBIT=$(check_config_value 'global' '' 'p95_critical')
validate_pair "global p95" "$GLOBAL_P95_WARNING_MBIT" "$GLOBAL_P95_CRITICAL_MBIT"

# Query vnStat's effective configuration once. Interface limits come from this output.
SHOWCONFIG_TEXT=$($VNSTAT --showconfig 2>&1)
SHOWCONFIG_RC=$?
if [ "$SHOWCONFIG_RC" -ne 0 ]; then
    SHOWCONFIG_ERROR=$(first_line_value "$SHOWCONFIG_TEXT")
    [ -n "$SHOWCONFIG_ERROR" ] || SHOWCONFIG_ERROR='showconfig query failed'
    die "vnStat showconfig failed: $SHOWCONFIG_ERROR"
fi

BANDWIDTH_DETECTION=$(showconfig_value 'BandwidthDetection')
if [ -n "$BANDWIDTH_DETECTION" ] && [ "$BANDWIDTH_DETECTION" != '0' ] && [ "$BANDWIDTH_DETECTION" != '1' ]; then
    die "vnStat showconfig returned invalid BandwidthDetection value: $BANDWIDTH_DETECTION"
fi

EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT=$(config_file_value 'MaxBandwidth')
if [ -n "$EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT" ] && ! is_number "$EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT"; then
    die "vnStat config contains invalid MaxBandwidth value: $EXPLICIT_GLOBAL_MAXBANDWIDTH_MBIT"
fi

# Query the verbose interface list once for vnStat's detected speed hints.
IFLIST_TEXT=$($VNSTAT --iflist 2>&1)
IFLIST_RC=$?

# Query the vnStat summary JSON once; this contains interface names, update timestamps and daily/monthly history.
SUMMARY_JSON=$($VNSTAT --json s 2>&1)
SUMMARY_RC=$?
if [ "$SUMMARY_RC" -ne 0 ]; then
    VNSTAT_ERROR=$(first_line_value "$SUMMARY_JSON")
    [ -n "$VNSTAT_ERROR" ] || VNSTAT_ERROR='summary query failed'
    die "vnStat JSON query failed: $VNSTAT_ERROR"
fi

JQ_ERROR=$(printf '%s' "$SUMMARY_JSON" | $JQ -e '.interfaces | type == "array"' 2>&1 >/dev/null)
if [ "$?" -ne 0 ]; then
    JQ_ERROR=$(first_line_value "$JQ_ERROR")
    [ -n "$JQ_ERROR" ] || JQ_ERROR='invalid JSON'
    die "vnStat returned invalid JSON: $JQ_ERROR"
fi

INTERFACES=$(printf '%s' "$SUMMARY_JSON" | $JQ -r '.interfaces[]?.name // empty' 2>&1)
if [ "$?" -ne 0 ]; then
    die "vnStat returned invalid JSON: $(first_line_value "$INTERFACES")"
fi
[ -n "$INTERFACES" ] || die "no vnStat interfaces found"

# Apply monitoring-side include/exclude filtering. vnStat itself does not support regex excludes.
while IFS= read -r IFACE || [ -n "$IFACE" ]; do
    [ -n "$IFACE" ] || continue

    if [ -n "$INCLUDE_REGEX" ] && ! match_regex "$IFACE" "$INCLUDE_REGEX"; then
        IGNORED_COUNT=$((IGNORED_COUNT + 1))
        IGNORED_ITEMS="${IGNORED_ITEMS}${IGNORED_SEPARATOR}$(monitor_text_value "$IFACE"): not matched by include regex"
        IGNORED_SEPARATOR=','
        continue
    fi

    if [ -n "$EXCLUDE_REGEX" ] && match_regex "$IFACE" "$EXCLUDE_REGEX"; then
        IGNORED_COUNT=$((IGNORED_COUNT + 1))
        IGNORED_ITEMS="${IGNORED_ITEMS}${IGNORED_SEPARATOR}$(monitor_text_value "$IFACE"): excluded by regex"
        IGNORED_SEPARATOR=','
        continue
    fi

    CHECKED_COUNT=$((CHECKED_COUNT + 1))
    CHECKED_INTERFACES="${CHECKED_INTERFACES}${CHECKED_SEPARATOR}${IFACE}"
    CHECKED_SEPARATOR=','
done <<EOF
$INTERFACES
EOF

if [ "$CHECKED_COUNT" -eq 0 ]; then
    printf 'vnStat has no interfaces after filtering | interfaces_checked=0;;;; interfaces_ignored=%s;;;;\n' "$IGNORED_COUNT"
    printf '%s\n' 'Ignored interfaces:'
    if [ "$IGNORED_COUNT" -gt 0 ]; then
        printf '%s\n' "$IGNORED_ITEMS" | $TR ',' '\n' | $SED 's/^/  /'
    else
        printf '%s\n' '  none'
    fi
    exit "$STATE_UNKNOWN"
fi

NOW_TS=$($DATE +%s)
is_number "$NOW_TS" || die "date returned invalid Unix timestamp: $NOW_TS"
CHECKED_INTERFACES_LINES=$(printf '%s' "$CHECKED_INTERFACES" | $TR ',' '\n')
INTERFACE_INDEX=0

# Analyze each checked interface. Long output is always emitted and grouped after final status is known.
while IFS= read -r IFACE || [ -n "$IFACE" ]; do
    [ -n "$IFACE" ] || continue

    INTERFACE_INDEX=$((INTERFACE_INDEX + 1))
    LABEL=$(sanitize_label "$IFACE")
    [ -n "$LABEL" ] || LABEL="interface_${INTERFACE_INDEX}"
    IFACE_TEXT=$(monitor_text_value "$IFACE")
    INTERFACE_STATE='OK'

    # Merge interface-specific 95th percentile thresholds with global defaults.
    INTERFACE_CONFIG_P95_WARNING_MBIT=$(check_config_value 'interface' "$IFACE" 'p95_warning')
    INTERFACE_CONFIG_P95_CRITICAL_MBIT=$(check_config_value 'interface' "$IFACE" 'p95_critical')
    if [ -n "$INTERFACE_CONFIG_P95_WARNING_MBIT" ]; then
        P95_WARNING_MBIT=$INTERFACE_CONFIG_P95_WARNING_MBIT
    else
        P95_WARNING_MBIT=$GLOBAL_P95_WARNING_MBIT
    fi
    if [ -n "$INTERFACE_CONFIG_P95_CRITICAL_MBIT" ]; then
        P95_CRITICAL_MBIT=$INTERFACE_CONFIG_P95_CRITICAL_MBIT
    else
        P95_CRITICAL_MBIT=$GLOBAL_P95_CRITICAL_MBIT
    fi
    validate_pair "p95 for $IFACE" "$P95_WARNING_MBIT" "$P95_CRITICAL_MBIT"
    if [ -n "$P95_WARNING_MBIT" ] || [ -n "$P95_CRITICAL_MBIT" ]; then
        P95_THRESHOLDS_CONFIGURED=1
    else
        P95_THRESHOLDS_CONFIGURED=0
    fi

    # Extract update age and daily/monthly totals from the summary JSON.
    TRAFFIC_TSV=$(printf '%s' "$SUMMARY_JSON" | $JQ -r --arg iface "$IFACE" '
        # vnStat JSON can use timestamp or structured date objects depending on version.
        (.interfaces[]? | select(.name == $iface)) as $if |
        def date_key($entry):
            if (($entry.timestamp | type) == "number") then
                $entry.timestamp
            elif (($entry.date | type) == "object" and (($entry.date.year | type) == "number") and (($entry.date.month | type) == "number")) then
                (($entry.date.year * 10000) + ($entry.date.month * 100) + ($entry.date.day // 1))
            else
                0
            end;
        def rows($name): [ $if.traffic[$name][]? ] | sort_by(date_key(.));
        def pick($name; $offset):
            (rows($name)) as $rows |
            if ($rows | length) > $offset then $rows[($rows | length) - 1 - $offset] else null end;
        def num($entry; $key):
            if $entry == null or (($entry[$key] | type) != "number") then "U" else $entry[$key] end;
        def total($entry):
            if $entry == null or (($entry.rx | type) != "number") or (($entry.tx | type) != "number") then "U" else ($entry.rx + $entry.tx) end;
        if $if == null then
            empty
        else
            (pick("day"; 0)) as $current_day |
            (pick("day"; 1)) as $previous_day |
            (pick("month"; 0)) as $current_month |
            (pick("month"; 1)) as $previous_month |
            # Emit a fixed TSV record that the POSIX shell parser can split safely.
            [
                (if (($if.updated.timestamp | type) == "number") then $if.updated.timestamp else "U" end),
                num($current_day; "rx"),
                num($current_day; "tx"),
                total($current_day),
                total($previous_day),
                num($current_month; "rx"),
                num($current_month; "tx"),
                total($current_month),
                total($previous_month)
            ] | @tsv
        end
    ' 2>&1)
    TRAFFIC_RC=$?

    if [ "$TRAFFIC_RC" -ne 0 ] || [ -z "$TRAFFIC_TSV" ]; then
        UPDATED_TS='U'
        RX_DAY='U'
        TX_DAY='U'
        CURRENT_DAY_TOTAL='U'
        PREVIOUS_DAY_TOTAL='U'
        RX_MONTH='U'
        TX_MONTH='U'
        CURRENT_MONTH_TOTAL='U'
        PREVIOUS_MONTH_TOTAL='U'
        TRAFFIC_ERROR=$(first_line_value "$TRAFFIC_TSV")
        [ -n "$TRAFFIC_ERROR" ] || TRAFFIC_ERROR='interface data could not be parsed'
        INTERFACE_STATE=$(max_state "$INTERFACE_STATE" 'UNKNOWN')
        add_summary_issue 'UNKNOWN' "$IFACE traffic data unavailable: $TRAFFIC_ERROR"
    else
        # The jq expression emits fixed numeric/U fields, so plain field splitting is safe here.
        set -- $TRAFFIC_TSV
        UPDATED_TS=$1
        RX_DAY=$2
        TX_DAY=$3
        CURRENT_DAY_TOTAL=$4
        PREVIOUS_DAY_TOTAL=$5
        RX_MONTH=$6
        TX_MONTH=$7
        CURRENT_MONTH_TOTAL=$8
        PREVIOUS_MONTH_TOTAL=$9
        TRAFFIC_ERROR=''
    fi

    if is_number "$UPDATED_TS"; then
        LAST_UPDATE_AGE=$($AWK -v now="$NOW_TS" -v updated="$UPDATED_TS" 'BEGIN {
            age = now - updated
            if (age < 0) {
                age = 0
            }
            printf "%.0f\n", age
        }')
        LAST_UPDATE_STATE=$(threshold_status "$LAST_UPDATE_AGE" "$LAST_UPDATE_WARNING_SECONDS" "$LAST_UPDATE_CRITICAL_SECONDS")
    else
        LAST_UPDATE_AGE='U'
        LAST_UPDATE_STATE='UNKNOWN'
    fi
    INTERFACE_STATE=$(max_state "$INTERFACE_STATE" "$LAST_UPDATE_STATE")
    case "$LAST_UPDATE_STATE" in
        CRITICAL)
            add_summary_issue 'CRITICAL' "$IFACE last vnStat update is stale (${LAST_UPDATE_AGE}s)"
            ;;
        WARNING)
            add_summary_issue 'WARNING' "$IFACE last vnStat update is stale (${LAST_UPDATE_AGE}s)"
            ;;
        UNKNOWN)
            if [ -z "$TRAFFIC_ERROR" ]; then
                add_summary_issue 'UNKNOWN' "$IFACE last vnStat update age unavailable"
            fi
            ;;
    esac

    # Use vnStat's native 95th percentile implementation for the current month.
    P95_JSON=$($VNSTAT --iface "$IFACE" --json p 2>&1)
    P95_RC=$?
    P95_BYTES_PER_SECOND='U'
    P95_MBIT='U'
    P95_COVERAGE='U'
    P95_SEEN='U'
    P95_EXPECTED='U'
    P95_STATE='OK'
    P95_ERROR=''

    if [ "$P95_RC" -eq 0 ]; then
        JQ_ERROR=$(printf '%s' "$P95_JSON" | $JQ -e '.interfaces | type == "array"' 2>&1 >/dev/null)
        if [ "$?" -eq 0 ]; then
            P95_TSV=$(printf '%s' "$P95_JSON" | $JQ -r --arg iface "$IFACE" '
                (.interfaces[]? | select(.name == $iface) | .bandwidth) as $bandwidth |
                if $bandwidth == null then empty else
                    [
                        ($bandwidth."95th_percentile".total_bytes_per_second // "U"),
                        ($bandwidth.entries.coverage_percentage // "U"),
                        ($bandwidth.entries.seen // "U"),
                        ($bandwidth.entries.expected // "U")
                    ] | @tsv
                end
            ' 2>&1)
            if [ "$?" -eq 0 ] && [ -n "$P95_TSV" ]; then
                # The percentile query emits fixed numeric/U fields, so plain field splitting is safe here.
                set -- $P95_TSV
                P95_BYTES_PER_SECOND=$1
                P95_COVERAGE=$2
                P95_SEEN=$3
                P95_EXPECTED=$4

                if is_number "$P95_BYTES_PER_SECOND"; then
                    P95_MBIT=$(calc_mbit_from_bytes_per_second "$P95_BYTES_PER_SECOND")
                    if [ "$P95_THRESHOLDS_CONFIGURED" -eq 1 ]; then
                        P95_STATE=$(threshold_status "$P95_MBIT" "$P95_WARNING_MBIT" "$P95_CRITICAL_MBIT")
                    fi
                else
                    P95_ERROR='95th percentile value is missing from vnStat JSON'
                fi
            else
                P95_ERROR=$(first_line_value "$P95_TSV")
                [ -n "$P95_ERROR" ] || P95_ERROR='95th percentile data is missing from vnStat JSON'
            fi
        else
            P95_ERROR=$(first_line_value "$JQ_ERROR")
            [ -n "$P95_ERROR" ] || P95_ERROR='invalid 95th percentile JSON'
        fi
    else
        P95_ERROR=$(first_line_value "$P95_JSON")
        [ -n "$P95_ERROR" ] || P95_ERROR='95th percentile query failed'
    fi
    if [ "$P95_MBIT" = 'U' ] && [ "$P95_THRESHOLDS_CONFIGURED" -eq 1 ]; then
        P95_STATE='UNKNOWN'
    fi
    INTERFACE_STATE=$(max_state "$INTERFACE_STATE" "$P95_STATE")
    case "$P95_STATE" in
        CRITICAL)
            add_summary_issue 'CRITICAL' "$IFACE 95th percentile high ($(format_number "$P95_MBIT") Mbit/s)"
            ;;
        WARNING)
            add_summary_issue 'WARNING' "$IFACE 95th percentile elevated ($(format_number "$P95_MBIT") Mbit/s)"
            ;;
        UNKNOWN)
            add_summary_issue 'UNKNOWN' "$IFACE 95th percentile unavailable: $P95_ERROR"
            ;;
    esac

    # Capacity limits intentionally follow vnStat's effective configuration.
    LIMIT_TSV=$(showconfig_limit_mbit "$IFACE")
    INTERFACE_LIMIT_MBIT=${LIMIT_TSV%%|*}
    LIMIT_SOURCE=${LIMIT_TSV#*|}

    if [ "$INTERFACE_LIMIT_MBIT" = 'U' ] || [ -z "$INTERFACE_LIMIT_MBIT" ]; then
        CAPACITY_PCT='U'
        CAPACITY_STATE='OK'
        CAPACITY_NOTE=$LIMIT_SOURCE
    elif [ "$P95_MBIT" = 'U' ]; then
        CAPACITY_PCT='U'
        CAPACITY_STATE='UNKNOWN'
        if [ -n "$P95_ERROR" ]; then
            CAPACITY_NOTE="95th percentile unavailable; ${P95_ERROR}"
        else
            CAPACITY_NOTE='95th percentile unavailable'
        fi
    else
        CAPACITY_PCT=$(calc_percent "$P95_MBIT" "$INTERFACE_LIMIT_MBIT")
        CAPACITY_STATE=$(threshold_status "$CAPACITY_PCT" "$CAPACITY_WARNING_PERCENT" "$CAPACITY_CRITICAL_PERCENT")
        CAPACITY_NOTE="of ${INTERFACE_LIMIT_MBIT} Mbit/s (${LIMIT_SOURCE})"
    fi
    INTERFACE_STATE=$(max_state "$INTERFACE_STATE" "$CAPACITY_STATE")
    case "$CAPACITY_STATE" in
        CRITICAL)
            add_summary_issue 'CRITICAL' "$IFACE capacity high ($(format_number "$CAPACITY_PCT")%)"
            ;;
        WARNING)
            add_summary_issue 'WARNING' "$IFACE capacity elevated ($(format_number "$CAPACITY_PCT")%)"
            ;;
        UNKNOWN)
            add_summary_issue 'UNKNOWN' "$IFACE capacity unavailable: $CAPACITY_NOTE"
            ;;
    esac

    # Relative growth is only meaningful when vnStat has a non-zero previous-day baseline.
    if [ "$CURRENT_DAY_TOTAL" = 'U' ] || [ "$PREVIOUS_DAY_TOTAL" = 'U' ] || ! is_positive_number "$PREVIOUS_DAY_TOTAL"; then
        DAY_GROWTH_PCT='U'
        DAY_GROWTH_STATE='OK'
        DAY_BASELINE_AVAILABLE=0
        DAY_GROWTH_NOTE='no previous day baseline available'
    else
        DAY_GROWTH_PCT=$(calc_growth_percent "$CURRENT_DAY_TOTAL" "$PREVIOUS_DAY_TOTAL")
        DAY_BASELINE_AVAILABLE=1
        DAY_GROWTH_STATE=$(threshold_status "$DAY_GROWTH_PCT" "$GROWTH_DAY_WARNING_PERCENT" "$GROWTH_DAY_CRITICAL_PERCENT")
    fi
    INTERFACE_STATE=$(max_state "$INTERFACE_STATE" "$DAY_GROWTH_STATE")
    case "$DAY_GROWTH_STATE" in
        CRITICAL)
            add_summary_issue 'CRITICAL' "$IFACE day growth high ($(format_number "$DAY_GROWTH_PCT")%)"
            ;;
        WARNING)
            add_summary_issue 'WARNING' "$IFACE day growth elevated ($(format_number "$DAY_GROWTH_PCT")%)"
            ;;
    esac

    # Missing previous-month data is expected for new interfaces and must not alert.
    if [ "$CURRENT_MONTH_TOTAL" = 'U' ] || [ "$PREVIOUS_MONTH_TOTAL" = 'U' ] || ! is_positive_number "$PREVIOUS_MONTH_TOTAL"; then
        MONTH_GROWTH_PCT='U'
        MONTH_GROWTH_STATE='OK'
        MONTH_BASELINE_AVAILABLE=0
        MONTH_GROWTH_NOTE='no previous month baseline available'
    else
        MONTH_GROWTH_PCT=$(calc_growth_percent "$CURRENT_MONTH_TOTAL" "$PREVIOUS_MONTH_TOTAL")
        MONTH_BASELINE_AVAILABLE=1
        MONTH_GROWTH_STATE=$(threshold_status "$MONTH_GROWTH_PCT" "$GROWTH_MONTH_WARNING_PERCENT" "$GROWTH_MONTH_CRITICAL_PERCENT")
    fi
    INTERFACE_STATE=$(max_state "$INTERFACE_STATE" "$MONTH_GROWTH_STATE")
    case "$MONTH_GROWTH_STATE" in
        CRITICAL)
            add_summary_issue 'CRITICAL' "$IFACE month growth high ($(format_number "$MONTH_GROWTH_PCT")%)"
            ;;
        WARNING)
            add_summary_issue 'WARNING' "$IFACE month growth elevated ($(format_number "$MONTH_GROWTH_PCT")%)"
            ;;
    esac

    # Build compact Nagios perfdata directly in memory because the final first line depends on all interfaces.
    INTERFACE_PERFDATA=$(
        printf '%s_p95=%s;%s;%s;0;' "$LABEL" "$(perf_value "$P95_MBIT" 'Mbps')" "$P95_WARNING_MBIT" "$P95_CRITICAL_MBIT"
        printf ' %s_cap=%s;%s;%s;0;100' "$LABEL" "$(perf_value "$CAPACITY_PCT" '%')" "$CAPACITY_WARNING_PERCENT" "$CAPACITY_CRITICAL_PERCENT"
        printf ' %s_growth_day=%s;%s;%s;;' "$LABEL" "$(perf_value "$DAY_GROWTH_PCT" '%')" "$GROWTH_DAY_WARNING_PERCENT" "$GROWTH_DAY_CRITICAL_PERCENT"
        printf ' %s_growth_month=%s;%s;%s;;' "$LABEL" "$(perf_value "$MONTH_GROWTH_PCT" '%')" "$GROWTH_MONTH_WARNING_PERCENT" "$GROWTH_MONTH_CRITICAL_PERCENT"
        printf ' %s_rx_day=%s;;;;' "$LABEL" "$(perf_value "$RX_DAY" 'B')"
        printf ' %s_tx_day=%s;;;;' "$LABEL" "$(perf_value "$TX_DAY" 'B')"
        printf ' %s_rx_month=%s;;;;' "$LABEL" "$(perf_value "$RX_MONTH" 'B')"
        printf ' %s_tx_month=%s;;;;' "$LABEL" "$(perf_value "$TX_MONTH" 'B')"
        printf ' %s_age=%s;%s;%s;0;' "$LABEL" "$(perf_value "$LAST_UPDATE_AGE" 's')" "$LAST_UPDATE_WARNING_SECONDS" "$LAST_UPDATE_CRITICAL_SECONDS"
    )
    PERFDATA="${PERFDATA}${PERFDATA:+ }${INTERFACE_PERFDATA}"

    # Keep long output operator-readable and grouped by final interface status without repeating threshold inventories.
    INTERFACE_BLOCK=$(
        printf 'Interface %s: %s\n' "$IFACE_TEXT" "$(state_detail_text "$INTERFACE_STATE")"
        if [ -n "$TRAFFIC_ERROR" ]; then
            printf '  Traffic data: unavailable (%s)\n' "$(monitor_text_value "$TRAFFIC_ERROR")"
        fi

        if [ "$P95_STATE" = 'UNKNOWN' ]; then
            printf '  95th percentile: unavailable%s\n' "$(monitor_text_value "${P95_ERROR:+ ($P95_ERROR)}")"
        elif [ "$P95_MBIT" = 'U' ]; then
            printf '  95th percentile: unavailable%s\n' "$(monitor_text_value "${P95_ERROR:+ ($P95_ERROR)}")"
        else
            printf '  95th percentile: %s Mbit/s\n' "$(format_number "$P95_MBIT")"
        fi
        printf '  95th percentile coverage: %s%% (%s/%s entries)\n' "$P95_COVERAGE" "$P95_SEEN" "$P95_EXPECTED"

        if [ "$CAPACITY_STATE" = 'OK' ] && [ "$CAPACITY_PCT" = 'U' ]; then
            printf '  Capacity: skipped (%s)\n' "$(monitor_text_value "$CAPACITY_NOTE")"
        elif [ "$CAPACITY_STATE" = 'UNKNOWN' ]; then
            printf '  Capacity: unavailable (%s)\n' "$(monitor_text_value "$CAPACITY_NOTE")"
        else
            printf '  Capacity: %s%% %s\n' "$(format_number "$CAPACITY_PCT")" "$(monitor_text_value "$CAPACITY_NOTE")"
        fi

        if [ "$DAY_BASELINE_AVAILABLE" -eq 1 ]; then
            printf '  Day growth: %s%%\n' "$(format_number "$DAY_GROWTH_PCT")"
        else
            printf '  Day growth: skipped (%s)\n' "$DAY_GROWTH_NOTE"
        fi

        if [ "$MONTH_BASELINE_AVAILABLE" -eq 1 ]; then
            printf '  Month growth: %s%%\n' "$(format_number "$MONTH_GROWTH_PCT")"
        else
            printf '  Month growth: skipped (%s)\n' "$MONTH_GROWTH_NOTE"
        fi

        printf '  Current day total: %s\n' "$(format_bytes "$CURRENT_DAY_TOTAL")"
        printf '  Previous day total: %s\n' "$(format_bytes "$PREVIOUS_DAY_TOTAL")"
        printf '  Current month total: %s\n' "$(format_bytes "$CURRENT_MONTH_TOTAL")"
        printf '  Previous month total: %s\n' "$(format_bytes "$PREVIOUS_MONTH_TOTAL")"
        printf '  Last vnStat update age: %s seconds\n' "$LAST_UPDATE_AGE"
    )

    case "$INTERFACE_STATE" in
        CRITICAL)
            CRITICAL_COUNT=$((CRITICAL_COUNT + 1))
            if [ -z "$NAMES_CRITICAL" ]; then NAMES_CRITICAL=$IFACE_TEXT; else NAMES_CRITICAL="${NAMES_CRITICAL}, ${IFACE_TEXT}"; fi
            append_interface_block "$INTERFACE_STATE" "$INTERFACE_BLOCK"
            ;;
        WARNING)
            WARNING_COUNT=$((WARNING_COUNT + 1))
            if [ -z "$NAMES_WARNING" ]; then NAMES_WARNING=$IFACE_TEXT; else NAMES_WARNING="${NAMES_WARNING}, ${IFACE_TEXT}"; fi
            append_interface_block "$INTERFACE_STATE" "$INTERFACE_BLOCK"
            ;;
        UNKNOWN)
            UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1))
            if [ -z "$NAMES_UNKNOWN" ]; then NAMES_UNKNOWN=$IFACE_TEXT; else NAMES_UNKNOWN="${NAMES_UNKNOWN}, ${IFACE_TEXT}"; fi
            append_interface_block "$INTERFACE_STATE" "$INTERFACE_BLOCK"
            ;;
        *)
            OK_COUNT=$((OK_COUNT + 1))
            if [ -z "$NAMES_OK" ]; then NAMES_OK=$IFACE_TEXT; else NAMES_OK="${NAMES_OK}, ${IFACE_TEXT}"; fi
            append_interface_block "$INTERFACE_STATE" "$INTERFACE_BLOCK"
            ;;
    esac

    FINAL_STATE=$(max_state "$FINAL_STATE" "$INTERFACE_STATE")
done <<EOF
$CHECKED_INTERFACES_LINES
EOF

FINAL_EXIT=$(state_exit_code "$FINAL_STATE")
if [ "$FINAL_EXIT" -eq 0 ]; then
    SUMMARY_TEXT="vnStat interfaces are healthy: ${OK_COUNT} checked"
else
    SUMMARY_TEXT='vnStat interfaces need attention:'
    SUMMARY_SEPARATOR=' '
    if [ "$CRITICAL_COUNT" -gt 0 ]; then
        if [ -n "$SUMMARY_CRITICAL" ]; then
            SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${SUMMARY_CRITICAL}"
        else
            SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${CRITICAL_COUNT} interface(s) need immediate attention"
        fi
        SUMMARY_SEPARATOR='; '
    fi
    if [ "$WARNING_COUNT" -gt 0 ]; then
        if [ -n "$SUMMARY_WARNING" ]; then
            SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${SUMMARY_WARNING}"
        else
            SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${WARNING_COUNT} interface(s) need attention"
        fi
        SUMMARY_SEPARATOR='; '
    fi
    if [ "$UNKNOWN_COUNT" -gt 0 ]; then
        if [ -n "$SUMMARY_UNKNOWN" ]; then
            SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${SUMMARY_UNKNOWN}"
        else
            SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${UNKNOWN_COUNT} interface(s) have incomplete data"
        fi
        SUMMARY_SEPARATOR='; '
    fi
    if [ "$OK_COUNT" -gt 0 ]; then SUMMARY_TEXT="${SUMMARY_TEXT}${SUMMARY_SEPARATOR}${OK_COUNT} healthy"; fi
fi

printf '%s | %s\n' "$SUMMARY_TEXT" "$PERFDATA"

printf '%s\n' 'Summary:'
if [ "$CRITICAL_COUNT" -gt 0 ]; then printf '  Needs immediate attention: %s\n' "$NAMES_CRITICAL"; fi
if [ "$WARNING_COUNT" -gt 0 ]; then printf '  Needs attention: %s\n' "$NAMES_WARNING"; fi
if [ "$UNKNOWN_COUNT" -gt 0 ]; then printf '  Incomplete data: %s\n' "$NAMES_UNKNOWN"; fi
if [ "$OK_COUNT" -gt 0 ]; then printf '  Healthy interfaces: %s\n' "$NAMES_OK"; fi
printf '  Checked interfaces: %s\n' "$CHECKED_COUNT"
printf '  Ignored interfaces: %s\n' "$IGNORED_COUNT"
if [ "$LONG_DETAIL_TRUNCATED" -gt 0 ]; then
    printf '  Interface detail output truncated: %s block(s) omitted after %s shown\n' "$LONG_DETAIL_TRUNCATED" "$LONG_DETAIL_COUNT"
fi
printf '\n'
[ -n "$LONG_CRITICAL" ] && printf '%s\n\n' "$LONG_CRITICAL"
[ -n "$LONG_WARNING" ] && printf '%s\n\n' "$LONG_WARNING"
[ -n "$LONG_UNKNOWN" ] && printf '%s\n\n' "$LONG_UNKNOWN"
[ -n "$LONG_OK" ] && printf '%s\n\n' "$LONG_OK"
printf '%s\n' 'Ignored interfaces:'
if [ "$IGNORED_COUNT" -gt 0 ]; then
    printf '%s\n' "$IGNORED_ITEMS" | $TR ',' '\n' | $SED 's/^/  /'
else
    printf '%s\n' '  none'
fi

exit "$FINAL_EXIT"
